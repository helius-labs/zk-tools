{
  "name": "@heliuslabs/spr-web-prover",
  "version": "0.7.0-alpha",
  "description": "Local Groth16 proving for Solana Privacy Rings in browsers.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helius-labs/zk-tools.git",
    "directory": "clients/spr-prover/packages/web-prover"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "bin": {
    "spr-prover-keys": "dist/scripts/install-keys.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    }
  },
  "scripts": {
    "generate:keys": "node scripts/generate-key-digests.mjs",
    "build": "rm -rf dist && ../../scripts/build-runtime.sh && npm run generate:keys && tsc -p tsconfig.build.json && node ../../scripts/prepare-prover-package.mjs",
    "types": "../../scripts/build-runtime.sh && npm run generate:keys && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "pretypecheck": "npm run generate:keys",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run generate:keys",
    "test": "vitest run",
    "prepack": "npm run build >&2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "webgpu": "0.6.2",
    "@heliuslabs/spr": "0.9.0-alpha"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "webgpu": "^0.6.2",
    "@heliuslabs/spr": "0.9.0-alpha"
  },
  "peerDependenciesMeta": {
    "webgpu": {
      "optional": true
    },
    "@heliuslabs/spr": {
      "optional": true
    }
  }
}
