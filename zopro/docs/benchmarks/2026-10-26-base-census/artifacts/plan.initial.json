{
  "environment": {
    "MALLOC_ARENA_MAX": "32",
    "MALLOC_MMAP_THRESHOLD_": "1073741824",
    "MALLOC_TRIM_THRESHOLD_": "-1",
    "RAYON_NUM_THREADS": "32",
    "ZOPRO_BASIS_KEY_DIR": "/tmp/zopro-canonical-grain-adoption/images",
    "ZOPRO_CPU_BOUNDED_SCHEDULE": "1",
    "ZOPRO_CPU_CANONICAL_WIRES": "1",
    "ZOPRO_CPU_DEFER_SIGNED_Y": "1",
    "ZOPRO_CPU_DEFER_SIGN_PARTS": "1",
    "ZOPRO_CPU_DEFER_SIGN_WIDTH": "12",
    "ZOPRO_CPU_FFT_COLUMN_ROOTS": "1",
    "ZOPRO_CPU_G2_PREFIX_RECORDS": "1",
    "ZOPRO_CPU_LAGRANGE": "1",
    "ZOPRO_CPU_LAGRANGE_DIR": "/tmp/zopro-lagrange-cache",
    "ZOPRO_CPU_LAGRANGE_FOLD": "1",
    "ZOPRO_CPU_PROOF_CONCURRENCY": "1",
    "ZOPRO_CPU_RESOURCE_SCHEDULE": "1",
    "ZOPRO_CPU_SMALL_CORE_ENTRY": "1",
    "ZOPRO_CPU_ZERO_AWARE_GROUPS": "1"
  },
  "source_pins": "/tmp/zopro-base-census/input-pins.json",
  "steps": [
    {
      "argv": [
        "rustc",
        "--edition=2021",
        "-O",
        "-C",
        "target-cpu=native",
        "-C",
        "lto=off",
        "-C",
        "codegen-units=1",
        "-L",
        "dependency=/tmp/zopro-grouping-module/target-native/release/deps",
        "--extern",
        "zopro_prover=/tmp/zopro-grouping-module/target-native/release/deps/libzopro_prover.rlib",
        "--extern",
        "zopro_bn254=/tmp/zopro-grouping-module/target-native/release/deps/libzopro_bn254-505b170cdc507df1.rlib",
        "--extern",
        "memmap2=/tmp/zopro-grouping-module/target-native/release/deps/libmemmap2-965af0fecf05a7bb.rlib",
        "--extern",
        "serde_json=/tmp/zopro-grouping-module/target-native/release/deps/libserde_json-cae5e7ec1f017ce1.rlib",
        "/tmp/zopro-base-census/probe.rs",
        "-o",
        "/tmp/zopro-base-census/probe"
      ],
      "kind": "command",
      "name": "link",
      "timeout_seconds": 600
    },
    {
      "argv": [
        "rustc",
        "--edition=2021",
        "-O",
        "-C",
        "target-cpu=native",
        "-C",
        "lto=off",
        "-C",
        "codegen-units=1",
        "-L",
        "dependency=/tmp/zopro-grouping-module/target-native/release/deps",
        "--extern",
        "zopro_prover=/tmp/zopro-grouping-module/target-native/release/deps/libzopro_prover.rlib",
        "--extern",
        "zopro_bn254=/tmp/zopro-grouping-module/target-native/release/deps/libzopro_bn254-505b170cdc507df1.rlib",
        "--extern",
        "memmap2=/tmp/zopro-grouping-module/target-native/release/deps/libmemmap2-965af0fecf05a7bb.rlib",
        "--extern",
        "serde_json=/tmp/zopro-grouping-module/target-native/release/deps/libserde_json-cae5e7ec1f017ce1.rlib",
        "--test",
        "/tmp/zopro-base-census/probe.rs",
        "-o",
        "/tmp/zopro-base-census/probe-tests"
      ],
      "kind": "command",
      "name": "link-tests",
      "timeout_seconds": 600
    },
    {
      "argv": [
        "/tmp/zopro-base-census/probe-tests"
      ],
      "kind": "command",
      "name": "tests",
      "required_tests": [
        "tests::signed_counts_match_independent_sorted_sets",
        "tests::signed_scalar_combination_matches_g1_and_g2_generator_oracles",
        "tests::zero_only_counts_no_classes",
        "tests::range_arithmetic_rejects_overflow_and_truncation"
      ],
      "timeout_seconds": 120,
      "unfiltered": true
    },
    {
      "argv": [
        "/usr/bin/time",
        "-v",
        "taskset",
        "-c",
        "0-31",
        "/tmp/zopro-base-census/probe",
        "/tmp/zopro-base-census/cases.json"
      ],
      "kind": "command",
      "name": "census",
      "timeout_seconds": 1200
    }
  ],
  "version": 1
}