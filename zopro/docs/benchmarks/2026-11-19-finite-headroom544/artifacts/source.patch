+        let groups = "0::/child";
+        let write = |dir:&std::path::Path, key:&str, v:&str|fs::write(dir.join(key),v).unwrap();
+        for dir in [&root,&group] {
+            write(dir,"memory.max","max");write(dir,"memory.high","max");
+        }
+        assert_eq!(cgroup_headroom(groups,&mounts),None);
+        write(&root,"memory.high","4096");write(&root,"memory.current","512");
+        assert_eq!(cgroup_headroom(groups,&mounts),Some(3584));
+        write(&group,"memory.max","1000");write(&group,"memory.high","1100");write(&group,"memory.current","777");
