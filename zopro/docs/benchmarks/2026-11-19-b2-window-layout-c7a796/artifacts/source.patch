+pub(super) fn grouped_layout_growth(
+    n: usize, bits: usize, ranges: usize, signed: bool, transpose: bool,
+) -> Option<usize> {
+    let next = one::<G2Config>(n, bits, ranges, signed)?;
+    let before = raw::<G2Config>(n, false)?;
+    let extra_held = next.held.saturating_sub(before.held);
+    let extra_leaf = next.leaf.saturating_sub(before.leaf);
+    let matrix = if transpose {
+        vector::<i16>(mul(n, (Fr::MODULUS_BITS as usize + 1).div_ceil(bits))?, false)?
+    } else {
+        0
+    };
+    add(add(extra_held, mul(extra_leaf, rayon::current_num_threads())?)?, matrix)
 }
