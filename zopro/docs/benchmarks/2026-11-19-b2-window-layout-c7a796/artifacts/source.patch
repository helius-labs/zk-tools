+use super::*;
+use std::sync::OnceLock;
+
+#[derive(Clone, Copy)]
+struct Layout {
+    mode: u8,
+    bits: usize,
+    ranges: usize,
+}
+impl Layout {
+    fn configured() -> Option<Self> {
+        static VALUE: OnceLock<Option<Layout>> = OnceLock::new();
+        *VALUE.get_or_init(|| {
+            let env = std::env::var("ZOPRO_TRIAL_B2_WINDOWS").ok()?;
+            let (width, ranges) = env.get(1..)?.split_once('x')?;
+            let mode = *env.as_bytes().first()?;
+            let bits = width.parse().ok()?;
+            let ranges = ranges.parse().ok()?;
+            if !matches!(mode, b's' | b'u' | b't')
+                || !(10..=13).contains(&bits)
+                || !(1..=4).contains(&ranges)
+            {
+                return None;
+            }
+            Some(Self { mode, bits, ranges })
+        })
+    }
+}
+
+pub(super) fn grouped(bases: &[G2Affine], groups: &ScalarGroups) -> Option<G2Projective> {
+    if !(65_536..262_144).contains(&bases.len()) || !(1024..65536).contains(&groups.values.len()) {
+        return None;
+    }
+    let layout = Layout::configured()?;
+    let signed = layout.mode != b'u';
+    let bytes = super::super::workspace::grouped_layout_growth(
+        groups.values.len(),
+        layout.bits,
+        layout.ranges,
+        signed,
+        layout.mode == b't',
+    );
+    let reservation = crate::preparation::Reservation::analysis(bytes);
+    if std::env::var_os("ZOPRO_TRIAL_B2_WINDOWS_TRACE").is_some() {
+        eprintln!(
+            "GROUPED_B2_WINDOWS {} {}x{} {} {}",
+            bases.len(),
+            layout.bits,
+            layout.ranges,
+            layout.mode as char,
+            reservation.is_some(),
+        );
+    }
+    let _reservation = reservation?;
+    let points = crate::msm::group_affine(bases, &groups.order, &groups.starts, &groups.counts);
+    Some(match layout.mode {
+        b'u' => super::super::msm_unsigned_raw(&points, &groups.values, layout.bits, layout.ranges),
+        b's' => {
+            super::super::merge_split_width(&points, &groups.values, layout.ranges, layout.bits)
+        }
+        _ => digit_matrix(&points, &groups.values, layout),
+    })
+}
+
+fn digit_matrix(bases: &[G2Affine], scalars: &[[u64; 4]], layout: Layout) -> G2Projective {
+    let Layout { bits, ranges, .. } = layout;
+    let count = scalars.len();
+    let windows = (Fr::MODULUS_BITS as usize + 1).div_ceil(bits);
+    let mut digits = vec![0i16; windows * count];
+    digits
+        .par_chunks_exact_mut(count)
+        .enumerate()
+        .for_each(|(w, row)| {
+            for (out, scalar) in row.iter_mut().zip(scalars) {
+                *out = digit(scalar, w, bits);
+            }
+        });
+    let part = count.div_ceil(ranges);
+    let batch = batch_size(bits).max(32);
+    let sums: Vec<_> = digits
+        .par_chunks_exact(count)
+        .enumerate()
+        .map(|(w, row)| {
+            if let Some(top) =
+                super::super::top_window::<zopro_bn254::G2Config, true>(bases, scalars, w, bits)
+            {
+                return top;
+            }
+            let mut slots: Vec<_> = bases
+                .par_chunks(part)
+                .zip(row.par_chunks(part))
+                .map(|(p, d)| {
+                    affine_buckets(super::super::fill_window(p, d.iter().copied(), bits, batch))
+                })
+                .collect();
+            let mut buckets = slots.swap_remove(0);
+            for slot in slots {
+                merge_buckets(&mut buckets, &slot);
+            }
+            crate::msm::weighted_affine(&buckets)
+        })
+        .collect();
+    let mut sum = G2Projective::IDENTITY;
+    for point in sums.into_iter().rev() {
+        for _ in 0..bits {
+            sum = sum.double();
+        }
+        sum += point;
+    }
+    sum
+}
