+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn transposed_digits_match_original_windows() {
+        let n = 1237;
+        let mut scalar = Fr::from(9812736123u64);
+        let mut p = G2Projective::IDENTITY;
+        let mut pts = Vec::with_capacity(n);
+        let mut words = Vec::with_capacity(n);
+        let mut expected = Fr::ZERO;
+        for i in 0..n {
+            scalar = scalar.square() + Fr::from(i as u64);
+            let mut s = if i % 2 == 0 { scalar } else { -scalar };
+            p += G2Affine::GENERATOR;
+            let point = if i % 11 == 0 {
+                G2Affine::IDENTITY
+            } else if i % 3 == 0 {
+                -p.to_affine()
+            } else {
+                p.to_affine()
+            };
+            let weight = if i % 11 == 0 {
+                Fr::ZERO
+            } else if i % 3 == 0 {
+                -Fr::from((i + 1) as u64)
+            } else {
+                Fr::from((i + 1) as u64)
+            };
+            if i % 7 == 0 {
+                s = Fr::ZERO;
+            }
+            expected += weight * s;
+            pts.push(point);
+            words.push(s.to_canonical());
+        }
+        for workers in [1, 8] {
+            let pool = rayon::ThreadPoolBuilder::new()
+                .num_threads(workers)
+                .build()
+                .unwrap();
+            pool.install(|| {
+                for (bits, ranges) in [(10, 4), (11, 3), (12, 3), (13, 2)] {
+                    let result = digit_matrix(
+                        &pts,
+                        &words,
+                        Layout {
+                            mode: b't',
+                            bits,
+                            ranges,
+                        },
+                    );
+                    assert_eq!(
+                        result.to_affine(),
+                        (G2Affine::GENERATOR * expected).to_affine()
+                    );
+                }
+            });
+        }
+    }
+}
