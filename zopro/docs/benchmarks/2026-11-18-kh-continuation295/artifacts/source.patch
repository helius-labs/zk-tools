+// The output slots are disjoint, and a window moves to its successor without
+// copying its buckets. The parent scope waits for all successors.
+fn scoped_sums<C: CurveConfig<Base = Fq>>(
+    cover: &[Span], k: &[Affine<C>], sk: &[[u64; 4]],
+    h: &[Affine<C>], sh: &[[u64; 4]], split: bool,
+) -> Vec<Projective<C>> {
+    let mut sums = vec![Projective::<C>::IDENTITY; cover.len()];
+    rayon::scope(|scope| {
+        for (&span, output) in cover.iter().zip(&mut sums) {
+            scope.spawn(move |scope| {
+                let size = batch_size(span.width).max(32);
+                let mut state = Window::new(1usize << (span.width - 1), size);
+                feed(&mut state, k, sk, span, size);
+                if split {
+                    scope.spawn(move |scope| {
+                        feed(&mut state, h, sh, span, size);
+                        scope.spawn(move |_| {
+                            *output = crate::msm::weighted_affine(&state.finish());
+                        });
+                    });
+                } else {
+                    feed(&mut state, h, sh, span, size);
+                    *output = crate::msm::weighted_affine(&state.finish());
+                }
+            });
+        }
+    });
+    sums
+}
