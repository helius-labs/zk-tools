+fn split_stripes<'a, T>(stripes: &mut [&'a mut [T]; 32], mid: usize) -> [&'a mut [T]; 32] {
+    core::array::from_fn(|i| {
+        let stripe = core::mem::take(&mut stripes[i]);
+        let (left, right) = stripe.split_at_mut(mid.min(stripe.len()));
+        stripes[i] = right;
+        left
+    })
+}
+
+fn output_stripes(mut out: &mut [Fr], width: usize) -> [&mut [Fr]; 32] {
+    let stripes = core::array::from_fn(|_| {
+        let count = out.len().min(8 * width);
+        let (stripe, tail) = core::mem::take(&mut out).split_at_mut(count);
+        out = tail;
+        stripe
+    });
+    debug_assert!(out.is_empty());
+    stripes
+}
+
+fn input_range(
+    plan: &Plan,
+    b: &[Fr],
+    mut workspace: [&mut [MaybeUninit<PackedPair>]; 32],
+    start: usize,
+    width: usize,
+    tile: usize,
+) {
+    let count = workspace[0].len();
+    if count > tile {
+        let mid = count / 2;
+        let left = split_stripes(&mut workspace, mid);
+        rayon::join(
+            || input_range(plan, b, left, start, width, tile),
+            || input_range(plan, b, workspace, start + mid, width, tile),
+        );
+        return;
+    }
+    for column in 0..count {
+        let index = start + column;
+        let mut values = core::array::from_fn(|i| load(b, 8 * (i * width + index)));
+        column_butterflies::<false>(&mut values, &plan.inverse_roots, 0, index, width);
+        for (stripe, value) in workspace.iter_mut().zip(values) {
+            stripe[column].write(PackedPair::store(value));
+        }
+    }
+}
+
+fn inverse_input(plan: &Plan, b: &[Fr], schedule: Schedule) -> Vec<PackedPair> {
+    let count = plan.n / 8;
+    let width = count / 32;
+    let tile = schedule.tile(width, rayon::current_num_threads());
+    let mut workspace = Vec::with_capacity(count);
+    let mut stripes = workspace.spare_capacity_mut()[..count].chunks_exact_mut(width);
+    let stripes = core::array::from_fn(|_| stripes.next().unwrap());
+    input_range(plan, b, stripes, 0, width, tile);
+    // SAFETY: The joined disjoint tasks write each of the count slots.
+    unsafe { workspace.set_len(count) };
+    workspace
+}
+
+fn output_range(
+    plan: &Plan,
+    workspace: [&[PackedPair]; 32],
+    mut a: [&mut [Fr]; 32],
+    b: &[Fr],
+    start: usize,
+    width: usize,
+    tile: usize,
+) {
+    let count = workspace[0].len();
+    if count > tile {
+        let mid = count / 2;
+        let left_a = split_stripes(&mut a, 8 * mid);
+        let left_workspace = core::array::from_fn(|i| &workspace[i][..mid]);
+        let right_workspace = core::array::from_fn(|i| &workspace[i][mid..]);
+        rayon::join(
+            || output_range(plan, left_workspace, left_a, b, start, width, tile),
+            || output_range(plan, right_workspace, a, b, start + mid, width, tile),
+        );
+        return;
+    }
+    for column in 0..count {
+        let index = start + column;
+        let mut values = core::array::from_fn(|i| workspace[i][column].load());
+        column_butterflies::<true>(&mut values, &plan.roots, 0, index, width);
+        for (row, (value, stripe)) in values.into_iter().zip(&mut a).enumerate() {
+            let offset = 8 * column;
+            if offset >= stripe.len() {
+                continue;
+            }
+            let count = (stripe.len() - offset).min(8);
+            let out = &mut stripe[offset..offset + count];
+            let result = value
+                .mul(&load(b, 8 * (row * width + index)))
+                .add(&load(out, 0))
+                .get();
+            out.copy_from_slice(&result[..count]);
+        }
+    }
+}
+
+fn emit_result(plan: &Plan, workspace: &[PackedPair], a: &mut [Fr], b: &[Fr], schedule: Schedule) {
+    let width = workspace.len() / 32;
+    let mut stripes = workspace.chunks_exact(width);
+    let strips = core::array::from_fn(|_| stripes.next().unwrap());
+    let tile = schedule.tile(width, rayon::current_num_threads());
+    output_range(plan, strips, output_stripes(a, width), b, 0, width, tile);
+}
