+// Experimental offline construction for generated public test origins.
+use super::{point_fft, Queries};
+use crate::{fft, solver, Fr, G1Affine, G1Projective, Store};
+use rayon::prelude::*;
+use std::io::{BufReader, Read};
+use std::path::Path;
+
+pub(super) struct Origin {
+    left: Vec<Fr>,
+    right: Vec<Fr>,
+}
+
+impl Origin {
+    fn read(path: &Path, n: usize) -> Result<Self, String> {
+        let file = std::fs::File::open(path).map_err(|e| e.to_string())?;
+        let bytes = file.metadata().map_err(|e| e.to_string())?.len();
+        let mut reader = BufReader::new(file);
+        let mut header = [0; 8];
+        reader.read_exact(&mut header).map_err(|e| e.to_string())?;
+        let count = u64::from_le_bytes(header);
+        if count > n as u64 || bytes != count * 64 + 8 {
+            return Err("invalid public origin dimensions".into());
+        }
+        let mut read_field = || -> Result<Fr, String> {
+            let mut word = [0; 32];
+            reader.read_exact(&mut word).map_err(|e| e.to_string())?;
+            Fr::from_be_bytes(&word).ok_or_else(|| "invalid public origin scalar".into())
+        };
+        let mut left = Vec::with_capacity(count as usize);
+        let mut right = Vec::with_capacity(count as usize);
+        for _ in 0..count {
+            left.push(read_field()?);
+            right.push(read_field()?);
+        }
+        Ok(Self { left, right })
+    }
+
+    pub(super) fn product(&self, plan: &fft::Plan, mut a: Vec<Fr>, mut b: Vec<Fr>) -> Vec<Fr> {
+        assert_eq!(a.len().max(b.len()), self.left.len());
+        let sub = |values: &mut Vec<Fr>, offset: &[Fr]| {
+            values.resize(offset.len(), Fr::ZERO);
+            values.par_iter_mut().zip(offset).for_each(|(x, y)| *x -= *y);
+        };
+        rayon::join(|| sub(&mut a, &self.left), || sub(&mut b, &self.right));
+        plan.euler_product_values(a, b)
+    }
+}
+
+fn transform(points: &mut [G1Projective], roots: &[Fr]) {
+    let shift = usize::BITS - points.len().trailing_zeros();
+    for i in 0..points.len() {
+        let j = i.reverse_bits() >> shift;
+        if i < j { points.swap(i, j); }
+    }
+    point_fft(points, roots);
+}
+
+fn scaled(point: G1Affine, scalar: Fr) -> G1Projective {
+    if scalar == Fr::ZERO { G1Projective::IDENTITY }
+    else if scalar == Fr::ONE { point.to_projective() }
+    else if scalar == -Fr::ONE { -point.to_projective() }
+    else { point * scalar }
+}
+
+fn linear_points(plan: &fft::Plan, key: &[G1Affine], origin: &[Fr],
+                 forward: &[Fr], inverse: &[Fr]) -> Vec<G1Affine> {
+    let n = key.len();
+    let mut points: Vec<_> = key.par_iter().enumerate().map(|(i, &point)|
+        scaled(point, origin.get(i).copied().unwrap_or(Fr::ZERO))).collect();
+    // The transpose reverses the order of the two symmetric DFT matrices.
+    transform(&mut points, forward);
+    points.par_iter_mut().enumerate().for_each(|(i, p)| *p = *p * Fr::from(i as u64));
+    transform(&mut points, inverse);
+    let derivative = plan.euler_product_values(origin.to_vec(), vec![Fr::ONE; n]);
+    points.par_iter_mut().zip(key).zip(derivative).for_each(|((p, &base), value)|
+        *p += scaled(base, value));
+    G1Projective::batch_to_affine(&points)
+}
+
+impl Queries {
+    pub(crate) fn fold_origin(&mut self, fft: &fft::Plan, solver: &solver::Plan,
+                              path: &Path) -> Result<(),String> {
+        let started = std::time::Instant::now();
+        let n = self.product.len();
+        let origin = Origin::read(path, n)?;
+        let (forward, inverse, _, _) = fft.tables().ok_or("missing domain tables")?;
+        let mut adjustment = vec![G1Projective::IDENTITY; solver.value_count()];
+        for (side, offset) in [(0, &origin.right), (1, &origin.left)] {
+            let rows = linear_points(fft, &self.product, offset, &forward, &inverse);
+            solver.for_each_side(side, |row, wire, coeff| adjustment[wire] += scaled(rows[row], coeff));
+        }
+        let constant = fft.euler_product_values(origin.left.clone(), origin.right.clone());
+        adjustment[0] -= crate::msm_g1(&self.product[..constant.len()], &constant);
+        if self.product_scale != Fr::ONE {
+            adjustment.par_iter_mut().for_each(|p| *p = *p * self.product_scale);
+        }
+        let folded = self.folded.as_mut().ok_or("missing folded key")?;
+        let nw = solver.basis_wires();
+        let np = solver.n_public;
+        let added: Vec<_> = (nw..adjustment.len())
+            .filter(|&i| !adjustment[i].is_identity() && folded.slots.binary_search(&i).is_err())
+            .collect();
+        let mut slots = folded.slots.clone();
+        slots.extend_from_slice(&added);
+        slots.sort_unstable();
+        let public: Vec<_> = (0..np).map(|i| adjustment[i] + folded.public[i]).collect();
+        let private: Vec<_> = (np..nw).chain(slots.iter().copied()).map(|i| {
+            if i < nw { adjustment[i] + folded.private[i-np] }
+            else if let Ok(pos) = folded.slots.binary_search(&i) { adjustment[i] + folded.private[nw-np+pos] }
+            else { adjustment[i] }
+        }).collect();
+        folded.public = Store::Owned(G1Projective::batch_to_affine(&public));
+        folded.private = Store::Owned(G1Projective::batch_to_affine(&private));
+        folded.slots = slots;
+        folded.windows.clear();
+        folded.public_window = None;
+        folded.reservation = None;
+        folded.prepare_public_window();
+        self.origin = Some(origin);
+        eprintln!("ORIGIN_KEY {} {} {} {}", n, added.len(), folded.private.len(), started.elapsed().as_millis());
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn transpose_gives_the_native_euler_pairing_with_padded_rows() {
+        for n in [8, 16, 32] {
+            for root_power in [1, 3] {
+                let root = Fr::root_of_unity(n).unwrap().pow(&[root_power]);
+                let coset = Fr::from(5u64);
+                let mut fft = fft::Plan::new(n, root, coset, fft::denominator(n, coset).unwrap());
+                fft.prepare_euler_basis();
+                let (fw, inv, _, _) = fft.tables().unwrap();
+                let points: Vec<_> = (0..n).map(|i|
+                    (G1Affine::GENERATOR * Fr::from((7*i + 1) as u64)).to_affine()).collect();
+                for len in [n - 3, n] {
+                    let origin: Vec<_> = (0..len).map(|i| Fr::from((i*i+9) as u64)).collect();
+                    let a: Vec<_> = (0..len).map(|i| Fr::from((3*i*i*i+2) as u64)).collect();
+                    let rows = linear_points(&fft, &points, &origin, &fw, &inv);
+                    let f = fft.euler_product_values(a.clone(), origin);
+                    assert_eq!(crate::msm_g1(&rows[..len], &a).to_affine(),
+                               crate::msm_g1(&points[..len], &f).to_affine());
+                }
+            }
+        }
+    }
+}
