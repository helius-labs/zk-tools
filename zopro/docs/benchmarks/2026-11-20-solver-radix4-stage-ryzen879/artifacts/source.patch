+#[inline(always)]
+fn radix4<const FORWARD: bool>(lanes: &mut [Pair], roots: &Twiddles, width: usize, col: usize) {
+    let r0 = broadcast(&roots.layers[0][col]);
+    let r1 = broadcast(&roots.layers[0][width + col]);
+    let r2 = broadcast(&roots.layers[1][col]);
+    let [a,b,c,d] = *<&[Pair; 4]>::try_from(&*lanes).unwrap();
+    if FORWARD {
+        let b = b.mul(&r2);
+        let d = d.mul(&r2);
+        let (lo0,lo1) = (a.add(&b), a.sub(&b));
+        let (hi0,hi1) = (c.add(&d).mul(&r0), c.sub(&d).mul(&r1));
+        lanes.copy_from_slice(&[lo0.add(&hi0),lo1.add(&hi1),lo0.sub(&hi0),lo1.sub(&hi1)]);
+    } else {
+        let (lo0,lo1) = (a.add(&c), b.add(&d));
+        let (hi0,hi1) = (a.sub(&c).mul(&r0), b.sub(&d).mul(&r1));
+        lanes.copy_from_slice(&[lo0.add(&lo1),lo0.sub(&lo1).mul(&r2),hi0.add(&hi1),hi0.sub(&hi1).mul(&r2)]);
+    }
+}
