+pub(crate) struct Radix4Writer<'a> {
+    data: *mut core::mem::MaybeUninit<PackedPair>,
+    width: usize,
+    _borrow: core::marker::PhantomData<&'a mut [core::mem::MaybeUninit<PackedPair>]>,
+}
+
+// Shared access exposes no safe reads or writes. write_band requires disjoint output
+// tiles, completed input rows, and a join before the buffers can be used elsewhere.
+unsafe impl Sync for Radix4Writer<'_> {}
+unsafe impl Send for Radix4Writer<'_> {}
+
+impl Radix4Writer<'_> {
+    /// # Safety
+    /// Tiles are unique and belong to this writer. All real rows they read have
+    /// finished writing in a joined solver band and will never be written again.
+    pub(crate) unsafe fn write_band(
+        &self, plan: &Plan, a: *const Fr, b: *const Fr, rows: usize, tiles: &[usize],
+    ) {
+        let write = |tile| {
+            for col in (tile * RADIX4_TILE)..((tile + 1) * RADIX4_TILE) {
+                let mut column: [Pair; 4] = core::array::from_fn(|stripe| {
+                    let first = 4 * (stripe * self.width + col);
+                    let values = core::array::from_fn(|lane| {
+                        let row = first + lane % 4;
+                        if row >= rows {
+                            return Fr::ZERO;
+                        }
+                        let input = if lane < 4 { a } else { b };
+                        unsafe { *input.add(row) }
+                    });
+                    Pair::new(&values)
+                });
+                radix4::<false>(&mut column, &plan.inverse_roots, self.width, col);
+                for (stripe, value) in column.into_iter().enumerate() {
+                    unsafe {
+                        self.data.add(stripe * self.width + col)
+                            .write(core::mem::MaybeUninit::new(PackedPair::store(value)));
+                    }
+                }
+            }
+        };
+        for &tile in tiles {
+            write(tile);
+        }
+    }
+}
