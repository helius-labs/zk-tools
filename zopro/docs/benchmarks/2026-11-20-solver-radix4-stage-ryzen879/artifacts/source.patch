+pub(crate) struct EulerPrefix {
+    data: Vec<PackedPair>,
+    _reservation: crate::preparation::Reservation,
+}
+
+impl EulerPrefix {
+    pub(crate) fn new(plan: &Plan) -> Option<Self> {
+        let n = plan.n;
+        if plan.released || plan.twisted.is_some() || plan.roots.single.is_some()
+            || !(8192..=1 << 17).contains(&n) {
+            return None;
+        }
+        let count = n / 4;
+        let bytes = count.checked_mul(core::mem::size_of::<PackedPair>())?;
+        let expansion = count.checked_mul(core::mem::size_of::<Pair>())?;
+        let reservation = crate::preparation::Reservation::analysis(
+            Some(bytes.checked_add(expansion)?.checked_add(64 << 10)?),
+        )?;
+        let mut data = Vec::new();
+        data.try_reserve_exact(count).ok()?;
+        Some(Self { data, _reservation: reservation })
+    }
+
+    pub(crate) fn writer(&mut self, plan: &Plan) -> Radix4Writer<'_> {
+        let width = plan.n / 16;
+        let data = &mut self.data.spare_capacity_mut()[..4 * width];
+        Radix4Writer { data: data.as_mut_ptr(), width, _borrow: core::marker::PhantomData }
+    }
+
+    /// # Safety
+    /// All tiles were initialized exactly once, and their workers have joined.
+    pub(crate) unsafe fn end_input(&mut self, plan: &Plan) {
+        unsafe { self.data.set_len(plan.n / 4) };
+    }
+
+    pub(crate) fn finish(mut self, plan: &Plan, mut a: Vec<Fr>, b: Vec<Fr>) -> Vec<Fr> {
+        a.resize(a.len().max(b.len()), Fr::ZERO);
+        let width = self.data.len() / 4;
+        assert_eq!(4 * width, plan.n / 4);
+        self.data.par_chunks_exact_mut(width).enumerate().for_each(|(stripe, values)| {
+            transform(plan, values, 2, stripe * width);
+        });
+        emit_prepared::<4>(plan, &mut a, &b, &self.data);
+        a
+    }
+}
