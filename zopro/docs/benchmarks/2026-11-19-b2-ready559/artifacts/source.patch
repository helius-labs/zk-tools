+
+#[cfg(not(target_arch = "wasm32"))]
+struct B2ReadyProbe {
+    start: Option<std::time::Instant>,
+    ticks: [std::sync::atomic::AtomicU64; 10],
+    direct: bool,
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+impl B2ReadyProbe {
+    fn new() -> Self {
+        static OPTIONS: std::sync::OnceLock<(bool, bool)> = std::sync::OnceLock::new();
+        let &(timed, direct) = OPTIONS.get_or_init(|| (
+            std::env::var("ZOPRO_TRIAL_B2_TIMES").as_deref() == Ok("1"),
+            std::env::var("ZOPRO_TRIAL_B2_DIRECT").as_deref() == Ok("1"),
+        ));
+        Self { start: timed.then(std::time::Instant::now), ticks: Default::default(), direct }
+    }
+
+    fn stamp(&self, slot: usize) {
+        if let Some(start) = self.start {
+            self.ticks[slot].store(start.elapsed().as_nanos() as u64, std::sync::atomic::Ordering::Relaxed);
+        }
+    }
+
+    fn span<T>(&self, begin: usize, end: usize, f: impl FnOnce() -> T) -> T {
+        self.stamp(begin);
+        let result = f();
+        self.stamp(end);
+        result
+    }
+
+    fn report(&self) {
+        if let Some(start) = self.start {
+            let joined = start.elapsed().as_nanos();
+            let ticks = self.ticks.each_ref().map(|tick| tick.load(std::sync::atomic::Ordering::Relaxed));
+            eprintln!("B2_READY {:?} {}", ticks, joined);
+        }
+    }
+}
