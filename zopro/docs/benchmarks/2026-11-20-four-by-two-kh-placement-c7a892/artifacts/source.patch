+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(crate) enum HPlacement {
+    Main,
+    Independent,
+    Joined,
+}
+
+pub(crate) fn h_placement() -> HPlacement {
+    static PLACEMENT: OnceLock<HPlacement> = OnceLock::new();
+    *PLACEMENT.get_or_init(|| match std::env::var("ZOPRO_892_H_POOL").as_deref() {
+        Ok("front") => HPlacement::Independent,
+        Ok("joined") => HPlacement::Joined,
+        _ => HPlacement::Main,
+    })
+}
+
+pub(crate) fn placement(query: &str) {
+    static TRACE: OnceLock<bool> = OnceLock::new();
+    if *TRACE.get_or_init(|| std::env::var_os("ZOPRO_892_TRACE").is_some()) {
+        eprintln!("ZP892_PLACEMENT {query} {}", rayon::current_num_threads());
     }
 }
 
