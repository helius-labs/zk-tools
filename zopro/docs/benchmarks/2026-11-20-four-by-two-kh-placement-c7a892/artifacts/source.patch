+pub(super) struct PoolCpu {
+    tasks: [Vec<std::fs::File>; 2],
+}
+
+impl PoolCpu {
+    pub(super) fn new(frontend: Option<&rayon::ThreadPool>) -> io::Result<Self> {
+        let ids = |_: rayon::BroadcastContext<'_>| {
+            // SAFETY: gettid takes no arguments and returns the calling thread.
+            unsafe { libc::syscall(libc::SYS_gettid) }
+        };
+        let main = rayon::broadcast(ids);
+        let front = frontend.map_or_else(Vec::new, |pool| pool.broadcast(ids));
+        let open = |tids: Vec<_>| tids.into_iter()
+            .map(|tid| std::fs::File::open(format!("/proc/self/task/{tid}/schedstat")))
+            .collect::<io::Result<Vec<_>>>();
+        Ok(Self { tasks: [open(main)?, open(front)?] })
+    }
+
+    pub(super) fn snapshot(&self) -> io::Result<[u64; 2]> {
+        use std::os::unix::fs::FileExt;
+        let mut result = [0; 2];
+        let mut bytes = [0; 128];
+        for (pool, tasks) in result.iter_mut().zip(&self.tasks) {
+            for task in tasks {
+                let size = task.read_at(&mut bytes, 0)?;
+                let text = std::str::from_utf8(&bytes[..size]).map_err(io::Error::other)?;
+                let elapsed = text.split_whitespace().next()
+                    .and_then(|t| t.parse::<u64>().ok())
+                    .ok_or_else(|| io::Error::other("missing schedstat execution time"))?;
+                *pool += elapsed;
+            }
+        }
+        Ok(result)
+    }
+}
