+//! Compact parallel fingerprint ordering, followed by exact equality checks.
+use rayon::prelude::*;
+
+type Words = [u64; 4];
+const MAX_DISTINCT_PER_FINGERPRINT: usize = 8;
+const MISSING: u32 = u32::MAX;
+
+fn fingerprint([a, b, c, d]: Words) -> u32 {
+    let x = a ^ b.rotate_left(11) ^ c.rotate_left(23) ^ d.rotate_left(37);
+    (x ^ (x >> 32)) as u32
+}
+
+pub(super) fn classify(scalars: &[Words], classes: &mut [u32]) -> Option<(Vec<Words>, Vec<usize>)> {
+    classify_with(scalars, classes, fingerprint)
+}
+
+fn classify_with(
+    scalars: &[Words],
+    classes: &mut [u32],
+    fingerprint: impl Fn(Words) -> u32,
+) -> Option<(Vec<Words>, Vec<usize>)> {
+    assert_eq!(scalars.len(), classes.len());
+    assert!(scalars.len() < MISSING as usize);
+    let mut keys = Vec::with_capacity(scalars.len());
+    for (i, &value) in scalars.iter().enumerate() {
+        if value != [0; 4] {
+            keys.push(((fingerprint(value) as u64) << 32) | i as u64);
+        }
+    }
+    keys.par_sort_unstable();
+
+    // The tie-breaker is the original position. Every representative is
+    // the first occurrence, even if multiple values share a fingerprint.
+    let mut previous = None;
+    let mut representatives = [0u32; MAX_DISTINCT_PER_FINGERPRINT];
+    let mut count = 0;
+    for &key in &keys {
+        let hash = (key >> 32) as u32;
+        if previous != Some(hash) {
+            previous = Some(hash);
+            count = 0;
+        }
+        let index = key as u32;
+        let value = &scalars[index as usize];
+        let representative = representatives[..count]
+            .iter()
+            .copied()
+            .find(|&i| scalars[i as usize] == *value);
+        classes[index as usize] = match representative {
+            Some(i) => i,
+            None => {
+                *representatives.get_mut(count)? = index;
+                count += 1;
+                index
+            }
+        };
+    }
+
+    keys.clear();
+    keys.resize(scalars.len(), u64::MAX);
+    let mut values = Vec::new();
+    let mut counts = Vec::new();
+    for (i, label) in classes.iter_mut().enumerate() {
+        if *label == MISSING {
+            continue;
+        }
+        let assigned = &mut keys[*label as usize];
+        if *assigned == u64::MAX {
+            *assigned = values.len() as u64;
+            values.push(scalars[i]);
+            counts.push(0);
+        }
+        *label = *assigned as u32;
+        counts[*assigned as usize] += 1;
+    }
+    Some((values, counts))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::testing::Seeded;
+
+    #[test]
+    fn fingerprint_order_preserves_exact_class_order() {
+        let mut rng = Seeded::new(0x2ab3_4c92);
+        let distinct: Vec<_> = (0..13_017).map(|_| rng.fr().to_canonical()).collect();
+        for n in [0, 11, 1025, 52_274] {
+            let scalars: Vec<_> = (0..n)
+                .map(|i| {
+                    if i % 19 == 0 {
+                        [0; 4]
+                    } else {
+                        distinct[i * 179 % distinct.len()]
+                    }
+                })
+                .collect();
+            let mut expected = vec![MISSING; n];
+            let ordinary = super::super::classify_nonzero(
+                &scalars,
+                &mut expected,
+                0,
+                ahash::RandomState::new(),
+            );
+            let mut labels = vec![MISSING; n];
+            assert_eq!(classify(&scalars, &mut labels).unwrap(), ordinary);
+            assert_eq!(labels, expected);
+        }
+        let collision = [[1, 0, 0, 0], [1, 3, 0, 0], [1, 0, 0, 0], [0; 4]];
+        let mut labels = [MISSING; 4];
+        assert_eq!(
+            classify_with(&collision, &mut labels, |_| 7).unwrap().1,
+            vec![2, 1]
+        );
+        assert_eq!(labels, [0, 1, 0, MISSING]);
+        let many: Vec<_> = (1..=10).map(|i| [i, 0, 0, 0]).collect();
+        assert!(classify_with(&many, &mut [MISSING; 10], |_| 12).is_none());
+    }
+}
