+//! Compare all five native arbitrary-parts outputs on one immutable image.
+use std::{fs::File, path::Path, sync::Arc};
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let args: Vec<_> = std::env::args_os().collect();
+    assert_eq!(args.len(), 3);
+    let file = File::open(&args[1])?;
+    // The experimental harness owns the unchanged, hash-pinned image.
+    let bytes = unsafe { memmap2::Mmap::map(&file)? };
+    let prover = zopro_prover::Prover::load_image(Arc::new(bytes))?;
+    for seed in 0..4 {
+        let result = prover.origin_independent_parts_probe(seed)?;
+        assert_eq!(result.len(), 384);
+        std::fs::write(Path::new(&args[2]).join(format!("{seed}.parts")), result)?;
+    }
+    Ok(())
+}
