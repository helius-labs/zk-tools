 impl Queries {
+    pub(crate) fn restore_independent_k(&self, fft: &fft::Plan, plan: &solver::Plan,
+                                         private: &[Fr], retained: &[usize], correction: &mut [Fr]) {
+        let Some(origin) = self.origin.as_ref() else { return };
+        let slots = plan.origin_private_slots(private, retained);
+        // Undo the two cross terms added to the private key. The constant
+        // origin product belonged to public wire zero and has no private term.
+        for side in [0, 1] {
+            let rows = plan.origin_private_rows(side, private, &slots);
+            let fixed = (0..origin.count).map(|i| {
+                let (a,b) = origin.pair(i);
+                if side == 0 { b } else { a }
+            }).collect();
+            let delta = fft.euler_product_values(rows, fixed);
+            assert!(delta.len() <= correction.len());
+            for (value, delta) in correction.iter_mut().zip(delta) { *value -= delta; }
+        }
+    }
