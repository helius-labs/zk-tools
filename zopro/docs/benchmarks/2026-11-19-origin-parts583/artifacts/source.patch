+//! Project an independent private K query through the two Euler row forms.
+use super::{Fr, Op, Plan, Previous};
+
+impl Plan {
+    fn projected_value(&self, wire: usize, private: &[Fr], slots: &[Fr]) -> Fr {
+        if wire < self.n_public {
+            Fr::ZERO
+        } else if wire < self.n_wires {
+            private[wire - self.n_public]
+        } else {
+            slots[wire - self.n_wires]
+        }
+    }
+
+    pub(crate) fn origin_private_slots(&self, private: &[Fr], retained: &[usize]) -> Vec<Fr> {
+        assert_eq!(private.len(), self.n_wires - self.n_public);
+        let mut slots = vec![Fr::ZERO; self.n_slots];
+        // Retained K slots have independent coefficients. The parts API only
+        // supplies original private wires, so their scalar is zero. Other slots
+        // must propagate their defining expression, as in the offline transpose.
+        for op in &self.ops {
+            let Op::Constraint(step) = op else { continue };
+            let mut next = step.first_slot();
+            let mut chain = Fr::ZERO;
+            for sum in &self.sums[step.sums()] {
+                let prefix = match sum.previous() {
+                    Previous::None => Fr::ZERO,
+                    Previous::Chain => chain,
+                    Previous::Slot(wire) => slots[wire - self.n_wires],
+                };
+                let x = self.projected_value(sum.term.wire(), private, &slots);
+                chain = prefix + self.coefficients[sum.term.coefficient()] * x;
+                if sum.stored() {
+                    if retained.binary_search(&(self.n_wires + next)).is_err() {
+                        slots[next] = chain;
+                    }
+                    next += 1;
+                }
+            }
+        }
+        slots
+    }
+
+    pub(crate) fn origin_private_rows(&self, side: usize, private: &[Fr], slots: &[Fr]) -> Vec<Fr> {
+        let mut rows = vec![Fr::ZERO; self.n_constraints];
+        self.for_each_side(side, |row, wire, coefficient| {
+            rows[row] += coefficient * self.projected_value(wire, private, slots);
+        });
+        rows
+    }
+
+    pub(crate) fn origin_solver_digest(&self) -> [u8; 32] {
+        use sha2::{Digest, Sha256};
+        let mut digest = Sha256::new();
+        self.write_image(&mut digest).expect("a parsed plan has a canonical solver image");
+        digest.finalize().into()
+    }
+}
