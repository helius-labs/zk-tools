+// Local experiment-only caller of the public arbitrary-parts API.
+impl Key {
+    pub fn origin_independent_parts_probe(&self, seed: usize) -> Result<Vec<u8>,String> {
+        let values = |length:usize, channel:usize| -> Vec<u8> {
+            let mut state=0x29ce_68d7_734b_e829u64 ^ ((channel as u64+1)<<32) ^ (seed as u64);
+            let mut buf=Vec::with_capacity(length*32);
+            for i in 0..length {
+                let mut canonical=[0;32];
+                for bytes in canonical.chunks_exact_mut(8) {
+                    state^=state<<13; state^=state>>7; state^=state<<17;
+                    bytes.copy_from_slice(&state.to_le_bytes());
+                }
+                let scalar=if seed==0 || (seed==1 && i%67!=0) {Fr::ZERO}
+                    else {Fr::from_be_bytes_mod_order(&canonical)};
+                for word in scalar.0 {buf.extend_from_slice(&word.to_le_bytes());}
+            }
+            buf
+        };
+        let n=[0,1,self.domain/2+3,self.domain][seed];
+        let (sa,sb,sk)=(values(self.lengths[0],0),values(self.lengths[1],1),values(self.lengths[2],2));
+        self.parts(&sa,&sb,&sk,&values(n,3),&values(n,4),&values(n,5))
+            .map_err(|_|"arbitrary parts returned an error".to_owned())
+    }
+}
