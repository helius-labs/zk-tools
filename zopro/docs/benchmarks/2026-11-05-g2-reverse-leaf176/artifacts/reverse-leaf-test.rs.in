
#[cfg(test)]
mod reverse_leaf_tests {
    use super::*;
    use zopro_bn254::{Fr,G2Config};
    #[cfg(zopro_g2_reverse_leaf)]
    pub(super) static GROUPS:std::sync::atomic::AtomicUsize=std::sync::atomic::AtomicUsize::new(0);
    #[test]
    fn reverse_leaf_independent_sums_modes_tails_and_reuse() {
        let g=Projective::<G2Config>::generator();
        for n in [0usize,7,8,9,63,64,65,200,352,511] {
            let size=n.max(1).next_power_of_two();
            let coefficients=(0..size).map(|i|Fr::from(70001+i as u64)).collect::<Vec<_>>();
            let input=Projective::<G2Config>::batch_to_affine(&coefficients.iter().map(|s|g**s).collect::<Vec<_>>());
            let steps=(0..n).map(|i|Fr::from(900001+i as u64)).collect::<Vec<_>>();
            let incoming=Projective::<G2Config>::batch_to_affine(&steps.iter().map(|s|g**s).collect::<Vec<_>>());
            let original=incoming.clone();
            let batch=incoming.iter().enumerate().map(|(i,p)|((i*37%size)as u32|if i%3!=1{1<<31}else{0},p)).collect::<Vec<_>>();
            for fast in [false,true] { for vi in [false,true] {
                let mut actual=input.clone();let mut expected=coefficients.clone();
                let mut scratch=Fq2AddScratch{canonical:fast,vector_inverse:vi,..Default::default()};
                let mut capacity=None;
                for pass in 0..3 {
                    for (i,(id,_)) in batch.iter().enumerate(){let b=(id&0x7fffffff)as usize;expected[b]+=if id>>31!=0{-steps[i]}else{steps[i]};}
                    if fast{apply::<G2Config,true>(&mut actual,&batch,&mut scratch)}else{apply::<G2Config,false>(&mut actual,&batch,&mut scratch)}
                    assert_eq!(actual,Projective::<G2Config>::batch_to_affine(&expected.iter().map(|s|g**s).collect::<Vec<_>>()));
                    let cap=(scratch.prefix_records.capacity(),scratch.tail.capacity());
                    if let Some(previous)=capacity{assert_eq!(cap,previous);}capacity=Some(cap);
                    assert_eq!(incoming,original,"immutable input pass{pass}");
                }
            }}
        }
        #[cfg(zopro_g2_reverse_leaf)]
        assert!(GROUPS.load(std::sync::atomic::Ordering::Relaxed)>0);
    }
}

#[cfg(zopro_g2_reverse_leaf)]
#[path="g2_borrowed/reverse_leaf.rs"]
mod reverse_leaf;
