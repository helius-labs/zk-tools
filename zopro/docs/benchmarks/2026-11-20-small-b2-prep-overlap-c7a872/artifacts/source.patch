+//! Optional proof-local preparation for small exclusive B2 queries.
+use super::{g2_phi, grouping, ScalarGroups};
+use crate::preparation::Reservation;
+use zopro_bn254::{Fr, G2Affine, G2Projective};
+
+const SMALL_QUERY: core::ops::Range<usize> = 1024..65_536;
+type Words = [u64; 4];
+
+#[derive(Clone, Copy)]
+pub(crate) enum Schedule {
+    Wait,
+    Early,
+    EarlySerial,
+}
+
+impl Schedule {
+    pub(crate) fn select(
+        eligible: bool,
+        terms: usize,
+        domain: usize,
+    ) -> Option<(Self, Reservation)> {
+        if !eligible
+            || !SMALL_QUERY.contains(&terms)
+            || std::env::var("ZOPRO_CPU_G2_RANGES").as_deref() == Ok("4")
+        {
+            return None;
+        }
+        let mode = match std::env::var("ZOPRO_TRIAL_STAGE_SMALL_B2").as_deref() {
+            Ok("wait") => Self::Wait,
+            Ok("early") => Self::Early,
+            Ok("early-serial") => Self::EarlySerial,
+            _ => return None,
+        };
+        // The grouping token separately accounts for the complete point and
+        // class lifetimes. Reserve the potentially concurrent FFT buffers.
+        let fft_buffers = super::workspace::vector::<Fr>(domain.checked_mul(6)?, false)?;
+        Some((mode, Reservation::analysis(Some(fft_buffers))?))
+    }
+
+    pub(crate) fn serial(self) -> bool {
+        matches!(self, Self::EarlySerial)
+    }
+
+    pub(crate) fn run<T: Send, U: Send>(
+        self,
+        quotient: impl FnOnce() -> T + Send,
+        prepare_b2: impl FnOnce() -> U + Send,
+    ) -> (T, U) {
+        let origin = std::env::var_os("ZOPRO_TRIAL_STAGE_SMALL_B2_TRACE")
+            .is_some()
+            .then(crate::time::Instant::now);
+        if origin.is_some() {
+            let name = match self {
+                Self::Wait => "wait",
+                Self::Early => "early",
+                Self::EarlySerial => "early-serial",
+            };
+            eprintln!("STAGED_SMALL_B2 {name}");
+        }
+        let quotient = || phase(origin, "fft", quotient);
+        let prepare_b2 = || phase(origin, "prepare", prepare_b2);
+        match self {
+            Self::Wait => (quotient(), prepare_b2()),
+            Self::Early | Self::EarlySerial => rayon::join(quotient, prepare_b2),
+        }
+    }
+}
+
+fn phase<T>(origin: Option<crate::time::Instant>, name: &str, work: impl FnOnce() -> T) -> T {
+    let Some(origin) = origin else { return work() };
+    let start = origin.elapsed().as_nanos();
+    let result = work();
+    eprintln!(
+        "SMALL_B2_PHASE {name} {start} {}",
+        origin.elapsed().as_nanos()
+    );
+    result
+}
+
+pub(crate) enum Prepared {
+    SplitRaw,
+    GroupTooSmall(ScalarGroups),
+    SplitGroups {
+        bases: Vec<G2Affine>,
+        scalars: Vec<Words>,
+        _reservation: Reservation,
+    },
+}
+
+impl Prepared {
+    pub(crate) fn new(bases: &[G2Affine], words: &mut [Words], group: bool, serial: bool) -> Self {
+        let groups = (group && crate::simd::cpu_option("ZOPRO_CPU_DEDUP"))
+            .then(|| grouping::groups_with_diversity_check(words))
+            .flatten();
+        let Some(groups) = groups else {
+            g2_phi::decompose(words, serial);
+            return Self::SplitRaw;
+        };
+        if !SMALL_QUERY.contains(&groups.values.len()) {
+            return Self::GroupTooSmall(groups);
+        }
+        let ScalarGroups {
+            len,
+            mut values,
+            starts,
+            order,
+            counts,
+            _reservation,
+        } = groups;
+        assert_eq!(len, bases.len());
+        let (bases, ()) = rayon::join(
+            || crate::msm::group_affine(bases, &order, &starts, &counts),
+            || g2_phi::decompose(&mut values, serial),
+        );
+        Self::SplitGroups {
+            bases,
+            scalars: values,
+            _reservation,
+        }
+    }
+
+    pub(crate) fn finish(self, bases: &[G2Affine], words: &[Words]) -> G2Projective {
+        match self {
+            Self::SplitRaw => g2_phi::from_split(bases, words, 12, 2),
+            Self::GroupTooSmall(groups) => crate::msm_grouped_b2(bases, &groups),
+            Self::SplitGroups {
+                bases,
+                scalars,
+                _reservation,
+            } => g2_phi::from_split(&bases, &scalars, 12, 2),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::testing::Seeded;
+
+    #[test]
+    fn staged_exclusive_b2_preserves_generator_sums() {
+        let mut rng = Seeded::new(0xe3a3_5125);
+        let weights: Vec<_> = (0..8195)
+            .map(|i| match i % 7 {
+                0 => Fr::ZERO,
+                1 => -Fr::from((i % 31) as u64),
+                _ => Fr::from((i % 31) as u64),
+            })
+            .collect();
+        let points: Vec<_> = weights.iter().map(|&w| G2Affine::GENERATOR * w).collect();
+        let bases = G2Projective::batch_to_affine(&points);
+        let random: Vec<_> = (0..2048).map(|_| rng.fr()).collect();
+        for domains in [13, 2048] {
+            let values: Vec<_> = (0..weights.len()).map(|i| random[i % domains]).collect();
+            let wanted = weights
+                .iter()
+                .zip(&values)
+                .fold(Fr::ZERO, |s, (a, b)| s + *a * *b);
+            let wanted = (G2Affine::GENERATOR * wanted).to_affine();
+            for (group, serial) in [(false, false), (true, false), (true, true)] {
+                let mut words: Vec<_> = values.iter().map(Fr::to_canonical).collect();
+                let prepared = Prepared::new(&bases, &mut words, group, serial);
+                assert_eq!(prepared.finish(&bases, &words).to_affine(), wanted);
+            }
+        }
+    }
+}
