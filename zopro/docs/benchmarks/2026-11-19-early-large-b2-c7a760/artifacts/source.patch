+pub(crate) fn fft_overlap_bytes(domain: usize) -> Option<usize> {
+    let extra = add(mul(domain, core::mem::size_of::<Fr>())?, 256 * core::mem::size_of::<crate::fft::Quad>())?;
+    add(fft_transient(domain, true)?, add(extra, 4096)?)
+}
+
+fn fft_transient(domain: usize, correction: bool) -> Option<usize> {
+    let scalar = vector::<Fr>(domain, false)?;
+    let expanded = vector::<Ifma8<FrConfig>>(domain / 4, false)?;
+    let compact = vector::<PackedIfma8<FrConfig>>(domain / 4, false)?;
+    let packing = add(mul(scalar, 3)?, expanded)?;
+    let leaves = add(
+        add(mul(scalar, 1 + usize::from(correction))?, compact)?,
+        add(expanded, mul(domain.div_ceil(128), 64)?)?,
+    )?;
+    Some(packing.max(leaves))
+}
