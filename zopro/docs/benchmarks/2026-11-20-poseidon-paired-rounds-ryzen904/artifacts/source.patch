+    #[test]
+    fn paired_feedback_matches_public_matrix_products() {
+        let (partial, a) = parameters(3);
+        assert_eq!(partial, PARTIAL);
+        assert_eq!(a.len(), SPARSE + 5 * partial);
+        for (i, &value) in FEEDBACK.iter().enumerate() {
+            let r = SPARSE + 10 * i;
+            assert_eq!(value, a[r + 6] * a[r + 3] + a[r + 7] * a[r + 4]);
+        }
+    }
