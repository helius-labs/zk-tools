+impl Plan {
+    /// The parent has recognized all coefficients in both rounds, verified the
+    /// original address list, and executed the earlier rows.
+    #[inline(never)]
+    pub(super) unsafe fn poseidon_round_pairs<const FUSED: bool>(
+        &self,
+        task: &[u32],
+        state: &mut [Fr; 13],
+        mut head: Fr,
+        a: &[Fr],
+        v: View,
+    ) -> Fr {
+        let [mut left, mut right] = [state[1], state[2]];
+        for (i, feedback) in FEEDBACK.iter().enumerate() {
+            let r = 2 * i;
+            let first = SPARSE + r * 5;
+            let second = first + 5;
+            let a0 = &a[first..first + 5];
+            let a1 = &a[second..second + 5];
+            // Projection into both head coordinates uses the same old tail.
+            let rest0 = Fr::sum_of_products(&a0[1], &left, &a0[2], &right) + a[13 + r];
+            let rest1 = Fr::sum_of_products(&a1[1], &left, &a1[2], &right) + a[14 + r];
+            // SAFETY: see the caller's checked task and the two original indices.
+            let h0 = unsafe { self.emit_poseidon(task, 3, PARTIAL, 9 + r, head, v) };
+            let x1 = a0[0] * h0 + rest0;
+            let projected = if FUSED { rest1 } else { rest1 + *feedback * h0 };
+            let h1 = unsafe { self.emit_poseidon(task, 3, PARTIAL, 10 + r, x1, v) };
+            head = if FUSED {
+                Fr::sum_of_products(&a1[0], &h1, feedback, &h0) + projected
+            } else {
+                a1[0] * h1 + projected
+            };
+            left += Fr::sum_of_products(&a0[3], &h0, &a1[3], &h1);
+            right += Fr::sum_of_products(&a0[4], &h0, &a1[4], &h1);
+        }
+        state[1] = left;
+        state[2] = right;
+        head
+    }
+}
