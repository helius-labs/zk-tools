+#[inline]
+pub(super) fn mode() -> u8 {
+    static MODE: std::sync::OnceLock<u8> = std::sync::OnceLock::new();
+    *MODE.get_or_init(
+        || match std::env::var("ZOPRO_904_PAIRED_POSEIDON").as_deref() {
+            Ok("fused") => 1,
+            Ok("early") => 2,
+            _ => 0,
+        },
+    )
+}
+
+#[inline]
+pub(super) fn trace(mode: u8) {
+    static TRACE: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    if *TRACE.get_or_init(|| std::env::var_os("ZOPRO_904_TRACE").is_some()) {
+        eprintln!("ZP904_PAIRED {mode}");
+    }
+}
