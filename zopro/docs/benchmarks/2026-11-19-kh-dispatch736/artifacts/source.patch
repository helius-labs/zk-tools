+/// Publish K/H window jobs to the scope before A is available to steal.
+pub(crate) fn fifo<C, Fa, Fb, A, B>(
+    k: &[Affine<C>],
+    sk: &[[u64; 4]],
+    h: &[Affine<C>],
+    sh: &[[u64; 4]],
+    b2_first: bool,
+    compute_a: Fa,
+    compute_b: Fb,
+) -> ((A, Projective<C>), B)
+where
+    C: CurveConfig<Base = Fq>,
+    Fa: FnOnce() -> A + Send,
+    Fb: FnOnce() -> B + Send,
+    A: Send,
+    B: Send,
+{
+    let cover = spans();
+    let mut sums = [Projective::<C>::IDENTITY; COUNT];
+    let mut a = None;
+    let mut b = None;
+    let a_slot = &mut a;
+    let b_slot = &mut b;
+    rayon::scope_fifo(|scope| {
+        let mut b_job = Some((b_slot, compute_b));
+        if b2_first {
+            let (slot, compute) = b_job.take().expect("B2 submitted once");
+            scope.spawn_fifo(move |_| *slot = Some(compute()));
+        }
+        for (&span, sum) in cover.iter().zip(&mut sums) {
+            scope.spawn_fifo(move |_| *sum = window(k, sk, h, sh, span));
+        }
