+/// Apply the same stable stride-32 traversal to points and scalars in place.
+pub(super) fn stripe_pairs<P, S>(points: &mut [P], scalars: &mut [S]) {
+    let n = points.len();
+    assert_eq!(n, scalars.len());
+    let mut visited = vec![0u64; n.div_ceil(64)];
+    for start in 0..n {
+        if visited[start / 64] & (1u64 << (start % 64)) != 0 { continue; }
+        let mut source = start;
+        loop {
+            visited[source / 64] |= 1u64 << (source % 64);
+            let column = source % 32;
+            let destination = column * (n / 32) + column.min(n % 32) + source / 32;
+            if destination == start { break; }
+            points.swap(start, destination);
+            scalars.swap(start, destination);
+            source = destination;
+        }
+    }
+}
