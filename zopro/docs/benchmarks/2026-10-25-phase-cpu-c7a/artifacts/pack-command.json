        "Comment": "Archive completed CPU results and serve through loopback SSM tunnel",
        "ExpiresAfter": "2026-10-26T00:24:23.064000+00:00",
        "Parameters": {
            "commands": [
                "set -eu",
                "test -f /var/tmp/zopro-phase-cpu-c7a/output/perf/result.json",
                "test -f /var/tmp/zopro-phase-cpu-c7a/output/comparison/result.json",
                "tar -C /var/tmp/zopro-phase-cpu-c7a --exclude='*/ctl' --exclude='*/ack' -czf /var/tmp/zopro-phase-cpu-c7a/review-results.tar.gz output hardware.txt bench.log bench-resume.log container-exit.txt resume-container-exit.txt host-stat-before.txt host-stat-after.txt host-stat-after-resume.txt host-cpu-pressure-before.txt host-cpu-pressure-after.txt host-memory-pressure-before.txt host-memory-pressure-after.txt perf-probe.log record-probe.log",
