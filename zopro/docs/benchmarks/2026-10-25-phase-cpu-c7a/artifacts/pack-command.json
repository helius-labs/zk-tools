                "docker cp zopro-phase-cpu-c7a-resume:/experiment/serve-results /var/tmp/zopro-phase-cpu-c7a/serve-results",
                "systemd-run --unit=zopro-phase-cpu-transfer --collect --property=RuntimeMaxSec=180 /var/tmp/zopro-phase-cpu-c7a/serve-results /var/tmp/zopro-phase-cpu-c7a/review-results.tar.gz",
                "systemctl is-active zopro-phase-cpu-transfer.service",
