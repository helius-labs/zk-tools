{
  "InstanceIds": [
    "i-0e421a4dee64f0e16"
  ],
  "DocumentName": "AWS-RunShellScript",
  "Comment": "Inspect initial profiler failure without repeating latency",
  "Parameters": {
    "commands": [
      "set -eu",
      "cat /var/tmp/zopro-phase-cpu-c7a/output/perf/profile/b0/1x2-w32/accepted/run/stderr.log",
      "cat /var/tmp/zopro-phase-cpu-c7a/output/perf/profile/b0/1x2-w32/accepted/run/exit.json",
      "cat /proc/sys/kernel/perf_event_mlock_kb",
      "docker inspect zopro-phase-cpu-c7a --format '{{json .State}}'",
      "systemctl is-active zopro-phase-cpu-ttl.timer"
    ],
    "executionTimeout": [
      "60"
    ]
  }
}
