+#[derive(Clone, Copy)]
+enum EarlyG1 { Off, A, K, Both }
+
+fn early_msm_g1(bases: &[G1Affine], scalars: &mut [Fr]) -> G1Projective {
+    #[cfg(not(target_arch = "wasm32"))]
+    return msm_affine::msm_in_place(bases, scalars);
+    #[cfg(target_arch = "wasm32")]
+    msm_g1(bases, scalars)
