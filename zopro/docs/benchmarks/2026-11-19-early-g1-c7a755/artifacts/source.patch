+#[cfg(all(zopro_resource_schedule, feature = "ifma8", target_arch = "x86_64", target_os = "linux", target_feature = "avx512ifma", target_feature = "avx512vl", target_feature = "avx512dq", not(no_ifma)))]
+impl Key {
+    fn early_g1(&self, a: usize, b: usize, k: usize) -> Option<(&rayon::ThreadPool, EarlyG1, crate::preparation::Reservation)> {
+        // Keep the large, grouped CPU route when A or K is removed from the later call.
+        if b < 65536 || !affine_msm() || self.equal_witness.is_some()
+            || !crate::simd::cpu_option("ZOPRO_CPU_DEDUP")
+        {
+            return None;
+        }
+        let selected = match std::env::var("ZOPRO_TRIAL_EARLY_G1").as_deref() {
+            Ok("a") => EarlyG1::A,
+            Ok("k") => EarlyG1::K,
+            Ok("both") => EarlyG1::Both,
+            _ => return None,
+        };
+        let pool = self.frontend_pool.as_deref()
+            .filter(|p| p.current_num_threads() < rayon::current_num_threads())?;
+        // The early query must have disjoint workers from the quotient.
+        if std::env::var("ZOPRO_CPU_FFT_PRODUCT_FRONTEND").as_deref() == Ok("1") {
+            return None;
+        }
+        let charge = pool.install(|| {
+            let bytes = |n| msm_affine::workspace::frontend_curve_bytes(n, rayon::current_num_threads());
+            let needed = match selected {
+                EarlyG1::A => bytes(a),
+                EarlyG1::K => bytes(k),
+                EarlyG1::Both => bytes(a)?.checked_add(bytes(k)?),
+                EarlyG1::Off => None,
+            };
+            crate::preparation::Reservation::analysis(needed)
+        })?;
+        if std::env::var_os("ZOPRO_TRIAL_CURVE_CLOCK").is_some() {
+            eprintln!("EARLY_G1 {}", match selected { EarlyG1::A=>"a", EarlyG1::K=>"k", EarlyG1::Both=>"both",EarlyG1::Off=>"off" });
+        }
+        Some((pool, selected, charge))
     }
 }
 
