{
  "argv": [
    "timeout",
    "-k",
    "5s",
    "180s",
    "/usr/lib/linux-tools/6.8.0-147-generic/perf",
    "record",
    "--no-buildid-cache",
    "--delay=-1",
    "--control=fifo:/output/measure/profiles/w32-tree/ctl,/output/measure/profiles/w32-tree/ack",
    "-e",
    "cycles:u",
    "-F",
    "199",
    "-o",
    "/output/measure/profiles/w32-tree/perf.data",
    "--",
    "taskset",
    "-c",
    "0-31",
    "/usr/local/bin/gt-candidate",
    "/gt/cases.json",
    "1x2",
    "tree",
    "32",
    "64"
  ],
  "environment": {
    "MALLOC_ARENA_MAX": "32",
    "MALLOC_MMAP_THRESHOLD_": "1073741824",
    "MALLOC_TRIM_THRESHOLD_": "-1",
    "RAYON_NUM_THREADS": "32",
    "ZOPRO_BASIS_KEY_DIR": "/gt-basis",
    "ZOPRO_BENCH_PERF_ACK": "/output/measure/profiles/w32-tree/ack",
    "ZOPRO_BENCH_PERF_CTL": "/output/measure/profiles/w32-tree/ctl",
    "ZOPRO_CPU_BOUNDED_SCHEDULE": "1",
    "ZOPRO_CPU_CANONICAL_WIRES": "1",
    "ZOPRO_CPU_DEFER_SIGNED_Y": "1",
    "ZOPRO_CPU_DEFER_SIGN_PARTS": "1",
    "ZOPRO_CPU_DEFER_SIGN_WIDTH": "12",
    "ZOPRO_CPU_FFT_COLUMN_ROOTS": "1",
    "ZOPRO_CPU_G2_PREFIX_RECORDS": "1",
    "ZOPRO_CPU_LAGRANGE": "1",
    "ZOPRO_CPU_LAGRANGE_DIR": "/output/lagrange-cache",
    "ZOPRO_CPU_LAGRANGE_FOLD": "1",
    "ZOPRO_CPU_PROOF_CONCURRENCY": "1",
    "ZOPRO_CPU_RESOURCE_SCHEDULE": "1",
    "ZOPRO_CPU_SMALL_CORE_ENTRY": "1",
    "ZOPRO_CPU_ZERO_AWARE_GROUPS": "1"
  }
}
