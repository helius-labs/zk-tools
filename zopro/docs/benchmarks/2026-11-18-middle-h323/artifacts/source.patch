 /// Treat Montgomery words as scalar integers, then undo their common R
 /// factor on the single output point. This avoids reducing every scalar.
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(super) enum MiddleH { Default, Canonical, Montgomery }
+
+pub(super) fn middle_h_mode(n: usize) -> MiddleH {
+    if !((1 << 15)..(1 << 18)).contains(&n) { return MiddleH::Default; }
+    match std::env::var("ZOPRO_BENCH_MIDDLE_H").as_deref() {
+        Ok("canonical") => MiddleH::Canonical,
+        Ok("montgomery") => MiddleH::Montgomery,
+        _ => MiddleH::Default,
+    }
+}
+
+#[inline(never)]
+pub(super) fn middle_h_canonical<C: CurveConfig>(bases: &[Affine<C>], scalars: &mut [Fr]) -> Projective<C>
+where C::Base: BatchInverse {
+    msm_raw(bases, canonical(scalars))
+}
+#[inline(never)]
+pub(super) fn middle_h_montgomery<C: CurveConfig>(bases: &[Affine<C>], scalars: &[Fr]) -> Projective<C>
+where C::Base: BatchInverse {
+    msm_montgomery(bases, scalars)
+}
