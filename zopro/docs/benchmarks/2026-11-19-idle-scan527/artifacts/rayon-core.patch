+fn idle_rounds(threads: usize, budget: Option<usize>) -> u32 {
+    match budget {
+        Some(probes @ (128 | 512)) if threads >= 16 => {
+            probes.div_ceil(threads - 1).clamp(1, ROUNDS_UNTIL_SLEEPY as usize) as u32
+        }
+        _ => ROUNDS_UNTIL_SLEEPY,
+    }
+}
 
