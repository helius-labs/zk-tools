+#[cfg(test)]
+mod idle_budget_tests {
+    #[test]
+    fn limits_scale_with_team_size() {
+        for (workers, budget, expected) in [
+            (8, Some(128), 32), (16, Some(128), 9), (32, Some(128), 5),
+            (64, Some(128), 3), (96, Some(128), 2), (96, Some(512), 6),
+            (32, Some(512), 17), (32, None, 32), (96, Some(0), 32),
+        ] {
+            assert_eq!(super::idle_rounds(workers, budget), expected);
+        }
+    }
+
+    #[test]
+    fn jobs_complete_after_idle_transitions() {
+        use std::sync::atomic::{AtomicUsize, Ordering};
+        use std::time::Duration;
+        let pool = crate::ThreadPoolBuilder::new().num_threads(32).build().unwrap();
+        for _ in 0..8 {
+            std::thread::sleep(Duration::from_millis(3));
+            let completed = AtomicUsize::new(0);
+            std::thread::scope(|scope| {
+                for _ in 0..4 {
+                    scope.spawn(|| pool.scope(|s| {
+                        for _ in 0..128 {
+                            s.spawn(|_| {
+                                crate::join(|| completed.fetch_add(1, Ordering::Relaxed),
+                                            || completed.fetch_add(1, Ordering::Relaxed));
+                            });
+                        }
+                    }));
+                }
+            });
+            assert_eq!(completed.load(Ordering::Relaxed), 1024);
+            assert_eq!(pool.broadcast(|ctx| ctx.index()).len(), 32);
+        }
+    }
