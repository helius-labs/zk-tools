  "environment": {},
  "steps": [
    {
      "kind": "command",
      "name": "capture-accepted",
      "argv": [
        "sudo",
        "-n",
        "perf",
        "record",
        "--no-buildid-cache",
        "-e",
        "cycles:u",
        "-F",
        "999",
        "-o",
        "/tmp/zopro-phased-complex-products/profiles-data/accepted/perf.data",
        "--",
        "taskset",
        "-c",
        "2",
        "/tmp/zopro-phased-complex-products/accepted-probe",
        "old",
        "affine-expression",
        "20000000"
      ],
      "environment": {},
      "required_tests": [],
      "unfiltered": false,
      "timeout_seconds": 120
    },
    {
      "kind": "command",
      "name": "decode-accepted",
      "argv": [
        "sudo",
        "-n",
        "perf",
        "script",
        "--header",
        "-i",
        "/tmp/zopro-phased-complex-products/profiles-data/accepted/perf.data",
        "-F",
        "comm,pid,tid,time,event,period,ip,sym,dso"
      ],
      "environment": {},
      "required_tests": [],
      "unfiltered": false,
      "timeout_seconds": 120
    },
