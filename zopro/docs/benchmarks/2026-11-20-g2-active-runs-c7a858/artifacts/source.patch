+impl ActiveRuns {
+    pub(super) fn prepare(bases: &[G2Affine], short: &[[u64; 4]], skip_zero: bool) -> Self {
+        assert_eq!(bases.len(), short.len());
+        let mut result = Self::default();
+        let mut begin = [None; 2];
+        for (i, (p, words)) in bases.iter().zip(short).enumerate() {
+            let valid = !p.is_identity();
+            for side in 0..2 {
+                let nonzero = words[side * 2] != 0 || words[side * 2 + 1] & (u64::MAX >> 1) != 0;
+                if valid && (!skip_zero || nonzero) {
+                    if begin[side].is_none() { begin[side] = Some(i); }
+                } else if let Some(start) = begin[side].take() {
+                    result.component[side].push(start..i);
+                }
+            }
+        }
+        for (runs, begin) in result.component.iter_mut().zip(begin) {
+            if let Some(start) = begin { runs.push(start..bases.len()); }
+        }
+        result
+    }
+}
