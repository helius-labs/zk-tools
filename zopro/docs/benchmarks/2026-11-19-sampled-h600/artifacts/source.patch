+//! Predict whether grouping can combine nonzero H coefficients.
+const SAMPLE: usize = 64;
+
+pub(super) fn stream_directly(scalars: &[[u64; 4]]) -> bool {
+    if scalars.len() < SAMPLE * 2 {
+        return false;
+    }
+    // Take one value per stratum. Vary the offset across strata so the
+    // sampler does not always select the same position in repeated blocks.
+    let stride = scalars.len() / SAMPLE;
+    let mut sample = [[0u64; 4]; SAMPLE];
+    let mut nonzero = 0;
+    for i in 0..SAMPLE {
+        let offset = (i * 37 + 17) % stride;
+        let value = scalars[i * stride + offset];
+        if value != [0; 4] {
+            sample[nonzero] = value;
+            nonzero += 1;
+        }
+    }
+    // When most coefficients vanish, the existing grouping path can
+    // still profit by compacting away zero bases.
+    if nonzero <= SAMPLE / 2 {
+        return false;
+    }
+    let occupied = &mut sample[..nonzero];
+    occupied.sort_unstable();
+    occupied.windows(2).all(|pair| pair[0] != pair[1])
+}
+
+#[cfg(test)]
+mod tests {
+    use super::stream_directly;
+
+    #[test]
+    fn h_sample_distinguishes_diverse_and_repeated_nonzero_values() {
+        let distinct: Vec<_> = (1..=53874).map(|i| [i, 1, 0, 0]).collect();
+        assert!(stream_directly(&distinct));
+        assert!(!stream_directly(&distinct[..32]));
+        let values: Vec<_> = distinct
+            .iter()
+            .map(|s| if s[0] % 7 == 0 { [0; 4] } else { *s })
+            .collect();
+        assert!(stream_directly(&values));
+        let repeated: Vec<_> = distinct.iter().map(|s| [s[0] % 8, 1, 0, 0]).collect();
+        assert!(!stream_directly(&repeated));
+        let sparse: Vec<_> = distinct
+            .iter()
+            .map(|s| if s[0] % 16 == 0 { *s } else { [0; 4] })
+            .collect();
+        assert!(!stream_directly(&sparse));
+        assert!(!stream_directly(&[[0; 4]; 256]));
+    }
+}
