+// Keep one single-symbol anchor per symbol within each tile. A proposed deletion
+// can reference only surviving anchors in that same tile, so deletions never
+// form chains. Coefficients are checked by reconstructing the exact affine form.
+fn private_tile(wires: &[Option<Form>], tile: usize) -> Value {
+    let mut single=0; let mut multi=0; let mut multi_zero_correction=0;
+    let mut constants=0; let mut rewrites=0; let mut max_anchors=0;
+    for slab in wires.chunks(tile) {
+        let mut anchors=BTreeMap::new();
+        for (i,row) in slab.iter().enumerate() {
+            let row=row.as_ref().unwrap();
+            if row.terms.len()==1 {
+                let (&atom,&c)=row.terms.first_key_value().unwrap();
+                anchors.entry(atom).or_insert_with(|| (i,c.inverse().unwrap()));
+            }
+        }
+        max_anchors=max_anchors.max(anchors.len());
+        for (i,row) in slab.iter().enumerate() {
+            let row=row.as_ref().unwrap();
+            if row.terms.is_empty() {constants+=1;continue;}
+            if row.terms.len()>4 || !row.terms.keys().all(|k| anchors.contains_key(k)) {continue;}
+            if row.terms.len()==1 && anchors[row.terms.first_key_value().unwrap().0].0==i {continue;}
+            let mut restored=Form::constant(Fr::ZERO);
+            for (atom,&weight) in &row.terms {
+                let (j,inv)=anchors[atom];
+                restored=restored.plus(&slab[j].as_ref().unwrap().scale(weight*inv));
+            }
+            let correction=row.constant-restored.constant;
+            restored=restored.plus(&Form::constant(correction));assert_eq!(&restored,row);
+            if row.terms.len()==1 {single+=1;} else {multi+=1;if correction==Fr::ZERO {multi_zero_correction+=1;}}
+            rewrites+=row.terms.len();
+        }
+    }
+    json!({"tile":tile,"retained_anchor_map_max":max_anchors,"constants":constants,"single_symbol_aliases":single,"two_to_four_terms":multi,"multi_zero_constant":multi_zero_correction,"point_updates":rewrites,"removable_rows":constants+single+multi})
 }
 
