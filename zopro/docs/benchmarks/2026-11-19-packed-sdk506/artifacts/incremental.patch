+//! Experimental B2 layout. All permanent indices and curve points stay in the mapped image.
+use super::{msm_affine, preparation::Reservation, Fr, G2Affine, G2Projective, Image};
+use rayon::prelude::*;
+
+const LEADER: u32 = 1 << 31;
+const SINGLE: usize = u32::MAX as usize;
+
+pub(super) struct Packed {
+    image: Image,
+    table: usize,
+    n: usize,
+    groups: usize,
+    prefix: usize,
+}
+
+impl Packed {
+    fn entry(&self, row: usize) -> (u32, usize) {
+        let bytes = (*self.image).as_ref();
+        let start = self.table + 8 * row;
+        let source = u32::from_le_bytes(bytes[start..start + 4].try_into().unwrap());
+        let group = u32::from_le_bytes(bytes[start + 4..start + 8].try_into().unwrap());
+        (source, group as usize)
+    }
+
+    fn source(&self, row: usize) -> usize {
+        (self.entry(row).0 & !LEADER) as usize
+    }
+
+    pub fn parse(image: &Image, at: usize, n: usize) -> Result<Self, &'static str> {
+        let bytes = (**image).as_ref().get(at..).ok_or("missing packed metadata")?;
+        if n >= LEADER as usize || bytes.len() != n.checked_mul(8).and_then(|x| x.checked_add(16)).ok_or("packed length overflow")? || &bytes[..8] != b"ZPB2T506" {
+            return Err("invalid packed metadata");
+        }
+        let groups = u32::from_le_bytes(bytes[8..12].try_into().unwrap()) as usize;
+        let prefix = u32::from_le_bytes(bytes[12..16].try_into().unwrap()) as usize;
+        if groups == 0 || groups > prefix || prefix >= n {return Err("invalid packed prefix");}
+        let result = Self { image: image.clone(), table: at+16, groups, prefix, n };
+        let mut visited = vec![0u64; n.div_ceil(64)];
+        for row in 0..n {
+            let source = result.source(row);
+            let (_, group) = result.entry(row);
+            if source >= n || visited[source / 64] & (1u64 << (source % 64)) != 0 || (row < prefix && group != SINGLE) || (row >= prefix && group >= groups) {
+                return Err("invalid packed mapping");
+            }
+            if row > groups && row < prefix && source <= result.source(row-1) { return Err("unordered singleton sources"); }
+            visited[source / 64] |= 1u64 << (source % 64);
+        }
+        visited.fill(0);
+        for row in 0..n {
+            if visited[row / 64] & (1u64 << (row % 64)) != 0 { continue; }
+            let mut j = row;
+            let mut leaders = 0;
+            loop {
+                visited[j / 64] |= 1u64 << (j % 64);
+                leaders += usize::from(result.entry(j).0 & LEADER != 0);
+                j = result.source(j);
+                if j == row {break;}
+            }
+            if leaders != usize::from(result.source(row)!=row) {return Err("invalid permutation cycle markers");}
+        }
+        Ok(result)
+    }
+
+    pub fn singleton_position(&self, source: usize) -> Option<usize> {
+        let (mut lo, mut hi) = (self.groups, self.prefix);
+        while lo < hi {
+            let mid = lo + (hi-lo)/2;
+            if self.source(mid) < source { lo = mid+1; } else { hi = mid; }
+        }
+        (lo < self.prefix && self.source(lo) == source).then_some(lo)
+    }
+
+    fn difference(&self, values: &[Fr], row: usize) -> Fr {
+        let (src, group) = self.entry(row);
+        values[(src & !LEADER) as usize] - values[self.source(group)]
+    }
+
+    fn in_place(&self, points: &[G2Affine], values: &mut [Fr]) -> G2Projective {
+        for start in 0..self.n {
+            if self.entry(start).0 & LEADER == 0 {continue;}
+            let saved = values[start];
+            let mut at = start;
+            loop {
+                let next = self.source(at);
+                if next == start {values[at]=saved;break;}
+                values[at] = values[next];
+                at = next;
+            }
+        }
+        let (front, tail) = values.split_at_mut(self.prefix);
+        tail.par_iter_mut().enumerate().for_each(|(i, value)| {
+            *value -= front[self.entry(self.prefix+i).1];
+        });
+        let words = msm_affine::canonical_exclusive(values);
+        msm_affine::g2_query_exclusive(points, words)
+    }
+
+    pub fn query(&self, points: &[G2Affine], values: &mut [Fr]) -> G2Projective {
+        assert_eq!(points.len(), self.n);
+        assert_eq!(values.len(), self.n);
+        let trace = std::env::var_os("ZOPRO_PACKED_TRACE").is_some();
+        let end=self.n-self.prefix;
+        let samples=end.min(64);
+        let mismatches=(0..samples).filter(|&i| !self.difference(values,self.prefix+(2*i+1)*end/(2*samples)).is_zero()).count();
+        if mismatches*4>samples || std::env::var_os("ZOPRO_PACKED_DENSE").is_some() {
+            if trace {eprintln!("PACKED_DENSE {mismatches} {samples}");}
+            return self.in_place(points,values);
+        }
+        let differences=(self.prefix..self.n).into_par_iter().with_min_len(512).filter(|&i|!self.difference(values,i).is_zero()).count();
+        let scratch = self.prefix.checked_mul(32).and_then(|bytes|differences.checked_mul(160)?.checked_add(bytes)?.checked_add(512));
+        let permit = Reservation::analysis(scratch);
+        if permit.is_none() || differences>end/16 {
+            if trace {eprintln!("PACKED_DENSE {differences} {end}");}
+            return self.in_place(points,values);
+        }
+        if trace {eprintln!("PACKED_SPARSE {} {differences}",self.prefix);}
+        let (main, extra)=rayon::join(|| {
+            let mut words:Vec<_>=(0..self.prefix).into_par_iter().map(|i|values[self.source(i)].to_canonical()).collect();
+            msm_affine::g2_query_exclusive(&points[..self.prefix], &mut words)
+        },|| {
+            if differences==0 {return G2Projective::IDENTITY;}
+            let mut bases=Vec::with_capacity(differences);
+            let mut words=Vec::with_capacity(differences);
+            for i in self.prefix..self.n {
+                let delta=self.difference(values,i);
+                if !delta.is_zero() {bases.push(points[i]);words.push(delta.to_canonical());}
+            }
+            debug_assert_eq!(words.len(),differences);
+            msm_affine::g2_query_exclusive(&bases,&mut words)
+        });
+        main+extra
+    }
+}
