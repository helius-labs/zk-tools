+        type Batch = Ifma8<FrConfig, true>;
+        let integer_one = Batch::new(&[Fr::from_montgomery([1, 0, 0, 0]); 8]);
+        let (full, tail) = scalars.as_chunks_mut::<8>();
+        for batch in full {
+            *batch = Batch::new(batch).mul(&integer_one).get();
+        }
+        for word in tail {
+            *word = Fr::from_montgomery(word.to_canonical_reduced());
+        }
+        return;
+    }
+    for word in scalars {
+        *word = Fr::from_montgomery(convert_word::<REDUCTION>(word));
+    }
+}
