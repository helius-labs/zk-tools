+/// Decode a four-limb Montgomery value without multiplying it by one.
+#[inline(always)]
+pub(crate) const fn decode_montgomery(
+    mut x: [u64; 4], p: [u64; 4], inv: u64,
+) -> [u64; 4] {
+    let mut round = 0;
+    while round < 4 {
+        let q = x[0].wrapping_mul(inv);
+        // q * p[0] cancels x[0] modulo 2^64. Their low halves
+        // produce a carry exactly when x[0] is nonzero.
+        let low = (q as u128) * (p[0] as u128);
+        let mut carry = (low >> 64) + (x[0] != 0) as u128;
+        let mut limb = 1;
+        while limb < 4 {
+            let column = (q as u128) * (p[limb] as u128) + x[limb] as u128 + carry;
+            x[limb - 1] = column as u64;
+            carry = column >> 64;
+            limb += 1;
+        }
+        x[3] = carry as u64;
+        round += 1;
+    }
+    reduce_once(x, p)
+}
