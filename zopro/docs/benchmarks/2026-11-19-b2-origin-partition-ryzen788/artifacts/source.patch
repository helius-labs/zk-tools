+use super::{ScalarGroups, classify_words, grouping_cost};
+use crate::preparation::Reservation;
+use crate::solver::{B2Origins, OriginPartition};
+use rayon::prelude::*;
+
+#[derive(Default)]
+struct LocalGroups {
+    values: Vec<[u64; 4]>,
+    counts: Vec<usize>,
+    order: Vec<u32>,
+}
+
+impl LocalGroups {
+    fn collect(origins: &OriginPartition, spans: &[usize], words: &[[u64; 4]]) -> Self {
+        let mut out = Self::default();
+        let mut mismatches = Vec::new();
+        let mut members = Vec::with_capacity(spans.len());
+        for row in origins.rows(spans) {
+            members.clear();
+            members.extend(spans.iter().filter_map(|&span| origins.position(span, row)));
+            let mut matched = 0;
+            let mut representative = [0; 4];
+            for &position in &members {
+                let value = words[position];
+                if value == [0; 4] {
+                    continue;
+                }
+                if matched == 0 {
+                    representative = value;
+                }
+                if representative == value {
+                    out.order.push(position as u32);
+                    matched += 1;
+                } else {
+                    mismatches.push(position);
+                }
+            }
+            if matched != 0 {
+                out.values.push(representative);
+                out.counts.push(matched);
+            }
+        }
+        for position in mismatches {
+            out.order.push(position as u32);
+            out.values.push(words[position]);
+            out.counts.push(1);
+        }
+        out
+    }
+
+    fn remaining(indices: &[u32], words: &[[u64; 4]], capacity: usize) -> Self {
+        let mut classes = vec![u32::MAX; indices.len()];
+        let selected = indices.iter().map(|&i| &words[i as usize]);
+        let (values, counts) =
+            classify_words(selected, &mut classes, capacity, ahash::RandomState::new());
+        let starts = offsets(&counts);
+        let mut next = starts[..counts.len()].to_vec();
+        let mut order = vec![0u32; *starts.last().unwrap()];
+        for (&position, class) in indices.iter().zip(classes) {
+            if class != u32::MAX {
+                order[next[class as usize]] = position;
+                next[class as usize] += 1;
+            }
+        }
+        Self {
+            values,
+            counts,
+            order,
+        }
+    }
+}
+
+fn offsets(counts: &[usize]) -> Vec<usize> {
+    let mut starts = Vec::with_capacity(counts.len() + 1);
+    starts.push(0);
+    for n in counts {
+        starts.push(starts.last().unwrap() + n);
+    }
+    starts
+}
+
+pub(super) fn assemble(
+    words: &[[u64; 4]],
+    origins: &B2Origins,
+    percent: usize,
+    capacity: usize,
+) -> Option<ScalarGroups> {
+    let partition = origins.partition()?;
+    let n = words.len();
+    // Includes first and final copies of the per-state vectors, plus
+    // residual hash output and a temporary list of unexpected terms.
+    let extra = n.checked_mul(112)?;
+    let reservation =
+        Reservation::analysis(grouping_cost::add(grouping_cost::peak(n, percent)?, extra))?;
+    let spans = origins.state_groups(words)?;
+    let room = capacity.min(origins.residual().div_ceil(3));
+    let (mut batches, residual): (Vec<_>, _) = rayon::join(
+        || {
+            spans
+                .par_iter()
+                .map(|spans| LocalGroups::collect(partition, spans, words))
+                .collect()
+        },
+        || LocalGroups::remaining(partition.residual(), words, room),
+    );
+    batches.push(residual);
+    let class_count: usize = batches.iter().map(|g| g.values.len()).sum();
+    if class_count * 100 > n * percent {
+        return None;
+    }
+    let points = batches.iter().map(|g| g.order.len()).sum();
+    let mut values = Vec::with_capacity(class_count);
+    let mut counts = Vec::with_capacity(class_count);
+    let mut order = Vec::with_capacity(points);
+    for mut batch in batches {
+        values.append(&mut batch.values);
+        counts.append(&mut batch.counts);
+        order.append(&mut batch.order);
+    }
+    let starts = offsets(&counts);
+    if std::env::var_os("ZOPRO_TRIAL_SPLIT_ORIGINS_TRACE").is_some() {
+        eprintln!(
+            "SPLIT_B2_ORIGINS {n} {class_count} {points} {}",
+            spans.len()
+        );
+    }
+    Some(ScalarGroups {
+        len: n,
+        values,
+        counts,
+        order,
+        starts,
+        _reservation: reservation,
+    })
+}
