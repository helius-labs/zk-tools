+
+const MASK_WORDS: usize = (STRIDE as usize).div_ceil(64);
+
+pub(crate) struct OriginPartition {
+    residual: Vec<u32>,
+    positions: Vec<u32>,
+    occupied: Vec<[u64; MASK_WORDS]>,
+    _memory: Reservation,
+}
+
+impl OriginPartition {
+    pub(crate) fn residual(&self) -> &[u32] {
+        &self.residual
+    }
+
+    pub(crate) fn rows(&self, spans: &[usize]) -> Vec<usize> {
+        let mut mask = [0u64; MASK_WORDS];
+        for &span in spans {
+            for (out, &word) in mask.iter_mut().zip(&self.occupied[span]) {
+                *out |= word;
+            }
+        }
+        let mut rows = Vec::with_capacity(STRIDE as usize);
+        for (i, mut bits) in mask.into_iter().enumerate() {
+            while bits != 0 {
+                rows.push(i * 64 + bits.trailing_zeros() as usize);
+                bits &= bits - 1;
+            }
+        }
+        rows
+    }
+
+    pub(crate) fn position(&self, span: usize, row: usize) -> Option<usize> {
+        let value = self.positions[span * STRIDE as usize + row];
+        (value != u32::MAX).then_some(value as usize)
+    }
+}
+
+impl B2Origins {
+    pub(crate) fn partition(&self) -> Option<&OriginPartition> {
+        if let Some(prepared) = self.partition.get() {
+            return Some(prepared);
+        }
+        let cells = self.states.len().checked_mul(STRIDE as usize)?;
+        let bytes = cells
+            .checked_mul(4)?
+            .checked_add(self.residual().checked_mul(4)?)?
+            .checked_add(self.states.len().checked_mul(MASK_WORDS * 8)?)?
+            .checked_add(512)?;
+        let memory = Reservation::analysis(Some(bytes))?;
+        let mut residual = Vec::with_capacity(self.residual());
+        let mut positions = vec![u32::MAX; cells];
+        let mut occupied = vec![[0u64; MASK_WORDS]; self.states.len()];
+        for (position, &origin) in self.order.iter().enumerate() {
+            if origin == u32::MAX {
+                residual.push(position as u32);
+                continue;
+            }
+            let cell = positions.get_mut(origin as usize)?;
+            *cell = position as u32;
+            let span = (origin / STRIDE) as usize;
+            let row = (origin % STRIDE) as usize;
+            occupied[span][row / 64] |= 1u64 << (row % 64);
+        }
+        let _ = self.partition.set(OriginPartition {
+            residual,
+            positions,
+            occupied,
+            _memory: memory,
+        });
+        self.partition.get()
+    }
+
+    pub(crate) fn state_groups(&self, words: &[[u64; 4]]) -> Option<Vec<Vec<usize>>> {
+        let (tags, n) = self.state_tags(words)?;
+        let mut groups = vec![Vec::new(); n as usize];
+        for (span, tag) in tags.into_iter().enumerate() {
+            groups[tag as usize].push(span);
+        }
+        Some(groups)
+    }
+}
