+pub(crate) struct EarlyK<'a, C: CurveConfig<Base = Fq>>(Vec<Window<'a, C>>);
+
+pub(crate) fn begin_k<'a, C: CurveConfig<Base = Fq>>(
+    bases: &'a [Affine<C>],
+    scalars: &[[u64; 4]],
+    count: usize,
+) -> EarlyK<'a, C> {
+    assert_eq!(bases.len(), scalars.len());
+    let cover = spans();
+    let states = cover[..count]
+        .par_iter()
+        .map(|&span| {
+            let size = batch_size(span.width).max(32);
+            let mut state = Window::new(1usize << (span.width - 1), size);
+            feed(&mut state, bases, scalars, span, size);
+            state
+        })
+        .collect();
+    EarlyK(states)
+}
+
+pub(crate) fn finish_kh<'a, C: CurveConfig<Base = Fq>>(
+    early: EarlyK<'a, C>,
+    k: &'a [Affine<C>], sk: &[[u64; 4]],
+    h: &'a [Affine<C>], sh: &[[u64; 4]],
+) -> Projective<C> {
+    assert_eq!(k.len(), sk.len());
+    assert_eq!(h.len(), sh.len());
+    let cover = spans();
+    let mut states: Vec<_> = early.0.into_iter().map(Some).collect();
+    states.resize_with(cover.len(), || None);
+    let sums: Vec<_> = states.into_par_iter().zip(cover.par_iter())
+        .map(|(state, &span)| {
+            let size = batch_size(span.width).max(32);
+            let mut state = state.unwrap_or_else(|| {
+                let mut state = Window::new(1usize << (span.width - 1), size);
+                feed(&mut state, k, sk, span, size);
+                state
+            });
+            feed(&mut state, h, sh, span, size);
+            crate::msm::weighted_affine(&state.finish())
+        }).collect();
+    combine(&cover, sums)
+}
