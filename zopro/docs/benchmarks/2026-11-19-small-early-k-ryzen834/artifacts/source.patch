+#[cfg(test)]
+mod early_seed_tests {
+    use super::*;
+    use crate::testing::Seeded;
+    use zopro_bn254::{G1Affine, G1Config};
+
+    #[test]
+    fn seeded_windows_match_generator_oracle() {
+        let g = G1Affine::GENERATOR;
+        let mut rng = Seeded::new(0x831a);
+        let mut expected = Fr::ZERO;
+        let mut fixture = |n: usize| -> (Vec<G1Affine>, Vec<[u64; 4]>) {
+            (0..n).map(|i| {
+                let (p, factor) = match i % 5 {
+                    0 => (G1Affine::IDENTITY, Fr::ZERO),
+                    1 => (-g, -Fr::ONE),
+                    _ => (g, Fr::ONE),
+                };
+                let value = if i % 13 == 0 { Fr::ZERO } else { rng.fr() };
+                expected += factor * value;
+                (p, value.to_canonical())
+            }).unzip()
+        };
+        let (k, sk) = fixture(1439);
+        let (h, sh) = fixture(2273);
+        let expected = (g * expected).to_affine();
+        for count in [2, 4, 8] {
+            let early = begin_k::<G1Config>(&k, &sk, count);
+            assert_eq!(finish_kh(early, &k, &sk, &h, &sh).to_affine(), expected);
+        }
+    }
 }
 
