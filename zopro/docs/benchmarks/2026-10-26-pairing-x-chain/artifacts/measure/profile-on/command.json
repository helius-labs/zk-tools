{
  "argv": [
    "timeout",
    "-k",
    "5s",
    "180s",
    "sudo",
    "-n",
    "/usr/bin/perf",
    "record",
    "--no-buildid-cache",
    "--delay=-1",
    "--control=fifo:/tmp/zopro-pairing-x-chain/profiles/on/ctl,/tmp/zopro-pairing-x-chain/profiles/on/ack",
    "-e",
    "cycles:u",
    "-F",
    "199",
    "-o",
    "/tmp/zopro-pairing-x-chain/profiles/on/perf.data",
    "--",
    "sudo",
    "-n",
    "-u",
    "ubuntu",
    "env",
    "ZOPRO_CPU_PAIRING_X_CHAIN=1",
    "ZOPRO_BENCH_PERF_CTL=/tmp/zopro-pairing-x-chain/profiles/on/ctl",
    "ZOPRO_BENCH_PERF_ACK=/tmp/zopro-pairing-x-chain/profiles/on/ack",
    "taskset",
    "-c",
    "2",
    "/tmp/zopro-pairing-x-chain/probe",
    "on",
    "512",
    "0"
  ],
  "environment": {}
}
