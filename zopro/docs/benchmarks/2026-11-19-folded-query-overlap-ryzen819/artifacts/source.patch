+                        eprintln!("K_FRONTEND {} {workers}", sk.len());
+                    }
+                    Some(msm(k, &mut *sk))
+                });
+                if let Some(result) = result {
+                    return result;
+                }
+            }
+        }
+        msm(k, sk)
+    }
