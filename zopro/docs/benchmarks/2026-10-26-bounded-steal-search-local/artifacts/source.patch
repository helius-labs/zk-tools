+    fn hold_budget(registry: &Registry, count: usize) -> Vec<crate::search::Permit<'_>> {
+        let deadline = Instant::now() + Duration::from_secs(5);
+        let mut permits = Vec::with_capacity(count);
+        while permits.len() < count {
+            if let Some(permit) = registry.search_admission.try_enter() {
+                permits.push(permit);
+            } else {
+                assert!(Instant::now() < deadline, "scan credit was not returned");
+                std::thread::yield_now();
+            }
+        }
