+        for workers in [2usize, 8] {
+            let pool = ThreadPoolBuilder::new().num_threads(workers).build().unwrap();
+            let registry = pool.install(Registry::current);
+            let permits = hold_budget(&registry, workers.div_ceil(2));
+            if std::env::var("ZOPRO_CPU_BOUNDED_STEAL_SEARCH").as_deref() == Ok("1") {
+                assert!(registry.search_admission.try_enter().is_none());
+            }
+            let (send, receive) = mpsc::channel();
+            pool.spawn(move || send.send(37).unwrap());
+            assert_eq!(receive.recv_timeout(Duration::from_secs(5)).unwrap(), 37);
+            assert_eq!(pool.broadcast(|ctx| ctx.index()), (0..workers).collect::<Vec<_>>());
+            drop(permits);
+            // Other idle workers can acquire credits immediately. Reclaim the
+            // complete budget with a deadline instead of assuming a quiet pool.
+            drop(hold_budget(&registry, workers.div_ceil(2)));
+        }
+    }
+}
