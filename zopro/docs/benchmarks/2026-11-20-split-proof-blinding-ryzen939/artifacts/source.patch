+
+    fn digits(scalar: Fr) -> [([i8; 256], usize); 2] {
+        let words = phi_split(scalar.to_canonical());
+        [0, 2].map(|i| {
+            let hi = words[i + 1];
+            let value = Fr::from_canonical([words[i], hi & (u64::MAX >> 1), 0, 0]).unwrap();
+            let (mut digits, used) = blinding_digits::<5>(value);
+            if hi >> 63 != 0 {
+                for d in &mut digits[..used] {
+                    *d = -*d;
+                }
+            }
+            (digits, used)
+        })
+    }
+
+    fn tables<C: CurveConfig>(
+        base: Projective<C>,
+        transform_x: impl Fn(C::Base) -> C::Base,
+    ) -> (Vec<Affine<C>>, [Affine<C>; 8]) {
+        let usual = odd_multiples(base);
+        let transformed = core::array::from_fn(|i| {
+            let p = usual[i];
+            if p.is_identity() {
+                p
+            } else {
+                Affine::new(transform_x(p.x), p.y)
+            }
+        });
+        (usual, transformed)
+    }
+
+    pub(super) fn g1(base: G1Projective, left: Fr, right: Fr) -> (G1Projective, G1Projective) {
+        let beta = BETA.square();
+        let (first, second) = tables(base, |x: Fq| x * beta);
+        let [(ld, ln), (le, en)] = digits(left);
+        let [(rd, rn), (re, fn_)] = digits(right);
+        let (mut l, mut r) = (G1Projective::IDENTITY, G1Projective::IDENTITY);
+        for i in (0..ln.max(en).max(rn).max(fn_)).rev() {
+            l = l.double();
+            r = r.double();
+            add_digit(&mut l, &first, ld[i]);
+            add_digit(&mut l, &second, le[i]);
+            add_digit(&mut r, &first, rd[i]);
+            add_digit(&mut r, &second, re[i]);
+        }
+        (l, r)
+    }
+
+    pub(super) fn g2(base: G2Projective, u: Fr, delta: &FixedBase<G2Config>, uv: Fr)
+        -> G2Projective
+    {
+        let (first, second) = tables(base, |x: Fq2| x.mul_by_fp(&BETA));
+        let [(ld, ln), (rd, rn)] = digits(u);
+        let mut out = G2Projective::IDENTITY;
+        for i in (0..ln.max(rn)).rev() {
+            out = out.double();
+            add_digit(&mut out, &first, ld[i]);
+            add_digit(&mut out, &second, rd[i]);
+        }
+        out + delta.mul(uv)
+    }
+
+    pub(super) fn mode() -> u8 {
+        static MODE: std::sync::OnceLock<u8> = std::sync::OnceLock::new();
+        *MODE.get_or_init(|| match std::env::var("ZOPRO_939_BLINDING").as_deref() {
+            Ok("g2") => 1,
+            Ok("both") => 2,
+            _ => 0,
+        })
+    }
+
+    pub(super) fn trace(query: &str) {
+        static TRACE: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+        if *TRACE.get_or_init(|| std::env::var_os("ZOPRO_939_TRACE").is_some()) {
+            eprintln!("ZP939_BLINDING {query}");
+        }
+    }
+
