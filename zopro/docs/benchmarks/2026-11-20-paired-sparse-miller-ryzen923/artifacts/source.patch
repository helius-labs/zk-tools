+use std::hint::black_box;
+use std::time::Instant;
+use zopro_bn254::{
+    pairing::{multi_miller_loop, G2Prepared},
+    Fr, G1Affine, G2Affine,
+};
+
+fn main() {
+    let identity = G2Prepared::new(&G2Affine::IDENTITY);
+    let mut cases = Vec::new();
+    for i in 1..=24u64 {
+        let p = (G1Affine::GENERATOR * Fr::from(i * 197)).to_affine();
+        let q = G2Prepared::new(&(G2Affine::GENERATOR * Fr::from(23 + i * 301)).to_affine());
+        let expected = multi_miller_loop(&[(p, &q), (G1Affine::IDENTITY, &identity)]);
+        assert_eq!(multi_miller_loop(&[(p, &q)]), expected);
+        cases.push((p, q, expected));
+    }
+    for i in 0..48 {
+        let (p, q, _) = &cases[i % 24];
+        black_box(multi_miller_loop(black_box(&[(*p, q)])));
+    }
+    for i in 0..192 {
+        let (p, q, expected) = &cases[i % 24];
+        let args = [(*p, q)];
+        let start = Instant::now();
+        let result = black_box(multi_miller_loop(black_box(&args)));
+        let ns = start.elapsed().as_nanos();
+        assert_eq!(result, *expected);
+        println!("SAMPLE {i} {ns}");
+    }
+}
