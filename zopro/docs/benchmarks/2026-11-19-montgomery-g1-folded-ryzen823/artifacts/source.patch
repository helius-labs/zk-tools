+//! Benchmark-only routes keeping scalar inputs in their Montgomery form.
+use super::{grouping, msm_grouped, msm_in_place, msm_raw};
+use crate::G1Projective;
+use zopro_bn254::{Fr, G1Affine};
+
+#[derive(Clone, Copy)]
+enum Mode {
+    Default,
+    H,
+    Ak,
+    All,
+}
+
+pub(crate) fn requested(query: char, count: usize) -> bool {
+    static MODE: std::sync::OnceLock<Mode> = std::sync::OnceLock::new();
+    let mode = MODE.get_or_init(|| match std::env::var("ZOPRO_TRIAL_MONT_G1").as_deref() {
+        Ok("h") => Mode::H,
+        Ok("ak") => Mode::Ak,
+        Ok("all") => Mode::All,
+        _ => Mode::Default,
+    });
+    let active = (65_536..262_144).contains(&count)
+        && match mode {
+            Mode::H => query == 'H',
+            Mode::Ak => query == 'A' || query == 'K',
+            Mode::All => true,
+            Mode::Default => false,
+        };
+    if active && std::env::var_os("ZOPRO_TRIAL_MONT_G1_TRACE").is_some() {
+        eprintln!("MONT_G1 {query} {count}");
+    }
+    active
+}
+
+fn grouped(bases: &[G1Affine], scalars: &[Fr]) -> G1Projective {
+    // SAFETY: an Fr stores its initialized Montgomery words contiguously.
+    let words =
+        unsafe { std::slice::from_raw_parts(scalars.as_ptr().cast::<[u64; 4]>(), scalars.len()) };
+    let sum = match grouping::group_words_montgomery(words) {
+        Some(groups) => msm_grouped(bases, &groups),
+        None => msm_raw(bases, words),
+    };
+    sum * Fr::from_montgomery([1, 0, 0, 0])
+}
+
+pub(crate) fn query(name: char, bases: &[G1Affine], scalars: &mut [Fr]) -> G1Projective {
+    if requested(name, scalars.len()) {
+        grouped(bases, scalars)
+    } else {
+        msm_in_place(bases, scalars)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::testing::Seeded;
+
+    #[test]
+    fn montgomery_g1_grouping_matches_generator() {
+        let mut rand = Seeded::new(0x439c75d4);
+        let generator = G1Affine::GENERATOR;
+        let bases: Vec<_> = (0..4099)
+            .map(|i| match i % 79 {
+                0 => G1Affine::IDENTITY,
+                1 => -generator,
+                _ => generator,
+            })
+            .collect();
+        let palette: Vec<_> = (0..113).map(|_| rand.fr()).collect();
+        for kind in 0..3 {
+            let scalars: Vec<_> = (0..bases.len())
+                .map(|i| match kind {
+                    0 => Fr::ZERO,
+                    1 => match i % 7 {
+                        0 => Fr::ZERO,
+                        1 | 2 => Fr::ONE,
+                        3 => -Fr::ONE,
+                        _ => palette[i % palette.len()],
+                    },
+                    _ => rand.fr(),
+                })
+                .collect();
+            let expected = bases
+                .iter()
+                .zip(&scalars)
+                .fold(Fr::ZERO, |sum, (base, &scalar)| {
+                    if *base == generator {
+                        sum + scalar
+                    } else if *base == -generator {
+                        sum - scalar
+                    } else {
+                        sum
+                    }
+                });
+            let ordinary = msm_in_place(&bases, &mut scalars.clone());
+            let trial = grouped(&bases, &scalars);
+            assert_eq!(trial.to_affine(), (generator * expected).to_affine());
+            assert_eq!(trial.to_affine(), ordinary.to_affine());
+        }
+    }
+}
