+    fn staged_suffix_buckets_match_generator_sum() {
+        let generator = G2Affine::GENERATOR;
+        let n = 4157;
+        let mut point = G2Projective::IDENTITY;
+        let mut weights = Vec::new();
+        let mut expected = Fr::ZERO;
+        let mut points = Vec::new();
+        for i in 0..n {
+            point += generator;
+            points.push(if i % 17 == 0 { G2Projective::IDENTITY } else { point });
+            let weight = match i % 7 {
+                0 => Fr::ZERO,
+                1 | 2 => Fr::from(1234u64),
+                3 | 4 => -Fr::from(1234u64),
+                _ => Fr::from(i as u64).pow(&[25]),
+            };
+            weights.push(weight.to_canonical());
+            if i % 17 != 0 {
+                expected += weight * Fr::from((i + 1) as u64);
+            }
+        }
+        let points = G2Projective::batch_to_affine(&points);
+        for cut in [1024, 2049, 3659] {
+            for grouping in [false, true] {
+                let mut prefix = weights[..cut].to_vec();
+                let suffix = stage_b2_range(&points[cut..], weights[cut..].to_vec(), grouping);
+                let job = B2StageJob::new(reserve_staged_b2(n, rayon::current_num_threads()).unwrap());
+                assert!(job.buckets.set(suffix).is_ok());
+                let staged = StagedB2::new(cut, std::sync::Arc::new(job));
+                assert_eq!(staged.finish(&points, &mut prefix, grouping).to_affine(), (generator * expected).to_affine());
+            }
+        }
+    }
