+//! Timings and optional disjoint placement for the ordinary CPU curve queries.
+use crate::{G1Projective, time::Instant};
+use std::sync::OnceLock;
+
+#[derive(Clone, Copy)]
+pub(super) enum Phase {
+    Solve,
+    Gather,
+    Fft,
+    A,
+    K,
+    H,
+    B2,
+}
+
+#[derive(Default)]
+pub(super) struct Clock {
+    start: Option<Instant>,
+    intervals: [OnceLock<(u128, u128, usize)>; 7],
+}
+
+impl Clock {
+    pub(super) fn new() -> Self {
+        Self {
+            start: std::env::var_os("ZOPRO_TRIAL_CURVE_CLOCK").is_some().then(Instant::now),
+            intervals: Default::default(),
+        }
+    }
+
+    pub(super) fn time<T>(&self, phase: Phase, f: impl FnOnce() -> T) -> T {
+        let Some(start) = self.start else {
+            return f();
+        };
+        let workers = rayon::current_num_threads();
+        let entered = start.elapsed().as_nanos();
+        let result = f();
+        let released = start.elapsed().as_nanos();
+        assert!(self.intervals[phase as usize].set((entered, released, workers)).is_ok());
+        result
+    }
+
+    pub(super) fn report(&self) {
+        if let Some(start) = self.start {
+            let names = ["solve", "gather", "fft", "a", "k", "h", "b2"];
+            let times = self.intervals.iter().zip(names).filter_map(|(sample, name)| {
+                let (begin, end, workers) = sample.get()?;
+                Some(format!("{name}:{begin}:{end}:{workers}"))
+            }).collect::<Vec<_>>().join(" ");
+            eprintln!("CURVE_CLOCK {} {times}", start.elapsed().as_nanos());
+        }
+    }
+}
+
+pub(super) fn placed(
+    placement: &str,
+    query: &str,
+    points: usize,
+    pool: Option<&rayon::ThreadPool>,
+    call: impl FnOnce() -> G1Projective + Send,
+) -> G1Projective {
+    #[cfg(all(zopro_resource_schedule,feature="ifma8",target_arch="x86_64",target_feature="avx512ifma",target_feature="avx512vl",target_feature="avx512dq",not(no_ifma)))]
+    if placement == query {
+        if let Some(pool) = pool.filter(|p| p.current_num_threads() < rayon::current_num_threads()) {
+            // Budget the geometry selected by the receiving pool's actual width.
+            return match pool.install(|| {
+                let workers = rayon::current_num_threads();
+                let Some(_memory) = crate::preparation::Reservation::analysis(
+                    crate::msm_affine::workspace::frontend_curve_bytes(points, workers)
+                ) else {
+                    return Err(call);
+                };
+                if std::env::var_os("ZOPRO_TRIAL_CURVE_CLOCK").is_some() {
+                    eprintln!("CURVE_FRONT {query} {points} {workers}");
+                }
+                Ok(call())
+            }) {
+                Ok(result) => result,
+                Err(fallback) => fallback(),
+            };
+        }
+    }
+    let _ = (placement, query, points, pool);
+    call()
+}
