+#[test]
+fn completed_source_replay_writes_destination_addresses_and_orientation() {
+    let (partial, _) = parameters(3);
+    let n = 7 * 3 + partial;
+    let plan = fixture(3, n, &vec![Vec::new(); n], false);
+    let encode = |base: usize, normal: bool| {
+        let mut task = vec![0; 3 * n];
+        for k in 3..n {
+            // Source and destination occupy different ranges, with distinct
+            // mappings for temporary inputs, constraint rows and output wires.
+            let [f, m, l] = positions(3, partial, k);
+            task[f] = EMIT_MARK | if normal { EMIT_NORMAL } else { 0 } | (base + k) as u32;
+            task[m] = pack_three([base + 3 * k, base + 3 * k + 1, base + 3 * k + 2]).unwrap();
+            task[l] = pack_three([base + n + 3 * k, base + n + 3 * k + 1, base + n + 3 * k + 2]).unwrap();
+        }
+        task
+    };
+    let source = encode(0, true);
+    let destination = encode(4 * n, false);
+    for materialize in [false, true] {
+        let mut w = vec![Fr::ZERO; 8 * n];
+        let mut a = vec![Fr::ZERO; 7 * n];
+        let mut b = a.clone();
+        let mut c = a.clone();
+        let view = View {
+            w: w.as_mut_ptr(),
+            a: a.as_mut_ptr(),
+            b: b.as_mut_ptr(),
+            c: if materialize { c.as_mut_ptr() } else { core::ptr::null_mut() },
+            completed_poseidon: core::ptr::null(),
+        };
+        for k in 3..n {
+            let x = Fr::from(k as u64) - Fr::from(4u64);
+            unsafe { plan.emit_poseidon(&source, 3, partial, k, x, view) };
+        }
+        unsafe { plan.replay_poseidon(&destination, &source, partial, view) };
+        for k in 3..n {
+            let x = Fr::from(k as u64) - Fr::from(4u64);
+            let square = x * x;
+            let fourth = square * square;
+            let fifth = fourth * x;
+            let base = 4 * n;
+            let row = base + 3 * k;
+            let wire = base + n + 3 * k;
+            assert_eq!(w[base + k], x);
+            assert_eq!(w[wire..wire + 3], [square, fourth, fifth]);
+            assert_eq!(a[row..row + 3], [x, square, fourth]);
+            assert_eq!(b[row..row + 3], [x, square, x]);
+            assert_eq!(c[row..row + 3], if materialize { [square, fourth, fifth] } else { [Fr::ZERO; 3] });
+        }
+    }
+}
