@@ -0,0 +1,97 @@
+//! Borrow completed span outputs from the current proof's solution arrays.
+use super::{constants::parameters, Fr};
+use std::{
+    hash::BuildHasher,
+    sync::{
+        atomic::{AtomicUsize, Ordering},
+        Mutex, OnceLock,
+    },
+};
+
+const SLOTS: usize = 256;
+
+#[derive(Clone, Copy)]
+pub(super) struct Entry {
+    state: [Fr; 3],
+    task: *const u32,
+}
+
+// The pointer refers to immutable schedule storage owned by the Plan, which
+// outlives the cache and all workers. Only completed spans are published.
+unsafe impl Send for Entry {}
+
+pub(crate) struct CompletedSpans {
+    hash: ahash::RandomState,
+    slots: Vec<Mutex<Option<Entry>>>,
+    hits: Option<AtomicUsize>,
+    _memory: crate::preparation::Reservation,
+}
+
+pub(super) const fn span_len() -> usize {
+    // Width three has 57 partial rounds in the recognized permutation.
+    3 * (7 * 3 + 57)
+}
+
+impl CompletedSpans {
+    pub(crate) fn new() -> Option<Self> {
+        static ENABLED: OnceLock<bool> = OnceLock::new();
+        if !*ENABLED.get_or_init(|| std::env::var_os("ZOPRO_TRIAL_POSEIDON_SOURCES").is_some()) {
+            return None;
+        }
+        debug_assert_eq!(span_len(), 3 * (7 * 3 + parameters(3).0));
+        let bytes = SLOTS * std::mem::size_of::<Mutex<Option<Entry>>>();
+        let memory = crate::preparation::Reservation::analysis(Some(bytes))?;
+        let mut slots = Vec::new();
+        slots.try_reserve_exact(SLOTS).ok()?;
+        slots.resize_with(SLOTS, || Mutex::new(None));
+        Some(Self {
+            hash: ahash::RandomState::new(),
+            slots,
+            hits: std::env::var_os("ZOPRO_TRIAL_POSEIDON_SOURCE_TRACE")
+                .map(|_| AtomicUsize::new(0)),
+            _memory: memory,
+        })
+    }
+
+    pub(super) fn index(&self, state: &[Fr; 3]) -> usize {
+        let words = state.map(|v| v.0);
+        self.hash.hash_one(words) as usize & (SLOTS - 1)
+    }
+
+    pub(super) fn lookup(&self, index: usize, state: &[Fr; 3]) -> Option<Entry> {
+        let entry = (*self.slots[index].try_lock().ok()?)?;
+        if &entry.state != state {
+            return None;
+        }
+        if let Some(hits) = &self.hits {
+            hits.fetch_add(1, Ordering::Relaxed);
+        }
+        Some(entry)
+    }
+
+    /// Caller has finished writing this recognized span into the single-writer
+    /// solution arrays. The task storage must belong to the enclosing Plan.
+    pub(super) unsafe fn publish(&self, index: usize, state: [Fr; 3], task: &[u32]) {
+        if let Ok(mut entry) = self.slots[index].try_lock() {
+            if entry.is_none() {
+                *entry = Some(Entry {
+                    state,
+                    task: task.as_ptr(),
+                });
+            }
+        }
+    }
+
+    pub(crate) fn report(&self) {
+        if let Some(hits) = &self.hits {
+            eprintln!("POSEIDON_SOURCE_REUSE {}", hits.load(Ordering::Relaxed));
+        }
+    }
+}
+
+impl Entry {
+    /// The caller is inside the same execution that owns the immutable schedule.
+    pub(super) unsafe fn task<'solve>(&self) -> &'solve [u32] {
+        unsafe { core::slice::from_raw_parts(self.task, span_len()) }
+    }
+}
