+pub(super) fn h_window_trial(
+    points: usize, bits: usize, parts: usize, signed: bool, main: usize, front: usize,
+) -> Option<usize> {
+    let profile = one::<G1Config>(points, bits, parts, signed)?;
+    // Include both pools at their complete per-worker bound and the additional
+    // indexed result vector. The admission stays live through the final fold.
+    let windows = (Fr::MODULUS_BITS as usize + usize::from(signed)).div_ceil(bits);
+    let ordered = vector::<Option<Projective<G1Config>>>(windows, false)?;
+    add(add(profile.held, ordered)?, mul(profile.leaf, add(main, front)?)?)
