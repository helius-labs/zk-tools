+use super::{msm_affine, preparation::Reservation, Fr, G2Affine, G2Projective};
+use rayon::prelude::*;
+
+pub(super) struct Groups {
+    upper: Option<Box<Groups>>,
+    ids: Vec<u32>,
+    ends: Vec<usize>,
+    sums: Vec<G2Affine>,
+    sources: Vec<u32>,
+    _held: Reservation,
+}
+
+fn u32at(bytes: &[u8], offset: usize) -> u32 {
+    u32::from_le_bytes(bytes[offset..offset + 4].try_into().unwrap())
+}
+
+impl Groups {
+    pub fn prepare(bases: &[G2Affine], data: &[u8]) -> Result<Option<Self>, &'static str> {
+        if data.starts_with(b"ZPNEST17") {
+            let size_bytes = data.get(8..16).ok_or("missing nested group size")?;
+            let size = usize::try_from(u64::from_le_bytes(size_bytes.try_into().unwrap())).map_err(|_|"nested group size overflow")?;
+            let (lower, upper) = data[16..].split_at_checked(size).ok_or("truncated nested group plan")?;
+            if !lower.starts_with(b"ZPGR0482") || !upper.starts_with(b"ZPGR0482") {return Err("invalid nested group levels");}
+            let Some(mut first) = Self::prepare_flat(bases,lower)? else {return Ok(None);};
+            first.upper=Self::prepare_flat(&first.sums,upper)?.map(Box::new);
+            return Ok(Some(first));
+        }
+        Self::prepare_flat(bases,data)
+    }
+
+    fn prepare_flat(bases: &[G2Affine], data: &[u8]) -> Result<Option<Self>, &'static str> {
+        if data.len() < 16 || &data[..8] != b"ZPGR0482" || u32at(data, 8) as usize != bases.len() {
+            return Err("invalid group dimensions");
+        }
+        let n = bases.len();
+        let count = u32at(data, 12) as usize;
+        if count == 0 || count > n / 2 || data.len() % 4 != 0 { return Err("invalid group count"); }
+        let members = (data.len() - 16) / 4;
+        let members = members.checked_sub(count).filter(|m| *m <= n && *m >= 2*count).ok_or("invalid member count")?;
+        // All member and remaining indices together occupy four bytes per key point.
+        let Some(held) = Reservation::analysis(n.checked_mul(4).and_then(|b| b.checked_add((count+n-members)*132 + count*8 + 512))) else { return Ok(None) };
+        let Some(_scratch) = Reservation::analysis(n.checked_add(data.len()).and_then(|x|x.checked_add(128 * rayon::current_num_threads() * 1024))) else {return Ok(None)};
+        let mut seen = vec![false; n];
+        let mut ids = Vec::with_capacity(members);
+        let mut ends = Vec::with_capacity(count);
+        let mut at = 16;
+        for _ in 0..count {
+            if at+4 > data.len() { return Err("missing group"); }
+            let len = u32at(data, at) as usize; at += 4;
+            if len < 2 || len > (data.len()-at)/4 { return Err("invalid group size"); }
+            for _ in 0..len {
+                let id=u32at(data, at); at += 4;
+                let flag = seen.get_mut(id as usize).ok_or("invalid B2 index")?;
+                if *flag {return Err("duplicate B2 index");}
+                *flag=true; ids.push(id);
+            }
+            ends.push(ids.len());
+        }
+        if at != data.len() {return Err("trailing group records");}
+        let mut sources=Vec::with_capacity(count+n-members);
+        for g in 0..count {
+            let start=if g==0 {0} else {ends[g-1]};
+            sources.push(ids[start]);
+        }
+        sources.extend((0..n).filter(|i| !seen[*i]).map(|i|i as u32));
+        let mut sums=vec![G2Affine::IDENTITY;sources.len()];
+        sums[..count].par_chunks_mut(128).enumerate().for_each(|(block,out)| {
+            let projective: Vec<_> = (block*128..block*128+out.len()).map(|g| {
+                let start=if g==0 {0} else {ends[g-1]};
+                let mut sum=G2Projective::IDENTITY;
+                for &i in &ids[start..ends[g]] {sum+=bases[i as usize];}
+                sum
+            }).collect();
+            out.copy_from_slice(&G2Projective::batch_to_affine(&projective));
+        });
+        sums[count..].par_iter_mut().zip(&sources[count..]).for_each(|(p,&i)|*p=bases[i as usize]);
+        Ok(Some(Self {upper:None, ids, ends, sources, sums, _held:held}))
+    }
+
+    fn members(&self, g:usize) -> &[u32] {
+        let start=if g==0 {0} else {self.ends[g-1]};
+        &self.ids[start..self.ends[g]]
+    }
+
+    fn choose(&self, rows: &[u32], scalars: &[Fr], adaptive: bool) -> (u32, u32) {
+        let first = rows[0];
+        let initial = scalars[first as usize];
+        let differences = rows[1..].iter().filter(|&&i| scalars[i as usize] != initial).count();
+        if !adaptive || differences * 2 <= rows.len() {
+            return (first, differences as u32);
+        }
+
+        let mut representative = first;
+        let mut balance = 0;
+        for &index in rows {
+            if balance == 0 {
+                representative = index;
+                balance = 1;
+            } else if scalars[index as usize] == scalars[representative as usize] {
+                balance += 1;
+            } else {
+                balance -= 1;
+            }
+        }
+        let alternative = scalars[representative as usize];
+        if balance > 0 && alternative != initial {
+            let count = rows.iter().filter(|&&i| scalars[i as usize] != alternative).count();
+            if count < differences {
+                return (representative, count as u32);
+            }
+        }
+        (first, differences as u32)
+    }
+
+    pub fn query(&self, bases:&[G2Affine], scalars:&[Fr]) -> Option<G2Projective> {
+        if std::env::var_os("ZOPRO_GROUP_SAMPLE").is_some() {
+            let samples=self.ends.len().min(32);
+            let mut mismatches=0;
+            let mut members=0;
+            for bucket in 0..samples {
+                let g=(2*bucket+1)*self.ends.len()/(2*samples);
+                let rows=self.members(g);
+                let representative=scalars[rows[0] as usize];
+                members+=rows.len()-1;
+                mismatches+=rows[1..].iter().filter(|&&i|scalars[i as usize]!=representative).count();
+            }
+            if mismatches*4>members {
+                if std::env::var_os("ZOPRO_GROUP_PROBE").is_some() {eprintln!("GROUP_SKIP {} {} {}",scalars.len(),mismatches,members);}
+                return None;
+            }
+        }
+        let adaptive = std::env::var_os("ZOPRO_ADAPTIVE_CORRECTIONS").is_some();
+        let _flags=Reservation::analysis(self.ends.len().checked_mul(8)?.checked_add(256))?;
+        let choices: Vec<(u32,u32)> = (0..self.ends.len()).into_par_iter()
+            .map(|g| self.choose(self.members(g), scalars, adaptive)).collect();
+        let count:usize=choices.iter().map(|&(_,count)|count as usize).sum();
+        if count>self.ids.len()/16 { return None; }
+        let _scratch=Reservation::analysis(count.checked_mul(160)?.checked_add(self.sources.len()*32+512))?;
+        if std::env::var_os("ZOPRO_GROUP_PROBE").is_some() {
+            eprintln!("GROUP_QUERY {} {} {}",scalars.len(),self.sources.len(),count);
+        }
+        let (main,extra)=rayon::join(|| {
+            if let Some(upper)=&self.upper {
+                let mut representatives:Vec<Fr>=self.sources.par_iter().enumerate().map(|(g,&source)| {
+                    let index=choices.get(g).map_or(source,|c|c.0);
+                    scalars[index as usize]
+                }).collect();
+                if let Some(result)=upper.query(&self.sums,&representatives) {
+                    if std::env::var_os("ZOPRO_GROUP_PROBE").is_some() { eprintln!("NESTED_UPPER_COMPACT {}",self.sums.len()); }
+                    return result;
+                }
+                if std::env::var_os("ZOPRO_GROUP_PROBE").is_some() { eprintln!("NESTED_UPPER_DENSE {}",self.sums.len()); }
+                return msm_affine::g2_query_exclusive(&self.sums,msm_affine::canonical_exclusive(&mut representatives));
+            }
+            let mut words:Vec<_>=self.sources.par_iter().enumerate().map(|(g,&source)| {
+                let index = choices.get(g).map_or(source, |c| c.0);
+                scalars[index as usize].to_canonical()
+            }).collect();
+            msm_affine::g2_query_exclusive(&self.sums,&mut words)
+        },|| {
+            if count==0 {return G2Projective::IDENTITY;}
+            let mut points=Vec::with_capacity(count);
+            let mut words=Vec::with_capacity(count);
+            for (g,&(selected,diff)) in choices.iter().enumerate() {
+                if diff==0 {continue;}
+                let members=self.members(g);
+                let rep=scalars[selected as usize];
+                for &i in members {
+                    let s=scalars[i as usize];
+                    if s!=rep {points.push(bases[i as usize]);words.push((s-rep).to_canonical());}
+                }
+            }
+            if adaptive && count>=256 {msm_affine::g2_query_exclusive(&points,&mut words)} else {super::msm_raw_b2(&points,&words)}
+        });
+        Some(main+extra)
+    }
+}
