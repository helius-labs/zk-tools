+fn sum_group_chunks<C: CurveConfig, F: Fn(u32) -> Affine<C> + Sync>(
+    get: &F,
+    order: &[u32],
+) -> Affine<C>
+where
+    C::Base: BatchInverse,
+{
+    let partials: Vec<_> = order.par_chunks(GROUP_SPLIT_TILE).map(|chunk| {
+        let mut points: Vec<_> = chunk.iter().map(|&index| limbs::<C>(get(index))).collect();
+        let mut count = [points.len()];
+        let mut scratch = Scratch::<C>::default();
+        while count[0] > 1 {
+            reduce_layer(&mut points, &[0], &mut count, &mut scratch);
+        }
+        affine::<C>(points[0])
+    }).collect();
+    let mut sum = Projective::<C>::IDENTITY;
+    for partial in partials {
+        sum += partial;
+    }
+    sum.to_affine()
 }
 
