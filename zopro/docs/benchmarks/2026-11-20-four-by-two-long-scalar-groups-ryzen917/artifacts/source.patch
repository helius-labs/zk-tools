+#[cfg(test)]
+mod split_group_tests {
+    use super::*;
+
+    fn compare<C: CurveConfig>() where C::Base: BatchInverse {
+        let generator = Projective::<C>::generator();
+        let p = generator.to_affine();
+        let q = (generator.double() + p).to_affine();
+        let points = [p, -p, q, Affine::<C>::IDENTITY, -q];
+        let counts = [0, 1, GROUP_SPLIT_MIN - 1, GROUP_SPLIT_MIN,
+                      GROUP_SPLIT_MIN + 3, 0, 2*GROUP_SPLIT_MIN + 1, 1];
+        let mut starts = vec![0];
+        for n in counts {
+            starts.push(starts.last().unwrap() + n);
+        }
+        let order: Vec<u32> = (0..*starts.last().unwrap())
+            .map(|i| ((i * (i % 3 + 1)) % points.len()) as u32).collect();
+        let get = |index| points[index as usize];
+        let expected: Vec<_> = starts.windows(2).map(|span| {
+            let mut sum = Projective::<C>::IDENTITY;
+            for &i in &order[span[0]..span[1]] {
+                sum += get(i);
+            }
+            sum.to_affine()
+        }).collect();
+        for threads in [1, 4] {
+            let pool = rayon::ThreadPoolBuilder::new().num_threads(threads).build().unwrap();
+            let got = pool.install(|| group_affine_impl(get, &order, &starts, &counts, true));
+            let ordinary = pool.install(|| group_affine_impl(get, &order, &starts, &counts, false));
+            assert_eq!(got, expected);
+            assert_eq!(ordinary, expected);
+        }
+    }
+
+    #[test]
+    fn long_class_shards_match_complete_curve_addition() {
+        compare::<zopro_bn254::G1Config>();
+        compare::<zopro_bn254::G2Config>();
+    }
