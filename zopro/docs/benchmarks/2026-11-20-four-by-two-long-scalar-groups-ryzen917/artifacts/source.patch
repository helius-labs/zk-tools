+const GROUP_SPLIT_TILE: usize = 512;
+const GROUP_SPLIT_MIN: usize = 2 * GROUP_SPLIT_TILE;
+
+fn split_group_admission<C: CurveConfig>(
+    terms: usize,
+    counts: &[usize],
+) -> Option<crate::preparation::Reservation>
+where
+    C::Base: BatchInverse,
+{
+    use std::sync::OnceLock;
+    static SELECT: OnceLock<(bool, bool, bool)> = OnceLock::new();
+    let (g1, g2, trace) = *SELECT.get_or_init(|| {
+        let mode = std::env::var("ZOPRO_917_GROUP_SPLIT").ok();
+        let g1 = matches!(mode.as_deref(), Some("both" | "g1"));
+        let g2 = matches!(mode.as_deref(), Some("both" | "g2"));
+        (g1, g2, std::env::var_os("ZOPRO_917_GROUP_TRACE").is_some())
+    });
+    let is_g2 = core::mem::size_of::<C::Base>() > 32;
+    let requested = if is_g2 { g2 } else { g1 };
+    if !requested && !trace {
+        return None;
+    }
+    let eligible = counts.iter().filter(|&&length| length >= GROUP_SPLIT_MIN);
+    let shards = eligible.clone().map(|&length| length.div_ceil(GROUP_SPLIT_TILE)).sum::<usize>();
+    let peak = if requested && shards != 0 {
+        let workers = rayon::current_num_threads().min(shards);
+        let per_point = core::mem::size_of::<LimbPoint<C::Base>>() +
+            core::mem::size_of::<usize>() +
+            core::mem::size_of::<Group<C::Base>>().div_ceil(2 * LANES) +
+            2 * core::mem::size_of::<FqBatch>().div_ceil(LANES);
+        GROUP_SPLIT_TILE.checked_mul(per_point)
+            .and_then(|bytes| bytes.checked_mul(workers))
+            .and_then(|bytes| {
+                shards.checked_mul(core::mem::size_of::<Affine<C>>())
+                    .and_then(|roots| bytes.checked_add(roots))
+            })
+    } else {
+        None
+    };
+    let reservation = crate::preparation::Reservation::analysis(peak);
+    if trace {
+        let curve = if is_g2 { "g2" } else { "g1" };
+        eprintln!("ZP917_GROUP {curve} {terms} {} {} {} {shards} {} {}",
+                  counts.len(), counts.iter().copied().max().unwrap_or(0),
+                  eligible.count(), peak.unwrap_or(0), reservation.is_some());
+    }
+    reservation
+}
