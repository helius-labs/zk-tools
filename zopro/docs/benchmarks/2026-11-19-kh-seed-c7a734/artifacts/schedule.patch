+// Finish a few real K/H windows before publishing A to the worker pool.
+pub(crate) fn seeded<C, A, T>(
+    k: &[Affine<C>],
+    sk: &[[u64; 4]],
+    h: &[Affine<C>],
+    sh: &[[u64; 4]],
+    seed: usize,
+    compute_a: A,
+) -> (T, Projective<C>)
+where
+    C: CurveConfig<Base = Fq>,
+    A: FnOnce() -> T + Send,
+    T: Send,
+{
+    let cover = spans();
+    let mut sums = [Projective::<C>::IDENTITY; COUNT];
+    let (initial, pending) = sums.split_at_mut(seed);
+    let (initial_spans, pending_spans) = cover.split_at(seed);
+    let compute = |(sum, &span): (&mut Projective<C>, &Span)| {
+        let size = batch_size(span.width).max(32);
+        let mut state = Window::new(1usize << (span.width - 1), size);
+        feed(&mut state, k, sk, span, size);
+        feed(&mut state, h, sh, span, size);
+        *sum = crate::msm::weighted_affine(&state.finish());
+    };
+    initial.par_iter_mut().zip(initial_spans).for_each(compute);
+    let (a, ()) = rayon::join(compute_a, || {
+        pending.par_iter_mut().zip(pending_spans).for_each(compute);
+    });
+    let mut kh = Projective::<C>::IDENTITY;
+    for (span, sum) in cover.iter().zip(&sums).rev() {
+        for _ in 0..span.width {
+            kh = kh.double();
+        }
+        kh += sum;
+    }
+    (a, kh)
 }
 
