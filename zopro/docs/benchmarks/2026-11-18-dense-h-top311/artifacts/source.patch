+pub(super) fn top_partition_growth<C: CurveConfig>(n: usize, bits: usize, groups: usize) -> Option<usize>
+where C::Base: BatchInverse {
+    let one = top::<C>(n, bits)?;
+    let part = top::<C>(n.div_ceil(groups), bits)?;
+    let held = mul(part.held, groups)?.saturating_sub(one.held);
+    let leaf = mul(part.leaf.saturating_sub(one.leaf), rayon::current_num_threads())?;
+    add(add(held, leaf)?, vector::<Projective<C>>(groups, false)?)
+}
