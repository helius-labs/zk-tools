+fn partitioned_top<C: CurveConfig>(bases: &[Affine<C>], scalars: &[[u64; 4]], w: usize, bits: usize, groups: usize) -> Projective<C>
+where C::Base: BatchInverse {
+    (0..groups).into_par_iter().map(|part| {
+        // Divide the remainder evenly so that all eligible slices have at least 1024 points.
+        let len = bases.len() / groups;
+        let extra = bases.len() % groups;
+        let first = len * part + part.min(extra);
+        let end = first + len + usize::from(part < extra);
+        indexed_top_sum::<C, false>(&bases[first..end], &scalars[first..end], w, bits, Fr::MODULUS_BITS as usize - w * bits)
