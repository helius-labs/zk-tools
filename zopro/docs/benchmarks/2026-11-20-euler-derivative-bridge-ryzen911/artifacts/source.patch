+fn transform(
+    plan: &Plan,
+    values: &mut [PackedPair],
+    level: usize,
+    first: usize,
+    schedule: Schedule,
+) {
+    if values.len() <= 1024 {
+        return leaf(plan, values, level, first);
+    }
+    columns::<false>(values, &plan.inverse_roots, level, schedule);
+    inner_columns(plan, values, level, first, schedule);
+    columns::<true>(values, &plan.roots, level, schedule);
+}
