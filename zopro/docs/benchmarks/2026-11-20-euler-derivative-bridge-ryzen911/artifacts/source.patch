+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum Schedule {
+    Fixed,
+    Adaptive,
+    Bridge,
+}
+
+impl Schedule {
+    fn selected() -> Self {
+        static MODE: std::sync::OnceLock<Schedule> = std::sync::OnceLock::new();
+        *MODE.get_or_init(|| match std::env::var("ZOPRO_911_WIDE_PASSES").as_deref() {
+            Ok("adaptive") => Self::Adaptive,
+            Ok("bridge") => Self::Bridge,
+            _ => Self::Fixed,
+        })
+    }
+
+    fn tile(self, width: usize, workers: usize) -> usize {
+        match self {
+            Self::Fixed => 32,
+            _ => (width / workers.max(1).next_power_of_two()).clamp(1, 32),
+        }
+    }
+}
