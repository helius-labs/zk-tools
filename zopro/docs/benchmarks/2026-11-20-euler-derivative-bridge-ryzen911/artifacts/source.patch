+// Complete the outer forward transform for B, emit A*D(B), and feed
+// the original A lanes through their first five inverse layers.
+fn bridge_range(
+    plan: &Plan,
+    mut workspace: [&mut [PackedPair]; 32],
+    mut a: [&mut [Fr]; 32],
+    start: usize,
+    width: usize,
+    tile: usize,
+) {
+    let count = workspace[0].len();
+    if count > tile {
+        let mid = count / 2;
+        let left_workspace = core::array::from_fn(|i| {
+            let (left, right) = core::mem::take(&mut workspace[i]).split_at_mut(mid);
+            workspace[i] = right;
+            left
+        });
+        let left_a = core::array::from_fn(|i| {
+            let stripe = core::mem::take(&mut a[i]);
+            let (left, right) = stripe.split_at_mut((8 * mid).min(stripe.len()));
+            a[i] = right;
+            left
+        });
+        rayon::join(
+            || bridge_range(plan, left_workspace, left_a, start, width, tile),
+            || bridge_range(plan, workspace, a, start + mid, width, tile),
+        );
+        return;
+    }
+    for column in 0..count {
+        let mut values: [Pair; 32] = core::array::from_fn(|i| workspace[i][column].load());
+        column_butterflies::<true>(&mut values, &plan.roots, 0, start + column, width);
+        for (value, stripe) in values.iter_mut().zip(&mut a) {
+            if let Some(out) = stripe.get_mut(8 * column..) {
+                let rows = out.len().min(8);
+                let out = &mut out[..rows];
+                let original = load(out, 0);
+                let product = value.mul(&original).get();
+                out.copy_from_slice(&product[..rows]);
+                *value = original;
+            } else {
+                *value = Pair::zero();
+            }
+        }
+        column_butterflies::<false>(&mut values, &plan.inverse_roots, 0, start + column, width);
+        for (stripe, value) in workspace.iter_mut().zip(values) {
+            stripe[column] = PackedPair::store(value);
+        }
+    }
+}
+
+fn bridge_derivatives(
+    plan: &Plan,
+    workspace: &mut [PackedPair],
+    mut a: &mut [Fr],
+    schedule: Schedule,
+) {
+    let width = workspace.len() / 32;
+    let tile = schedule.tile(width, rayon::current_num_threads());
+    columns::<false>(workspace, &plan.inverse_roots, 0, schedule);
+    inner_columns(plan, workspace, 0, 0, schedule);
+    let mut stripes = workspace.chunks_exact_mut(width);
+    let stripes = core::array::from_fn(|_| stripes.next().unwrap());
+    let output = core::array::from_fn(|_| {
+        let count = a.len().min(8 * width);
+        let (stripe, tail) = core::mem::take(&mut a).split_at_mut(count);
+        a = tail;
+        stripe
+    });
+    debug_assert!(a.is_empty());
+    bridge_range(plan, stripes, output, 0, width, tile);
+    inner_columns(plan, workspace, 0, 0, schedule);
+    columns::<true>(workspace, &plan.roots, 0, schedule);
 }
 
