+#[cfg(test)]
+#[test]
+fn bridge_matches_fixed_on_different_nonzero_prefixes() {
+    let n = 32768;
+    let root = Fr::root_of_unity(n).unwrap().pow(&[3]);
+    let coset = Fr::from(5u64);
+    let mut plan = Plan::new(n, root, coset, denominator(n, coset).unwrap());
+    plan.prepare_euler_basis();
+    let mut rng = crate::testing::Seeded::new(0x9191_7231_0091);
+    let a: Vec<_> = (0..n).map(|_| rng.fr()).collect();
+    let b: Vec<_> = (0..n).map(|_| rng.fr()).collect();
+    for workers in [1, 5, 24] {
+        let pool = rayon::ThreadPoolBuilder::new()
+            .num_threads(workers)
+            .build()
+            .unwrap();
+        pool.install(|| {
+            for (la, lb) in [(3, n - 5), (n / 2 + 7, n / 3), (n * 3 / 4 - 1, n - 3)] {
+                let expected = run_product(&plan, a[..la].to_vec(), &b[..lb], Schedule::Fixed);
+                let actual = run_product(&plan, a[..la].to_vec(), &b[..lb], Schedule::Bridge);
+                assert_eq!(actual, expected, "workers={workers} lengths={la},{lb}");
+            }
+        });
+    }
+}
