+#[inline(always)]
+fn column_butterflies<const FORWARD: bool>(
+    values: &mut [Pair; 32],
+    roots: &Twiddles,
+    level: usize,
+    column: usize,
+    width: usize,
+) {
+    for order in 0..5 {
+        let stage = if FORWARD { 4 - order } else { order };
+        let gap = 16 >> stage;
+        let layer = &roots.layers[level + stage];
+        for block in values.chunks_exact_mut(2 * gap) {
+            let (lo, hi) = block.split_at_mut(gap);
+            for j in 0..gap {
+                let w = root(layer, j * width + column);
+                (lo[j], hi[j]) = apply_pair::<FORWARD>(lo[j], hi[j], &w);
+            }
+        }
+    }
+}
