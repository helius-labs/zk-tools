+/// Extra conservative workspace for evaluating weighted partials concurrently.
+#[cfg(all(zopro_resource_schedule, zopro_g2_horner_buckets))]
+pub(super) fn flat_weighted_g2_ranges_bytes(n: usize, bits: usize, parts: usize) -> Option<usize> {
+    use zopro_bn254::G2Projective;
+    let jobs = 127usize.div_ceil(bits).checked_mul(parts)?;
+    let state = hb_windows::<G2Config>(n, bits, parts)?;
+    // Each job may suspend with a weighted tree live. Reserve its full
+    // forecast instead of depending on how many Rayon workers are active.
+    let weights = crate::msm::workspace_weighted::<G2Config>(1 << (bits - 1))?;
+    add(
+        add(state.held, mul(add(state.leaf, weights)?, jobs)?)?,
+        vector::<G2Projective>(jobs, false)?,
     )
 }
 
