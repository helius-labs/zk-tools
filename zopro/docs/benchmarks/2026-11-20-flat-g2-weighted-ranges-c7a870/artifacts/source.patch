+#[cfg(zopro_resource_schedule)]
+fn try_flat_weighted_ranges(
+    bases: &[G2Affine],
+    short: &[[u64; 4]],
+    bits: usize,
+    parts: usize,
+) -> Option<G2Projective> {
+    let parts = match std::env::var("ZOPRO_TRIAL_G2_WEIGHTED_RANGES").as_deref() {
+        Ok("same") => parts,
+        Ok("double") => parts.checked_mul(2)?,
+        _ => return None,
+    };
+    // The additional live work is bounded by the shape of this small query.
+    if !(MIN_QUERY..MAX_QUERY).contains(&bases.len()) || !(2..=4).contains(&parts) {
+        return None;
+    }
+    let bytes = super::workspace::flat_weighted_g2_ranges_bytes(bases.len(), bits, parts)?;
+    let _scratch = crate::preparation::Reservation::analysis(Some(bytes))?;
+    if crate::simd::cpu_option("ZOPRO_TRIAL_G2_WEIGHTED_RANGES_TRACE") {
+        eprintln!("G2_WEIGHTED_RANGES {} {bits} {parts} {bytes}", bases.len());
+    }
+    Some(flat_weighted_ranges(bases, short, bits, parts))
+}
+
+#[cfg(zopro_resource_schedule)]
+fn flat_weighted_ranges(
+    bases: &[G2Affine],
+    short: &[[u64; 4]],
+    bits: usize,
+    parts: usize,
+) -> G2Projective {
+    assert_eq!(bases.len(), short.len());
+    let chunk = bases.len().div_ceil(parts);
+    let windows = 127usize.div_ceil(bits);
+    // Range weighting is linear. Return one projective point per job and
+    // release its affine buckets before combining with another point range.
+    let partials: Vec<_> = (0..windows * parts)
+        .into_par_iter()
+        .map(|job| {
+            let window = job / parts;
+            let part = job % parts;
+            let start = (part * chunk).min(bases.len());
+            let end = (start + chunk).min(bases.len());
+            let buckets = hb_window(&bases[start..end], &short[start..end], window, bits);
+            crate::msm::weighted_affine(&buckets)
+        })
+        .collect();
+    let mut result = G2Projective::IDENTITY;
+    for window in partials.chunks_exact(parts).rev() {
+        for _ in 0..bits {
+            result = result.double();
+        }
+        for &partial in window {
+            result += partial;
+        }
+    }
+    result
+}
