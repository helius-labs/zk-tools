+use super::{solver::Plan, words, Fr, G1Affine, G1Projective, G2Affine, G2Projective, Key};
+use crate::preparation::Reservation;
+use rayon::prelude::*;
+use sha2::{Digest, Sha256};
+use std::mem::size_of;
+
+const HEADER: usize = 48;
+const ROW: usize = 36;
+const WINDOWS: usize = 64;
+const BUCKETS: usize = 15;
+
+struct Row {
+    wire: usize,
+    scalar: Fr,
+}
+
+pub(super) struct Offsets {
+    rows: Vec<Row>,
+    pub a: G1Projective,
+    pub k: G1Projective,
+    pub b2: G2Projective,
+    _reservation: Reservation,
+}
+
+impl Offsets {
+    pub fn apply(&self, wires: &mut [Fr]) {
+        for row in &self.rows {
+            wires[row.wire] -= row.scalar;
+        }
+    }
+}
+
+#[derive(Clone, Copy)]
+struct Positions {
+    a: Option<usize>,
+    k: Option<usize>,
+    b2: usize,
+}
+
+fn u32_le(bytes: &[u8]) -> usize {
+    u32::from_le_bytes(bytes.try_into().unwrap()) as usize
+}
+
+fn entries(data: &[u8], n: usize) -> Result<&[u8], &'static str> {
+    if data.len() < HEADER || &data[..8] != b"ZPWO0001" {
+        return Err("invalid public wire offset header");
+    }
+    let count = u32_le(&data[44..48]);
+    let entries = &data[HEADER..];
+    if u32_le(&data[40..44]) != n || count == 0 || count > n ||
+        count.checked_mul(ROW) != Some(entries.len()) {
+        return Err("invalid public wire offset dimensions");
+    }
+    Ok(entries)
+}
+
+fn map_row(row: &[u8], plan: &Plan, private: usize) -> Result<(Positions, Row), &'static str> {
+    let b2 = u32_le(&row[..4]);
+    let wire = *plan.b_indices.get(b2).ok_or("public wire offset index exceeds B2")?;
+    let scalar = Fr::from_canonical(words(&row[4..])).ok_or("noncanonical public wire offset")?;
+    let k = (wire as usize).checked_sub(plan.n_public);
+    if scalar == Fr::ZERO || k.is_some_and(|i| i >= private) {
+        return Err("invalid public wire offset row");
+    }
+    Ok((Positions { a: plan.a_indices.binary_search(&wire).ok(), k, b2 }, Row {wire: wire as usize, scalar}))
+}
+
+type Sums = (G1Projective, G1Projective, G2Projective);
+const ZERO: Sums = (G1Projective::IDENTITY, G1Projective::IDENTITY, G2Projective::IDENTITY);
+
+fn correction(records: &[u8], positions: &[Positions], a: &[G1Affine], k: &[G1Affine], b2: &[G2Affine]) -> Sums {
+    let mut windows = [ZERO; WINDOWS];
+    windows.par_iter_mut().enumerate().for_each(|(window, sum)| {
+        let mut buckets = [ZERO; BUCKETS];
+        for (row, pos) in records.chunks_exact(ROW).zip(positions) {
+            let digit = (row[4 + window / 2] >> (4 * (window % 2))) & 15;
+            if digit != 0 {
+                let bucket = &mut buckets[usize::from(digit) - 1];
+                if let Some(i) = pos.a { bucket.0 += a[i]; }
+                if let Some(i) = pos.k { bucket.1 += k[i]; }
+                bucket.2 += b2[pos.b2];
+            }
+        }
+        let mut running = ZERO;
+        for bucket in buckets.iter().rev() {
+            running.0 += bucket.0;
+            running.1 += bucket.1;
+            running.2 += bucket.2;
+            sum.0 += running.0;
+            sum.1 += running.1;
+            sum.2 += running.2;
+        }
+    });
+    let mut total = ZERO;
+    for sum in windows.iter().rev() {
+        for _ in 0..4 {
+            total = (total.0.double(), total.1.double(), total.2.double());
+        }
+        total.0 += sum.0;
+        total.1 += sum.1;
+        total.2 += sum.2;
+    }
+    total
+}
+
+pub(super) fn prepare(key: &Key, data: &[u8]) -> Result<Option<Offsets>, &'static str> {
+    let records = entries(data, key.b2.len())?;
+    let count = records.len() / ROW;
+    let Some(plan) = key.solver.as_ref() else { return Ok(None) };
+    let Some(folded) = key.lagrange.as_ref().and_then(|q| q.folded.as_ref()) else { return Ok(None) };
+    if !key.canonical_wires || key.has_gpu() || key.a.len() != plan.a_indices.len() || key.b2.len() != plan.b_indices.len() {
+        return Ok(None);
+    }
+    let held = count.checked_mul(size_of::<Row>()).and_then(|n| n.checked_add(size_of::<Offsets>()));
+    let Some(reservation) = Reservation::analysis(held) else { return Ok(None) };
+    let leaves = rayon::current_num_threads().min(WINDOWS);
+    let windows = (WINDOWS + 8 + leaves * (BUCKETS + 8)) * size_of::<Sums>();
+    let scratch = count.checked_mul(size_of::<Positions>()).and_then(|n| n.checked_add(windows));
+    let Some(_temporary) = Reservation::analysis(scratch) else { return Ok(None) };
+    let mut digest = Sha256::new();
+    for p in &key.b2[..] {
+        for coord in [p.x.c0, p.x.c1, p.y.c0, p.y.c1] {
+            for limb in coord.0 { digest.update(limb.to_le_bytes()); }
+        }
+    }
+    if digest.finalize()[..] != data[8..40] { return Err("public wire offset B2 digest mismatch"); }
+    let mut rows = Vec::with_capacity(count);
+    let mut positions = Vec::with_capacity(count);
+    let mut previous = None;
+    for row in records.chunks_exact(ROW) {
+        let (p, r) = map_row(row, plan, folded.private.len())?;
+        if previous.is_some_and(|i| p.b2 <= i) { return Err("public wire offset indices must increase"); }
+        previous = Some(p.b2);
+        rows.push(r);
+        positions.push(p);
+    }
+    let (a,k,b2) = correction(records,&positions,&key.a,&folded.private,&key.b2);
+    Ok(Some(Offsets {rows, a, k, b2, _reservation: reservation}))
+}
