+//! Operation accounting for one diagnostic proof at a time.
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering::Relaxed};
+
+static CAPTURE: AtomicBool = AtomicBool::new(false);
+static METRICS: [AtomicU64; 24] = [const { AtomicU64::new(0) }; 24];
+
+pub(crate) fn begin() {
+    assert!(!CAPTURE.swap(true, Relaxed));
+    assert!(METRICS.iter().all(|m| m.load(Relaxed)==0));
+}
+
+pub(crate) fn end() {
+    assert!(CAPTURE.swap(false, Relaxed));
+    let values=METRICS.iter().map(|m| m.swap(0, Relaxed).to_string()).collect::<Vec<_>>();
+    eprintln!("ZP896_COUNTS {}", values.join(" "));
+}
+
+fn record<const N: usize>(offset: usize, values: [usize; N]) {
+    if CAPTURE.load(Relaxed) {
+        for (count, add) in METRICS[offset..offset+N].iter().zip(values) {
+            count.fetch_add(add as u64, Relaxed);
+        }
+    }
+}
+
+#[derive(Default)]
+pub(crate) struct Window {
+    pub(crate) terms: usize,
+    pub(crate) first: usize,
+    pub(crate) equal: usize,
+    pub(crate) opposite: usize,
+    pub(crate) spills: usize,
+    pub(crate) projective_adds: usize,
+    pub(crate) updates: usize,
+    pub(crate) batches: usize,
+    pub(crate) tails: usize,
+}
+
+impl Window {
+    pub(crate) fn batch(&mut self, n: usize) {
+        self.updates += n;
+        self.batches += 1;
+        self.tails += n % 8;
+    }
+
+    pub(crate) fn finish(&self, affine: usize, projective: usize) {
+        record(0, [1, affine, self.terms, self.first, self.equal, self.opposite, self.spills,
+                   self.projective_adds, self.updates, self.batches, self.tails, projective]);
+    }
+}
+
+pub(crate) fn merge(pairs: usize, exceptional: usize) {
+    record(12, [pairs, exceptional]);
+}
+
+pub(crate) fn tree_layer(pairs: usize, full: usize) {
+    record(14, [1, pairs, pairs-full]);
+}
+
+pub(crate) fn weighted(buckets: usize) {
+    record(17, [1, buckets]);
+}
+
+pub(crate) fn index(input: usize) {
+    record(19, [1, input]);
+}
+
+pub(crate) fn grouping(input: usize, terms: usize, classes: usize) {
+    record(21, [input, terms, classes]);
+}
