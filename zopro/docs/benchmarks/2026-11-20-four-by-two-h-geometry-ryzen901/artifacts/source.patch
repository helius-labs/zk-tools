+/// Complete two-range scratch forecast for the selected H geometry.
+pub(super) fn h_flex_trial(widths: &[usize], signed: bool, workers: usize) -> Option<usize> {
+    let mut held = vector::<Projective<G1Config>>(widths.len(), false)?;
+    let mut leaf = 0;
+    for &bits in widths {
+        let magnitude = bits.checked_sub(usize::from(signed))?;
+        let slots = 1usize.checked_shl(magnitude as u32)?;
+        let profile = shape::<G1Config>(slots, 1, 2, batch_size(magnitude + 1).max(32))?;
+        held = add(held, profile.held)?;
+        leaf = leaf.max(profile.leaf);
+    }
+    add(held, mul(leaf, workers)?)
 }
 
