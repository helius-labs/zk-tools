+
+/// Keep optional G1 point and reduction scratch inside the live proof budget.
+pub(crate) fn grouped_g1_pool_bytes(n: usize) -> Option<usize> {
+    let p = envelope::<G1Config>(n, true, false)?;
+    add(p.held, mul(p.leaf, rayon::current_num_threads())?)
