+#[cfg(not(target_arch = "wasm32"))]
+impl Key {
+    fn dispatch_grouped_g1<F>(&self, query: &str, terms: usize, work: F) -> G1Projective
+    where
+        F: FnOnce() -> G1Projective + Send,
+    {
+        #[cfg(all(zopro_resource_schedule, feature = "ifma8", target_os = "linux",
+            target_arch = "x86_64", target_feature = "avx512ifma",
+            target_feature = "avx512vl", target_feature = "avx512dq", not(no_ifma)))]
+        if std::env::var("ZOPRO_TRIAL_G1_FRONTEND").as_deref() == Ok(query) {
+            if let Some(pool) = self.frontend_pool.as_ref()
+                .filter(|pool| pool.current_num_threads() < rayon::current_num_threads())
+            {
+                // The helper returns an uncalled closure if memory admission fails.
+                let charged = pool.install(|| {
+                    let bytes = msm_affine::workspace::grouped_g1_pool_bytes(terms);
+                    match preparation::Reservation::analysis(bytes) {
+                        Some(_scratch) => {
+                            if std::env::var_os("ZOPRO_TRIAL_G1_FRONTEND_PROBE").is_some() {
+                                eprintln!("GROUP_G1_POOL {query} {terms} {} {}",
+                                    rayon::current_num_threads(), bytes.unwrap_or(0));
+                            }
+                            Ok(work())
+                        }
+                        None => Err(work),
+                    }
+                });
+                return match charged { Ok(sum) => sum, Err(unused) => unused() };
+            }
+        }
+        work()
+    }
+}
