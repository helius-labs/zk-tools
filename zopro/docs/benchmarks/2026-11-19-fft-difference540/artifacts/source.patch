+impl Ifma8<crate::FrConfig, false> {
+    /// Normalized R260 inputs are below 2p. The temporary delta is below
+    /// 4p and is used only in this product. REDC is below p + 8p²/R < 2p.
+    #[inline(always)]
+    pub fn difference_times(&self, b: &Self, root: &Self) -> Self {
+        unsafe {
+            let p = crate::FrConfig::P;
+            let twice = split(crate::portable::add4(p, p).0).map(Self::splat);
+            let mask = Self::splat(MASK);
+            let mut carry = Self::splat(0);
+            let digits = core::array::from_fn(|j| {
+                let biased = _mm512_add_epi64(twice[j], self.0[j]);
+                let value = _mm512_add_epi64(_mm512_sub_epi64(biased, b.0[j]), carry);
+                carry = _mm512_srai_epi64::<52>(value);
+                _mm512_and_si512(value, mask)
+            });
+            Self(digits, PhantomData).mul(root)
+        }
+    }
+}
