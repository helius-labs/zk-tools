+// Explicit outer boundaries for experiments. Invalid configurations do not
+// replace the ordinary schedule, and inner depths are left untouched.
+fn custom_boundaries(raw: &str, bands: usize, deepest: usize) -> Option<[u32; 3]> {
+    let mut result = [u32::MAX; 3];
+    let mut fields = raw.split(',');
+    let observed = bands.checked_sub(1)?;
+    if !(1..=result.len()).contains(&observed) {
+        return None;
+    }
+    let mut previous = 0;
+    for cutoff in &mut result[..observed] {
+        let next: u32 = fields.next()?.parse().ok()?;
+        if next <= previous || next as usize >= deepest {
+            return None;
+        }
+        *cutoff = next;
+        previous = next;
+    }
+    fields.next().is_none().then_some(result)
 }
 
