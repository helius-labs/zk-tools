+mod radix522_tests {
+    use super::*;
+
+    #[test]
+    fn scaled_euler_matches_full_product_across_lengths() {
+        for n in [256usize,8192,32768] {
+            let root=Fr::root_of_unity(n).unwrap().pow(&[3]);
+            let coset=Fr::from(5u64);
+            let mut plan=Plan::new(n,root,coset,denominator(n,coset).unwrap());
+            plan.prepare_euler_basis();
+            let sequence=|len,seed|{
+                let mut x= -Fr::from(seed);
+                (0..len).map(|i|{x=x.square()+Fr::from(i as u64+1); if i%19==0 {Fr::ZERO} else {x}}).collect::<Vec<_>>()
+            };
+            for (na,nb) in [(0,0),(1,0),(0,7),(n/2+3,n-11),(n,n)] {
+                let a=sequence(na,9u64);let b=sequence(nb,13u64);
+                let original=euler_scaled::<false,false,false>(&plan,a.clone(),b.clone());
+                assert_eq!(original,euler_scaled::<true,false,false>(&plan,a.clone(),b.clone()));
+                assert_eq!(original,euler_scaled::<false,true,false>(&plan,a.clone(),b.clone()));
+                assert_eq!(original,euler_scaled::<true,true,true>(&plan,a,b));
+            }
+        }
+    }
+}
