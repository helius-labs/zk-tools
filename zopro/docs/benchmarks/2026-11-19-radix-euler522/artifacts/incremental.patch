+    /// Normalize the unchanged limbs at radix R256, returning 16*x.
+    #[inline(always)]
+    pub fn export_times16(&self) -> [crate::Fr;8] {
+        Ifma8::<crate::FrConfig,true>(self.0,PhantomData).get()
+    }
