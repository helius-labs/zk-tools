+#[cfg(test)]
+#[test]
+fn typed_handoff_matches_raw_with_identical_blinding() {
+    use crate::verify::Proof;
+    let g1 = G1Affine::GENERATOR;
+    let g2 = G2Affine::GENERATOR;
+    let fixed = FixedPoints { alpha: g1, beta: g1, delta: g1, beta2: g2, delta2: g2 };
+    let prepared = PreparedFixedPoints::new(fixed);
+    let a = (g1 * Fr::from(8u64)).double();
+    let c = (g1 * Fr::from(13u64)).double();
+    let b = (g2 * Fr::from(19u64)).double();
+    let mut parts = Vec::new();
+    for value in [a, G1Projective::IDENTITY, c, G1Projective::IDENTITY] {
+        crate::output_g1(&mut parts, value);
+    }
+    crate::output_g2(&mut parts, b);
+    for u in [Fr::ONE, -Fr::ONE, Fr::from(13u64)] {
+        for v in [Fr::ZERO, -Fr::ONE, Fr::from(29u64)] {
+            let raw = prepared.rerandomized_with(&parts, u, v).unwrap();
+            for batch in [false, true] {
+                let direct = prepared.typed_outputs(a + g1, c, b + g2, u, v, batch).unwrap();
+                assert_eq!(direct, Proof::from_raw(&raw).unwrap());
+            }
+        }
+    }
+    assert!(prepared.typed_rerandomized(-g1.to_projective(), c, b, true).is_none());
+}
