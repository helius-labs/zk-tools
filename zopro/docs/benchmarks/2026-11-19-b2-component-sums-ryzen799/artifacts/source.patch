+#[cfg(zopro_g2_horner_buckets)]
+pub(super) fn split_components_growth(n: usize, bits: usize, ranges: usize) -> Option<usize> {
+    let component = hb_windows::<G2Config>(n, bits, ranges)?;
+    let before = raw::<G2Config>(n, false)?;
+    let held = mul(component.held, 2)?.saturating_sub(before.held);
+    let leaf = component.leaf.saturating_sub(before.leaf);
+    add(held, mul(leaf, rayon::current_num_threads())?)
 }
 
