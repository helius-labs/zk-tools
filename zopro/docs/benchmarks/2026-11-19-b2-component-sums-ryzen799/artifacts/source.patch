+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn split_components_matches_weighted_generator() {
+        let mut p = G2Projective::IDENTITY;
+        let mut w = Fr::from(79387166u64);
+        let mut points = Vec::new();
+        let mut short = Vec::new();
+        let mut expected = Fr::ZERO;
+        for i in 1..1301 {
+            p += G2Affine::GENERATOR;
+            w = w.square() + Fr::from(i);
+            let (mut point, mut weight) = (p.to_affine(), Fr::from(i));
+            if i % 19 == 0 {
+                point = G2Affine::IDENTITY;
+                weight = Fr::ZERO;
+            }
+            if i % 3 == 0 {
+                point = -point;
+                weight = -weight;
+            }
+            let s = if i % 7 == 0 {
+                Fr::ZERO
+            } else if i % 2 == 0 {
+                -w
+            } else {
+                w
+            };
+            expected += s * weight;
+            points.push(point);
+            short.push(phi_split(s.to_canonical()));
+        }
+        for workers in [1, 8] {
+            rayon::ThreadPoolBuilder::new()
+                .num_threads(workers)
+                .build()
+                .unwrap()
+                .install(|| {
+                    for (bits, ranges) in [(10, 1), (11, 2), (12, 3), (13, 2)] {
+                        assert_eq!(
+                            sum_split(&points, &short, bits, ranges).to_affine(),
+                            (G2Affine::GENERATOR * expected).to_affine()
+                        );
+                    }
+                });
+        }
+    }
+}
