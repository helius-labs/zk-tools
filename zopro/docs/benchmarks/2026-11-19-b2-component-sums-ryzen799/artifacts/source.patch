+use super::*;
+use std::sync::OnceLock;
+
+pub(crate) fn grouped(
+    bases: &[G2Affine],
+    groups: &super::super::ScalarGroups,
+) -> Option<G2Projective> {
+    static GEOMETRY: OnceLock<Option<(usize, usize)>> = OnceLock::new();
+    let (bits, ranges) = (*GEOMETRY.get_or_init(|| {
+        let text = std::env::var("ZOPRO_TRIAL_B2_COMPONENTS").ok()?;
+        let (bits, ranges) = text.split_once('x')?;
+        let bits = bits.parse().ok()?;
+        let ranges = ranges.parse().ok()?;
+        ((10..=13).contains(&bits) && (1..=3).contains(&ranges)).then_some((bits, ranges))
+    }))?;
+    if !(65_536..262_144).contains(&bases.len()) || !(1024..65536).contains(&groups.values.len()) {
+        return None;
+    }
+    let memory =
+        super::super::workspace::split_components_growth(groups.values.len(), bits, ranges);
+    let reservation = crate::preparation::Reservation::analysis(memory);
+    if std::env::var_os("ZOPRO_TRIAL_B2_COMPONENTS_TRACE").is_some() {
+        eprintln!(
+            "B2_PHI_COMPONENTS {} {bits}x{ranges} {}",
+            bases.len(),
+            reservation.is_some()
+        );
+    }
+    let _reservation = reservation?;
+    let (points, short): (_, Vec<_>) = rayon::join(
+        || crate::msm::group_affine(bases, &groups.order, &groups.starts, &groups.counts),
+        || {
+            groups
+                .values
+                .par_iter()
+                .with_min_len(256)
+                .map(|&word| phi_split(word))
+                .collect()
+        },
+    );
+    Some(sum_split(&points, &short, bits, ranges))
+}
+
+fn sum_split(bases: &[G2Affine], short: &[[u64; 4]], bits: usize, ranges: usize) -> G2Projective {
+    let (low, mut high) = rayon::join(
+        || component::<false>(bases, short, bits, ranges),
+        || component::<true>(bases, short, bits, ranges),
+    );
+    high.x = high.x.mul_by_fp(&BETA);
+    low + high
+}
+
+fn component<const HIGH: bool>(
+    bases: &[G2Affine],
+    short: &[[u64; 4]],
+    bits: usize,
+    ranges: usize,
+) -> G2Projective {
+    let windows = 127usize.div_ceil(bits);
+    let batch = batch_size(bits).max(32);
+    let part = bases.len().div_ceil(ranges);
+    let sums: Vec<_> = (0..windows)
+        .into_par_iter()
+        .map(|w| {
+            let leading = (w + 1 == windows)
+                .then(|| 126 - w * bits)
+                .filter(|&width| width <= 8);
+            let mut buckets: Vec<_> = bases
+                .par_chunks(part)
+                .zip(short.par_chunks(part))
+                .map(|(points, words)| {
+                    if let Some(top) = leading {
+                        return hb_top_component(points, words, HIGH, w, bits, top);
+                    }
+                    let digits = words.iter().map(|s| hb_digit(s, HIGH, w, bits));
+                    affine_buckets(super::super::fill_window(points, digits, bits, batch))
+                })
+                .collect();
+            let mut sum = buckets.swap_remove(0);
+            for other in buckets {
+                merge_buckets(&mut sum, &other);
+            }
+            crate::msm::weighted_affine(&sum)
+        })
+        .collect();
+    let mut sum = G2Projective::IDENTITY;
+    for part in sums.into_iter().rev() {
+        for _ in 0..bits {
+            sum = sum.double();
+        }
+        sum += part;
+    }
+    sum
+}
