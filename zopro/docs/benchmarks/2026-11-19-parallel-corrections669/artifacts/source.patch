+use super::{Fr, Reservation};
+use rayon::prelude::*;
+use std::ops::Index;
+
+struct Rows<'a, P, S: ?Sized> {
+    bases: &'a [P],
+    scalars: &'a S,
+    members: &'a [u32],
+    ends: &'a [usize],
+    choices: &'a [(u32, u32)],
+    tile: usize,
+}
+
+impl<P: Copy + Send + Sync, S: Index<usize, Output = Fr> + Sync + ?Sized> Rows<'_, P, S> {
+    fn fill(&self, first: usize, offsets: &[usize], points: &mut [P], words: &mut [[u64; 4]]) {
+        if points.is_empty() { return; }
+        if offsets.len() > 2 {
+            let mid = (offsets.len() - 1) / 2;
+            let boundary = offsets[mid] - offsets[0];
+            let (pl, pr) = points.split_at_mut(boundary);
+            let (wl, wr) = words.split_at_mut(boundary);
+            rayon::join(
+                || self.fill(first, &offsets[..=mid], pl, wl),
+                || self.fill(first + mid, &offsets[mid..], pr, wr),
+            );
+            return;
+        }
+        let begin = first * self.tile;
+        let end = (begin + self.tile).min(self.choices.len());
+        let mut position = 0;
+        for group in begin..end {
+            let (chosen, changed) = self.choices[group];
+            if changed == 0 { continue; }
+            let base = self.scalars[chosen as usize];
+            let start = if group == 0 { 0 } else { self.ends[group - 1] };
+            for &member in &self.members[start..self.ends[group]] {
+                let row = member as usize;
+                let value = self.scalars[row];
+                if value != base {
+                    points[position] = self.bases[row];
+                    words[position] = (value - base).to_canonical();
+                    position += 1;
+                }
+            }
+        }
+        assert_eq!(position, points.len());
+    }
+}
+
+pub(crate) fn collect<P, S>(
+    bases: &[P], scalars: &S, members: &[u32], ends: &[usize],
+    choices: &[(u32, u32)], count: usize, tile: usize,
+) -> Option<(Vec<P>, Vec<[u64; 4]>)>
+where P: Copy + Send + Sync, S: Index<usize, Output = Fr> + Sync + ?Sized {
+    if count == 0 { return Some((Vec::new(), Vec::new())); }
+    let tiles = choices.len().div_ceil(tile);
+    let _charge = Reservation::analysis(tiles.checked_add(1)?.checked_mul(size_of::<usize>()))?;
+    let mut offsets = vec![0usize; tiles + 1];
+    offsets[1..].par_iter_mut().zip(choices.par_chunks(tile))
+        .for_each(|(size, chunk)| *size = chunk.iter().map(|row| row.1 as usize).sum());
+    for i in 1..=tiles { offsets[i] += offsets[i - 1]; }
+    assert_eq!(offsets[tiles], count);
+    let mut points = vec![bases[0]; count];
+    let mut words = vec![[0; 4]; count];
+    Rows { bases, scalars, members, ends, choices, tile }.fill(0, &offsets, &mut points, &mut words);
+    Some((points, words))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn correction_rows_keep_the_original_order_across_empty_tiles() {
+        let n = 253;
+        let members: Vec<_> = (0..3*n as u32).rev().collect();
+        let ends: Vec<_> = (1..=n).map(|g| 3*g).collect();
+        let bases: Vec<_> = (0..3*n).collect();
+        let mut scalars = vec![Fr::ONE; bases.len()];
+        let mut choices = Vec::new();
+        let mut expected = (Vec::new(), Vec::new());
+        for (g, ids) in members.chunks_exact(3).enumerate() {
+            let chosen = ids[1];
+            let mut different = 0;
+            if g % 39 == 0 {
+                for (index, value) in [(ids[0], -Fr::ONE), (ids[2], Fr::ZERO)] {
+                    scalars[index as usize] = value;
+                    different += 1;
+                    expected.0.push(index as usize);
+                    expected.1.push((value-Fr::ONE).to_canonical());
+                }
+            }
+            choices.push((chosen, different));
+        }
+        for tile in [1, 13, 128, 256] {
+            assert_eq!(collect(&bases, &scalars[..], &members, &ends, &choices, expected.0.len(), tile).unwrap(), expected);
+        }
+    }
+}
