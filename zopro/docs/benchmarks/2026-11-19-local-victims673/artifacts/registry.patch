+#[cfg(test)]
+mod victim_domain_tests {
+    use super::VictimDomains;
+    #[test]
+    fn every_other_worker_is_probed_once_after_its_local_peers() {
+        for labels in [vec![0], vec![0, 1], vec![0, 0, 1, 2, 1, 0, 2], vec![7; 17]] {
+            let domains = VictimDomains::from_labels(&labels);
+            for worker in 0..labels.len() {
+                for start in 0..labels.len()+1 {
+                    let mut order = Vec::new();
+                    let result: Option<()> = domains.visit(worker, start, start+3, |w| { order.push(w); None });
+                    assert!(result.is_none());
+                    let boundary = order.iter().position(|&w| labels[w] != labels[worker]).unwrap_or(order.len());
+                    assert!(order[boundary..].iter().all(|&w| labels[w] != labels[worker]));
+                    order.sort_unstable();
+                    assert_eq!(order, (0..labels.len()).filter(|&w| w != worker).collect::<Vec<_>>());
+                }
+            }
+        }
+    }
