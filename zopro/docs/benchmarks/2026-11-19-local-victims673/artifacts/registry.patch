+struct VictimDomains {
+    workers: Vec<usize>,
+    ranges: Vec<std::ops::Range<usize>>,
+}
+
+impl VictimDomains {
+    fn from_labels(labels: &[usize]) -> Self {
+        let mut workers: Vec<_> = (0..labels.len()).collect();
+        workers.sort_unstable_by_key(|&worker| (labels[worker], worker));
+        let mut ranges = vec![0..0; workers.len()];
+        let mut lo = 0;
+        while lo < workers.len() {
+            let hi = lo + workers[lo..].partition_point(|&w| labels[w] == labels[workers[lo]]);
+            for &worker in &workers[lo..hi] {
+                ranges[worker] = lo..hi;
+            }
+            lo = hi;
+        }
+        Self { workers, ranges }
+    }
+
+    fn configured(threads: usize) -> Option<Self> {
+        let raw = std::env::var("ZOPRO_TRIAL_VICTIM_DOMAINS").ok()?;
+        let ids: Vec<usize> = raw.split(',').map(str::parse).collect::<Result<_, _>>().ok()?;
+        if ids.len() != threads || ids.iter().all(|&id| id == ids[0]) {
+            return None;
+        }
+        if std::env::var_os("ZOPRO_REPORT_VICTIM_DOMAINS").is_some() { eprintln!("VICTIM_DOMAINS {threads} {raw}"); }
+        Some(Self::from_labels(&ids))
+    }
+
+    fn visit<T>(&self, worker: usize, local_start: usize, remote_start: usize, mut probe: impl FnMut(usize) -> Option<T>) -> Option<T> {
+        let range = &self.ranges[worker];
+        let local = &self.workers[range.clone()];
+        let n_remote = self.workers.len() - local.len();
+        let local_start = local_start % local.len();
+        if let Some(job) = local[local_start..].iter().chain(&local[..local_start])
+            .copied().filter(|&id| id != worker).find_map(&mut probe) {
+            return Some(job);
+        }
+        if n_remote == 0 { return None; }
+        let remote_start = remote_start % n_remote;
+        (remote_start..n_remote).chain(0..remote_start).find_map(|i| {
+            let slot = if i < range.start { i } else { i + local.len() };
+            probe(self.workers[slot])
+        })
+    }
+}
