+#[cfg(test)]
+#[test]
+fn uniform_g2_classes_match_complete_group_reduction() {
+    use zopro_bn254::{Fr, G2Affine, G2Config};
+
+    let pool = rayon::ThreadPoolBuilder::new().num_threads(8).build().unwrap();
+    pool.install(|| for size in [4, 8] {
+        let counts = [vec![size; 257], vec![1, 3, size, 2]].concat();
+        let mut starts = vec![0];
+        for count in &counts {
+            starts.push(starts.last().unwrap() + count);
+        }
+        let n = *starts.last().unwrap();
+        let order: Vec<u32> = (0..n as u32).rev().collect();
+        let mut bases: Vec<G2Affine> = (0..n)
+            .map(|i| (G2Affine::GENERATOR * Fr::from((i + 1) as u64)).to_affine())
+            .collect();
+        for step in 0..4 {
+            if step == 1 {
+                // Ordinary first layer; equal sums in the second layer.
+                let p = |x| (G2Affine::GENERATOR * Fr::from(x as u64)).to_affine();
+                bases[n - 4..].copy_from_slice(&[p(2), p(9), p(6), p(5)]);
+            } else if step == 2 {
+                bases[n - 1] = -bases[n - 2];
+            } else if step == 3 {
+                bases[n - 1] = G2Affine::IDENTITY;
+            }
+            let a = group_affine_uniform::<G2Config>(&bases, &order, &starts, &counts);
+            let b = group_affine::<G2Config>(&bases, &order, &starts, &counts);
+            assert_eq!(a, b, "class size {size}, edge case {step}");
+        }
+    });
+}
