+// Keep each result at the first operand's original position. Doubling the
+// stride makes the next layer read those slots directly.
+fn reduce_uniform<C: CurveConfig>(
+    points: &mut [LimbPoint<C::Base>],
+    size: usize,
+    scratch: &mut Scratch<C>,
+) -> bool
+where
+    C::Base: BatchInverse,
+{
+    for level in 0..size.ilog2() {
+        let stride = 1 << level;
+        let count = points.len() >> (level + 1);
+        if points.chunks_exact(2 * stride).any(|p| {
+            let a = &p[0];
+            let b = &p[stride];
+            a.is_infinity() || b.is_infinity() || a.x == b.x
+        }) {
+            return false;
+        }
+        apply_normal_pairs::<C, _>(points, scratch, count, |i| {
+            let first = i << (level + 1);
+            (first, first + stride)
+        });
+    }
+    true
+}
