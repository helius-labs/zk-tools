+fn apply_normal_pairs<C: CurveConfig, P: Fn(usize) -> (usize, usize)>(
+    points: &mut [LimbPoint<C::Base>],
+    s: &mut Scratch<C>,
+    m: usize,
+    pair: P,
+) where
+    C::Base: BatchInverse,
