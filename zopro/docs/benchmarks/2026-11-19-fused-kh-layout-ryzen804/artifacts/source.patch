+#[cfg(test)]
+mod tests {
+    use super::*;
+    use zopro_bn254::{G1Affine, G1Projective};
+    #[test]
+    fn fused_layouts_match_generator_with_signed_coefficients() {
+        let mut expected = Fr::ZERO;
+        let mut point = G1Projective::IDENTITY;
+        let mut s = Fr::from(81u64);
+        let mut points = Vec::new();
+        let mut words = Vec::new();
+        for i in 1u64..2239 {
+            point += G1Affine::GENERATOR;
+            s = s.square() + Fr::from(i);
+            let (mut p, mut weight) = (point.to_affine(), Fr::from(i));
+            if i % 11 == 0 {
+                p = -p;
+                weight = -weight;
+            }
+            if i % 17 == 0 {
+                p = G1Affine::IDENTITY;
+                weight = Fr::ZERO;
+            }
+            let coefficient = if i % 7 == 0 {
+                Fr::ZERO
+            } else if i % 3 == 0 {
+                -s
+            } else {
+                s
+            };
+            expected += coefficient * weight;
+            points.push(p);
+            words.push(coefficient.to_canonical());
+        }
+        let want = (G1Affine::GENERATOR * expected).to_affine();
+        for n in [1, 8] {
+            rayon::ThreadPoolBuilder::new()
+                .num_threads(n)
+                .build()
+                .unwrap()
+                .install(|| {
+                    for (windows, mode) in [
+                        (18, Partition::Shared),
+                        (22, Partition::Shared),
+                        (20, Partition::Merge),
+                        (20, Partition::Separate),
+                    ] {
+                        let result = sum(
+                            &points[..1121],
+                            &words[..1121],
+                            &points[1121..],
+                            &words[1121..],
+                            windows,
+                            mode,
+                        );
+                        assert_eq!(result.to_affine(), want);
+                    }
+                });
+        }
+    }
+}
