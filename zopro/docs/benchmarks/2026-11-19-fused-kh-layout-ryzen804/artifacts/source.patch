+#[cfg(zopro_real_kh)]
+pub(super) fn fused_balanced_growth(count: usize, ranges: usize) -> Option<usize> {
+    let bound = shape::<G1Config>(1 << 12, 20, 1, batch_size(13).max(32))?;
+    let mut held = 0usize;
+    let mut leaf = 0usize;
+    for i in 0..count {
+        let bits = (i + 1) * 255 / count - i * 255 / count;
+        let span = shape::<G1Config>(1 << (bits - 1), 1, ranges, batch_size(bits).max(32))?;
+        held = add(held, span.held)?;
+        leaf = leaf.max(span.leaf);
+    }
+    let extra = add(held.saturating_sub(bound.held),
+                    mul(leaf.saturating_sub(bound.leaf), rayon::current_num_threads())?)?;
+    add(extra, vector::<[usize; 2]>(count, false)?)
 }
 
