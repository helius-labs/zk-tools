+use super::*;
+use std::sync::OnceLock;
+
+#[derive(Copy, Clone)]
+pub(crate) enum Partition {
+    Shared,
+    Merge,
+    Separate,
+}
+
+pub(super) fn try_fused<C: CurveConfig<Base = Fq>>(
+    k: &[Affine<C>],
+    sk: &[[u64; 4]],
+    h: &[Affine<C>],
+    sh: &[[u64; 4]],
+) -> Option<Projective<C>> {
+    static LAYOUT: OnceLock<Option<(usize, Partition)>> = OnceLock::new();
+    let (count, partition) = (*LAYOUT.get_or_init(|| {
+        let text = std::env::var("ZOPRO_TRIAL_KH_LAYOUT").ok()?;
+        let (windows, mode) = text.split_once('-')?;
+        let count = windows.parse().ok()?;
+        if !(18..=24).contains(&count) {
+            return None;
+        }
+        let partition = match mode {
+            "shared" => Partition::Shared,
+            "merge" => Partition::Merge,
+            "separate" => Partition::Separate,
+            _ => return None,
+        };
+        Some((count, partition))
+    }))?;
+    let parts = if matches!(partition, Partition::Shared) {
+        1
+    } else {
+        2
+    };
+    let bytes = crate::msm_affine::workspace::fused_balanced_growth(count, parts);
+    let budget = crate::preparation::Reservation::analysis(bytes);
+    if std::env::var_os("ZOPRO_TRIAL_KH_LAYOUT_TRACE").is_some() {
+        let mode = match partition {
+            Partition::Shared => "shared",
+            Partition::Merge => "merge",
+            Partition::Separate => "separate",
+        };
+        eprintln!("KH_LAYOUT {count}-{mode} {}", budget.is_some());
+    }
+    let _budget = budget?;
+    Some(sum(k, sk, h, sh, count, partition))
+}
+
+fn sum<C: CurveConfig<Base = Fq>>(
+    k: &[Affine<C>],
+    sk: &[[u64; 4]],
+    h: &[Affine<C>],
+    sh: &[[u64; 4]],
+    windows: usize,
+    partition: Partition,
+) -> Projective<C> {
+    let cover: Vec<_> = (0..windows)
+        .map(|i| {
+            let start = i * BITS / windows;
+            Span {
+                start,
+                width: (i + 1) * BITS / windows - start,
+            }
+        })
+        .collect();
+    let fold = |sums: Vec<Projective<C>>| {
+        let mut result = Projective::<C>::IDENTITY;
+        for (span, sum) in cover.iter().zip(sums).rev() {
+            for _ in 0..span.width {
+                result = result.double();
+            }
+            result += sum;
+        }
+        result
+    };
+    let bucket = |points: &[Affine<C>], scalars: &[[u64; 4]], span: Span| {
+        let size = batch_size(span.width).max(32);
+        let mut state = Window::new(1 << (span.width - 1), size);
+        feed(&mut state, points, scalars, span, size);
+        state.finish()
+    };
+    if matches!(partition, Partition::Separate) {
+        let compute = |points, scalars| {
+            fold(
+                cover
+                    .par_iter()
+                    .map(|&span| crate::msm::weighted_affine(&bucket(points, scalars, span)))
+                    .collect(),
+            )
+        };
+        let (a, b) = rayon::join(|| compute(k, sk), || compute(h, sh));
+        return a + b;
+    }
+    let sums = cover
+        .par_iter()
+        .map(|&span| {
+            let out = match partition {
+                Partition::Shared => {
+                    let size = batch_size(span.width).max(32);
+                    let mut state = Window::new(1 << (span.width - 1), size);
+                    feed(&mut state, k, sk, span, size);
+                    feed(&mut state, h, sh, span, size);
+                    state.finish()
+                }
+                _ => {
+                    let (mut a, b) = rayon::join(|| bucket(k, sk, span), || bucket(h, sh, span));
+                    crate::msm_affine::merge_buckets(&mut a, &b);
+                    a
+                }
+            };
+            crate::msm::weighted_affine(&out)
+        })
+        .collect();
+    fold(sums)
+}
