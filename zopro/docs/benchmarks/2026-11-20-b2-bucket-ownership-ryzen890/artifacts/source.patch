+/// Request-local digit indices and owner scratch. Reserve the entire trial
+/// because owners can be live beside the existing leading-window reducers.
+#[cfg(zopro_g2_horner_buckets)]
+pub(super) fn ownership_bytes(n: usize, bits: usize, workers: usize) -> Option<usize> {
+    const TILE: usize = crate::msm::WEIGHTED_TILE;
+    let windows = 127usize.div_ceil(bits);
+    let bins = 1usize.checked_shl(bits as u32)?;
+    // Counts, starts and scatter cursors can coexist during the build.
+    let index = add(vector::<u32>(mul(2, n)?, false)?,
+                    mul(vector::<usize>(add(bins, 1)?, false)?, 3)?)?;
+    let active = vector::<(u32, std::ops::Range<usize>)>(TILE, false)?;
+    let leaf = add(add(window::<G2Config>(TILE, TILE)?, active)?,
+                   crate::msm::workspace_weighted::<G2Config>(TILE)?)?;
+    let leading = four_range_growth(n, workers)?;
+    add(leading, add(mul(index, windows - 1)?, mul(workers, leaf)?)?)
