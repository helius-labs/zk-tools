+    pub(in super::super) fn window(
+        bases: &[G2Affine],
+        short: &[[u64; 4]],
+        w: usize,
+        bits: usize,
+    ) -> Option<G2Projective> {
+        let half = 1 << (bits - 1);
+        let (order, starts) = order(short, w, bits)?;
+        let partials: Vec<_> = (0..half / WEIGHTED_TILE)
+            .into_par_iter()
+            .map(|tile| {
+                let start = tile * WEIGHTED_TILE;
+                let end = start + WEIGHTED_TILE;
+                let mut state = Window::new(WEIGHTED_TILE, WEIGHTED_TILE, BatchAdd::default());
+                let mut active = Vec::with_capacity(WEIGHTED_TILE);
+                state.feed_layers(bases, &order, &starts[start..=end], &mut active);
+                for p in &mut state.affine {
+                    if !p.is_identity() {
+                        p.x = p.x.mul_by_fp(&BETA);
+                    }
+                }
+                for p in &mut state.projective {
+                    p.x = p.x.mul_by_fp(&BETA);
+                }
+                state.feed_layers(bases, &order, &starts[half + start..=half + end], &mut active);
+                weighted_tile(&state.finish())
+            })
+            .collect();
+        Some(combine_weighted_tiles(partials))
+    }
+}
