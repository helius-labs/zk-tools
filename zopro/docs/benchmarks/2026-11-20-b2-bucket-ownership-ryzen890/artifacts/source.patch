+
+    fn bucket(digit: i16, offset: usize) -> usize {
+        offset + digit.unsigned_abs() as usize - 1
+    }
+
+    // Pack both component histograms in one index stream. Each entry retains
+    // the original key order within its bucket and a separate sign bit.
+    fn order(short: &[[u64; 4]], w: usize, bits: usize) -> Option<(Vec<u32>, Vec<usize>)> {
+        let half = 1 << (bits - 1);
+        let mut counts = vec![0usize; 2 * half];
+        for words in short {
+            for (high, offset) in [(true, 0), (false, half)] {
+                let digit = component(words, high, w, bits);
+                if digit != 0 {
+                    counts[bucket(digit, offset)] += 1;
+                }
+            }
+        }
+        // Avoid a long sequence of nearly empty inversion batches on a
+        // highly skewed window. The original point partitions spread it out.
+        let limit = (4 * short.len().div_ceil(half)).max(32);
+        if counts.iter().any(|count| *count > limit) {
+            return None;
+        }
+        let mut starts = Vec::with_capacity(2 * half + 1);
+        starts.push(0);
+        for count in counts {
+            starts.push(starts.last().unwrap() + count);
+        }
+        let mut next = starts[..2 * half].to_vec();
+        let mut order = vec![0; *starts.last().unwrap()];
+        for (i, words) in short.iter().enumerate() {
+            for (high, offset) in [(true, 0), (false, half)] {
+                let digit = component(words, high, w, bits);
+                if digit != 0 {
+                    let dest = bucket(digit, offset);
+                    order[next[dest]] = i as u32 | (u32::from(digit < 0) << 31);
+                    next[dest] += 1;
+                }
+            }
+        }
+        Some((order, starts))
+    }
+
+    impl<'a> Window<'a> {
+        fn feed_layers(
+            &mut self,
+            bases: &'a [G2Affine],
+            order: &[u32],
+            starts: &[usize],
+            active: &mut Vec<(u32, Range<usize>)>,
+        ) {
+            active.extend(starts.windows(2).enumerate().filter_map(|(bucket, pair)| {
+                (pair[0] < pair[1]).then_some((bucket as u32, pair[0]..pair[1]))
+            }));
+            let size = self.batch.capacity();
+            while !active.is_empty() {
+                // Each active bucket contributes at most one operand in a
+                // layer. Execute its pending update before the next layer.
+                active.retain_mut(|(bucket, range)| {
+                    let operand = order[range.start];
+                    range.start += 1;
+                    let point = &bases[(operand & INDEX_MASK) as usize];
+                    if !point.is_identity() {
+                        self.add(*bucket | (operand & NEGATIVE), point);
+                        if self.batch.len() == size {
+                            self.execute();
+                        }
+                    }
+                    range.start != range.end
+                });
+                self.execute();
+            }
+        }
+    }
