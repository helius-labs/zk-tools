+fn trial_layout(n: usize) -> Option<(usize, bool, crate::preparation::Reservation)> {
+    let (bits, owners) = match std::env::var("ZOPRO_TRIAL_B2_OWNER").as_deref() {
+        Ok("point11") => (11, false),
+        Ok("owner11") => (11, true),
+        Ok("owner12") => (12, true),
+        _ => return None,
+    };
+    if owners && !super::g2_borrowed::ownership_available() {
+        return None;
+    }
+    let workers = rayon::current_num_threads();
+    let bytes = if owners {
+        super::workspace::ownership_bytes(n, bits, workers)
+    } else {
+        super::workspace::four_range_growth(n, workers)
+    };
+    let reservation = crate::preparation::Reservation::analysis(bytes)?;
+    if std::env::var_os("ZOPRO_TRIAL_B2_OWNER_TRACE").is_some() {
+        eprintln!("B2_BUCKET_OWNER {bits} {owners} {n}");
+    }
+    Some((bits, owners, reservation))
