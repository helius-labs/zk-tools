+    pub fn extracted_query(&self, points: &[G2Affine], values: &mut [Fr]) -> G2Projective {
+        let force_dense = std::env::var_os("ZOPRO_PACKED_DENSE").is_some();
+        let trace = std::env::var_os("ZOPRO_PACKED_TRACE").is_some();
+        let tail = &values[self.prefix..];
+        const BLOCKS: usize = 128;
+        let width = tail.len().div_ceil(BLOCKS);
+        let mut counts = [0usize; BLOCKS];
+        if !force_dense {
+            counts.par_iter_mut().zip(tail.par_chunks(width)).for_each(|(count, chunk)| {
+                *count = chunk.iter().filter(|x| !x.is_zero()).count();
+            });
+        }
+        let total: usize = counts.iter().sum();
+        let reservation = if force_dense || total > tail.len() / 16 {
+            None
+        } else {
+            Reservation::analysis(total.checked_mul(160).and_then(|bytes| bytes.checked_add(256)))
+        };
+        if reservation.is_none() {
+            if trace { eprintln!("PACKED_DENSE {} {}", total, tail.len()); }
