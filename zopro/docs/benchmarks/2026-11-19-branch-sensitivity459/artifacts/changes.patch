--- a/crates/zopro-core/src/public_b2_offset.rs
+++ b/crates/zopro-core/src/public_b2_offset.rs
@@ -42,0 +43,33 @@
+
+#[derive(Default)]
+pub(super) struct G1Branches {
+    pub a: OnceLock<G1Term>,
+    pub kh: OnceLock<G1Term>,
+}
+
+pub(super) struct G1Term {
+    left: Vec<[u64; 4]>,
+    right: Vec<[u64; 4]>,
+    value: G1Projective,
+}
+
+pub(super) fn measure_term(
+    cache: &OnceLock<G1Term>, name: &str,
+    left: &[[u64; 4]], right: &[[u64; 4]], calculate: impl Fn() -> G1Projective,
+) -> G1Projective {
+    if !std::env::var("ZOPRO_BENCH_G1_TERMS").unwrap_or_default().split(',').any(|s| s == name) {
+        return calculate();
+    }
+    let trace = std::env::var_os("ZOPRO_BENCH_SENSITIVITY_TRACE").is_some();
+    let term = cache.get_or_init(|| {
+        if trace { eprintln!("G1_INIT {name}"); }
+        G1Term { left: left.to_vec(), right: right.to_vec(), value: calculate() }
+    });
+    if left == term.left && right == term.right {
+        if trace { eprintln!("G1_MATCH {name}"); }
+        term.value
+    } else {
+        if trace { eprintln!("G1_MISS {name}"); }
+        calculate()
+    }
+}
