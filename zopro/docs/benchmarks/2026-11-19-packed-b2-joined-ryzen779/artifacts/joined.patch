+/// Group the replacement prefix and compact correction tail without copying
+/// the mapped prefix. On a declined group, the caller still owns both inputs.
+pub(super) fn grouped_g2_with_tail(
+    bases: &[zopro_bn254::G2Affine],
+    tail: &[zopro_bn254::G2Affine],
+    words: &[[u64; 4]],
+) -> Option<zopro_bn254::G2Projective> {
+    if bases.len().checked_add(tail.len())? != words.len()
+        || !crate::simd::cpu_option("ZOPRO_CPU_DEDUP")
+    {
+        return None;
+    }
+    let mut g = grouping::groups_with_diversity_check(words)?;
+    let points = crate::msm::group_affine_prepared(bases, tail, &g.order, &g.starts, &g.counts);
+    #[cfg(all(
+        zopro_g2_horner_buckets, target_arch = "x86_64",
+        target_feature = "avx512ifma", target_feature = "avx512vl",
+        target_feature = "avx512dq", feature = "ifma8", not(no_ifma)
+    ))]
+    if (1024..65536).contains(&points.len()) {
+        return Some(g2_phi::raw_exclusive(&points, &mut g.values));
+    }
+    Some(msm_raw(&points, &g.values))
+}
