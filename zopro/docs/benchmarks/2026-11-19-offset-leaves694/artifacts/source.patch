+
+fn convert_block(rows: &[Row], start: usize, wires: &mut [Fr]) {
+    let convert = |slice: &mut [Fr]| {
+        for wire in slice {
+            *wire = Fr::from_montgomery(wire.to_canonical());
+        }
+    };
+    let mut cursor = 0;
+    for row in block_rows(rows, start, wires.len()) {
+        let at = row.wire - start;
+        convert(&mut wires[cursor..at]);
+        let value = wires[at];
+        wires[at] = if value == row.scalar {
+            Fr::ZERO
+        } else {
+            Fr::from_montgomery((value - row.scalar).to_canonical())
+        };
+        cursor = at + 1;
+    }
+    convert(&mut wires[cursor..]);
+}
