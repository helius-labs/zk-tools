+
+
+struct QueryReturnTimes {
+    start: std::time::Instant,
+    finish_ns: [std::sync::atomic::AtomicU64; 4],
+}
+
+impl QueryReturnTimes {
+    fn new() -> Self {
+        Self {
+            start: std::time::Instant::now(),
+            finish_ns: Default::default(),
+        }
+    }
+
+    fn run<T>(&self, index: usize, f: impl FnOnce() -> T) -> T {
+        let result = f();
+        self.finish_ns[index].store(self.start.elapsed().as_nanos() as u64, std::sync::atomic::Ordering::Relaxed);
+        result
+    }
+
+    fn report(&self, route: &str, omit_b: bool) {
+        let joined = self.start.elapsed().as_nanos();
+        let times = self.finish_ns.each_ref().map(|t| t.load(std::sync::atomic::Ordering::Relaxed));
+        eprintln!("QUERY_RETURNS {} {} {} {} {} {} {}", route, omit_b, times[0], times[1], times[2], times[3], joined);
+    }
+}
