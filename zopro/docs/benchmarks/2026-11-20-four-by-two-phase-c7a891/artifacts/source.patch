+//! Single-key fixed-request ablation for the native benchmark.
+use crate::preparation::Reservation;
+use std::sync::OnceLock;
+use std::time::Instant;
+use zopro_bn254::{Fr, G1Projective, G2Projective};
+
+#[derive(Clone, Copy)]
+pub(crate) enum Query {
+    A,
+    K,
+    H,
+    B2,
+}
+impl Query {
+    fn name(self) -> &'static str {
+        match self {
+            Self::A => "a",
+            Self::K => "k",
+            Self::H => "h",
+            Self::B2 => "b2",
+        }
+    }
+
+    fn replay_enabled(self) -> bool {
+        static MODE: OnceLock<Option<String>> = OnceLock::new();
+        match MODE.get_or_init(|| std::env::var("ZOPRO_891_REPLAY").ok()).as_deref() {
+            Some("all") => true,
+            Some("kh") => matches!(self, Self::K | Self::H),
+            Some("a") => matches!(self, Self::A),
+            Some("b2") => matches!(self, Self::B2),
+            _ => false,
+        }
+    }
+}
+
+pub(crate) fn clock() -> Option<Instant> {
+    static CLOCK: OnceLock<bool> = OnceLock::new();
+    if *CLOCK.get_or_init(|| std::env::var_os("ZOPRO_891_CLOCK").is_some()) {
+        Some(Instant::now())
+    } else {
+        None
+    }
+}
+
+pub(crate) fn trace_enabled() -> bool {
+    static TRACE: OnceLock<bool> = OnceLock::new();
+    *TRACE.get_or_init(|| std::env::var_os("ZOPRO_891_REPLAY_TRACE").is_some())
+}
+
+type B = (G1Projective, G2Projective);
+struct Frozen<T> {
+    base: usize,
+    scalars: Vec<Fr>,
+    value: T,
+    _reservation: Reservation,
+}
+
+pub(crate) fn g1(
+    query: Query, origin: Option<Instant>, base: usize, scalars: &mut [Fr],
+    compute: impl FnOnce(&mut [Fr]) -> G1Projective,
+) -> G1Projective {
+    static A: OnceLock<Option<Frozen<G1Projective>>> = OnceLock::new();
+    static K: OnceLock<Option<Frozen<G1Projective>>> = OnceLock::new();
+    static H: OnceLock<Option<Frozen<G1Projective>>> = OnceLock::new();
+    let cell = match query {
+        Query::A => &A,
+        Query::K => &K,
+        Query::H => &H,
+        _ => unreachable!(),
+    };
+    run(cell, query, origin, base, scalars, compute)
+}
+
+pub(crate) fn b2(
+    origin: Option<Instant>, base: usize, scalars: &mut [Fr],
+    compute: impl FnOnce(&mut [Fr]) -> B,
+) -> B {
+    static B2: OnceLock<Option<Frozen<B>>> = OnceLock::new();
+    run(&B2, Query::B2, origin, base, scalars, compute)
+}
+
+fn run<T: Copy + Sync + Send>(
+    cell: &OnceLock<Option<Frozen<T>>>, query: Query, origin: Option<Instant>,
+    base: usize, scalars: &mut [Fr], compute: impl FnOnce(&mut [Fr]) -> T,
+) -> T {
+    let start = origin.map(|t| t.elapsed());
+    let result = if query.replay_enabled() {
+        replay(cell, query, base, scalars, compute)
+    } else {
+        compute(scalars)
+    };
+    if let (Some(t), Some(start)) = (origin, start) {
+        eprintln!("ZP891_QUERY {} {} {}", query.name(), start.as_nanos(), t.elapsed().as_nanos());
+    }
+    result
+}
+
+fn replay<T: Copy + Sync + Send>(
+    cell: &OnceLock<Option<Frozen<T>>>, query: Query, base: usize,
+    scalars: &mut [Fr], compute: impl FnOnce(&mut [Fr]) -> T,
+) -> T {
+    let mut compute = Some(compute);
+    let mut primed = false;
+    let frozen = cell.get_or_init(|| {
+        let _reservation = Reservation::analysis(Some(std::mem::size_of_val(scalars)))?;
+        let copy = scalars.to_vec();
+        let value = compute.take().unwrap()(scalars);
+        primed = true;
+        Some(Frozen { base, scalars: copy, value, _reservation })
+    });
+    let trace = |event| {
+        if trace_enabled() {
+            eprintln!("ZP891_REPLAY {} {}", query.name(), event);
+        }
+    };
+    if let Some(frozen) = frozen {
+        if primed || (frozen.base == base && frozen.scalars == scalars) {
+            trace(if primed { "prime" } else { "hit" });
+            return frozen.value;
+        }
+        trace("mismatch");
+    } else {
+        trace("denied");
+    }
+    compute.unwrap()(scalars)
+}
