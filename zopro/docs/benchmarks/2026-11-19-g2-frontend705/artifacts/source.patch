+
+/// Optional extra workspace when B2 runs on an existing auxiliary pool. The
+/// original proof forecast still covers all work remaining on the main pool.
+pub(crate) fn auxiliary_g2(n: usize, workers: usize) -> Option<usize> {
+    if !(1024..65536).contains(&n) || workers == 0 { return None; }
+    let p = envelope::<G2Config>(n, true, true)?;
+    add(p.held, mul(p.leaf, workers)?)
 }
 
