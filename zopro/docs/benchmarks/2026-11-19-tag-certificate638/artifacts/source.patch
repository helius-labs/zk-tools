+// A bank contains sixteen nonzero fingerprints. A collision or a full bank
+// may lose evidence, but the same scalar can never increase the count twice.
+fn tagged_exceeds(scalars: &[[u64; 4]], bank_count: usize, cutoff: usize) -> bool {
+    const ONES: u128 = u128::MAX / 255;
+    const HIGH: u128 = ONES << 7;
+    fn zero_bytes(word: u128) -> u128 {
+        word.wrapping_sub(ONES) & !word & HIGH
+    }
+    let mut banks = Vec::new();
+    if banks.try_reserve_exact(bank_count).is_err() {
+        return false;
+    }
+    banks.resize(bank_count, 0u128);
+    let shift = u64::BITS - bank_count.ilog2();
+    let mut occupied = 0;
+    for scalar in scalars {
+        if scalar[0] == 0 {
+            continue;
+        }
+        let hash = scalar[0].wrapping_mul(0x9e3779b97f4a7c15);
+        let bank = &mut banks[(hash >> shift) as usize];
+        let tag = ((hash >> (shift - 8)) as u8).max(1) as u128;
+        if zero_bytes(*bank ^ (tag * ONES)) != 0 {
+            continue;
+        }
+        let free = zero_bytes(*bank);
+        if free != 0 {
+            // Subtraction can also flag a byte after a zero through borrow.
+            // The least significant flagged byte is always an actual zero.
+            let slot_shift = free.trailing_zeros() & !7;
+            *bank |= tag << slot_shift;
+            occupied += 1;
+            if occupied > cutoff {
+                return true;
+            }
+        }
+    }
+    false
 }
 
