+#[cfg(test)]
+#[test]
+fn serial_distinct_words_match_parallel_and_field_oracle() {
+    for n in [0, 1, 17, 4097] {
+        let fields: Vec<Fr> = (0..n).map(|i|Fr::from(i as u64).pow(&[17])).collect();
+        let mut direct: Vec<_> = fields.iter().map(|f|f.0).collect();
+        let mut parallel = direct.clone();
+        convert_distinct_scalars(&mut direct,true);
+        convert_distinct_scalars(&mut parallel,false);
+        assert_eq!(direct,parallel);
+        assert_eq!(direct,fields.iter().map(|f|f.to_canonical()).collect::<Vec<_>>());
+    }
+}
