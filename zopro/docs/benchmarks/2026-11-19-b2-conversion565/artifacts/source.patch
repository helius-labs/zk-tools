+fn convert_distinct_scalars(values: &mut [[u64;4]], serial: bool) {
+    let convert = |v: &mut [u64;4]| *v = Fr::from_montgomery(*v).to_canonical();
+    if serial { values.iter_mut().for_each(convert); }
+    else { values.par_iter_mut().for_each(convert); }
+}
