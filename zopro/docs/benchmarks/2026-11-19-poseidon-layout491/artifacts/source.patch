+use super::Fr;
+use std::collections::{BTreeMap, HashMap};
+use std::sync::{Mutex,OnceLock};
+use std::sync::atomic::{AtomicBool,Ordering};
+
+#[derive(Default)]
+struct State {
+    lookup: HashMap<Vec<[u64;4]>,usize>,
+    completed: Vec<bool>,
+    counts: BTreeMap<usize,[usize;3]>,
+    patterns: HashMap<Vec<[usize;8]>,usize>,
+    structural: HashMap<(Vec<[u64;4]>,usize),usize>,
+    structural_complete:Vec<bool>,
+    shaped_counts:BTreeMap<(usize,usize,usize,usize),[usize;3]>,
+}
+static STORE: OnceLock<Mutex<State>>=OnceLock::new();
+static ACTIVE:AtomicBool=AtomicBool::new(false);
+pub fn begin()->bool {
+    if STORE.set(Mutex::new(State::default())).is_err() {return false;}
+    ACTIVE.store(true,Ordering::Release);true
+}
+pub struct Visit(usize);
+impl Drop for Visit {
+    fn drop(&mut self) {
+        STORE.get().unwrap().lock().unwrap().completed[self.0]=true;
+    }
+}
+pub fn visit(state:&[Fr])->Option<Visit> {
+    if !ACTIVE.load(Ordering::Acquire){return None;}
+    let w=state.len();let key:Vec<_>=state.iter().map(|x|x.to_canonical()).collect();
+    let mut s=STORE.get().unwrap().lock().unwrap();let prev=s.lookup.get(&key).copied();
+    let id=match prev {Some(i)=>i,None=>{let i=s.completed.len();s.lookup.insert(key,i);s.completed.push(false);i}};
+    let ready=s.completed[id];let c=s.counts.entry(w).or_default();c[0]+=1;c[1]+=usize::from(prev.is_some());c[2]+=usize::from(ready);
+    Some(Visit(id))
+}
+pub fn active()->bool { ACTIVE.load(Ordering::Acquire) }
+pub struct LayoutVisit(usize);
+impl Drop for LayoutVisit {
+    fn drop(&mut self){STORE.get().unwrap().lock().unwrap().structural_complete[self.0]=true;}
+}
+pub fn layout(input:&[Fr],mut form:Vec<[usize;8]>)->Option<LayoutVisit>{
+    let mut ranges=[0;3];
+    for (group,(a,b)) in [(0,1),(1,4),(4,7)].into_iter().enumerate() {
+        let mut ordered:Vec<_>=form.iter().flat_map(|row|row[a..b].iter().copied()).collect();
+        ordered.sort_unstable();
+        assert!(ordered.windows(2).all(|v|v[0]<v[1]));
+        ranges[group]=1+ordered.windows(2).filter(|v|v[1]!=v[0]+1).count();
+        let low=ordered[0];
+        for row in &mut form {for id in &mut row[a..b]{*id-=low;}}
+    }
+    let key:Vec<_>=input.iter().map(Fr::to_canonical).collect();
+    let mut state=STORE.get().unwrap().lock().unwrap();
+    let next=state.patterns.len();let shape=*state.patterns.entry(form).or_insert(next);
+    let k=(key,shape);let prev=state.structural.get(&k).copied();
+    let i=match prev{Some(i)=>i,None=>{let i=state.structural_complete.len();state.structural.insert(k,i);state.structural_complete.push(false);i}};
+    let ready=state.structural_complete[i];
+    let counts=state.shaped_counts.entry((input.len(),ranges[0],ranges[1],ranges[2])).or_default();
+    counts[0]+=1;counts[1]+=usize::from(prev.is_some());counts[2]+=usize::from(ready);
+    Some(LayoutVisit(i))
+}
+pub fn finish(){
+    ACTIVE.store(false,Ordering::Release);
+    let mut state=STORE.get().unwrap().lock().unwrap();
+    for (width,c) in &state.counts {eprintln!("POSEIDON_REUSE {} {} {} {}",width,c[0],c[1],c[2]);}
+    for ((w,slots,rows,wires),c) in &state.shaped_counts {eprintln!("POSEIDON_LAYOUT {} {} {} {} {} {} {}",w,slots,rows,wires,c[0],c[1],c[2]);}
+    *state=State::default();
+}
