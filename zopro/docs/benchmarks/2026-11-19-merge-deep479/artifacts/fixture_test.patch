+// Deterministic public fixtures with nonempty subtrees along the input paths.
+func deepValue(seed int64, slot, i int, kind string) *big.Int {
+	digest := sha256.Sum256([]byte(fmt.Sprintf("merge479/%d/%d/%d/%s", seed, slot, i, kind)))
+	return new(big.Int).Mod(new(big.Int).SetBytes(digest[:]), poseidon.Modulus)
+}
+
+func deeperState(entries map[uint64]*big.Int, seed int64, slot int) map[uint64]*big.Int {
+	for i := 0; i < 32; i++ {
+		if _, exists := entries[uint64(i)]; !exists {
+			entries[uint64(i)] = deepValue(seed, slot, i, "low")
+		}
+	}
+	for level := 5; level < protocol.StateTreeHeight; level++ {
+		index := (uint64(1) << level) | (deepValue(seed, slot, level, "index").Uint64() & ((uint64(1) << level) - 1))
+		entries[index] = deepValue(seed, slot, level, "high")
+	}
+	return entries
+}
+
+func populateNullifiers(t testing.TB, tree *protocol.NullifierTree, seed int64, slot int) {
+	for i := 0; i < 64+int(seed%8)*8; i++ {
+		if err := tree.Insert(deepValue(seed, slot, i, "spent")); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
