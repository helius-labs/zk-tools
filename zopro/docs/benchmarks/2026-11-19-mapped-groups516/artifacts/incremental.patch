+//! Optional mapped group sums immediately before a complete, reordered B2 query.
+use super::{msm_affine, preparation::Reservation, Fr, G2Affine, G2Projective, Image, Store};
+use rayon::prelude::*;
+
+pub(super) struct Layout {
+    image: Image,
+    wires_at: usize,
+    ends_at: usize,
+    n: usize,
+    groups: usize,
+    singles: usize,
+    prefix: Store<G2Affine>,
+}
+
+fn le32(data: &[u8]) -> usize {
+    u32::from_le_bytes(data[..4].try_into().unwrap()) as usize
+}
+
+impl Layout {
+    pub fn parse(image: &Image, trailer: usize, sums_at: usize, groups: usize, original: &[u32]) -> Result<Self, &'static str> {
+        let n = original.len();
+        let data = (**image).as_ref().get(trailer..).ok_or("missing B2 layout")?;
+        let size = n.checked_add(groups).and_then(|x|x.checked_mul(4)).and_then(|x|x.checked_add(16)).ok_or("B2 layout overflow")?;
+        if data.len() != size || &data[..8] != b"ZPB2W516" || groups == 0 || groups > n/2 || le32(&data[8..]) != groups {
+            return Err("invalid B2 layout header");
+        }
+        let singles = le32(&data[12..]);
+        if singles > n-2*groups {return Err("invalid B2 singleton count");}
+        let index_bytes = &data[16..16+4*n];
+        let mut seen = vec![0u64;n.div_ceil(64)];
+        for wire in index_bytes.chunks_exact(4) {
+            let row=original.binary_search(&(le32(wire) as u32)).map_err(|_|"foreign B2 wire")?;
+            let bit=1u64 << (row%64);
+            if seen[row/64]&bit!=0 {return Err("duplicate B2 wire");}
+            seen[row/64]|=bit;
+        }
+        let mut start=singles;
+        for bytes in data[16+4*n..].chunks_exact(4) {
+            let end=le32(bytes);
+            if end>n || end.checked_sub(start).is_none_or(|length|length<2) {return Err("invalid B2 group boundary");}
+            start=end;
+        }
+        if start!=n {return Err("incomplete B2 groups");}
+        let bytes = (groups+singles).checked_mul(128).ok_or("B2 point range overflow")?;
+        Ok(Self {image:image.clone(), wires_at:trailer+16, ends_at:trailer+16+4*n, n,groups,singles,prefix:Store::mapped(image,sums_at,bytes)?})
+    }
+
+    pub fn check_sums(&self, points:&[G2Affine]) -> bool {
+        (0..self.groups).into_par_iter().all(|g| {
+            let mut sum = G2Projective::IDENTITY;
+            for &point in &points[self.range(g)] { sum+=point; }
+            sum == self.prefix[g].to_projective()
+        })
+    }
+
+    pub fn wires(&self) -> &[u8] {
+        &(*self.image).as_ref()[self.wires_at..self.ends_at]
+    }
+
+    pub fn extract(&self, wires:&[Fr]) -> Vec<Fr> {
+        self.wires().par_chunks_exact(4).map(|w|wires[le32(w)]).collect()
+    }
+
+    fn range(&self, g:usize) -> std::ops::Range<usize> {
+        let data=(*self.image).as_ref();
+        let at=self.ends_at+4*g;
+        let lo=if g==0 {self.singles} else {le32(&data[at-4..])};
+        lo..le32(&data[at..])
+    }
+
+    fn select(&self,g:usize,values:&[Fr]) -> (u32,u32) {
+        let range=self.range(g);
+        let block=&values[range.clone()];
+        let first=block[0];
+        let initial=block[1..].iter().filter(|&&v|v!=first).count();
+        if initial*2<=block.len() {return (range.start as u32,initial as u32);}
+        let mut balance=0usize;
+        let mut pos=0;
+        for (i, &v) in block.iter().enumerate() {
+            if balance==0 {pos=i; balance=1;}
+            else if v==block[pos] {balance+=1;} else {balance-=1;}
+        }
+        if balance!=0 && block[pos]!=first {
+            let count=block.iter().filter(|&&v|v!=block[pos]).count();
+            if count<initial {return ((range.start+pos) as u32,count as u32);}
+        }
+        (range.start as u32,initial as u32)
+    }
+
+    fn compact(&self,points:&[G2Affine],values:&[Fr]) -> Option<G2Projective> {
+        let samples=self.groups.min(32);
+        let mut checked=0;
+        let mut misses=0;
+        for bucket in 0..samples {
+            let g=(2*bucket+1)*self.groups/(2*samples);
+            let slice=&values[self.range(g)];
+            checked+=slice.len()-1;
+            misses+=slice[1..].iter().filter(|&&v|v!=slice[0]).count();
+        }
+        if misses*4>checked {return None;}
+        let _flags=Reservation::analysis(self.groups.checked_mul(8)?.checked_add(256))?;
+        let selected:Vec<_>=(0..self.groups).into_par_iter().map(|g|self.select(g,values)).collect();
+        let count:usize=selected.iter().map(|r|r.1 as usize).sum();
+        if count>(self.n-self.singles)/16 {return None;}
+        let _scratch=Reservation::analysis(self.prefix.len().checked_mul(32)?.checked_add(count.checked_mul(160)?)?.checked_add(512))?;
+        let (main,residual)=rayon::join(||{
+            let mut words:Vec<_>=(0..self.prefix.len()).into_par_iter().map(|i|{
+                let row=if i<self.groups {selected[i].0 as usize} else {i-self.groups};
+                values[row].to_canonical()
+            }).collect();
+            msm_affine::g2_query_exclusive(&self.prefix,&mut words)
+        },||{
+            if count==0 {return G2Projective::IDENTITY;}
+            let mut bases=Vec::with_capacity(count);
+            let mut words=Vec::with_capacity(count);
+            for (g,&(index,diffs)) in selected.iter().enumerate() {
+                if diffs==0 {continue;}
+                let rep=values[index as usize];
+                for row in self.range(g) {
+                    if values[row]!=rep {bases.push(points[row]);words.push((values[row]-rep).to_canonical());}
+                }
+            }
+            if count>=256 {msm_affine::g2_query_exclusive(&bases,&mut words)} else {super::msm_raw_b2(&bases,&words)}
+        });
+        if std::env::var_os("ZOPRO_LAYOUT_PROBE").is_some() {eprintln!("LAYOUT_SPARSE {} {count}",self.prefix.len());}
+        Some(main+residual)
+    }
+
+    pub fn query(&self, points:&[G2Affine],values:&mut [Fr]) -> G2Projective {
+        assert_eq!(points.len(),self.n);
+        assert_eq!(values.len(),self.n);
+        if std::env::var_os("ZOPRO_LAYOUT_DENSE").is_none() {
+            if let Some(result)=self.compact(points,values) {return result;}
+        }
+        if std::env::var_os("ZOPRO_LAYOUT_PROBE").is_some() {eprintln!("LAYOUT_DENSE {}",self.n);}
+        msm_affine::g2_query_exclusive(points,msm_affine::canonical_exclusive(values))
+    }
+}
