 //! Apply both local transforms and the Euler weights in one expanded leaf.
 use super::*;
+
+#[derive(Clone, Copy)]
+enum Center {
+    Ordinary,
+    Direct(Pair),
+    Paired(Pair),
+}
+
+fn center_selection(plan: &Plan) -> Center {
+    // Both diagonal factors are below 4N, the bound for mul_u28.
+    if plan.n > 1 << 26 {
+        return Center::Ordinary;
+    }
+    static CONFIG: std::sync::OnceLock<u8> = std::sync::OnceLock::new();
+    let mode = *CONFIG.get_or_init(|| match std::env::var("ZOPRO_907_CENTER").as_deref() {
+        Ok("direct") => 1,
+        Ok("paired") => 2,
+        _ => 0,
+    });
+    if std::env::var_os("ZOPRO_907_TRACE").is_some() {
+        eprintln!("ZP907_CENTER {mode}");
+    }
+    let fourth_root = plan.inverse_roots.pair.get()[1];
+    let coefficient = Pair::new(&[fourth_root * Fr::from((plan.n / 2) as u64); 8]);
+    match mode {
+        1 => Center::Direct(coefficient),
+        2 => Center::Paired(coefficient),
+        _ => Center::Ordinary,
+    }
+}
+
+#[inline(always)]
+fn direct_center(x: &Pair, diagonal: u64, half: u64, root: &Pair) -> Pair {
+    let prev = Pair::shuffle_pair::<3, 0, 1, 2>(x, x);
+    let next = Pair::shuffle_pair::<1, 2, 3, 0>(x, x);
+    let opposite = Pair::shuffle_pair::<2, 3, 0, 1>(x, x);
+    let total = x.add(&opposite).add(&prev.add(&next));
+    x.mul_u28(&[diagonal; 8])
+        .add(&prev.sub(&next).mul(root))
+        .sub(&total.mul_u28(&[half; 8]))
+}
+
+/// Both halves use the same form. The last two root products in each
+/// four-point group are the negatives of the first two. Interleave the
+/// independent differences from two groups for a single full-vector product.
+#[inline(always)]
+fn paired_center(a: &mut Pair, b: &mut Pair, da: u64, db: u64, half: u64, root: &Pair) {
+    let prev = Pair::shuffle_pair::<3, 0, 7, 4>(a, b);
+    let next = Pair::shuffle_pair::<1, 2, 5, 6>(a, b);
+    let neighbor = prev.sub(&next).mul(root);
+
+    let even = Pair::shuffle_pair::<0, 2, 4, 6>(a, b);
+    let odd = Pair::shuffle_pair::<1, 3, 5, 7>(a, b);
+    let pair_sum = even.add(&odd);
+    let other = Pair::shuffle_pair::<1, 0, 3, 2>(&pair_sum, &pair_sum);
+    let sum = pair_sum.add(&other).mul_u28(&[half; 8]);
+
+    let positive = neighbor.sub(&sum);
+    let negative = Pair::zero().sub(&neighbor.add(&sum));
+    let ca = Pair::shuffle_pair::<0, 1, 4, 5>(&positive, &negative);
+    let cb = Pair::shuffle_pair::<2, 3, 6, 7>(&positive, &negative);
+    *a = a.mul_u28(&[da; 8]).add(&ca);
+    *b = b.mul_u28(&[db; 8]).add(&cb);
+}
 
