+// The four lanes of a radix-4 column occupy every eighth stripe of the
+// original radix-32 column. A last-band tile is packed directly into registers.
+// Earlier tiles already contain the first two inverse butterfly layers.
+unsafe fn resume_columns(
+    mut stripes: [&mut [core::mem::MaybeUninit<PackedPair>]; 32],
+    roots: &Twiddles,
+    a: &[Fr],
+    b: &[Fr],
+    last_band: &[u64; 8],
+    width: usize,
+    start: usize,
+) {
+    let columns = stripes[0].len();
+    if columns > 32 {
+        let mid = columns / 2;
+        let left = core::array::from_fn(|i| {
+            let (left, right) = core::mem::take(&mut stripes[i]).split_at_mut(mid);
+            stripes[i] = right;
+            left
+        });
+        rayon::join(
+            || unsafe { resume_columns(left, roots, a, b, last_band, width, start) },
+            || unsafe { resume_columns(stripes, roots, a, b, last_band, width, start + mid) },
+        );
+        return;
+    }
+    let load = |row: usize| {
+        Pair::new(&core::array::from_fn(|lane| {
+            let values = if lane < 4 { a } else { b };
+            values.get(row + lane % 4).copied().unwrap_or(Fr::ZERO)
+        }))
+    };
+    for j in 0..columns {
+        let col = start + j;
+        let mut local: [Pair; 32] = [Pair::zero(); 32];
+        for group in 0..8 {
+            let tile = (group * width + col) / RADIX4_TILE;
+            let from_rows = last_band[tile / 64] >> (tile % 64) & 1 != 0;
+            let lanes = if from_rows {
+                let values = core::array::from_fn(|stripe| {
+                    load(4 * ((8 * stripe + group) * width + col))
+                });
+                inverse_radix4(values, roots, 8 * width, group * width + col)
+            } else {
+                core::array::from_fn(|stripe| unsafe {
+                    stripes[8 * stripe + group][j].assume_init_ref().load()
+                })
+            };
+            for (stripe, value) in lanes.into_iter().enumerate() {
+                local[8 * stripe + group] = value;
+            }
+        }
+        column_kernel_from::<false, false, 2>(&mut local, roots, 0, width, col);
+        for (stripe, value) in stripes.iter_mut().zip(local) {
+            stripe[j].write(PackedPair::store(value));
+        }
+    }
+}
