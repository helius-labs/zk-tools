+
+impl EulerPrefix {
+    pub(crate) fn new(plan: &Plan) -> Option<Self> {
+        let n = plan.n;
+        if plan.released || plan.twisted.is_some() || plan.roots.single.is_some()
+            || !(8192..=1 << 17).contains(&n) {
+            return None;
+        }
+        let count = n / 4;
+        let bytes = count.checked_mul(core::mem::size_of::<PackedPair>())?;
+        let expansion = count.checked_mul(core::mem::size_of::<Pair>())?;
+        let reservation = crate::preparation::Reservation::analysis(
+            Some(bytes.checked_add(expansion)?.checked_add(64 << 10)?),
+        )?;
+        let mut data = Vec::new();
+        data.try_reserve_exact(count).ok()?;
+        Some(Self { data, last_band: [0; 8], _reservation: reservation })
+    }
+
+    pub(crate) fn writer(&mut self, plan: &Plan) -> Radix4Writer<'_> {
+        let width = plan.n / 16;
+        let data = &mut self.data.spare_capacity_mut()[..4 * width];
+        Radix4Writer { data: data.as_mut_ptr(), width, _borrow: core::marker::PhantomData }
+    }
+
+    pub(crate) fn mark_last_band(&mut self, tiles: &[usize]) {
+        for &tile in tiles {
+            self.last_band[tile / 64] |= 1 << (tile % 64);
+        }
+    }
+
+    /// # Safety
+    /// The other tiles were initialized exactly once and their workers joined.
+    pub(crate) unsafe fn finish(mut self, plan: &Plan, mut a: Vec<Fr>, b: Vec<Fr>) -> Vec<Fr> {
+        a.resize(a.len().max(b.len()), Fr::ZERO);
+        let count = plan.n / 4;
+        let q = count / 32;
+        let mut stripes = self.data.spare_capacity_mut()[..count].chunks_exact_mut(q);
+        let stripes = core::array::from_fn(|_| stripes.next().unwrap());
+        unsafe {
+            resume_columns(stripes, &plan.inverse_roots, &a, &b, &self.last_band, q, 0);
+            self.data.set_len(count);
+        }
+        transform_inner(plan, &mut self.data);
+        emit_prepared(plan, &mut a, &b, &self.data);
+        a
+    }
