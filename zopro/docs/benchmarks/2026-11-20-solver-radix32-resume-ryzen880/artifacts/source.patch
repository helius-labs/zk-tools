+fn resumed_radix32_matches_euler_for_partial_rows() {
+    let n = 8192;
+    let root = Fr::root_of_unity(n).unwrap().pow(&[3]);
+    let coset = Fr::from(5u64);
+    let mut plan = Plan::new(n, root, coset, crate::fft::denominator(n, coset).unwrap());
+    plan.prepare_euler_basis();
+    for rows in [7, 2048, 4021, 8191, 8192] {
+        let a: Vec<_> = (0..rows).map(|i| Fr::from((i*i+7) as u64)).collect();
+        let b: Vec<_> = (0..rows).map(|i| Fr::from((3*i*i+41) as u64)).collect();
+        let mut expected = a.clone();
+        emit_products(&plan, &mut expected, &b, Vec::with_capacity(n/4));
+        for mode in 0..4 {
+            let mut prefix = EulerPrefix::new(&plan).unwrap();
+            let (late, early): (Vec<_>, Vec<_>) = (0..n/16/RADIX4_TILE).rev().partition(|&i| {
+                match mode {
+                    0 => false,
+                    1 => true,
+                    2 => i % 2 == 0,
+                    _ => (3 * i + 29) % 17 < 5,
+                }
+            });
+            prefix.mark_last_band(&late);
+            let writer = prefix.writer(&plan);
+            let actual = unsafe {
+                writer.write_band(&plan, a.as_ptr(), b.as_ptr(), rows, &early);
+                prefix.finish(&plan, a.clone(), b.clone())
+            };
+            assert_eq!(actual, expected);
+        }
+    }
