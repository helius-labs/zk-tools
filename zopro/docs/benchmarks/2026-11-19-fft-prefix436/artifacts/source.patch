+// The packed input rows are a prefix. After a DIF stage each half has
+// min(live, gap) potentially nonzero rows, starting at its first row.
+fn inverse_prefix<const CACHED: bool>(
+    local: &mut [Pair; 32], roots: &Twiddles, q: usize, column: usize, live: usize,
+) {
+    for stage in 0..5 {
+        let gap = 16 >> stage;
+        let both = live.min(2 * gap).saturating_sub(gap);
+        let active = live.min(gap);
+        let root = |j: usize| {
+            if CACHED {
+                broadcast(&roots.columns[0][31 * column + 32 - 2 * gap + j])
+            } else {
+                broadcast(&roots.layers[stage][j * q + column])
+            }
+        };
+        for block in (0..32).step_by(2 * gap) {
+            for j in 0..both {
+                let (a,b) = (local[block+j], local[block+gap+j]);
+                local[block+j] = a.add(&b);
+                local[block+gap+j] = a.sub(&b).mul(&root(j));
+            }
+            for j in both..active {
+                local[block+gap+j] = local[block+j].mul(&root(j));
+            }
+        }
+    }
+}
