+#[cfg(test)]
+#[test]
+fn inverse_prefix_matches_all_occupancies() {
+    let n = 8192;
+    let q = n / 128;
+    let coset = Fr::from(5u64);
+    let mut plan = Plan::new(n, Fr::root_of_unity(n).unwrap().pow(&[3]), coset, crate::fft::denominator(n, coset).unwrap());
+    for cached in [false,true] {
+        if cached { plan.inverse_roots.prepare_columns(); }
+        for live in 0..=32 {
+            for column in [0,1,q/2,q-1] {
+                let mut pruned = core::array::from_fn(|r| Pair::new(&core::array::from_fn(|j| {
+                    if r<live { Fr::from((r*1201+j*1147+column+1) as u64).square() } else { Fr::ZERO }
+                })));
+                let mut reference = pruned;
+                if cached {
+                    inverse_prefix::<true>(&mut pruned, &plan.inverse_roots, q, column, live);
+                    column_kernel::<true,false>(&mut reference, &plan.inverse_roots, 0, q, column);
+                } else {
+                    inverse_prefix::<false>(&mut pruned, &plan.inverse_roots, q, column, live);
+                    column_kernel::<false,false>(&mut reference, &plan.inverse_roots, 0, q, column);
+                }
+                for (x,y) in pruned.iter().zip(reference) { assert_eq!(x.get(), y.get()); }
+            }
+        }
+    }
