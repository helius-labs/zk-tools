+// Each stage uses the same twiddle in every block at a given position.
+#[inline(always)]
+fn root_major_stage<const CACHED: bool, const FORWARD: bool>(
+    local: &mut [Pair; 32], roots: &Twiddles, level: usize, q: usize,
+    column: usize, stage: usize, gap: usize,
+) {
+    for j in 0..gap {
+        let root = if CACHED {
+            broadcast(&roots.columns[level][31 * column + 32 - 2 * gap + j])
+        } else {
+            broadcast(&roots.layers[level + stage][j * q + column])
+        };
+        for block in local.chunks_exact_mut(2 * gap) {
+            let (lo, hi) = block.split_at_mut(gap);
+            let (a, b) = (lo[j], hi[j]);
+            if FORWARD {
+                let product = b.mul(&root);
+                lo[j] = a.add(&product);
+                hi[j] = a.sub(&product);
+            } else {
+                lo[j] = a.add(&b);
+                hi[j] = a.sub(&b).mul(&root);
+            }
+        }
+    }
+}
