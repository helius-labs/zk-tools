+//! Benchmark-only wall-clock spans measured against one proof-local origin.
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::Instant;
+
+#[derive(Clone, Copy)]
+pub(super) enum Phase {
+    Solve,
+    Gather,
+    Quotient,
+    A,
+    K,
+    H,
+    B2,
+    Correction,
+}
+
+pub(super) struct Timeline {
+    origin: Instant,
+    endpoints: [[AtomicU64; 2]; 8],
+}
+
+impl Timeline {
+    pub(super) fn begin() -> Option<Self> {
+        static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+        ENABLED
+            .get_or_init(|| std::env::var_os("ZOPRO_TRIAL_FOLDED_TIMELINE").is_some())
+            .then(|| Self {
+                origin: Instant::now(),
+                endpoints: std::array::from_fn(|_| [AtomicU64::new(0), AtomicU64::new(0)]),
+            })
+    }
+
+    pub(super) fn report(&self, b2: usize) {
+        let end = self.origin.elapsed().as_nanos();
+        let spans = self
+            .endpoints
+            .each_ref()
+            .map(|ends| ends.each_ref().map(|stamp| stamp.load(Ordering::Relaxed)));
+        eprintln!("FOLDED_TIMELINE {b2} {end} {spans:?}");
+    }
+}
+
+pub(super) struct Span<'a> {
+    timeline: &'a Timeline,
+    finish: &'a AtomicU64,
+}
+
+impl Drop for Span<'_> {
+    fn drop(&mut self) {
+        self.finish.store(
+            self.timeline.origin.elapsed().as_nanos() as u64,
+            Ordering::Relaxed,
+        );
+    }
+}
+
+pub(super) fn span(timeline: Option<&Timeline>, phase: Phase) -> Option<Span<'_>> {
+    timeline.map(|timeline| {
+        let [start, finish] = &timeline.endpoints[phase as usize];
+        start.store(
+            timeline.origin.elapsed().as_nanos() as u64,
+            Ordering::Relaxed,
+        );
+        Span { timeline, finish }
+    })
+}
+
+pub(super) fn measure<T>(timeline: Option<&Timeline>, phase: Phase, op: impl FnOnce() -> T) -> T {
+    let _guard = span(timeline, phase);
+    op()
+}
