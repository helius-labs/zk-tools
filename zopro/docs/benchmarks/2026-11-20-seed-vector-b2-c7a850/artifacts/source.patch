+            1 => Fr::ONE,
+            2 => -Fr::ONE,
+            _ => seed.fr(),
+        }).collect();
+        let mut words: Vec<_> = input.iter().map(|f| f.0).collect();
+        decode_b2_classes(&mut words);
+        assert!(words.iter().zip(&input).all(|(actual, value)| *actual == value.to_canonical()));
+    }
 }
 
