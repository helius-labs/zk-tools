+//! Use exact zero/one selection for products of bit-hint outputs.
+use super::{Expression, Fr};
+#[cfg(zopro_resource_schedule)]
+use super::{HintKind, Op, Plan};
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::OnceLock;
+
+static BIT_PRODUCTS: AtomicUsize = AtomicUsize::new(0);
+
+fn trace() -> bool {
+    static TRACE: OnceLock<bool> = OnceLock::new();
+    *TRACE.get_or_init(|| std::env::var_os("ZOPRO_921_BIT_TRACE").is_some())
+}
+
+pub(super) fn schedule_clock() -> Option<crate::time::Instant> {
+    static CLOCK: OnceLock<bool> = OnceLock::new();
+    CLOCK
+        .get_or_init(|| std::env::var_os("ZOPRO_921_CLOCK").is_some())
+        .then(crate::time::Instant::now)
+}
+
+pub(super) fn schedule_report(started: Option<crate::time::Instant>) {
+    if let Some(t) = started {
+        eprintln!("ZP921_SOLVE {}", t.elapsed().as_nanos());
+    }
+    if trace() {
+        eprintln!("ZP921_PRODUCTS {}", BIT_PRODUCTS.swap(0, Ordering::Relaxed));
+    }
+}
+
+#[cfg(zopro_resource_schedule)]
+pub(super) fn prepare(plan: &mut Plan) {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    if !*ENABLED.get_or_init(|| std::env::var("ZOPRO_921_BIT_SOLVER").as_deref() == Ok("1")) {
+        return;
+    }
+    let Some(_scratch) = crate::preparation::Reservation::analysis(plan.n_wires.checked_add(64))
+    else {
+        return;
+    };
+    let mut bits = vec![false; plan.n_wires];
+    let mut selected = 0;
+    for op in &mut plan.ops {
+        match op {
+            Op::Hint(hint) => bits[hint.outputs()].fill(matches!(hint.kind, HintKind::Bits)),
+            Op::Constraint(step) => {
+                let product = step.assignment.as_ref().is_none_or(|a| a.side() == 2);
+                if product {
+                    let mut selected_here = false;
+                    for e in &mut step.expressions[..2] {
+                        if let Expression::Wire(wire) = *e {
+                            if bits.get(wire as usize) == Some(&true) {
+                                *e = Expression::Bit(wire);
+                                selected_here = true;
+                            }
+                        }
+                    }
+                    selected += usize::from(selected_here);
+                }
+                if let Some(a) = &step.assignment {
+                    let is_bit = |e: &Expression| {
+                        matches!(
+                            e,
+                            Expression::Bit(_)
+                                | Expression::Zero
+                                | Expression::Constant(0 | 1)
+                                | Expression::Wire(0)
+                        )
+                    };
+                    bits[a.wire()] = product
+                        && a.coefficient() == 1
+                        && matches!(step.expressions[2], Expression::Zero)
+                        && step.expressions[..2].iter().all(is_bit);
+                }
+            }
+        }
+    }
+    if trace() {
+        eprintln!("ZP921_PLAN {selected}");
+    }
+}
+
+#[inline]
+fn bit_product(bit: Fr, other: Fr) -> Fr {
+    if trace() {
+        BIT_PRODUCTS.fetch_add(1, Ordering::Relaxed);
+    }
+    if bit == Fr::ZERO {
+        Fr::ZERO
+    } else if bit == Fr::ONE {
+        other
+    } else {
+        // Keep field semantics even when a supplied image's data flow has
+        // a value outside the expected bit range.
+        bit * other
+    }
+}
+
+#[inline]
+pub(super) fn multiply(expressions: &[Expression; 3], a: Fr, b: Fr) -> Fr {
+    if matches!(expressions[1], Expression::Bit(_)) {
+        bit_product(b, a)
+    } else if matches!(expressions[0], Expression::Bit(_)) {
+        bit_product(a, b)
+    } else {
+        a * b
+    }
+}
+
+#[cfg(test)]
+#[test]
+fn known_bit_products_match_generic_field_multiplication() {
+    let left = [Expression::Bit(1), Expression::Wire(2), Expression::Zero];
+    let right = [Expression::Wire(1), Expression::Bit(2), Expression::Zero];
+    let both = [Expression::Bit(1), Expression::Bit(2), Expression::Zero];
+    for a in [Fr::ZERO, Fr::ONE, -Fr::ONE, Fr::from(12345)] {
+        for b in [Fr::ZERO, Fr::ONE, -Fr::ONE, Fr::from(678901)] {
+            for tags in [&left, &right, &both] {
+                assert_eq!(multiply(tags, a, b), a * b);
+            }
+        }
+    }
+}
+
+const _: () = {
+    // The tag reuses the existing expression discriminant.
+    assert!(core::mem::size_of::<Expression>() == 12);
+};
