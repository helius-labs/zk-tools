+    pub fn from_wires<'a>(&'a self, bases: &[G1Affine], indices: &[u32], wires: &[Fr]) -> Option<PreparedA<'a>> {
+        if bases.len() != indices.len() { return None; }
+        let get = |index: u32| wires[indices[index as usize] as usize];
+        if std::env::var_os("ZOPRO_GROUP_SAMPLE").is_some() {
+            let samples = self.ends.len().min(32);
+            let (mut misses, mut members) = (0, 0);
+            for bucket in 0..samples {
+                let rows = self.members((2 * bucket + 1) * self.ends.len() / (2 * samples));
+                let first = get(rows[0]);
+                members += rows.len() - 1;
+                misses += rows[1..].iter().filter(|&&i| get(i) != first).count();
+            }
+            if misses * 4 > members { return None; }
+        }
+        let adaptive = std::env::var_os("ZOPRO_ADAPTIVE_CORRECTIONS").is_some();
+        let _choices = Reservation::analysis(self.ends.len().checked_mul(8)?.checked_add(256))?;
+        let choices: Vec<_> = (0..self.ends.len()).into_par_iter()
+            .map(|g| self.choose(self.members(g), get, adaptive)).collect();
+        let count: usize = choices.iter().map(|&(_, diff)| diff as usize).sum();
+        if count > self.ids.len() / 16 { return None; }
+        let bytes = self.sources.len().checked_mul(32)?.checked_add(count.checked_mul(96)?)?;
+        let held = Reservation::analysis(bytes.checked_add(512))?;
+        let (words,(extra_points, extra_words)) = rayon::join(
+            || self.sources.par_iter().enumerate().map(|(g,&source)| {
+                get(choices.get(g).map_or(source, |c| c.0)).to_canonical()
+            }).collect(),
+            || {
+                let mut points = Vec::with_capacity(count);
+                let mut words = Vec::with_capacity(count);
+                for (g, &(selected, diff)) in choices.iter().enumerate() {
+                    if diff == 0 { continue; }
+                    let rep = get(selected);
+                    for &i in self.members(g) {
+                        let value = get(i);
+                        if value != rep {
+                            points.push(bases[i as usize]);
+                            words.push((value - rep).to_canonical());
+                        }
+                    }
+                }
+                debug_assert_eq!(points.len(), count);
+                (points, words)
+            }
+        );
+        let result = PreparedA { bases: &self.sums, words, extra_points, extra_words, adaptive, _held: held };
+        if std::env::var_os("ZOPRO_TRIAL_A_AUDIT").is_some() {
+            let dense: Vec<_> = indices.par_iter().map(|&i| wires[i as usize].to_canonical()).collect();
+            assert_eq!(result.evaluate().to_affine(), msm_affine::msm_canonical(bases, &dense).to_affine());
+            eprintln!("A_FROM_WIRES {} {} {} {}", indices.len(), self.sources.len(), count, bytes);
+        }
+        Some(result)
     }
 
