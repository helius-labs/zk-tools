+/// Request-specific representatives and exact residuals for the A query.
+pub(super) struct PreparedA<'a> {
+    bases: &'a [G1Affine],
+    words: Vec<[u64; 4]>,
+    extra_points: Vec<G1Affine>,
+    extra_words: Vec<[u64; 4]>,
+    adaptive: bool,
+    _held: Reservation,
+}
+
+impl PreparedA<'_> {
+    pub fn evaluate(&self) -> G1Projective {
+        let (grouped, corrections) = rayon::join(
+            || msm_affine::msm_canonical(self.bases, &self.words),
+            || {
+                if self.extra_words.is_empty() { G1Projective::IDENTITY }
+                else if self.adaptive && self.extra_words.len() >= 256 {
+                    msm_affine::msm_canonical(&self.extra_points, &self.extra_words)
+                } else { msm_affine::msm_raw(&self.extra_points, &self.extra_words) }
+            }
+        );
+        grouped + corrections
+    }
 }
 
