 //! Signed borrowed G2 prefix, retaining accepted arithmetic and scratch.
 use super::*;
+
+#[cfg(target_arch = "x86_64")]
+fn prefetch_distance() -> usize {
+    static CONFIG: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+    *CONFIG.get_or_init(|| {
+        let distance = match std::env::var("ZOPRO_906_G2_PREFETCH").as_deref() {
+            Ok("one") => 1,
+            Ok("two") => 2,
+            _ => 0,
+        };
+        if std::env::var_os("ZOPRO_906_TRACE").is_some() {
+            eprintln!("ZP906_PREFETCH {distance}");
+        }
+        distance
+    })
+}
+
+#[cfg(target_arch = "x86_64")]
+#[inline(always)]
+fn prefetch_points<C: CurveConfig<Base = Fq2>, const XY: bool>(
+    buckets: &[Affine<C>],
+    group: &[(u32, &Affine<C>)],
+) {
+    use std::arch::x86_64::{_MM_HINT_T0, _mm_prefetch};
+
+    for &(encoded, incoming) in group {
+        for point in [&buckets[(encoded & 0x7fffffff) as usize], incoming] {
+            let x = std::ptr::addr_of!(point.x).cast::<i8>();
+            let y = std::ptr::addr_of!(point.y).cast::<i8>();
+            // SAFETY: Both references come from admissible batch entries.
+            // Each coordinate contains two 32-byte field elements.
+            unsafe {
+                _mm_prefetch::<_MM_HINT_T0>(x);
+                _mm_prefetch::<_MM_HINT_T0>(x.add(63));
+                if XY {
+                    _mm_prefetch::<_MM_HINT_T0>(y.add(63));
+                }
+            }
+        }
+    }
+}
