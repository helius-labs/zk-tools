+fn complete_mode() -> usize {
+    static MODE: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+    *MODE.get_or_init(|| match std::env::var("ZOPRO_934_G2_CHAIN").as_deref() {
+        Ok("single") => 1,
+        Ok("double") => 2,
+        _ => 0,
+    })
+}
+
+/// Each chain covers complete eight-lane groups. Both chains share one
+/// product inversion. The identity prefix and the last inverse update
+/// of each chain need no multiplication.
+#[inline(never)]
+fn apply_complete<C: CurveConfig<Base = Fq2>, const FAST: bool, const CHAINS: usize>(
+    buckets: &mut [Affine<C>],
+    batch: &[(u32, Affine<C>)],
+    scratch: &mut Fq2AddScratch,
+) {
+    debug_assert!(matches!(CHAINS, 1 | 2));
+    debug_assert!(batch.len() >= 4 * LANES && batch.len().is_multiple_of(LANES));
+    static TRACE: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    static TRACED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+    if *TRACE.get_or_init(|| std::env::var_os("ZOPRO_934_G2_CHAIN_TRACE").is_some())
+        && !TRACED.swap(true, std::sync::atomic::Ordering::Relaxed)
+    {
+        eprintln!("ZOPRO_934_COMPLETE {CHAINS} {}", batch.len());
+    }
+    let count = batch.len() / LANES;
+    scratch.prefix_records.clear();
+    scratch.prefix_records.reserve(count);
+    let mut chains = [FqBatch::one(); CHAINS];
+    for j in 0..count {
+        let first = j * LANES;
+        let ax = fq2_pack(core::array::from_fn(|i| buckets[batch[first + i].0 as usize].x));
+        let bx = fq2_pack(core::array::from_fn(|i| batch[first + i].1.x));
+        let dx = core::array::from_fn(|i| canonical_sub::<FAST>(&bx[i], &ax[i]));
+        let norm = Fq2::lanes_norm(&dx);
+        let chain = &mut chains[j % CHAINS];
+        scratch.prefix_records.push([*chain, norm]);
+        *chain = if j < CHAINS { norm } else { chain.mul(&norm) };
+    }
+    let product = if CHAINS == 2 { chains[0].mul(&chains[1]) } else { chains[0] };
+    let root = direct_chain_inverse(&product, true, scratch.vector_inverse)
+        .unwrap_or_else(|| FqBatch::new(&invert_lanes(product.get(), scratch.vector_inverse)));
+    let mut inverses = [root; CHAINS];
+    if CHAINS == 2 {
+        inverses[0] = root.mul(&chains[1]);
+        inverses[1] = root.mul(&chains[0]);
+    }
+    for j in (0..count).rev() {
+        let inverse = &mut inverses[j % CHAINS];
+        let factor = if j < CHAINS {
+            *inverse
+        } else {
+            let [prefix, norm] = scratch.prefix_records[j];
+            let factor = prefix.mul(inverse);
+            *inverse = inverse.mul(&norm);
+            factor
+        };
+        finish_group::<C, FAST>(buckets, batch, j, &factor);
+    }
+}
+
+#[inline(always)]
+fn finish_group<C: CurveConfig<Base = Fq2>, const FAST: bool>(
+    buckets: &mut [Affine<C>],
+    batch: &[(u32, Affine<C>)],
+    j: usize,
+    factor: &FqBatch,
+) {
+    let k=j*LANES;
+    let a:[Affine<C>;LANES]=core::array::from_fn(|i|buckets[batch[k+i].0 as usize]);
+    let b:[Affine<C>;LANES]=core::array::from_fn(|i|batch[k+i].1);
+    let ax=fq2_pack(a.map(|p|p.x));let ay=fq2_pack(a.map(|p|p.y));
+    let bx=fq2_pack(b.map(|p|p.x));let by=fq2_pack(b.map(|p|p.y));
+    let denominator=core::array::from_fn(|i|canonical_sub::<FAST>(&bx[i],&ax[i]));
+    let dy=core::array::from_fn(|i|canonical_sub::<FAST>(&by[i],&ay[i]));
+    let slope=Fq2::lanes_scaled_numerator(&dy,&denominator,factor);
+    let x=Fq2::lanes_sub(&Fq2::lanes_square(&slope),&Fq2::lanes_add(&ax,&bx));
+    let y=Fq2::lanes_sub(&Fq2::lanes_mul(&slope,&Fq2::lanes_sub(&ax,&x)),&ay);
+    let(x,y)=(fq2_unpack(x),fq2_unpack(y));
+    for i in 0..LANES {buckets[batch[k+i].0 as usize]=Affine::new(x[i],y[i]);}
 }
 
