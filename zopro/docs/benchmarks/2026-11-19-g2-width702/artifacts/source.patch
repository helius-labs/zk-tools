+/// Reduce partition pairs as workers finish their independent bucket fills.
+fn tiled(bases: &[G2Affine], short: &mut [[u64; 4]], bits: usize, parts: usize) -> G2Projective {
+    for s in short.iter_mut() { *s = phi_split(*s); }
+    let width = bases.len().div_ceil(parts);
+    let windows = 127usize.div_ceil(bits);
+    let sums: Vec<_> = (0..windows).into_par_iter().map(|w| {
+        let groups = (0..parts).into_par_iter().map(|part| {
+            let start = (part * width).min(bases.len());
+            let end = (start + width).min(bases.len());
+            hb_window(&bases[start..end], &short[start..end], w, bits)
+        }).reduce_with(|mut left, right| {
+            merge_buckets(&mut left, &right);
+            left
+        }).expect("nonzero partition count");
+        crate::msm::weighted_affine(&groups)
+    }).collect();
+    let mut result = G2Projective::IDENTITY;
+    for sum in sums.iter().rev() {
+        for _ in 0..bits { result = result.double(); }
+        result += sum;
+    }
+    result
+}
