 use super::{msm_affine, preparation::Reservation, Fr, G2Affine, G2Projective};
 use rayon::prelude::*;
 
+
+pub(super) trait GroupScalar: Copy + Eq + Send + Sync {
+    fn words(self) -> [u64; 4];
+    fn difference(self, representative: Self) -> [u64; 4];
+}
+impl GroupScalar for Fr {
+    fn words(self) -> [u64; 4] { self.to_canonical() }
+    fn difference(self, representative: Self) -> [u64; 4] {
+        (self - representative).to_canonical()
+    }
+}
+impl GroupScalar for [u64; 4] {
+    fn words(self) -> [u64; 4] { self }
+    fn difference(self, representative: Self) -> [u64; 4] {
+        let actual = Fr::from_canonical(self).expect("canonical scalar");
+        let previous = Fr::from_canonical(representative).expect("canonical representative");
+        (actual - previous).to_canonical()
+    }
+}
