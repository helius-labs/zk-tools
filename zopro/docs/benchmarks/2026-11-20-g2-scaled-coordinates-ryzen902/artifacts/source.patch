+//! Exact modular division by sixteen without leaving normalized SIMD lanes.
+use crate::{ifma8::Ifma8, FpConfig};
+use core::{arch::x86_64::*, marker::PhantomData};
+
+impl<C: FpConfig> Ifma8<C, true> {
+    /// For raw x < 2p, select k < 16 with 16 dividing x + kp.
+    /// The result is normalized, below 17p/16 < 2p, and still in host radix.
+    #[inline(always)]
+    pub fn divide_by_sixteen(&self) -> Self {
+        const MASK: u64 = (1u64 << 52) - 1;
+        let p = C::P;
+        let modulus = [
+            p[0] & MASK,
+            ((p[0] >> 52) | (p[1] << 12)) & MASK,
+            ((p[1] >> 40) | (p[2] << 24)) & MASK,
+            ((p[2] >> 28) | (p[3] << 36)) & MASK,
+            p[3] >> 16,
+        ];
+        // SAFETY: the module requires AVX-512 IFMA/VL/DQ. Each base-52
+        // digit times k < 16 and its incoming carry fit in 64 bits.
+        unsafe {
+            let lo = _mm512_and_si512(self.0[0], _mm512_set1_epi64(15));
+            let k = _mm512_and_si512(
+                _mm512_mullo_epi64(lo, _mm512_set1_epi64((C::INV & 15) as i64)),
+                _mm512_set1_epi64(15),
+            );
+            let mask = _mm512_set1_epi64(MASK as i64);
+            let mut carry = _mm512_setzero_si512();
+            let mut digits = [_mm512_setzero_si512(); 5];
+            for i in 0..5 {
+                let sum = _mm512_add_epi64(
+                    _mm512_add_epi64(
+                        self.0[i],
+                        _mm512_mullo_epi64(k, _mm512_set1_epi64(modulus[i] as i64)),
+                    ),
+                    carry,
+                );
+                digits[i] = _mm512_and_si512(sum, mask);
+                carry = _mm512_srli_epi64::<52>(sum);
+            }
+            debug_assert_eq!(_mm512_cmpneq_epi64_mask(carry, _mm512_setzero_si512()), 0);
+            for i in 0..4 {
+                digits[i] = _mm512_or_si512(
+                    _mm512_srli_epi64::<4>(digits[i]),
+                    _mm512_and_si512(_mm512_slli_epi64::<48>(digits[i + 1]), mask),
+                );
+            }
+            digits[4] = _mm512_srli_epi64::<4>(digits[4]);
+            Self(digits, PhantomData)
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{Fq, FqConfig};
+
+    #[test]
+    fn exact_division_in_mixed_radix() {
+        let mut seed = 0x26fa8c8395fbf502u64;
+        let inverse = Fq::from_u64(16).inverse().unwrap();
+        for sample in 0..1024 {
+            let values = core::array::from_fn(|i| {
+                if sample == 0 {
+                    return match i {
+                        0 => Fq::ZERO,
+                        1 => Fq::ONE,
+                        2 => -Fq::ONE,
+                        _ => Fq::from_montgomery([i as u64, 0, 0, 0]),
+                    };
+                }
+                let bytes = core::array::from_fn(|_| {
+                    seed ^= seed << 13;
+                    seed ^= seed >> 7;
+                    seed ^= seed << 17;
+                    seed as u8
+                });
+                Fq::from_random_bytes(&bytes)
+            });
+            let mut packed = Ifma8::<FqConfig, true>::new(&values);
+            let mut expected = values;
+            for i in 0..4 {
+                if i == 1 {
+                    // Force lazy representatives from normal addition.
+                    packed = packed.add(&packed);
+                    expected = expected.map(|v| v.double());
+                }
+                packed = packed.divide_by_sixteen();
+                expected = expected.map(|v| v * inverse);
+                assert_eq!(packed.get(), expected);
+            }
+        }
+    }
+}
