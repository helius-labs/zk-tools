+// Derivatives past the last constraint have no consumer. Keep the existing
+// packed workspace, then write only the required columns of the final stage.
+fn prefix_columns<const CACHED: bool>(
+    mut stripes: [&mut [PackedPair]; 32], roots: &Twiddles, width: usize,
+    start: usize, needed: usize,
+) {
+    let len=stripes[0].len();
+    if len>64 {
+        let mid=len/2;
+        let left=core::array::from_fn(|i|{
+            let (left,right)=core::mem::take(&mut stripes[i]).split_at_mut(mid);
+            stripes[i]=right;
+            left
+        });
+        rayon::join(||prefix_columns::<CACHED>(left,roots,width,start,needed),
+                    ||prefix_columns::<CACHED>(stripes,roots,width,start+mid,needed));
+        return;
+    }
+    for j in 0..len {
+        let column=start+j;
+        let mut values:[Pair;32]=core::array::from_fn(|i|stripes[i][j].load());
+        for order in 0..4 {
+            let gap=1<<order;
+            for block in (0..32).step_by(2*gap) {
+                for k in 0..gap {
+                    let root=if CACHED {broadcast(&roots.columns[0][31*column+32-2*gap+k])}
+                             else {broadcast(&roots.layers[4-order][k*width+column])};
+                    let low=block+k;let high=low+gap;
+                    let a=values[low];let b=values[high].mul(&root);
+                    values[low]=a.add(&b);values[high]=a.sub(&b);
+                }
+            }
+        }
+        for k in 0..16 {
+            if k*width+column>=needed {break;}
+            let root=if CACHED {broadcast(&roots.columns[0][31*column+k])}
+                     else {broadcast(&roots.layers[0][k*width+column])};
+            let a=values[k];let b=values[k+16].mul(&root);
+            stripes[k][j]=PackedPair::store(a.add(&b));
+            if (k+16)*width+column<needed {stripes[k+16][j]=PackedPair::store(a.sub(&b));}
+        }
+    }
+}
+
+fn prefix_pairs(count:usize)->usize {
+    // The pointwise consumer loads two packed pairs for its final eight lanes.
+    2*count.div_ceil(8)
+}
+
+fn finish_prefix(plan:&Plan, values:&mut [PackedPair], needed:usize){
+    let width=values.len()/32;
+    let mut iter=values.chunks_exact_mut(width);
+    let stripes=core::array::from_fn(|_|iter.next().unwrap());
+    if plan.roots.columns.is_empty(){prefix_columns::<false>(stripes,&plan.roots,width,0,needed)}
+    else{prefix_columns::<true>(stripes,&plan.roots,width,0,needed)}
+}
