+#[cfg(test)]
+#[test]
+fn ready_range_orders_match_independent_scalar_sum() {
+    let n = 513usize;
+    let g = G2Projective::generator();
+    let weights: Vec<_> = (0..n).map(|i| Fr::from((i % 29) as u64)).collect();
+    let bases = G2Projective::batch_to_affine(&weights.iter().map(|k| g * *k).collect::<Vec<_>>());
+    let scalars: Vec<_> = (0..n).map(|i| {
+        let k = Fr::from((i + 3) as u64).pow(&[27]);
+        if i % 3 == 0 { -k } else { k }
+    }).collect();
+    let expected = weights.iter().zip(&scalars).fold(Fr::ZERO, |a, (l, r)| a + *l * *r);
+    let short: Vec<_> = scalars.iter().map(|s| phi_split(s.to_canonical())).collect();
+    for threads in [1, 4] {
+        let pool = rayon::ThreadPoolBuilder::new().num_threads(threads).build().unwrap();
+        for range_major in [false, true] {
+            let sums = pool.install(|| ready_ranges(&bases, &short, 12, 11, n.div_ceil(2), range_major));
+            let mut sum = G2Projective::IDENTITY;
+            for term in sums.into_iter().rev() {
+                for _ in 0..12 { sum = sum.double(); }
+                sum += term;
+            }
+            assert_eq!(sum.to_affine(), (g * expected).to_affine());
+        }
+    }
 }
 
