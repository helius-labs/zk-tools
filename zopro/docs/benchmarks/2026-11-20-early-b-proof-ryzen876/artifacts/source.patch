 include!("groth16_rerandomize.rs");
 
+pub(crate) struct PreparedProofB {
+    pub(crate) point: G2Affine,
+    pub(crate) lines: zopro_bn254::pairing::G2Prepared,
+}
+
+pub(crate) struct StagedProofB<'a> {
+    fixed: &'a PreparedFixedPoints,
+    u: Fr,
+    v: Fr,
+    early: bool,
+    result: std::sync::OnceLock<PreparedProofB>,
+}
+
+impl<'a> StagedProofB<'a> {
+    pub(crate) fn new(fixed: &'a PreparedFixedPoints, early: bool) -> Self {
+        let u = loop {
+            let candidate = uniform_fr();
+            if !candidate.is_zero() {
+                break candidate;
+            }
+        };
+        Self { fixed, u, v: uniform_fr(), early, result: std::sync::OnceLock::new() }
+    }
+
+    pub(crate) fn compute(&self, b2: G2Projective) {
+        let b = joint_g2(
+            b2 + self.fixed.0.fixed.beta2,
+            self.u,
+            self.fixed.0.fixed.delta2,
+            self.u * self.v,
+            self.fixed.0.windows.as_ref().map(|(_, g2)| g2),
+        ).to_affine();
+        assert!(self.result.set(PreparedProofB {
+            point: b,
+            lines: zopro_bn254::pairing::G2Prepared::new(&b),
+        }).is_ok(), "one staged B result per proof");
+    }
+
+    pub(crate) fn early(&self) -> bool {
+        self.early
+    }
+
+    pub(crate) fn finish(self, parts: &[u8]) -> Option<(Vec<u8>, PreparedProofB)> {
+        let b = self.result.into_inner()?;
+        let raw = self.fixed.assemble_prepared_b(parts, b.point, self.u, self.v)?;
+        Some((raw, b))
+    }
+}
+
+#[cfg(test)]
+#[test]
+fn staged_b_matches_rerandomization() {
+    let g = G1Affine::GENERATOR;
+    let q = G2Affine::GENERATOR;
+    let fixed = PreparedFixedPoints::new(FixedPoints {
+        alpha: g, beta: g, delta: g, beta2: q, delta2: q,
+    });
+    for a in [G1Projective::IDENTITY, -g.to_projective(), g.to_projective().double()] {
+        for b2 in [G2Projective::IDENTITY, -q.to_projective(), q.to_projective().double()] {
+            let mut parts = Vec::new();
+            for part in [a, G1Projective::IDENTITY, g.to_projective().double(), g.to_projective()] {
+                crate::output_g1(&mut parts, part);
+            }
+            crate::output_g2(&mut parts, b2);
+            for early in [false, true] {
+                let staged = StagedProofB::new(&fixed, early);
+                staged.compute(b2);
+                let expected = fixed.rerandomized_with(&parts, staged.u, staged.v);
+                let got = staged.finish(&parts);
+                assert_eq!(got.as_ref().map(|(raw, _)| raw), expected.as_ref());
+                if let Some((raw, b)) = got {
+                    let proof = crate::verify::Proof::from_raw(&raw).unwrap();
+                    assert_eq!(proof.bs, b.point);
+                    assert_eq!(b.lines, zopro_bn254::pairing::G2Prepared::new(&proof.bs));
+                }
+            }
+        }
+    }
+}
