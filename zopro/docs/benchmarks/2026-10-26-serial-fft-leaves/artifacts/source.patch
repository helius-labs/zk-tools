+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn cutoff_bounds_and_available_parallelism_hold_at_domain_and_worker_edges() {
+        for vectors in [0,1,2,63,64,65,127,128,1023,1024,1025,8192,32768,65536,1usize<<26] {
+            for workers in [0,1,2,4,16,32,64,96,128,9999,usize::MAX] {
+                let limit=cutoff(vectors,workers);
+                assert!(limit.is_power_of_two()&&(64..=1024).contains(&limit));
+                let workers=workers.max(1);
+                if let Some(required)=workers.checked_mul(128) {
+                    if vectors>=required {
+                        assert!(vectors/limit>=2*workers,"vectors={vectors},workers={workers},limit={limit}");
+                    }
+                }
+            }
+        }
+    }
+
+    // Build domain values by evaluating sparse ordinary polynomials using
+    // scalar Fr operations. Check every inverse coefficient before testing
+    // a forward pass, so inverse/forward errors cannot merely cancel.
+    fn check<S:PairStorage>(plan:&Plan,root:Fr,twisted:bool,seed:u64) {
+        let n=plan.n;
+        let a=[(0,Fr::from(seed+1)),(1,Fr::from(7u64)),(n/2+1,Fr::from(13u64)),(n-1,-Fr::ONE)];
+        let b=[(2,Fr::from(11u64)),(n/3,Fr::from(seed+19)),(n-2,Fr::from(23u64))];
+        let evaluate=|terms:&[(usize,Fr)],coset:Fr| {
+            let mut out=vec![Fr::ZERO;n];
+            for &(k,c) in terms {
+                let step=root.pow(&[k as u64]);let mut value=c*coset.pow(&[k as u64]);
+                for out in &mut out {*out+=value;value*=step;}
+            }
+            out
+        };
+        let input_a=evaluate(&a,Fr::ONE);let input_b=evaluate(&b,Fr::ONE);
+        let mut values:Vec<S>=(0..n/4).map(|i|S::store(Pair::new(&core::array::from_fn(|j|
+            if j<4 {input_a[4*i+j]}else{input_b[4*i+j-4]})))).collect();
+        transform::<S,false>(&mut values,&plan.inverse_roots,0);
+        let scale=Fr::from(n as u64);let log=n.trailing_zeros()as usize;
+        let coefficient=|terms:&[(usize,Fr)],k|terms.iter().filter(|(i,_)|*i==k).fold(Fr::ZERO,|s,(_,c)|s+*c);
+        for (i,value) in values.iter().enumerate() {
+            let got=value.load().get();
+            for j in 0..8 {
+                let k=bit_reverse(4*i+j%4,log);
+                let expected=scale*coefficient(if j<4{&a}else{&b},k);
+                assert_eq!(got[j],expected,"inverse n={n},row={i},lane={j}");
+            }
+        }
+        let coset=if twisted{Fr::from(5u64)}else{Fr::ONE};
+        let expected_a=evaluate(&a,coset);let expected_b=evaluate(&b,coset);
+        if twisted {
+            let roots=plan.roots.twisted(coset);
+            transform::<S,true>(&mut values,&roots,0);
+        }else{transform::<S,true>(&mut values,&plan.roots,0);}
+        for(i,value)in values.iter().enumerate(){let got=value.load().get();for j in 0..8{
+            let expected=scale*if j<4{expected_a[4*i+j]}else{expected_b[4*i+j-4]};
+            assert_eq!(got[j],expected,"forward n={n},twisted={twisted},row={i},lane={j}");
+        }}
+    }
+
+    #[test]
+    fn inverse_and_forward_match_scalar_polynomials_with_cached_and_twisted_roots() {
+        for workers in [1,4,32] {
+            rayon::ThreadPoolBuilder::new().num_threads(workers).stack_size(512*1024)
+                .build().unwrap().install(|| {
+                for n in [8usize,128,512,8192,32768,131072,262144] {
+                    if workers==32&&n==262144{continue;}
+                    let root=Fr::root_of_unity(n).unwrap().pow(&[3]);let coset=Fr::from(5u64);
+                    let mut plan=Plan::new(n,root,coset,crate::fft::denominator(n,coset).unwrap());
+                    plan.prepare_euler_study();
+                    // Explicitly exercise uncached ordinary roots as well as
+                    // their admitted column cache. Leaf arithmetic is identical.
+                    let make_roots=|base:Fr| {
+                        let mut value=Fr::ONE;
+                        Twiddles::new((0..n/2).map(|_|{let out=value;value*=base;out}).collect())
+                    };
+                    // Replace the whole object so its allocation and admission
+                    // token are both released. Clearing only columns kept credit.
+                    plan.roots=make_roots(root);
+                    plan.inverse_roots=make_roots(root.inverse().unwrap());
+                    check::<PackedPair>(&plan,root,false,workers as u64);
+                    check::<PackedPair>(&plan,root,true,workers as u64);
+                    if n<=8192{check::<Pair>(&plan,root,false,37);}
+                    if n==262144 {
+                        // Each builder's peak may consume the entire existing optional
+                        // budget. Exercise admitted directions one at a time.
+                        plan.roots.prepare_columns();
+                        assert!(!plan.roots.columns.is_empty());
+                        check::<PackedPair>(&plan,root,false,61);
+                        plan.roots=make_roots(root);
+                        plan.inverse_roots.prepare_columns();
+                        assert!(!plan.inverse_roots.columns.is_empty());
+                        check::<PackedPair>(&plan,root,false,79);
+                    }
+                }
+            });
+        }
+    }
+
+    #[test]
+    fn concurrent_callers_share_roots_with_small_worker_stacks() {
+        let n=32768usize;let root=Fr::root_of_unity(n).unwrap().pow(&[3]);let coset=Fr::from(5u64);
+        let mut plan=Plan::new(n,root,coset,crate::fft::denominator(n,coset).unwrap());
+        plan.prepare_euler_study();
+        let pool=rayon::ThreadPoolBuilder::new().num_threads(8).stack_size(512*1024).build().unwrap();
+        std::thread::scope(|scope| {
+            let mut callers=Vec::new();
+            for caller in 0..3u64 {
+                let pool=&pool;let plan=&plan;
+                callers.push(scope.spawn(move||pool.install(||{
+                    check::<PackedPair>(plan,root,caller%2!=0,caller*101+1);
+                })));
+            }
+            for caller in callers{caller.join().unwrap();}
+        });
+    }
+}
