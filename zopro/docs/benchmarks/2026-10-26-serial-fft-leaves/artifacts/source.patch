+//! Bound nested forks inside existing expanded FFT leaves.
+use super::*;
+
+#[cfg(zopro_serial_fft_leaves)]
+pub(super) fn enabled() -> bool {
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ENABLED.get_or_init(||std::env::var("ZOPRO_CPU_SERIAL_FFT_LEAVES").is_ok_and(|v|v=="1"))
+}
+
+fn cutoff(vectors: usize, workers: usize) -> usize {
+    let budget=workers.max(1).saturating_mul(2);
+    let target=(vectors/budget).clamp(64,1024);
+    1usize << target.ilog2()
+}
+
+pub(super) fn transform<S: PairStorage, const FORWARD: bool>(
+    values: &mut [S], roots: &Twiddles, level: usize,
+) {
+    let cutoff=cutoff(values.len(),rayon::current_num_threads());
+    transform_inner::<S,FORWARD>(values,roots,level,cutoff);
+}
+
+fn transform_inner<S: PairStorage, const FORWARD: bool>(
+    values: &mut [S],
+    roots: &Twiddles,
+    level: usize,
+    cutoff: usize,
+) {
+    if values.len() <= 1024 {
+        // Expand a cache-sized leaf once; its inner butterflies use the
+        // unchanged lane and fused native kernels without extra packing.
+        let mut local: Vec<Pair> = values.iter().map(S::load).collect();
+        if FORWARD {
+            dit_bounded(&mut local, roots, level, cutoff);
+        } else {
+            dif_bounded(&mut local, roots, level, cutoff);
+        }
+        for (out, value) in values.iter_mut().zip(local) {
+            *out = S::store(value);
+        }
+        return;
+    }
+    let q = values.len() / 32;
+    let mut pieces = values.chunks_exact_mut(q);
+    let v0 = pieces.next().unwrap();
+    let v1 = pieces.next().unwrap();
+    let v2 = pieces.next().unwrap();
+    let v3 = pieces.next().unwrap();
+    let v4 = pieces.next().unwrap();
+    let v5 = pieces.next().unwrap();
+    let v6 = pieces.next().unwrap();
+    let v7 = pieces.next().unwrap();
+    let v8 = pieces.next().unwrap();
+    let v9 = pieces.next().unwrap();
+    let v10 = pieces.next().unwrap();
+    let v11 = pieces.next().unwrap();
+    let v12 = pieces.next().unwrap();
+    let v13 = pieces.next().unwrap();
+    let v14 = pieces.next().unwrap();
+    let v15 = pieces.next().unwrap();
+    let v16 = pieces.next().unwrap();
+    let v17 = pieces.next().unwrap();
+    let v18 = pieces.next().unwrap();
+    let v19 = pieces.next().unwrap();
+    let v20 = pieces.next().unwrap();
+    let v21 = pieces.next().unwrap();
+    let v22 = pieces.next().unwrap();
+    let v23 = pieces.next().unwrap();
+    let v24 = pieces.next().unwrap();
+    let v25 = pieces.next().unwrap();
+    let v26 = pieces.next().unwrap();
+    let v27 = pieces.next().unwrap();
+    let v28 = pieces.next().unwrap();
+    let v29 = pieces.next().unwrap();
+    let v30 = pieces.next().unwrap();
+    let v31 = pieces.next().unwrap();
+    if FORWARD {
+        [
+            &mut *v0, &mut *v1, &mut *v2, &mut *v3, &mut *v4, &mut *v5, &mut *v6, &mut *v7,
+            &mut *v8, &mut *v9, &mut *v10, &mut *v11, &mut *v12, &mut *v13, &mut *v14, &mut *v15,
+            &mut *v16, &mut *v17, &mut *v18, &mut *v19, &mut *v20, &mut *v21, &mut *v22, &mut *v23,
+            &mut *v24, &mut *v25, &mut *v26, &mut *v27, &mut *v28, &mut *v29, &mut *v30, &mut *v31,
+        ]
+        .into_par_iter()
+        .for_each(|part| transform_inner::<S, FORWARD>(part, roots, level + 5, cutoff));
+    }
+    stored_columns::<S, FORWARD>(
+        v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15, v16, v17, v18, v19,
+        v20, v21, v22, v23, v24, v25, v26, v27, v28, v29, v30, v31, roots, level,
+    );
+    if !FORWARD {
+        [
+            &mut *v0, &mut *v1, &mut *v2, &mut *v3, &mut *v4, &mut *v5, &mut *v6, &mut *v7,
+            &mut *v8, &mut *v9, &mut *v10, &mut *v11, &mut *v12, &mut *v13, &mut *v14, &mut *v15,
+            &mut *v16, &mut *v17, &mut *v18, &mut *v19, &mut *v20, &mut *v21, &mut *v22, &mut *v23,
+            &mut *v24, &mut *v25, &mut *v26, &mut *v27, &mut *v28, &mut *v29, &mut *v30, &mut *v31,
+        ]
+        .into_par_iter()
+        .for_each(|part| transform_inner::<S, FORWARD>(part, roots, level + 5, cutoff));
+    }
+}
+
+// These binary boundaries expose additional chunks only where the current
+// transform budget requires them. Their butterfly order matches DIF/DIT.
+fn dif_bounded(values:&mut [Pair], roots:&Twiddles, level:usize, cutoff:usize) {
+    if values.len()<=cutoff {return dif_serial(values,roots,level);}
+    let mid=values.len()/2;
+    let (lo,hi)=values.split_at_mut(mid);
+    dif_quads(lo,hi,&roots.layers[level][..mid]);
+    rayon::join(||dif_bounded(lo,roots,level+1,cutoff),||dif_bounded(hi,roots,level+1,cutoff));
+}
+fn dit_bounded(values:&mut [Pair], roots:&Twiddles, level:usize, cutoff:usize) {
+    if values.len()<=cutoff {return dit_serial(values,roots);}
+    let mid=values.len()/2;
+    let (lo,hi)=values.split_at_mut(mid);
+    rayon::join(||dit_bounded(lo,roots,level+1,cutoff),||dit_bounded(hi,roots,level+1,cutoff));
+    dit_quads(lo,hi,&roots.layers[level][..mid]);
+}
+
+// Retain the existing sequential butterfly kernels, extended over a bounded
+// leaf. No fork or allocation occurs in these two terminal functions.
+#[inline(never)]
+fn dif_serial(values:&mut [Pair], roots:&Twiddles, mut level:usize) {
+    let mut gap=values.len()/2;
+    while gap>=1 {
+        let layer=&roots.layers[level][..gap];
+        for chunk in values.chunks_exact_mut(gap*2) {
+            let (lo,hi)=chunk.split_at_mut(gap);
+            dif_quads(lo,hi,layer);
+        }
+        gap/=2;
+        level+=1;
+    }
+    for pair in values.as_chunks_mut::<2>().0 {
+        let (a,b)=pair.split_at_mut(1);
+        dif_within(&mut a[0],&mut b[0],&broadcast(&roots.pair));
+    }
+}
+#[inline(never)]
+fn dit_serial(values:&mut [Pair], roots:&Twiddles) {
+    for pair in values.as_chunks_mut::<2>().0 {
+        let (a,b)=pair.split_at_mut(1);
+        dit_within(&mut a[0],&mut b[0],&broadcast(&roots.pair),roots.single.as_ref().map(broadcast).as_ref());
+    }
+    let mut gap=1;
+    while gap<values.len() {
+        let layer=&roots.layers[roots.layers.len()-1-gap.trailing_zeros() as usize][..gap];
+        for chunk in values.chunks_exact_mut(gap*2) {
+            let (lo,hi)=chunk.split_at_mut(gap);
+            dit_quads(lo,hi,layer);
+        }
+        gap*=2;
+    }
+}
