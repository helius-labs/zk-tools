+
+struct WireRow {
+    wire: usize,
+    offset: Fr,
+}
+
+pub(super) struct WireCorrection {
+    rows: Vec<WireRow>,
+    pub a: G1Projective,
+    pub k: G1Projective,
+    pub b2: G2Projective,
+    _reservation: Reservation,
+}
+
+impl WireCorrection {
+    pub fn apply(&self, wires: &mut [Fr]) {
+        for row in &self.rows { wires[row.wire] -= row.offset; }
+        if std::env::var_os("ZOPRO_BENCH_OFFSET_TRACE").is_some() { eprintln!("WIRE_APPLY"); }
+    }
+}
+
+impl Key {
+    pub(super) fn prepare_wire_offsets(&self, plan: &solver::Plan, private: &[G1Affine]) -> Option<WireCorrection> {
+        use rayon::prelude::*;
+        use std::mem::size_of;
+        if self.b2.len()!=30089 || plan.b_indices.len()!=self.b2.len() || self.a.len()!=plan.a_indices.len() { return None; }
+        let count=OFFSETS.len()/36;
+        let charge=count.checked_mul(size_of::<WireRow>())?.checked_add(size_of::<WireCorrection>())?;
+        let _reservation=Reservation::analysis(Some(charge))?;
+        let scratch=count.checked_mul(size_of::<(Option<usize>,Option<usize>)>())?
+            .checked_add((2*64 + 16 + 2*rayon::current_num_threads().min(64)*23) * size_of::<G1Projective>())?;
+        let _temporary=Reservation::analysis(Some(scratch))?;
+        let b2=self.public_b2_offset.get_or_init(||prepare(&self.b2)).as_ref()?.point;
+        let mut rows=Vec::with_capacity(count);
+        let mut maps=Vec::with_capacity(count);
+        for row in OFFSETS.chunks_exact(36) {
+            let i=u32::from_le_bytes(row[..4].try_into().unwrap()) as usize;
+            let wire=*plan.b_indices.get(i)?;
+            let a=plan.a_indices.binary_search(&wire).ok();
+            let k=(wire as usize).checked_sub(plan.n_public);
+            if k.is_some_and(|j|j>=private.len()) {return None;}
+            maps.push((a,k));
+            rows.push(WireRow{wire:wire as usize,offset:Fr::from_canonical(super::words(&row[4..]))?});
+        }
+        let mut windows=[(G1Projective::IDENTITY,G1Projective::IDENTITY);64];
+        windows.par_iter_mut().enumerate().for_each(|(w,out)| {
+            let mut a=[G1Projective::IDENTITY;15]; let mut k=a;
+            for (row,(ia,ik)) in OFFSETS.chunks_exact(36).zip(&maps) {
+                let digit=(row[4+w/2]>>(4*(w%2))) & 15;
+                if digit>0 {
+                    let j=digit as usize-1;
+                    if let Some(i)=ia {a[j]+=self.a[*i];}
+                    if let Some(i)=ik {k[j]+=private[*i];}
+                }
+            }
+            let mut run=(G1Projective::IDENTITY,G1Projective::IDENTITY);
+            for j in (0..15).rev() {run.0+=a[j];run.1+=k[j];out.0+=run.0;out.1+=run.1;}
+        });
+        let (mut a,mut k)=(G1Projective::IDENTITY,G1Projective::IDENTITY);
+        for (wa,wk) in windows.iter().rev() {for _ in 0..4 {a=a.double();k=k.double();}a+=*wa;k+=*wk;}
+        if std::env::var_os("ZOPRO_BENCH_OFFSET_TRACE").is_some() {
+            eprintln!("WIRE_SETUP {} {} {} {charge} {scratch}",count,maps.iter().filter(|(a,_)|a.is_some()).count(),maps.iter().filter(|(_,k)|k.is_some()).count());
+        }
+        Some(WireCorrection{a,k,b2,rows,_reservation})
+    }
+}
