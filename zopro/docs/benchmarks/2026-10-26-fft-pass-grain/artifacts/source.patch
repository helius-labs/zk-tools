+#[cfg(test)]
+mod pass_grain_tests {
+    use super::*;
+
+    #[test]
+    fn packing_and_product_match_sparse_polynomial_oracle_across_pools() {
+        for workers in [1,4,32] {
+            rayon::ThreadPoolBuilder::new().num_threads(workers).stack_size(512*1024)
+                .build().unwrap().install(|| {
+                for n in [8usize,128,1024,8192,65536] {
+                    let root=Fr::root_of_unity(n).unwrap().pow(&[3]);
+                    let coset=Fr::from(5u64);
+                    let mut plan=Plan::new(n,root,coset,super::super::denominator(n,coset).unwrap());
+                    plan.prepare_euler_study();
+                    let eval=|terms:&[(usize,Fr)]| {
+                        let mut values=vec![Fr::ZERO;n];let mut derivative=vec![Fr::ZERO;n];
+                        for &(k,c) in terms {
+                            let step=root.pow(&[k as u64]);let mut x=c;
+                            for (v,d) in values.iter_mut().zip(&mut derivative){
+                                *v+=x;*d+=Fr::from(k as u64)*x;x*=step;
+                            }
+                        }
+                        (values,derivative)
+                    };
+                    let (a,da)=eval(&[(0,Fr::ONE),(1,Fr::from(7u64)),(n/2+1,Fr::from(13u64)),(n-1,-Fr::ONE)]);
+                    let (b,db)=eval(&[(2,Fr::from(11u64)),(n/3,Fr::from(19u64)),(n-2,Fr::from(23u64))]);
+                    let expected:Vec<_>=(0..n).map(|i|Fr::from(n as u64)*(da[i]*b[i]+a[i]*db[i])).collect();
+                    assert_eq!(euler_product_grained(&plan,a,b),expected,"workers={workers},n={n}");
+                    assert!(euler_product_grained(&plan,Vec::new(),Vec::new()).is_empty());
+                }
+            });
+        }
+    }
+
+    #[test]
+    fn partial_pointwise_rows_match_scalar_oracle_for_concurrent_small_stack_callers() {
+        let pool=rayon::ThreadPoolBuilder::new().num_threads(8).stack_size(512*1024).build().unwrap();
+        std::thread::scope(|scope| {
+            let mut callers=Vec::new();
+            for caller in 0..3u64 {
+                let pool=&pool;
+                callers.push(scope.spawn(move || pool.install(|| {
+                    for n in [0usize,1,3,4,7,8,9,127,128,129,255,256,257,1023,1024,1025,4095,4096,4097] {
+                        let count=n.div_ceil(8)*8;
+                        let rows:Vec<[Fr;4]>=(0..count).map(|i|core::array::from_fn(|j| {
+                            match (i+j+caller as usize)%7 {
+                                0=>Fr::ZERO,1=>Fr::ONE,2=>-Fr::ONE,
+                                _=>Fr::from(3+i as u64*17+j as u64+caller*101).pow(&[37]),
+                            }
+                        })).collect();
+                        let values:Vec<PackedPair>=rows.chunks(4).map(|q|PackedPair::store(
+                            Pair::new(&core::array::from_fn(|j|q[j%4][if j<4 {2}else{3}])))).collect();
+                        for nb in [0,n/3,n] {
+                            let mut a:Vec<_>=rows[..n].iter().map(|r|r[0]).collect();
+                            let b:Vec<_>=rows[..nb].iter().map(|r|r[1]).collect();
+                            let expected:Vec<_>=(0..n).map(|i|rows[i][2]*b.get(i).copied().unwrap_or(Fr::ZERO)+a[i]*rows[i][3]).collect();
+                            euler_combine_grained(&mut a,&b,&values);
+                            assert_eq!(a,expected,"caller={caller},n={n},nb={nb}");
+                        }
+                    }
+                })));
+            }
+            for caller in callers {caller.join().unwrap();}
+        });
+    }
