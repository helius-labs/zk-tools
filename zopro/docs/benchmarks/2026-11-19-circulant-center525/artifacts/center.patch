+#[inline(always)]
+fn circulant(x: &Pair, q: u64, n: u64, imaginary: &Pair) -> Pair {
+    let previous = Pair::shuffle_pair::<3, 0, 1, 2>(x, x);
+    let next = Pair::shuffle_pair::<1, 2, 3, 0>(x, x);
+    let opposite = Pair::shuffle_pair::<2, 3, 0, 1>(x, x);
