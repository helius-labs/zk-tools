+fn paired_window(bases: &[G2Affine], words: &[[u64; 4]], window: usize, bits: usize) -> Vec<G2Affine> {
+    let chunk = bases.len().div_ceil(4);
+    let fill = |part: usize| {
+        let start = (part * chunk).min(bases.len());
+        let end = (start + chunk).min(bases.len());
+        hb_window(&bases[start..end], &words[start..end], window, bits)
+    };
+    let pair = |first| {
+        let (mut left, right) = rayon::join(|| fill(first), || fill(first + 1));
+        merge_buckets(&mut left, &right);
+        left
+    };
+    let (mut left, right) = rayon::join(|| pair(0), || pair(2));
+    merge_buckets(&mut left, &right);
+    left
+}
