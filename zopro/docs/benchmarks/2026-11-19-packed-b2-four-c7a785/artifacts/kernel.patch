+/// Match the ordinary large B2 curve path on the compact prefix.
+pub(super) fn g2_query_ordinary_grouped(
+    bases: &[zopro_bn254::G2Affine], words: &[[u64; 4]],
+) -> zopro_bn254::G2Projective {
+    assert_eq!(bases.len(), words.len());
+    let groups = crate::simd::cpu_option("ZOPRO_CPU_DEDUP")
+        .then(|| grouping::groups_with_diversity_check(words))
+        .flatten();
+    match groups {
+        Some(groups) => msm_grouped(bases, &groups),
+        None => msm_raw(bases, words),
+    }
+}
