+#[cfg(test)]
+mod unsigned_split_tests {
+    use super::*;
+    use zopro_bn254::{G2Affine,G2Projective};
+    use crate::testing::Seeded;
+    #[test]
+    fn split_unsigned_windows_match_generator() {
+        let parent = rayon::ThreadPoolBuilder::new().num_threads(4).build().unwrap();
+        let front = rayon::ThreadPoolBuilder::new().num_threads(2).build().unwrap();
+        let mut r=Seeded::new(0x2377d03ee);
+        let mut expected=Fr::ZERO;
+        let mut point=G2Projective::IDENTITY;
+        let mut points=Vec::new();
+        let mut words=Vec::new();
+        for i in 1u64..2011 {
+            point+=G2Affine::GENERATOR;
+            let (mut p,mut weight)=(point.to_affine(),Fr::from(i));
+            if i%13==0 {p=-p;weight=-weight;}
+            if i%17==0 {p=G2Affine::IDENTITY;weight=Fr::ZERO;}
+            let s=if i%7==0 {Fr::ZERO} else {r.fr()};
+            expected+=s*weight;
+            points.push(p);
+            words.push(s.to_canonical());
+        }
+        let want=(G2Affine::GENERATOR*expected).to_affine();
+        parent.install(|| {
+            for (bits,parts) in [(10,1),(11,2),(12,3)] {
+                let ordinary=msm_unsigned_on(&points,&words,bits,parts,None);
+                assert_eq!(ordinary.to_affine(),want);
+                for n in [1,4,12] {
+                    let split=msm_unsigned_on(&points,&words,bits,parts,Some((&front,n)));
+                    assert_eq!(split.to_affine(),want);
+                }
+            }
+        });
+    }
+}
