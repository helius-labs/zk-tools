+#[cfg(all(zopro_resource_schedule, target_os = "linux", target_arch = "x86_64"))]
+pub(super) fn grouped_b2_split(
+    bases: &[zopro_bn254::G2Affine], groups: &ScalarGroups, frontend: &rayon::ThreadPool,
+) -> Option<zopro_bn254::G2Projective> {
+    static WINDOWS: std::sync::OnceLock<Option<usize>> = std::sync::OnceLock::new();
+    let windows = (*WINDOWS.get_or_init(|| std::env::var("ZOPRO_TRIAL_B2_FRONT_WINDOWS").ok()?.parse().ok()))?;
+    if !(65_536..262_144).contains(&bases.len()) || !(1024..65_536).contains(&groups.values.len())
+        || !crate::simd::cpu_option("ZOPRO_CPU_UNSIGNED")
+    {
+        return None;
+    }
+    assert_eq!(bases.len(), groups.len);
+    let workers=frontend.current_num_threads();
+    let (bits,parts)=unsigned_layout::<zopro_bn254::G2Config>(groups.values.len());
+    let count=(Fr::MODULUS_BITS as usize).div_ceil(bits);
+    if windows==0 || windows>=count || workers>=rayon::current_num_threads() {
+        return None;
+    }
+    let bytes = workspace::unsigned_b2_frontend_bytes(groups.values.len(),bits,parts,workers);
+    let budget = crate::preparation::Reservation::analysis(bytes);
+    if std::env::var_os("ZOPRO_TRIAL_B2_FRONT_TRACE").is_some() {
+        eprintln!("B2_FRONT_WINDOWS {} {windows} {workers} {}",bases.len(),budget.is_some());
+    }
+    let _budget=budget?;
+    let points = crate::msm::group_affine(bases,&groups.order,&groups.starts,&groups.counts);
+    Some(msm_unsigned_on(&points,&groups.values,bits,parts,Some((frontend,windows))))
+}
