+
+fn finish<C: CurveConfig>(partials: Vec<[(Projective<C>, Affine<C>); 2]>) -> Projective<C> {
  let(mut sum,mut offset,mut running)=(Projective::<C>::IDENTITY,Projective::<C>::IDENTITY,Projective::<C>::IDENTITY);
  for pair in partials.into_iter().rev(){for(weighted,total)in pair.into_iter().rev(){sum+=weighted;offset+=running;running+=total;}}
  for _ in 0..GROUP.ilog2(){offset=offset.double();}sum+offset
 }
+/// Merge one tile's two input ranges and immediately reduce its weighted tree.
+pub(crate) fn try_merged<C: CurveConfig>(
+    left: &mut [Affine<C>], right: &[Affine<C>]
+) -> Option<Projective<C>>
+where C::Base: BatchInverse,
+{
+    if left.len() != right.len() || left.is_empty() || left.len() % (2 * GROUP) != 0 {
+        return None;
+    }
+    let tasks = (left.len() / (2 * GROUP)).min(rayon::current_num_threads());
+    let extra = workspace::<C>(2 * GROUP)?
+        .saturating_sub(workspace_weighted::<C>(GROUP)?)
+        .checked_mul(tasks)?;
+    let _reservation = crate::preparation::Reservation::analysis(Some(extra))?;
+    if std::env::var_os("ZOPRO_BENCH_H_MERGE_TRACE").is_some() {
+        eprintln!("H_MERGE_CHUNKS");
+    }
+    let partials = left.par_chunks_mut(2 * GROUP).zip(right.par_chunks(2 * GROUP))
+        .map(|(lhs, rhs)| {
+            crate::msm_affine::merge_bucket_chunk(lhs, rhs);
+            forest::<C>(lhs, &mut Vec::new(), &mut scratch::<C>())
+        }).collect();
+    Some(finish(partials))
+}
