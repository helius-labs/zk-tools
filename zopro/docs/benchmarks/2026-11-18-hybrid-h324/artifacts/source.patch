+#[derive(Clone, Copy)]
+enum SignedWindows { AllLower, WideOnly }
+
+fn signed_window(shape: SignedWindows, widths: &[usize], i: usize) -> bool {
+    i + 1 < widths.len() && (matches!(shape, SignedWindows::AllLower) || widths[i] == 14)
+}
+
+#[inline(always)]
+fn field_at(words: &[u64; 4], offset: usize, bits: usize) -> u32 {
+    let lane = offset / 64;
+    let shift = offset % 64;
+    let mut field = words[lane] >> shift;
+    if shift + bits > 64 { field |= words[lane + 1] << (64 - shift); }
+    (field & ((1 << bits) - 1)) as u32
+}
+
+#[inline(always)]
+fn hybrid_digit<const SIGNED: bool>(words: &[u64; 4], offset: usize, bits: usize, carry_in: bool) -> i16 {
+    let (raw, carry) = if carry_in {
+        let adjacent = field_at(words, offset - 1, bits + 1);
+        (adjacent >> 1, (adjacent & 1) as i32)
+    } else {
+        (field_at(words, offset, bits), 0)
+    };
+    let sign = 1u32 << (bits - 1);
+    let value = if SIGNED { (raw ^ sign) as i32 - sign as i32 } else { raw as i32 };
+    (value + carry) as i16
+}
+
+#[inline(never)]
+fn hybrid_sum<C: CurveConfig>(bases: &[Affine<C>], words: &[[u64;4]], widths: &[usize], offsets: &[usize], mode: SignedWindows) -> Projective<C>
+where C::Base: BatchInverse {
+    let sums: Vec<_> = (0..widths.len()).into_par_iter().map(|i| {
+        let bits = widths[i];
+        let carry_in = i > 0 && signed_window(mode, widths, i - 1);
+        let buckets = if signed_window(mode, widths, i) {
+            let digits = words.iter().map(|s| hybrid_digit::<true>(s, offsets[i], bits, carry_in));
+            fill_window_impl::<C,false,false>(bases,digits,bits,batch_size(bits).max(32))
+        } else {
+            let digits = words.iter().map(|s| hybrid_digit::<false>(s, offsets[i], bits, carry_in));
+            fill_window_impl::<C,false,true>(bases,digits,bits + 1,batch_size(bits + 1).max(32))
+        };
+        crate::msm::weighted_affine(&affine_buckets(buckets))
+    }).collect();
+    let mut result = *sums.last().unwrap();
+    for i in (0..sums.len()-1).rev() {
+        for _ in 0..widths[i] { result = result.double(); }
+        result += sums[i];
+    }
+    result
+}
