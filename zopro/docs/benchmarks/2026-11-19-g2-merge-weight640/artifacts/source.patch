+// Both modes allocate the forest only after a tile's merge temporaries are gone.
+pub(crate) fn merge_then_weight<C: CurveConfig>(
+    left: &mut [Affine<C>],
+    right: &[Affine<C>],
+    fused: bool,
+) -> Option<Projective<C>>
+where
+    C::Base: BatchInverse,
+{
+    let needed = workspace::<C>(left.len())?;
+    if left.len() != right.len() || needed > workspace_weighted::<C>(left.len())? {
+        return None;
+    }
+    if !fused {
+        left.par_chunks_mut(2 * GROUP)
+            .zip(right.par_chunks(2 * GROUP))
+            .for_each(|(a, b)| crate::msm_affine::merge_bucket_block(a, b));
+    }
+    let partials = left.par_chunks_mut(2 * GROUP)
+        .zip(right.par_chunks(2 * GROUP))
+        .map(|(a, b)| {
+            if fused {
+                crate::msm_affine::merge_bucket_block(a, b);
+            }
+            forest(a, &mut Vec::new(), &mut scratch::<C>())
+        })
+        .collect();
+    Some(combine(partials))
+}
