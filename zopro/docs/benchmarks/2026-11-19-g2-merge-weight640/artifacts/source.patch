+#[test]
+fn merged_g2_ranges_match_weighted_generator_for_exceptions_and_multiple_tiles() {
+    for n in [512usize, 2048] {
+        let (left, weights) = fixture::<G2Config>(n, 0);
+        let mut right = left.clone();
+        let mut coefficients = weights.clone();
+        for i in 0..n {
+            match i % 4 {
+                0 => { right[i] = -left[i]; coefficients[i] = -weights[i]; }
+                1 => { right[i] = Affine::IDENTITY; coefficients[i] = Fr::ZERO; }
+                2 => { let j = (i + 1) % n; right[i] = left[j]; coefficients[i] = weights[j]; }
+                _ => (),
+            }
+        }
+        let total = weights.iter().zip(&coefficients).enumerate().fold(Fr::ZERO,
+            |s, (i, (l, r))| s + (*l + *r) * Fr::from((i + 1) as u64));
+        let expected = (Projective::<G2Config>::generator() * total).to_affine();
+        for fused in [false, true] {
+            let mut out = left.clone();
+            assert!(merge_then_weight(&mut out[..n-1], &right[..n-1], fused).is_none());
+            assert_eq!(out, left);
+            assert_eq!(merge_then_weight(&mut out, &right, fused).unwrap().to_affine(), expected);
+        }
+    }
