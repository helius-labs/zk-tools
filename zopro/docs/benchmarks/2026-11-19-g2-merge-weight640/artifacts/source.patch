+pub(crate) fn merge_bucket_block<C: CurveConfig>(left: &mut [Affine<C>], right: &[Affine<C>])
+where
+    C::Base: BatchInverse,
+{
+    let mut pairs = Vec::with_capacity(left.len());
+    for (i, (a, &b)) in left.iter_mut().zip(right).enumerate() {
+        if a.is_identity() {
+            *a = b;
+        } else if b.is_identity() {
+        } else if a.x == b.x {
+            *a = (*a + b).to_affine();
+        } else {
+            pairs.push((i as u32, b));
+        }
+    }
+    if !pairs.is_empty() {
+        BatchAdd::<C>::default().apply(left, &pairs);
+    }
 }
 
