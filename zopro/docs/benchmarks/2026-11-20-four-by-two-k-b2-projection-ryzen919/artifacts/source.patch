+pub(crate) fn k_b2_projection_mode() -> Option<(bool, bool)> {
+    static MODE: OnceLock<Option<(bool, bool)>> = OnceLock::new();
+    *MODE.get_or_init(|| {
+        let trace = std::env::var_os("ZOPRO_919_TRACE").is_some();
+        match std::env::var("ZOPRO_919_PROJECTION").as_deref() {
+            Ok("gate") => Some((false,trace)),
+            Ok("projected") => Some((true,trace)),
+            _ => None,
+        }
+    })
 }
 
