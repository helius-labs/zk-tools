+//! Use the folded private K wire projection to classify B2 without hashing it.
+use super::*;
+
+const MISSING: u32 = u32::MAX;
+
+struct B2Classes {
+    shared: Vec<u32>,
+    counts: Vec<usize>,
+    rows: Vec<u32>,
+}
+
+fn project_classes(
+    k: &[[u64; 4]],
+    k_rows: &[u32],
+    k_values: &[[u64; 4]],
+    b: &[[u64; 4]],
+    wires: &[u32],
+    n_public: usize,
+) -> Option<B2Classes> {
+    if b.len() != wires.len() {
+        return None;
+    }
+    let mut ids = vec![MISSING; k_values.len()];
+    let mut result = B2Classes {
+        shared: Vec::with_capacity(k_values.len()),
+        counts: Vec::with_capacity(k_values.len()),
+        rows: Vec::with_capacity(b.len()),
+    };
+    for (&value, &wire) in b.iter().zip(wires) {
+        let source = if let Some(i) = (wire as usize).checked_sub(n_public) {
+            if *k.get(i)? != value {
+                return None;
+            }
+            k_rows[i]
+        } else if value == [0; 4] {
+            MISSING
+        } else {
+            // The image supplies the public wire IDs, but their values
+            // need independent exact lookup. Unrepresented values fall
+            // back to independent grouping for the whole query.
+            k_values.iter().position(|&v| v == value)? as u32
+        };
+        if source == MISSING {
+            result.rows.push(MISSING);
+            continue;
+        }
+        let local = &mut ids[source as usize];
+        if *local == MISSING {
+            *local = result.shared.len() as u32;
+            result.shared.push(source);
+            result.counts.push(0);
+        }
+        result.counts[*local as usize] += 1;
+        result.rows.push(*local);
+    }
+    Some(result)
+}
+
+pub(crate) fn project_k_b2(
+    k: &[Fr],
+    b: &[Fr],
+    b_wires: &[u32],
+    n_public: usize,
+) -> Option<(ScalarGroups, ScalarGroups)> {
+    if !crate::simd::cpu_option("ZOPRO_CPU_DEDUP")
+        || !(65_536..262_144).contains(&k.len())
+        || !(65_536..262_144).contains(&b.len())
+        || b.len() != b_wires.len()
+        || n_public > 8
+    {
+        return None;
+    }
+    let (k, b) = (k.as_flattened_words(), b.as_flattened_words());
+    let zero_aware = std::env::var("ZOPRO_CPU_ZERO_AWARE_GROUPS").as_deref() == Ok("1");
+    let (sample, k_percent) = grouping_sample(k, zero_aware)?;
+    let (_, b_percent) = grouping_sample(b, zero_aware)?;
+    let capacity = if crate::simd::cpu_option("ZOPRO_CPU_RESERVE_GROUPS") {
+        (sample.len() * 16)
+            .min(k.len() * k_percent / 100)
+            .min(32768)
+    } else {
+        0
+    };
+    drop(sample);
+
+    // Keep both existing worst-case group reservations and also charge the
+    // extra shared-ID map and local references, even when only one curve
+    // holds on to the remaining output.
+    let extra = grouping_cost::vector::<u32>(k.len(), false)?.checked_mul(2)?;
+    let k_owner = crate::preparation::Reservation::analysis(
+        grouping_cost::peak(k.len(), k_percent)?.checked_add(extra),
+    )?;
+    let b_owner = grouping_cost::reserve(b.len(), b_percent)?;
+    let mut k_rows = vec![MISSING; k.len()];
+    let (mut k_values, k_counts) =
+        classify_nonzero(k, &mut k_rows, capacity, ahash::RandomState::new());
+    if k_values.len() * 100 > k.len() * k_percent {
+        return None;
+    }
+    let projected = project_classes(k, &k_rows, &k_values, b, b_wires, n_public)?;
+    if projected.shared.len() * 100 > b.len() * b_percent {
+        return None;
+    }
+
+    k_values
+        .par_iter_mut()
+        .for_each(|v| *v = Fr::from_montgomery(*v).to_canonical());
+    let b_values = projected
+        .shared
+        .iter()
+        .map(|&id| k_values[id as usize])
+        .collect();
+    Some((
+        pack_groups(k.len(), k_values, k_counts, k_rows, k_owner),
+        pack_groups(b.len(), b_values, projected.counts, projected.rows, b_owner),
+    ))
+}
+
+// Fr is transparent over its four limbs. Like the ordinary group classifier,
+// the projection only reads this shared view of initialized Montgomery words.
+trait WordView {
+    fn as_flattened_words(&self) -> &[[u64; 4]];
+}
+impl WordView for [Fr] {
+    fn as_flattened_words(&self) -> &[[u64; 4]] {
+        unsafe { std::slice::from_raw_parts(self.as_ptr().cast::<[u64; 4]>(), self.len()) }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn projected_b2_matches_first_occurrence_grouping_and_fallbacks() {
+        for n in 0..96 {
+            let k: Vec<_> = (0..n).map(|i| Fr::from(((i * 19) % 31) as u64).0).collect();
+            let mut k_rows = vec![MISSING; n];
+            let (k_values, _) = classify_nonzero(&k, &mut k_rows, 0, ahash::RandomState::new());
+            let mut b = vec![[0; 4]];
+            let mut wires = vec![0];
+            for i in (0..n).step_by(2).rev() {
+                b.push(k[i]);
+                wires.push((i + 2) as u32);
+            }
+            if let Some(first) = k_values.first() {
+                b.push(*first);
+                wires.push(1);
+            }
+            let projected = project_classes(&k, &k_rows, &k_values, &b, &wires, 2).unwrap();
+            let mut ordinary_rows = vec![MISSING; b.len()];
+            let (ordinary_values, ordinary_counts) =
+                classify_nonzero(&b, &mut ordinary_rows, 0, ahash::RandomState::new());
+            let values: Vec<_> = projected
+                .shared
+                .iter()
+                .map(|&v| k_values[v as usize])
+                .collect();
+            assert_eq!(ordinary_values, values);
+            assert_eq!(ordinary_counts, projected.counts);
+            assert_eq!(ordinary_rows, projected.rows);
+            assert!(project_classes(&k, &k_rows, &k_values, &b[..0], &wires, 2).is_none());
+            b[0] = Fr::from(87623).0;
+            assert!(project_classes(&k, &k_rows, &k_values, &b, &wires, 2).is_none());
+            b[0] = [0; 4];
+            if n != 0 {
+                b[1] = Fr::from(87624).0;
+                assert!(project_classes(&k, &k_rows, &k_values, &b, &wires, 2).is_none());
+                wires[1] = u32::MAX;
+                assert!(project_classes(&k, &k_rows, &k_values, &b, &wires, 2).is_none());
+            }
+        }
+    }
+}
