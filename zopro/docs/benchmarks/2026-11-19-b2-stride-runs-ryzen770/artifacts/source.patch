+/// Collapse chains of equal scalars separated by a candidate stride before
+/// inserting their representatives into the exact hash table.
+pub(crate) fn group_witness_runs(scalars: &[Fr], stride: usize) -> Option<ScalarGroups> {
+    if !crate::simd::cpu_option("ZOPRO_CPU_DEDUP")
+        || scalars.len() < 256 || scalars.len() >= u32::MAX as usize
+        || stride == 0 || stride >= scalars.len()
+    {
+        return None;
+    }
+    // SAFETY: Fr is repr(transparent) over four initialized u64 limbs.
+    let words = unsafe { std::slice::from_raw_parts(scalars.as_ptr().cast::<[u64; 4]>(), scalars.len()) };
+    let zero_aware = std::env::var("ZOPRO_CPU_ZERO_AWARE_GROUPS").as_deref() == Ok("1");
+    let (sample, percent) = grouping_sample(words, zero_aware)?;
+    let reservation = grouping_cost::reserve(words.len(), percent)?;
+    let n = words.len();
+    let tiles = n.div_ceil(RUN_TILE);
+    let scratch_bytes = grouping_cost::add(
+        grouping_cost::mul(tiles, grouping_cost::vector::<Vec<ScalarRun>>(1, false)?)?,
+        grouping_cost::vector::<ScalarRun>(n, false)?,
+    )?;
+    let scratch = crate::preparation::Reservation::analysis(Some(scratch_bytes))?;
+    let mut runs = scalar_runs(words, stride);
+    if std::env::var_os("ZOPRO_TRIAL_B2_PHASES").is_some() {
+        let representatives: usize = runs.iter().map(Vec::len).sum();
+        eprintln!("B2_RUNS {n} {stride} {representatives}");
+    }
+    let input_capacity = if crate::simd::cpu_option("ZOPRO_CPU_RESERVE_GROUPS") {
+        (sample.len() * 16).min(n * percent / 100).min(32768)
+    } else {
+        0
+    };
+
+    let (mut values, counts) = group_runs(words, &mut runs, input_capacity, ahash::RandomState::new());
+    if values.len() * 100 > n * percent {
+        return None;
+    }
+    let mut starts = Vec::with_capacity(counts.len() + 1);
+    starts.push(0);
+    for count in &counts {
+        starts.push(starts.last().unwrap() + count);
+    }
+    let mut positions = starts[..counts.len()].to_vec();
+    let mut order = vec![0u32; *starts.last().unwrap()];
+    for run in runs.into_iter().flatten() {
+        let k = run.class as usize;
+        let start = positions[k];
+        for (j, slot) in order[start..start + run.len as usize].iter_mut().enumerate() {
+            *slot = (run.first as usize + j * stride) as u32;
+        }
+        positions[k] += run.len as usize;
+    }
+    drop(scratch);
+    values.par_iter_mut().for_each(|v| *v = Fr::from_montgomery(*v).to_canonical());
+    Some(ScalarGroups { len: n, values, order, starts, counts, _reservation: reservation })
+}
+
+const RUN_TILE: usize = 2048;
+
+struct ScalarRun {
+    first: u32,
+    len: u32,
+    class: u32,
+}
+
+fn scalar_runs(words: &[[u64; 4]], stride: usize) -> Vec<Vec<ScalarRun>> {
+    words.par_chunks(RUN_TILE).enumerate().map(|(tile, chunk)| {
+        let offset = tile * RUN_TILE;
+        let mut runs = Vec::with_capacity(chunk.len());
+        for (j, scalar) in chunk.iter().enumerate() {
+            let i = offset + j;
+            if *scalar == [0; 4] || (i >= stride && words[i - stride] == *scalar) {
+                continue;
+            }
+            let len = 1 + words[i + 1..].iter().skip(stride - 1)
+                .step_by(stride).take_while(|&x| x == scalar).count();
+            runs.push(ScalarRun { first: i as u32, len: len as u32, class: u32::MAX });
+        }
+        runs
+    }).collect()
+}
+
+fn group_runs(
+    words: &[[u64; 4]],
+    runs: &mut [Vec<ScalarRun>],
+    capacity: usize,
+    state: impl std::hash::BuildHasher,
+) -> (Vec<[u64; 4]>, Vec<usize>) {
+    use hashbrown::{hash_table::Entry, HashTable};
+    let mut table = HashTable::<u32>::with_capacity(capacity);
+    let mut values = Vec::new();
+    let mut counts = Vec::new();
+    for run in runs.iter_mut().flatten() {
+        let value = words[run.first as usize];
+        let index = match table.entry(
+            state.hash_one(value),
+            |&i| values[i as usize] == value,
+            |&i| state.hash_one(&values[i as usize]),
+        ) {
+            Entry::Occupied(entry) => *entry.get(),
+            Entry::Vacant(entry) => {
+                let index = values.len() as u32;
+                values.push(value);
+                counts.push(0);
+                entry.insert(index);
+                index
+            }
+        };
+        run.class = index;
+        counts[index as usize] += run.len as usize;
+    }
+    (values, counts)
 }
 
