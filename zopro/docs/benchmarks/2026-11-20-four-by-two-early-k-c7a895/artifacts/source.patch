     static TRACE: OnceLock<bool> = OnceLock::new();
     if *TRACE.get_or_init(|| std::env::var_os("ZOPRO_892_TRACE").is_some()) {
         eprintln!("ZP892_PLACEMENT {query} {}", rayon::current_num_threads());
+    }
+}
+
+pub(crate) fn k_overlap_mode() -> Option<bool> {
+    static EARLY: OnceLock<Option<bool>> = OnceLock::new();
+    *EARLY.get_or_init(|| match std::env::var("ZOPRO_895_K_OVERLAP").as_deref() {
+        Ok("early") => Some(true),
+        Ok("late") => Some(false),
+        _ => None,
+    })
+}
+
+pub(crate) fn k_overlap_clock() -> Option<Instant> {
+    static CLOCK: OnceLock<bool> = OnceLock::new();
+    CLOCK.get_or_init(|| std::env::var_os("ZOPRO_895_CLOCK").is_some()).then(Instant::now)
+}
+
+pub(crate) struct Stage {
+    start: u128,
+    end: u128,
+    workers: usize,
+}
+
+pub(crate) fn k_overlap_span<T>(
+    clock: Option<Instant>, compute: impl FnOnce() -> T,
+) -> (T, Option<Stage>) {
+    let start = clock.map(|t| t.elapsed().as_nanos());
+    let result = compute();
+    let span = clock.zip(start).map(|(t, start)| Stage {
+        start,
+        end: t.elapsed().as_nanos(),
+        workers: rayon::current_num_threads(),
+    });
+    (result, span)
+}
+
+pub(crate) fn k_overlap_report(
+    early: bool, points: usize, fft: Option<Stage>, k: Option<Stage>, curves: Option<Stage>,
+) {
+    let mode = if early { "early" } else { "late" };
+    static TRACE: OnceLock<bool> = OnceLock::new();
+    if *TRACE.get_or_init(|| std::env::var_os("ZOPRO_895_TRACE").is_some()) {
+        eprintln!("ZP895_ROUTE {mode} {points}");
+    }
+    if let (Some(fft), Some(k), Some(curves)) = (fft, k, curves) {
+        eprintln!("ZP895_SPAN {mode} {} {} {} {} {} {} {} {} {}",
+            fft.start, fft.end, fft.workers, k.start, k.end, k.workers,
+            curves.start, curves.end, curves.workers);
     }
 }
 
