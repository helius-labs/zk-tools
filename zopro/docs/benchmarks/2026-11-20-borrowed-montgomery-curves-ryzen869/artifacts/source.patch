+#[cfg(all(test, target_arch = "x86_64", target_os = "linux", target_feature = "avx512ifma", target_feature = "avx512vl", target_feature = "avx512dq", feature = "ifma8", not(no_ifma)))]
+#[test]
+fn montgomery_curve_witnesses_have_one_common_factor() {
+    let mut rng = testing::Seeded::new(0x8721_2b9e);
+    let mut scalars = vec![Fr::ZERO, Fr::ONE, -Fr::ONE];
+    scalars.extend((0..18).map(|_| rng.fr()));
+    let inverse_r = Fr::from_montgomery([1, 0, 0, 0]);
+    let mut direct = Fr::ZERO;
+    let mut encoded = Fr::ZERO;
+    for (i, (&scalar, &words)) in scalars.iter().zip(montgomery_words(&scalars)).enumerate() {
+        let factor = Fr::from(i as u64 + 1);
+        direct += scalar * factor;
+        encoded += Fr::from_canonical(words).unwrap() * factor;
+    }
+    assert_eq!((G1Affine::GENERATOR * direct).to_affine(),
+               ((G1Affine::GENERATOR * encoded) * inverse_r).to_affine());
+    assert_eq!((G2Affine::GENERATOR * direct).to_affine(),
+               ((G2Affine::GENERATOR * encoded) * inverse_r).to_affine());
 }
 
