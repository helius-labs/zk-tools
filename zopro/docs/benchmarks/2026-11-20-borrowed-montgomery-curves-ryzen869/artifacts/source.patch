+fn montgomery_words(values: &[Fr]) -> &[[u64; 4]] {
+    // SAFETY: the native field is repr(transparent) over four initialized
+    // limbs. This shared view cannot outlive the input borrow.
+    unsafe { std::slice::from_raw_parts(values.as_ptr().cast::<[u64; 4]>(), values.len()) }
+}
