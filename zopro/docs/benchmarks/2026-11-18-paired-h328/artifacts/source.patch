+// Two disjoint digit fields revisit the same tile while the base points and
+// scalar words are hot. Each field owns its collision queue and batch state.
+fn paired<C: CurveConfig>(bases: &[Affine<C>], words: &[[u64; 4]], tile: usize) -> Projective<C>
+where
+    C::Base: BatchInverse,
+{
+    assert_eq!(bases.len(), words.len());
+    let mut offset = 0;
+    let fields: Vec<_> = WIDTHS
+        .iter()
+        .map(|&bits| {
+            let start = offset;
+            offset += bits;
+            (bits, start)
+        })
+        .collect();
+    let pairs: Vec<_> = fields
+        .par_chunks(2)
+        .map(|pair| {
+            let left = pair[0];
+            let mut wl = Window::<C>::new(1 << left.0, batch_size(left.0 + 1).max(32));
+            let mut wr = pair
+                .get(1)
+                .map(|right| Window::<C>::new(1 << right.0, batch_size(right.0 + 1).max(32)));
+            for (points, scalars) in bases.chunks(tile).zip(words.chunks(tile)) {
+                feed(points, scalars, &mut wl, left);
+                if let (Some(&right), Some(w)) = (pair.get(1), wr.as_mut()) {
+                    feed(points, scalars, w, right);
+                }
+            }
+            let right = wr.map(|w| finish(w));
+            (finish(wl), right)
+        })
+        .collect();
+    let mut sums = Vec::with_capacity(WIDTHS.len());
+    for (left, right) in pairs {
+        sums.push(left);
+        sums.extend(right);
+    }
+    combine(&sums)
+}
+
+fn feed<C: CurveConfig>(
+    bases: &[Affine<C>],
+    words: &[[u64; 4]],
+    window: &mut Window<C>,
+    field: (usize, usize),
+) where
+    C::Base: BatchInverse,
+{
+    let (bits, offset) = field;
+    let lane = offset / 64;
+    let shift = offset % 64;
+    let mask = (1u64 << bits) - 1;
+    let size = batch_size(bits + 1).max(32);
+    // Hoist the cross-limb condition out of the hot scan.
+    let mut step = |base: Affine<C>, raw: u64| {
+        let digit = (raw & mask) as usize;
+        if digit == 0 || base.is_identity() {
+            return;
+        }
+        let k = digit - 1;
+        if window.busy(k) {
+            window.queue.push((k as u32, base));
+            if window.queue.len() == size - 1 {
+                window.flush_queue();
+            }
+        } else {
+            window.add_signed(k as u32, base);
+            if window.batch.len() == size {
+                window.execute();
+                window.take_from_queue();
+            }
+        }
+    };
+    if shift + bits <= 64 {
+        for (&point, scalar) in bases.iter().zip(words) {
+            step(point, scalar[lane] >> shift);
+        }
+    } else {
+        for (&point, scalar) in bases.iter().zip(words) {
+            step(
+                point,
+                (scalar[lane] >> shift) | (scalar[lane + 1] << (64 - shift)),
+            );
+        }
+    }
+}
+
+fn finish<C: CurveConfig>(mut w: Window<C>) -> Projective<C>
+where
+    C::Base: BatchInverse,
+{
+    w.execute();
+    w.flush_queue();
+    crate::msm::weighted_affine(&affine_buckets(w))
 }
 
