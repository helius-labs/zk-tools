+impl Ifma8<crate::FrConfig, false> {
+    /// Low halves of two adjacent inverse DIF layers, in the R260 representation.
+    /// All four inputs and the twiddle lie below 2p. The radix-52 pairwise
+    /// sums are retained per limb until the final sum and difference are formed.
+    #[inline(always)]
+    pub fn radix4_low(a: &Self, b: &Self, c: &Self, d: &Self, root: &Self) -> (Self, Self) {
+        let twice = const { crate::portable::add4(crate::FrConfig::P, crate::FrConfig::P).0 };
+        let four = const {
+            let two = crate::portable::add4(crate::FrConfig::P, crate::FrConfig::P).0;
+            crate::portable::add4(two, two).0
+        };
+        // a+b+c+d < 8p. Two conditional subtractions map it below 2p.
+        // 0 <= 4p+(a+b)-(c+d) < 8p. REDC with root < 2p gives
+        // less than p+16p²/R < 2p. Only the normalized outputs escape.
+        unsafe {
+            let mask = Self::splat(MASK);
+            let bias = split(four).map(Self::splat);
+            let mut sum = [Self::splat(0); 5];
+            let mut diff = sum;
+            let mut sum_carry = Self::splat(0);
+            let mut diff_carry = Self::splat(0);
+            for j in 0..5 {
+                let left = _mm512_add_epi64(a.0[j], b.0[j]);
+                let right = _mm512_add_epi64(c.0[j], d.0[j]);
+                let total = _mm512_add_epi64(_mm512_add_epi64(left, right), sum_carry);
+                let delta = _mm512_add_epi64(_mm512_add_epi64(_mm512_sub_epi64(left, right), bias[j]), diff_carry);
+                sum[j] = _mm512_and_si512(total, mask);
+                diff[j] = _mm512_and_si512(delta, mask);
+                sum_carry = _mm512_srli_epi64::<52>(total);
+                diff_carry = _mm512_srai_epi64::<52>(delta);
+            }
+            let low = Self::reduce(Self::reduce(sum, four).0, twice);
+            (low, Self(diff, PhantomData).mul(root))
+        }
+    }
+}
