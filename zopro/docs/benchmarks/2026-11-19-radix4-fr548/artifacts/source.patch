+    fn radix4_low_matches_scalar_field_and_bounds() {
+        use crate::portable::{add4,less,sub4};
+        type V = Ifma8<FrConfig, false>;
+        let p = FrConfig::P;
+        let twice = add4(p,p).0;
+        let one = [1,0,0,0];
+        let mut values = vec![[0;4],one,sub4(p,one).0,p,add4(p,one).0,sub4(twice,one).0];
+        for bit in [51,52,63,64,103,104,127,128,155,156,191,192,207,208,253] {
+            let mut x = [0;4]; x[bit/64] = 1 << (bit%64);
+            values.extend([sub4(x,one).0,x,add4(x,one).0]);
+        }
+        let mut seed=0xae9102e51u64;
+        for _ in 0..96 {
+            let mut bytes=[0u8;64];
+            for w in bytes.chunks_exact_mut(8) {
+                seed ^= seed << 13; seed ^= seed >> 7; seed ^= seed << 17;
+                w.copy_from_slice(&seed.to_le_bytes());
+            }
+            let x=Fp::<FrConfig>::from_random_bytes(&bytes).0;
+            values.push(if seed&1 == 0 {x} else {add4(p,x).0});
+        }
+        for i in 0..values.len() {
+            for j in 0..values.len() {
+                let left=V::raw(&core::array::from_fn(|l|values[(i+l)%values.len()]));
+                let right=V::raw(&core::array::from_fn(|l|values[(j+2*l)%values.len()]));
+                let root=V::raw(&core::array::from_fn(|l|values[(i*7+j*3+l)%values.len()]));
+                let c=V::raw(&core::array::from_fn(|l|values[(j*3+l)%values.len()]));
+                let d=V::raw(&core::array::from_fn(|l|values[(i*5+2*l)%values.len()]));
+                let (sum,product)=V::radix4_low(&left,&right,&c,&d,&root);
+                let (x,y,z,t,w)=(left.get(),right.get(),c.get(),d.get(),root.get());
+                assert_eq!(sum.get(),core::array::from_fn(|k|x[k]+y[k]+z[k]+t[k]));
+                assert_eq!(product.get(),core::array::from_fn(|k|(x[k]+y[k]-z[k]-t[k])*w[k]));
+                for v in [sum,product] {
+                    let limbs:[[u64;8];5]=v.0.map(|word|unsafe {core::mem::transmute(word)});
+                    for k in 0..8 {
+                        assert!(limbs.iter().all(|t|t[k]<=MASK) && limbs[4][k] < 1<<48);
+                    }
+                    let packed:[[u64;8];4]=v.compact().0.map(|word|unsafe {core::mem::transmute(word)});
+                    for k in 0..8 {assert!(less(core::array::from_fn(|j|packed[j][k]),twice));}
+                }
+            }
+        }
+    }
