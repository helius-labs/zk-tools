--- /dev/null
+++ b/crates/zopro-core/src/public_b2_offset.rs
@@ -0,0 +1,42 @@
+use super::*;
+use std::sync::OnceLock;
+
+const PUBLIC_FIXTURE: &[u8] = include_bytes!("public_b2_sensitivity.bin");
+
+pub(super) struct Correction {
+    prefix: usize,
+    suffix_sum: G2Projective,
+}
+
+impl Key {
+    pub(super) fn b2_with_public_offset(&self, words: &mut [[u64;4]]) -> G2Projective {
+        let prefix = match std::env::var("ZOPRO_BENCH_SENSITIVITY").as_deref() {
+            Ok("half") => words.len() / 2,
+            Ok("quarter") => words.len() / 4,
+            Ok("none") => 0,
+            _ => return msm_affine::g2_query_exclusive(&self.b2, words),
+        };
+        if self.b2.len() * 32 != PUBLIC_FIXTURE.len() {
+            return msm_affine::g2_query_exclusive(&self.b2, words);
+        }
+        let (head, tail) = words.split_at_mut(prefix);
+        // This diagnostic binary runs on little-endian x86. A byte slice can
+        // view all initialized scalar limbs without alignment or padding.
+        let bytes = unsafe { std::slice::from_raw_parts(tail.as_ptr().cast::<u8>(), std::mem::size_of_val(tail)) };
+        let trace = std::env::var_os("ZOPRO_BENCH_SENSITIVITY_TRACE").is_some();
+        if bytes != &PUBLIC_FIXTURE[prefix * 32..] {
+            if trace { eprintln!("SENSITIVITY_MISS"); }
+            return msm_affine::g2_query_exclusive(&self.b2, words);
+        }
+        let slot: &OnceLock<Option<Correction>> = &self.public_b2_offset;
+        let state = slot.get_or_init(|| {
+            if trace { eprintln!("SENSITIVITY_INIT"); }
+            Some(Correction {prefix, suffix_sum: msm_affine::g2_query_exclusive(&self.b2[prefix..], tail)})
+        }).as_ref().unwrap();
+        assert_eq!(state.prefix, prefix);
+        if trace { eprintln!("SENSITIVITY_APPLY {prefix}"); }
+        if head.is_empty() { state.suffix_sum } else {
+            msm_affine::g2_query_exclusive(&self.b2[..prefix], head) + state.suffix_sum
+        }
+    }
+}
