+fn record_scalar_counts(label: &str, words: &[[u64; 4]], grouped: Option<&ScalarGroups>) {
+    // Diagnostics for public fixtures. Emit only aggregate counts.
+    use std::collections::HashMap;
+    let mut freq = HashMap::new();
+    let mut zero = 0usize;
+    let mut short = 0usize;
+    for word in words {
+        if *word == [0; 4] {
+            zero += 1;
+        } else {
+            *freq.entry(*word).or_insert(0usize) += 1;
+            short += usize::from(word[1..] == [0; 3]);
+        }
+    }
+    let largest = freq.values().copied().max().unwrap_or(0);
+    let single = freq.values().filter(|v| **v == 1).count();
+    eprintln!("QUERY_COUNTS {} {} {} {} {} {} {} {}", label, words.len(), zero, short,
+        freq.len(), single, largest, grouped.map_or(0, |g| g.values.len()));
+}
