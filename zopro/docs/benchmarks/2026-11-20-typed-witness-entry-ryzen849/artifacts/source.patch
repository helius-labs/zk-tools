+#[derive(Clone, Copy)]
+enum SolverWitness<'a> {
+    Encoded(&'a [u8]),
+    Fields(&'a [Fr]),
+}
+
+impl<'a> SolverWitness<'a> {
+    fn fields(self) -> Result<std::borrow::Cow<'a, [Fr]>, String> {
+        match self {
+            Self::Encoded(bytes) if bytes.len().is_multiple_of(32) => {
+                Ok(std::borrow::Cow::Owned(frs(bytes)))
+            }
+            Self::Encoded(_) => Err("invalid witness encoding".into()),
+            Self::Fields(fields) => Ok(std::borrow::Cow::Borrowed(fields)),
+        }
+    }
+}
+
+#[cfg(test)]
+#[test]
+fn solver_witness_borrows_montgomery_fields_and_checks_byte_boundary() {
+    use std::borrow::Cow;
+
+    let fields = [Fr::ZERO, Fr::ONE, -Fr::ONE, Fr::from_u64(753)];
+    let bytes: Vec<_> = fields.iter().flat_map(|f| f.0.iter().flat_map(|x| x.to_le_bytes())).collect();
+    let borrowed = SolverWitness::Fields(&fields).fields().unwrap();
+    assert!(matches!(borrowed, Cow::Borrowed(slice) if slice.as_ptr()==fields.as_ptr()));
+    let decoded = SolverWitness::Encoded(&bytes).fields().unwrap();
+    assert!(matches!(decoded, Cow::Owned(values) if values == fields));
+    assert_eq!(SolverWitness::Encoded(&bytes[..bytes.len()-1]).fields().unwrap_err(),
+               "invalid witness encoding");
+}
