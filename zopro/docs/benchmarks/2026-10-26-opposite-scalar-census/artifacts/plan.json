        "--extern",
        "zopro_bn254=/tmp/zopro-grouping-module/target-native/release/deps/libzopro_bn254-505b170cdc507df1.rlib",
        "--extern",
        "rayon=/tmp/zopro-grouping-module/target-native/release/deps/librayon-8c351a88ff22669b.rlib",
        "--extern",
        "serde_json=/tmp/zopro-grouping-module/target-native/release/deps/libserde_json-cae5e7ec1f017ce1.rlib",
        "/tmp/zopro-opposite-scalar-census/probe.rs",
        "-o",
        "/tmp/zopro-opposite-scalar-census/probe"
      ],
      "kind": "command",
      "name": "link",
      "timeout_seconds": 600
    },
    {
      "argv": [
        "/tmp/zopro-opposite-scalar-census/probe",
        "/tmp/zopro-opposite-scalar-census/cases.json"
      ],
      "kind": "command",
      "name": "census",
      "timeout_seconds": 1200
