+//! Borrow the first layer's right operands while gathering G2 scalar groups.
+use super::*;
+use zopro_bn254::{G2Affine, G2Config};
+
+const GROUP: usize = 256;
+const MAX_POINTS: usize = 2048;
+const TILE_OVERLAP: usize = 512 * 1024;
+
+pub(super) fn try_reduce(
+    bases: &[G2Affine],
+    order: &[u32],
+    starts: &[usize],
+    counts: &[usize],
+) -> Option<Vec<G2Affine>> {
+    let packed = BatchAdd::<G2Config>::default();
+    if counts.len() < 1024 || !packed.borrowed_g2_enabled() {
+        return None;
+    }
+    let active = counts
+        .len()
+        .div_ceil(GROUP)
+        .min(rayon::current_num_threads());
+    let _reserve = crate::preparation::Reservation::analysis(active.checked_mul(TILE_OVERLAP))?;
+    Some(reduce(bases, order, starts, counts))
+}
+
+fn reduce(bases: &[G2Affine], order: &[u32], starts: &[usize], counts: &[usize]) -> Vec<G2Affine> {
+    assert_eq!(starts.len(), counts.len() + 1);
+    let n = counts.len();
+    let mut result: Vec<G2Affine> = Vec::with_capacity(n);
+    result.spare_capacity_mut()[..n]
+        .par_chunks_mut(GROUP)
+        .enumerate()
+        .for_each_init(Tile::default, |tile, (i, output)| {
+            let first = i * GROUP;
+            let after = first + output.len();
+            if starts[after] - starts[first] > MAX_POINTS {
+                let offset = starts[first];
+                let local: Vec<_> = starts[first..=after]
+                    .iter()
+                    .map(|start| start - offset)
+                    .collect();
+                let ordinary = group_affine(
+                    bases,
+                    &order[offset..starts[after]],
+                    &local,
+                    &counts[first..after],
+                );
+                for (dst, point) in output.iter_mut().zip(ordinary) {
+                    dst.write(point);
+                }
+                return;
+            }
+            tile.reduce_tile(
+                bases,
+                order,
+                &starts[first..=after],
+                &counts[first..after],
+                output,
+            );
+        });
+    // SAFETY: each disjoint output tile initializes all its entries, and
+    // every Rayon task has joined before the result becomes observable.
+    unsafe { result.set_len(n) };
+    result
+}
+
+#[derive(Default)]
+struct Tile<'a> {
+    heads: Vec<G2Affine>,
+    pairs: Vec<(u32, &'a G2Affine)>,
+    remaining: Vec<LimbPoint<Fq2>>,
+    packed: BatchAdd<G2Config>,
+    scratch: Scratch<G2Config>,
+}
+
+impl<'a> Tile<'a> {
+    fn reduce_tile(
+        &mut self,
+        bases: &'a [G2Affine],
+        order: &[u32],
+        starts: &[usize],
+        counts: &[usize],
+        out: &mut [core::mem::MaybeUninit<G2Affine>],
+    ) {
+        self.heads.clear();
+        self.pairs.clear();
+        self.remaining.clear();
+        self.heads
+            .reserve_exact(counts.iter().map(|n| n.div_ceil(2)).sum());
+        self.pairs.reserve_exact(counts.iter().map(|n| n / 2).sum());
+        self.remaining.reserve_exact(
+            counts
+                .iter()
+                .filter(|&&n| n > 2)
+                .map(|n| n.div_ceil(2))
+                .sum(),
+        );
+        let mut start = [0usize; GROUP + 1];
+        for (j, range) in starts.windows(2).enumerate() {
+            let mut points = order[range[0]..range[1]].chunks_exact(2);
+            for pair in &mut points {
+                let left = &bases[pair[0] as usize];
+                let right = &bases[pair[1] as usize];
+                let slot = self.heads.len() as u32;
+                let sum = if left.is_identity() {
+                    *right
+                } else if right.is_identity() {
+                    *left
+                } else if left.x == right.x {
+                    (*left + *right).to_affine()
+                } else {
+                    self.pairs.push((slot, right));
+                    *left
+                };
+                self.heads.push(sum);
+            }
+            if let [last] = points.remainder() {
+                self.heads.push(bases[*last as usize]);
+            }
+            start[j + 1] = self.heads.len();
+        }
+        if !self.pairs.is_empty() {
+            self.packed
+                .apply_signed_borrowed_g2(&mut self.heads, &self.pairs);
+        }
+
+        let mut next_starts = [0usize; GROUP];
+        let mut next_counts = [0usize; GROUP];
+        for (j, dst) in out.iter_mut().enumerate() {
+            let heads = &self.heads[start[j]..start[j + 1]];
+            match heads {
+                [] => {
+                    dst.write(G2Affine::IDENTITY);
+                }
+                [point] => {
+                    dst.write(*point);
+                }
+                _ => {
+                    next_starts[j] = self.remaining.len();
+                    next_counts[j] = heads.len();
+                    self.remaining
+                        .extend(heads.iter().copied().map(limbs::<G2Config>));
+                }
+            }
+        }
+        let next_starts = &next_starts[..counts.len()];
+        let next_counts = &mut next_counts[..counts.len()];
+        while next_counts.iter().any(|&count| count > 1) {
+            reduce_layer(
+                &mut self.remaining,
+                next_starts,
+                next_counts,
+                &mut self.scratch,
+            );
+        }
+        for (j, dst) in out.iter_mut().enumerate() {
+            if next_counts[j] != 0 {
+                dst.write(affine::<G2Config>(self.remaining[next_starts[j]]));
+            }
+        }
+    }
+}
