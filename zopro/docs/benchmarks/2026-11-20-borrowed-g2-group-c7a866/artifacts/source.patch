+#[cfg(test)]
+mod tests {
+    use super::*;
+    use zopro_bn254::G2Projective;
+
+    #[test]
+    fn first_borrowed_layer_matches_projective_group_sums() {
+        let mut curve = Vec::new();
+        let mut scalar = Vec::new();
+        let mut order = Vec::new();
+        let mut starts = vec![0];
+        let mut expected = Vec::new();
+        let sizes = (0..1027).map(|i| if i == 811 { 2061 } else { i % 13 });
+        for size in sizes {
+            let mut sum = Fr::ZERO;
+            for j in 0..size {
+                let k = scalar.len();
+                let weight = match k % 23 {
+                    0 => Fr::ZERO,
+                    1 => Fr::ONE,
+                    2 => -Fr::ONE,
+                    3 | 4 => Fr::from(31u64),
+                    _ => Fr::from((k * 503 + j + 17) as u64),
+                };
+                scalar.push(weight);
+                curve.push(G2Affine::GENERATOR * weight);
+                order.push(k as u32);
+                sum += weight;
+            }
+            starts.push(order.len());
+            expected.push(G2Affine::GENERATOR * sum);
+        }
+        let points = G2Projective::batch_to_affine(&curve);
+        let expected = G2Projective::batch_to_affine(&expected);
+        let counts: Vec<_> = starts.windows(2).map(|r| r[1] - r[0]).collect();
+        for workers in [1, 4, 16] {
+            let pool = rayon::ThreadPoolBuilder::new()
+                .num_threads(workers)
+                .build()
+                .unwrap();
+            pool.install(|| {
+                assert_eq!(reduce(&points, &order, &starts, &counts), expected);
+                assert_eq!(group_affine(&points, &order, &starts, &counts), expected);
+            });
+        }
+    }
+}
