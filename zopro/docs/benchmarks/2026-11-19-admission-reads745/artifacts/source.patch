+#[cfg(any(target_os = "linux", target_os = "android"))]
+fn cgroup_directory_headroom(directory: &std::path::Path, v2: bool) -> Option<usize> {
+    let (limit_file, current_file) = if v2 {
+        ("memory.max", "memory.current")
+    } else {
+        ("memory.limit_in_bytes", "memory.usage_in_bytes")
+    };
+    let maximum = std::fs::read_to_string(directory.join(limit_file)).ok()?;
+    let maximum = maximum.trim().parse::<usize>().ok();
+    let high = if v2 {
+        std::fs::read_to_string(directory.join("memory.high"))
+            .ok()
+            .and_then(|text| text.trim().parse::<usize>().ok())
+    } else {
+        None
+    };
+    let limit = maximum.into_iter().chain(high).min()?;
+    let current = std::fs::read_to_string(directory.join(current_file)).ok()?;
+    Some(limit.saturating_sub(current.trim().parse::<usize>().ok()?))
