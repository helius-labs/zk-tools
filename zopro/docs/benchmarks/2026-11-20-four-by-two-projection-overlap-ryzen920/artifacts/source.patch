+
+pub(crate) fn timed_interval<T>(
+    clock: Option<Instant>,
+    work: impl FnOnce() -> T,
+) -> (T, Option<(u128,u128)>) {
+    let start = clock.map(|t| t.elapsed().as_nanos());
+    let value = work();
+    let span = start.zip(clock.map(|t| t.elapsed().as_nanos()));
+    (value, span)
 }
 
