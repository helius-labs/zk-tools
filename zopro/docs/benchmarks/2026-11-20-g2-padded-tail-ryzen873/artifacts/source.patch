+/// Finish the partial group first, then return the inverse prefix for
+/// the remaining groups. Dummy lanes have denominator one and no destination.
+#[inline(never)]
+fn padded_tail<C: CurveConfig<Base = Fq2>>(
+    buckets: &mut [Affine<C>],
+    batch: &[(u32, &Affine<C>)],
+    prefix: &FqBatch,
+) -> FqBatch {
+    debug_assert!((1..LANES).contains(&batch.len()));
+    let a: [Affine<C>; LANES] = core::array::from_fn(|i| {
+        batch.get(i).map_or(Affine::IDENTITY, |&(id, _)| {
+            buckets[(id & 0x7fff_ffff) as usize]
+        })
+    });
+    let bx = fq2_pack(core::array::from_fn(|i| {
+        batch.get(i).map_or(Fq2::ONE, |&(_, p)| p.x)
+    }));
+    let by = fq2_pack(core::array::from_fn(|i| {
+        batch.get(i).map_or(Fq2::ZERO, |&(id, p)| {
+            if id >> 31 != 0 { -p.y } else { p.y }
+        })
+    }));
+    let ax = fq2_pack(a.map(|p| p.x));
+    let ay = fq2_pack(a.map(|p| p.y));
+    let denominator = core::array::from_fn(|i| canonical_sub::<true>(&bx[i], &ax[i]));
+    let numerator = core::array::from_fn(|i| canonical_sub::<true>(&by[i], &ay[i]));
+    let norm = prefix_norm(&denominator);
+    let product = prefix_mul(prefix, &norm);
+    let inverse = prefix_inverse(&product, true, true).expect("complete vector group");
+    let slope = prefix_numerator(&numerator, &denominator, &prefix_mul(prefix, &inverse));
+    let x = Fq2::lanes_sub(&Fq2::lanes_square(&slope), &Fq2::lanes_add(&ax, &bx));
+    let y = Fq2::lanes_sub(&Fq2::lanes_mul(&slope, &Fq2::lanes_sub(&ax, &x)), &ay);
+    let (x, y) = (fq2_unpack(x), fq2_unpack(y));
+    for ((&(id, _), x), y) in batch.iter().zip(x).zip(y) {
+        buckets[(id & 0x7fff_ffff) as usize] = Affine::new(x, y);
+    }
+    prefix_mul(&inverse, &norm)
+}
