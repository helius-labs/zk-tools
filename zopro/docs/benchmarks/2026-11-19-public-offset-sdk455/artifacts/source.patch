@@ -0,0 +1,48 @@
+use super::*;
+use sha2::{Digest, Sha256};
+use crate::preparation::Reservation;
+
+const OFFSETS: &[u8] = include_bytes!("public_b2_offset.bin");
+const POINT_DIGEST: [u8;32] = [103, 152, 229, 136, 152, 26, 42, 77, 132, 84, 116, 120, 133, 119, 111, 217, 208, 253, 172, 52, 187, 60, 221, 172, 171, 233, 242, 110, 65, 252, 167, 214];
+
+pub(super) struct Correction { point: G2Projective, _reservation: Reservation }
+
+impl Key {
+    pub(super) fn b2_with_public_offset(&self, words: &mut [[u64;4]]) -> G2Projective {
+        if self.b2.len()!=30089 || std::env::var("ZOPRO_BENCH_PUBLIC_B2_OFFSETS").as_deref()!=Ok("1") {
+            return msm_affine::g2_query_exclusive(&self.b2,words);
+        }
+        let correction=self.public_b2_offset.get_or_init(|| prepare(&self.b2));
+        let Some(correction)=correction else {return msm_affine::g2_query_exclusive(&self.b2,words);};
+        if std::env::var_os("ZOPRO_BENCH_OFFSET_TRACE").is_some() {eprintln!("OFFSET_QUERY");}
+        for_each_offset(|i,k| {
+            let v=words[i];
+            words[i]=if v==k { [0;4] } else {
+                (Fr::from_canonical(v).unwrap()-Fr::from_canonical(k).unwrap()).to_canonical()
+            };
+        });
+        msm_affine::g2_query_exclusive(&self.b2,words)+correction.point
+    }
+}
+fn for_each_offset(mut visit:impl FnMut(usize,[u64;4])) {
+    for row in OFFSETS.chunks_exact(36) {
+        let i=u32::from_le_bytes(row[..4].try_into().unwrap()) as usize;
+        visit(i,super::words(&row[4..]));
+    }
+}
+fn prepare(points:&[G2Affine])->Option<Correction> {
+    let _reservation=Reservation::analysis(OFFSETS.len().checked_add(std::mem::size_of::<Correction>()))?;
+    let start=std::time::Instant::now();
+    let mut hash=Sha256::new();
+    for p in points {
+        for v in [p.x.c0,p.x.c1,p.y.c0,p.y.c1] {
+            for limb in v.0 {hash.update(limb.to_le_bytes());}
+        }
+    }
+    let digest:[u8;32]=hash.finalize().into();
+    if digest!=POINT_DIGEST {return None;}
+    let mut point=G2Projective::IDENTITY;
+    for_each_offset(|i,k| point+=points[i]*Fr::from_canonical(k).unwrap());
+    if std::env::var_os("ZOPRO_BENCH_OFFSET_TRACE").is_some() {eprintln!("OFFSET_SETUP_NS {}",start.elapsed().as_nanos());}
+    Some(Correction{point,_reservation})
+}
