+            if step % 97 == 0 {
+                let words = core::array::from_fn(|i| edges[(step / 97 + i) % edges.len()]);
+                state = Ifma8::<crate::FqConfig, true>::raw(&words);
+                expected = words.map(|v| numeric(v) * inverse_r);
+            }
+            let words: [[[u64; 4]; LANES]; 3] = core::array::from_fn(|_| {
+                core::array::from_fn(|_| {
+                    let mut bytes = [0u8; 64];
+                    for b in bytes.chunks_mut(8) {
+                        seed ^= seed << 13;
+                        seed ^= seed >> 7;
+                        seed ^= seed << 17;
+                        b.copy_from_slice(&seed.to_le_bytes());
