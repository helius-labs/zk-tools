+pub(super) fn mixed_h_growth<C: CurveConfig>(n: usize, widths: &[usize]) -> Option<usize>
+where C::Base: BatchInverse {
+    let uniform=one::<C>(n,13,1,false)?;
+    let mut held=0;
+    let mut leaf=0;
+    for &bits in widths {
+        let p=shape::<C>(1usize.checked_shl(bits as u32)?,1,1,batch_size(bits+1).max(32))?;
+        held=add(held,p.held)?;
+        leaf=leaf.max(p.leaf);
+    }
+    add(held.saturating_sub(uniform.held),
+        mul(leaf.saturating_sub(uniform.leaf),rayon::current_num_threads())?)
 }
