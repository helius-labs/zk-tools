+use super::*;
+
+// Consecutive little-endian bit fields covering the 254 scalar bits.
+const NINETEEN: &[usize] = &[14,13,14,13,13,14,13,13,14,13,13,14,13,13,14,13,13,14,13];
+const WORD_ALIGNED: &[usize] = &[13,13,13,13,12,13,13,13,13,12,13,13,13,13,12,13,13,12,12,12];
+
+pub(super) fn selected() -> Option<&'static [usize]> {
+    match std::env::var("ZOPRO_BENCH_H_LAYOUT").as_deref() {
+        Ok("19") => Some(NINETEEN),
+        Ok("word") => Some(WORD_ALIGNED),
+        _ => None,
+    }
+}
+
+pub(super) fn sum<C: CurveConfig>(bases: &[Affine<C>], words: &[[u64; 4]], widths: &[usize]) -> Projective<C>
+where C::Base: BatchInverse {
+    assert_eq!(bases.len(), words.len());
+    let mut offsets = [0usize; 20];
+    let mut end=0;
+    for (slot, &bits) in offsets.iter_mut().zip(widths) {
+        *slot=end;
+        end+=bits;
+    }
+    assert_eq!(end,Fr::MODULUS_BITS as usize);
+    let sums: Vec<_> = widths.par_iter().zip(&offsets[..widths.len()]).map(|(&bits, &offset)| {
+        let lane=offset/64;
+        let shift=offset%64;
+        let mask=(1u64<<bits)-1;
+        let batch=batch_size(bits+1).max(32);
+        let buckets=if shift+bits<=64 {
+            fill_window_impl::<C,false,true>(bases,words.iter().map(|v|((v[lane]>>shift)&mask)as i16),bits+1,batch)
+        } else {
+            fill_window_impl::<C,false,true>(bases,words.iter().map(|v|(((v[lane]>>shift)|(v[lane+1]<<(64-shift)))&mask)as i16),bits+1,batch)
+        };
+        crate::msm::weighted_affine(&affine_buckets(buckets))
+    }).collect();
+    let mut result=*sums.last().unwrap();
+    for j in (0..sums.len()-1).rev() {
+        for _ in 0..widths[j] { result=result.double(); }
+        result+=sums[j];
+    }
+    result
+}
