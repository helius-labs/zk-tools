+#[cfg(test)]
+mod tests {
+    use super::*;
+    use zopro_bn254::{G1Config,G1Affine};
+    #[test]
+    fn mixed_windows_reconstruct_generator_sum() {
+        let mut bases=vec![G1Affine::GENERATOR;1031];
+        let mut words=Vec::new();
+        let mut expected=Fr::ZERO;
+        for (i,p) in bases.iter_mut().enumerate() {
+            let value=match i%31 {
+                0=>Fr::ZERO,1=>-Fr::ONE,_=>Fr::from((i+1)as u64).pow(&[47]),
+            };
+            if i%7==0 { *p=G1Affine::IDENTITY; }
+            else if i%3==0 { *p=-*p;expected-=value; }
+            else { expected+=value; }
+            words.push(value.to_canonical());
+        }
+        for layout in [NINETEEN,WORD_ALIGNED] {
+            assert_eq!(sum::<G1Config>(&bases,&words,layout).to_affine(),(G1Affine::GENERATOR*expected).to_affine());
+        }
+    }
+}
