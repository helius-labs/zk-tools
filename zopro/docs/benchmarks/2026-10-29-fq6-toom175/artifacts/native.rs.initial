use serde_json::{json,Value};use sha2::{Digest,Sha256};use std::{fs,path::{Path,PathBuf},collections::BTreeMap,process::Command};
const R:&str="/home/ubuntu/src/zopro-perf-work/fq6-toom175";const Z:&str="/home/ubuntu/src/zk-tools/zopro";const M:&str="/home/ubuntu/src/zk-tools/zopro/docs/benchmarks/2026-10-29-balanced-kh-adoption/artifacts/production-source-manifest.json";
fn r(p:impl AsRef<Path>)->PathBuf{Path::new(R).join(p)}fn read(p:impl AsRef<Path>)->Value{serde_json::from_slice(&fs::read(p).unwrap()).unwrap()}fn save(p:impl AsRef<Path>,v:&Value){fs::write(p,serde_json::to_vec_pretty(v).unwrap()).unwrap()}fn hash(p:impl AsRef<Path>)->String{format!("{:x}",Sha256::digest(fs::read(p).unwrap()))}
fn setup(){assert!(!r("build-plan.json").exists());let m=read(M);assert_eq!(m["source_files_sha256"].as_object().unwrap().len(),175);let mut pins=BTreeMap::new();pins.insert(M.to_string(),hash(M));for(f,h)in m["source_files_sha256"].as_object().unwrap(){let from=Path::new(Z).join(f);assert_eq!(hash(&from),h.as_str().unwrap());let to=r("source").join(f);fs::create_dir_all(to.parent().unwrap()).unwrap();fs::copy(&from,&to).unwrap();pins.insert(from.display().to_string(),hash(from));}
let file="crates/zopro-bn254/src/fq6.rs";let path=r("source").join(file);let orig=fs::read_to_string(&path).unwrap();let decl="#[cfg(zopro_fq6_toom)]\nmod toom;\n";let before=orig[orig.find("        let v0 = self.c0 * o.c0;").unwrap()..orig.rfind("    }\n}\ncrate::assign_ops!").unwrap()].to_string();let after=format!("        #[cfg(zopro_fq6_toom)]\n        {{ toom::multiply(self, o) }}\n        #[cfg(not(zopro_fq6_toom))]\n        {{\n{before}        }}\n");assert_eq!(orig.matches(&before).count(),1);let next=orig.replace(&before,&after).replacen("use core::",&format!("{decl}use core::"),1);assert_eq!(next.replace(&after,&before).replacen(decl,"",1),orig);fs::write(&path,next).unwrap();let child=r("source/crates/zopro-bn254/src/fq6/toom.rs");fs::create_dir_all(child.parent().unwrap()).unwrap();fs::copy(r("kernel.rs"),&child).unwrap();pins.insert(child.display().to_string(),hash(child));let mut exact=0;for(f,h)in m["source_files_sha256"].as_object().unwrap(){let p=r("source").join(f);if hash(&p)==h.as_str().unwrap(){exact+=1}else{assert_eq!(f,file);}pins.insert(p.display().to_string(),hash(p));}assert_eq!(exact,174);save(r("source-audit.json"),&json!({"original_files":175,"snapshot_files":176,"originals_exact":174,"changed_file":file,"module_declaration":decl,"before":before,"after":after,"reverse175_exact":true,"field_originals_exact":16,"field_originals":17,"new_child":"crates/zopro-bn254/src/fq6/toom.rs","production_changed":false,"heap_key_tables_unsafe_new_kernel":false}));
let probe=fs::read_to_string(r("probe.rs")).unwrap().replace("perf::Usage::read()","perf::Usage::now()").replace("\"cpu_ms\":after.user_ms-before.user_ms+after.system_ms-before.system_ms,\"whole_process_maxrss_kib\":after.max_rss_kib","\"resource\":after.difference(&before)");fs::write(r("probe.rs"),probe).unwrap();let flags=m["rustflags"].as_str().unwrap();fs::write(r("native-flags.txt"),flags).unwrap();let mut steps=vec![];for mode in["off","on"]{let f=if mode=="on"{format!("{flags} --cfg zopro_fq6_toom")}else{flags.into()};let env=json!({"RUSTFLAGS":f,"CARGO_TARGET_DIR":r(format!("target-{mode}")),"CARGO_BUILD_JOBS":"16","RAYON_NUM_THREADS":"1"});steps.push(json!({"kind":"command","name":format!("field-{mode}"),"argv":["cargo","test","--manifest-path",r("source/Cargo.toml"),"--locked","--offline","--release","-p","zopro-bn254","--lib","--","--test-threads=1"],"environment":env,"unfiltered":true,"required_tests":["tests::final_exponentiation_matches_its_general_square_reference"],"timeout_seconds":1800}));steps.push(json!({"kind":"command","name":format!("libraries-{mode}"),"argv":["cargo","build","--manifest-path",r("source/Cargo.toml"),"--locked","--offline","--release","-p","zopro-bn254","--lib","--message-format=json"],"environment":env,"timeout_seconds":1800}));steps.push(json!({"kind":"command","name":format!("freeze-{mode}"),"argv":[r("native-helper"),"freeze",mode],"environment":env,"timeout_seconds":120}));steps.push(json!({"kind":"command","name":format!("link-{mode}"),"argv":[r("native-helper"),"link",mode],"timeout_seconds":600}));}steps.push(json!({"kind":"command","name":"link-frozen","argv":[r("native-helper"),"link","frozen"],"timeout_seconds":600}));for f in["design.md","design.initial.md","history-audit.md","native.rs","native-helper","kernel.rs","probe.rs","perf.rs","source-audit.json","native-flags.txt"]{let p=r(f);pins.insert(p.display().to_string(),hash(p));}let previous="/home/ubuntu/src/zopro-perf-work/balanced-kh-production/frozen-candidate.json";let parent=read(previous);assert_eq!(parent["rustflags"],flags);for n in["libc","zopro_bn254"]{let p=parent["libraries"][n].as_str().unwrap();assert_eq!(hash(p),parent["input_pins"][p].as_str().unwrap());pins.insert(p.into(),hash(p));}pins.insert(previous.into(),hash(previous));save(r("build-pins.json"),&json!(pins));save(r("build-plan.json"),&json!({"version":1,"source_pins":r("build-pins.json"),"steps":steps}));println!("Prepared9native steps;174originals exact/inverse175; field33OFF/35ON expected; no SDK");}
fn freeze(mode:&str){assert!(["off","on"].contains(&mode));let count=read(r(format!("native/field-{mode}/tests.json")))["passed_tests"].as_array().unwrap().len();assert_eq!(count,if mode=="off"{33}else{35});let mut lib=None;for line in fs::read_to_string(r(format!("native/libraries-{mode}/stdout.log"))).unwrap().lines(){let v:Value=serde_json::from_str(line).unwrap();if v["reason"]=="compiler-artifact"&&v["target"]["name"]=="zopro_bn254"{let files=v["filenames"].as_array().unwrap();let meta=files.iter().filter_map(Value::as_str).find(|s|s.ends_with(".rmeta")).unwrap();let from=Path::new(meta).with_extension("rlib");let to=r(format!("frozen/{mode}/libzopro_bn254-{}.rlib",hash(&from)));fs::create_dir_all(to.parent().unwrap()).unwrap();fs::copy(&from,&to).unwrap();lib=Some(to);}}let lib=lib.unwrap();let flags=std::env::var("RUSTFLAGS").unwrap();let mut fingerprints=vec![];for e in fs::read_dir(r(format!("target-{mode}/release/.fingerprint"))).unwrap(){let e=e.unwrap();let p=e.path().join("lib-zopro_bn254.json");if p.exists(){let v=read(&p);assert_eq!(v["rustflags"],json!(flags.split_whitespace().collect::<Vec<_>>()));fingerprints.push(v);}}assert_eq!(fingerprints.len(),1);save(r(format!("field-{mode}.json")),&json!({"library":lib,"sha256":hash(&lib),"flags":flags,"tests":count,"unfiltered":true,"fingerprints":fingerprints}));}
fn find(dir:&Path,prefix:&str)->PathBuf{let mut a=fs::read_dir(dir).unwrap().map(Result::unwrap).map(|e|e.path()).filter(|p|{let n=p.file_name().unwrap().to_str().unwrap();n.starts_with(prefix)&&n.ends_with(".rlib")}).collect::<Vec<_>>();a.sort();assert_eq!(a.len(),1,"{prefix}: {a:?}");a.pop().unwrap()}
fn link(mode:&str){assert!(["frozen","off","on"].contains(&mode));let parent=read("/home/ubuntu/src/zopro-perf-work/balanced-kh-production/frozen-candidate.json");let field=if mode=="frozen"{PathBuf::from(parent["libraries"]["zopro_bn254"].as_str().unwrap())}else{PathBuf::from(read(r(format!("field-{mode}.json")))["library"].as_str().unwrap())};let dep=r(format!("target-{}/release/deps",if mode=="frozen"{"off"}else{mode}));let tools=Path::new("/home/ubuntu/src/zopro-perf-work/tool-target/release/deps");let mut libs=BTreeMap::new();libs.insert("zopro_bn254",field);for(n,prefix)in[("ark_ref","libark_bn254-"),("ark_ff","libark_ff-"),("ark_ec","libark_ec-")]{libs.insert(n,find(&dep,prefix));}libs.insert("serde_json",tools.join("libserde_json-cdebb9338c2784ad.rlib"));libs.insert("sha2",tools.join("libsha2-16b8f2c03bdf5faa.rlib"));libs.insert("libc",PathBuf::from(parent["libraries"]["libc"].as_str().unwrap()));let mut cmd=Command::new("rustc");cmd.args(["--edition=2021","-O","-C","target-cpu=native","-C","lto=fat","-C","codegen-units=1","-L"]).arg(format!("dependency={}",dep.display())).arg("-L").arg(format!("dependency={}",tools.display())).arg("-L").arg(format!("dependency={}",Path::new(parent["libraries"]["zopro_bn254"].as_str().unwrap()).parent().unwrap().display()));for(n,p)in&libs{cmd.arg("--extern").arg(format!("{n}={}",p.display()));}cmd.arg(r("probe.rs")).arg("-o").arg(r(format!("{mode}-probe")));let status=cmd.status().unwrap();assert!(status.success());let mut pins=BTreeMap::new();for(p,h)in libs.values().map(|p|(p.display().to_string(),hash(p))){pins.insert(p,h);}for f in["probe.rs","perf.rs"]{pins.insert(r(f).display().to_string(),hash(r(f)));}save(r(format!("probe-{mode}.json")),&json!({"libraries":libs,"input_pins":pins,"binary":r(format!("{mode}-probe")),"sha256":hash(r(format!("{mode}-probe"))),"native":true}));}
fn main(){let a:Vec<_>=std::env::args().collect();match a[1].as_str(){"setup"=>setup(),"freeze"=>freeze(&a[2]),"link"=>link(&a[2]),_=>panic!()}}
