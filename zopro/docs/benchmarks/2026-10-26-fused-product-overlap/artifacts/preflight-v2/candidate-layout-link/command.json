{
  "argv": [
    "timeout",
    "-k",
    "5s",
    "120s",
    "rustc",
    "--edition=2021",
    "-O",
    "-C",
    "target-cpu=native",
    "/tmp/zopro-fused-product-overlap/layout.rs",
    "--extern",
    "zopro_core=/tmp/zopro-fused-product-overlap/target-native-v2/release/deps/libzopro_core.rlib",
    "-L",
    "dependency=/tmp/zopro-fused-product-overlap/target-native-v2/release/deps",
    "-o",
    "/tmp/zopro-fused-product-overlap/candidate-layout"
  ],
  "environment": {
    "MALLOC_ARENA_MAX": "32",
    "MALLOC_MMAP_THRESHOLD_": "1073741824",
    "MALLOC_TRIM_THRESHOLD_": "-1",
    "RAYON_NUM_THREADS": "32",
    "ZOPRO_BASIS_KEY_DIR": "/tmp/zopro-canonical-grain-adoption/images",
    "ZOPRO_CPU_BOUNDED_SCHEDULE": "1",
    "ZOPRO_CPU_CANONICAL_WIRES": "1",
    "ZOPRO_CPU_DEFER_SIGNED_Y": "1",
    "ZOPRO_CPU_DEFER_SIGN_PARTS": "1",
    "ZOPRO_CPU_DEFER_SIGN_WIDTH": "12",
    "ZOPRO_CPU_FFT_COLUMN_ROOTS": "1",
    "ZOPRO_CPU_G2_PREFIX_RECORDS": "1",
    "ZOPRO_CPU_LAGRANGE": "1",
    "ZOPRO_CPU_LAGRANGE_DIR": "/tmp/zopro-lagrange-cache",
    "ZOPRO_CPU_LAGRANGE_FOLD": "1",
    "ZOPRO_CPU_PROOF_CONCURRENCY": "1",
    "ZOPRO_CPU_RESOURCE_SCHEDULE": "1",
    "ZOPRO_CPU_SMALL_CORE_ENTRY": "1",
    "ZOPRO_CPU_ZERO_AWARE_GROUPS": "1"
  }
}
