+struct EulerPhases {
+    start: std::time::Instant,
+    times: [u64;4],
+    next: usize,
+}
+impl EulerPhases {
+    fn begin()->Self {Self{start:std::time::Instant::now(),times:[0;4],next:0}}
+    fn mark(&mut self) {self.times[self.next]=self.start.elapsed().as_nanos() as u64;self.next+=1;}
+    fn report(mut self) {
+        self.mark();
+        eprintln!("EULER_PHASES {} {} {} {}",self.times[0],self.times[1],self.times[2],self.times[3]);
+    }
+}
