+// Present the first-stage representatives in the upper-stage point order.
+struct Representatives<'a> {
+    original: &'a [Fr],
+    sources: &'a [u32],
+    choices: &'a [(u32, u32)],
+}
+
+impl std::ops::Index<usize> for Representatives<'_> {
+    type Output = Fr;
+
+    fn index(&self, group: usize) -> &Fr {
+        let source = match self.choices.get(group) {
+            Some(&(chosen, _)) => chosen,
+            None => self.sources[group],
+        };
+        &self.original[source as usize]
+    }
+}
+
+/// The upper query reads the current witness through one source index per point.
+struct MappedRepresentatives<'a> {
+    original: &'a [Fr],
+    indices: &'a [u32],
+}
+
+impl std::ops::Index<usize> for MappedRepresentatives<'_> {
+    type Output = Fr;
+
+    fn index(&self, group: usize) -> &Fr {
+        &self.original[self.indices[group] as usize]
+    }
+}
+
+fn select_indices<'a>(
+    sources: &'a [u32],
+    choices: &[(u32, u32)],
+) -> Option<(std::borrow::Cow<'a, [u32]>, Option<Reservation>)> {
+    assert!(choices.len() <= sources.len());
+    if choices.iter().zip(sources).all(|(&(chosen, _), &first)| chosen == first) {
+        return Some((std::borrow::Cow::Borrowed(sources), None));
+    }
+    let charge = Reservation::analysis(sources.len().checked_mul(std::mem::size_of::<u32>()))?;
+    let mut indices = sources.to_vec();
+    for (index, &(chosen, _)) in indices.iter_mut().zip(choices) {
+        *index = chosen;
+    }
+    Some((std::borrow::Cow::Owned(indices), Some(charge)))
 }
 
