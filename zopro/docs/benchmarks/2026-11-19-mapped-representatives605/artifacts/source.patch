+#[cfg(test)]
+mod mapped_representative_tests {
+    use super::*;
+
+    #[test]
+    fn unchanged_and_changed_sources_preserve_upper_order() {
+        let original: Vec<_> = (0u64..9).map(Fr::from).collect();
+        let sources = [3, 1, 8, 5, 2];
+        for (choices, changed, expected) in [
+            (vec![(3, 2), (1, 0)], false, vec![3, 1, 8, 5, 2]),
+            (vec![(7, 1), (1, 2)], true, vec![7, 1, 8, 5, 2]),
+            (Vec::new(), false, vec![3, 1, 8, 5, 2]),
+        ] {
+            let (indices, charge) = select_indices(&sources, &choices).unwrap();
+            assert_eq!(charge.is_some(), changed);
+            let mapped = MappedRepresentatives {original: &original, indices: &indices};
+            let old = Representatives {original: &original, sources: &sources, choices: &choices};
+            for (i, value) in expected.into_iter().enumerate() {
+                assert_eq!(mapped[i], old[i]);
+                assert_eq!(mapped[i], Fr::from(value as u64));
+            }
+        }
+    }
+}
