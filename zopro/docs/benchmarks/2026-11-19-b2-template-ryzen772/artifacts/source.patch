+use super::{grouping_cost, ScalarGroups};
+use crate::preparation::Reservation;
+use rayon::prelude::*;
+use std::sync::OnceLock;
+use zopro_bn254::Fr;
+
+const CLASS_TILE: usize = 256;
+const BIT_TILE: usize = 4096;
+
+struct Template {
+    terms: usize,
+    starts: Vec<usize>,
+    words: Vec<u32>,
+    flags: Vec<u32>,
+    _memory: Reservation,
+}
+
+#[derive(Default)]
+struct Tile {
+    values: Vec<[u64; 4]>,
+    counts: Vec<usize>,
+    members: Vec<u32>,
+    ones: Vec<u32>,
+    exceptions: Vec<u32>,
+}
+
+impl Template {
+    fn parse(bytes: &[u8], expected_terms: usize, memory: Reservation) -> Option<Self> {
+        let mut words = bytes.chunks_exact(4).map(|x| u32::from_le_bytes(x.try_into().unwrap()));
+        let terms = words.next()? as usize;
+        let classes = words.next()? as usize;
+        let flags = words.next()? as usize;
+        if terms != expected_terms || flags > terms || classes > terms - flags
+            || bytes.len() != (3 + classes + terms).checked_mul(4)?
+        {
+            return None;
+        }
+
+        let mut starts = Vec::with_capacity(classes + 1);
+        starts.push(0usize);
+        for _ in 0..classes {
+            let len = words.next()? as usize;
+            if len == 0 {
+                return None;
+            }
+            starts.push(starts.last()?.checked_add(len)?);
+        }
+        if *starts.last()? != terms - flags {
+            return None;
+        }
+
+        let mut seen = vec![false; terms];
+        let positions: Vec<u32> = words.collect();
+        for &index in &positions {
+            let first = seen.get_mut(index as usize)?;
+            if *first {
+                return None;
+            }
+            *first = true;
+        }
+        let flags = positions[terms - flags..].to_vec();
+        let mut order = positions;
+        order.truncate(terms - flags.len());
+        Some(Self { terms, starts, words: order, flags, _memory: memory })
+    }
+
+    fn load(expected_terms: usize) -> Option<Self> {
+        use std::io::Read;
+        let file = std::fs::File::open(std::env::var_os("ZOPRO_TRIAL_B2_TEMPLATE_FILE")?).ok()?;
+        let length = usize::try_from(file.metadata().ok()?.len()).ok()?;
+        let max = (3 + expected_terms.checked_mul(2)?).checked_mul(4)?;
+        if length < 12 || length > max {
+            return None;
+        }
+        // Covers the file being decoded, both index arrays, the range
+        // checks, and the wide start offsets while the plan is resident.
+        let memory = Reservation::analysis(grouping_cost::mul(max, 5))?;
+        let mut bytes = Vec::with_capacity(length);
+        file.take((max as u64) + 1).read_to_end(&mut bytes).ok()?;
+        Self::parse(&bytes, expected_terms, memory)
+    }
+
+    fn apply(&self, scalars: &[Fr]) -> Option<ScalarGroups> {
+        if self.terms != scalars.len() {
+            return None;
+        }
+        let n = self.terms;
+        let reservation = grouping_cost::reserve(n, 80)?;
+        let classes = self.starts.len() - 1;
+        let tile_count = classes.div_ceil(CLASS_TILE) + self.flags.len().div_ceil(BIT_TILE);
+        // At most one row membership, one unit index and one exception index
+        // per input are covered conservatively, along with the per-tile
+        // scalar outputs, capacity rounding and Vec metadata.
+        let extra = grouping_cost::add(grouping_cost::mul(n, 72)?, grouping_cost::mul(tile_count, 512)?)?;
+        let _extra = Reservation::analysis(Some(extra))?;
+        let (mut tiles, flags): (Vec<_>, Vec<_>) = rayon::join(
+            || (0..classes.div_ceil(CLASS_TILE)).into_par_iter().map(|tile| {
+                let start = tile * CLASS_TILE;
+                let end = (start + CLASS_TILE).min(classes);
+                let mut out = Tile::default();
+                out.values.reserve_exact(end - start);
+                out.counts.reserve_exact(end - start);
+                out.members.reserve_exact(self.starts[end] - self.starts[start]);
+                for window in self.starts[start..=end].windows(2) {
+                    let indices = &self.words[window[0]..window[1]];
+                    let rep = scalars[indices[0] as usize];
+                    let before = out.members.len();
+                    for &i in indices {
+                        let value = scalars[i as usize];
+                        if value == Fr::ONE {
+                            out.ones.push(i);
+                        } else if value != Fr::ZERO {
+                            if value == rep {
+                                out.members.push(i);
+                            } else {
+                                out.exceptions.push(i);
+                            }
+                        }
+                    }
+                    let count = out.members.len() - before;
+                    if count != 0 {
+                        out.counts.push(count);
+                        out.values.push(rep.to_canonical());
+                    }
+                }
+                out
+            }).collect(),
+            || self.flags.par_chunks(BIT_TILE).map(|positions| {
+                let mut out = Tile::default();
+                for &i in positions {
+                    let v = scalars[i as usize];
+                    if v == Fr::ONE {
+                        out.ones.push(i);
+                    } else if v != Fr::ZERO {
+                        out.exceptions.push(i);
+                    }
+                }
+                out
+            }).collect(),
+        );
+        tiles.extend(flags);
+
+        let one_count: usize = tiles.iter().map(|t| t.ones.len()).sum();
+        let exception_count: usize = tiles.iter().map(|t| t.exceptions.len()).sum();
+        let kept = tiles.iter().map(|t| t.counts.len()).sum::<usize>() + usize::from(one_count != 0) + exception_count;
+        if exception_count > n / 128 || kept > n * 80 / 100 {
+            return None;
+        }
+        let points = tiles.iter().map(|t| t.members.len()).sum::<usize>() + one_count + exception_count;
+        let mut order = Vec::with_capacity(points);
+        let mut counts = Vec::with_capacity(kept);
+        let mut values = Vec::with_capacity(kept);
+        for tile in &mut tiles {
+            order.append(&mut tile.members);
+            counts.append(&mut tile.counts);
+            values.append(&mut tile.values);
+        }
+        if one_count > 0 {
+            counts.push(one_count);
+            values.push(Fr::ONE.to_canonical());
+            for tile in &mut tiles {
+                order.append(&mut tile.ones);
+            }
+        }
+        for tile in tiles {
+            for i in tile.exceptions {
+                order.push(i);
+                counts.push(1);
+                values.push(scalars[i as usize].to_canonical());
+            }
+        }
+        let mut starts = Vec::with_capacity(counts.len() + 1);
+        starts.push(0);
+        for count in &counts {
+            starts.push(starts.last().unwrap() + count);
+        }
+        if std::env::var_os("ZOPRO_TRIAL_B2_PHASES").is_some() {
+            eprintln!("B2_TEMPLATE {n} {classes} {} {one_count} {exception_count} {kept}", self.flags.len());
+        }
+        Some(ScalarGroups { len: n, values, order, starts, counts, _reservation: reservation })
+    }
+}
+
+pub(super) fn classify(scalars: &[Fr]) -> Option<ScalarGroups> {
+    static PLAN: OnceLock<Option<Template>> = OnceLock::new();
+    PLAN.get_or_init(|| Template::load(scalars.len())).as_ref()?.apply(scalars)
+}
+
+#[cfg(test)]
+#[test]
+fn template_validates_members_and_routes_boolean_and_nonboolean_exceptions() {
+    const N: usize = 2048;
+    let plan_bytes = |bad: bool| {
+        let values = [N as u32, 2, (N - 8) as u32, 4, 4].into_iter().chain(
+            (0..N as u32).map(move |i| if bad && i == 21 { 20 } else { i }),
+        );
+        values.flat_map(u32::to_le_bytes).collect::<Vec<_>>()
+    };
+    let reservation = || Reservation::analysis(Some(1024)).unwrap();
+    assert!(Template::parse(&plan_bytes(true), N, reservation()).is_none());
+    assert!(Template::parse(&plan_bytes(false), N - 1, reservation()).is_none());
+    let plan = Template::parse(&plan_bytes(false), N, reservation()).unwrap();
+    let mut terms = vec![Fr::ZERO; N];
+    terms[0..4].fill(Fr::from(19u64));
+    terms[1] = Fr::ONE;
+    terms[2] = Fr::from(123u64);
+    terms[4..8].fill(Fr::from(27u64));
+    terms[4] = Fr::ZERO;
+    terms[21] = Fr::from(377u64);
+    terms[111] = Fr::ONE;
+    let groups = plan.apply(&terms).unwrap();
+    let mut seen = vec![false; N];
+    for (value, bounds) in groups.values.iter().zip(groups.starts.windows(2)) {
+        for &i in &groups.order[bounds[0]..bounds[1]] {
+            let i = i as usize;
+            assert!(!seen[i]);
+            seen[i] = true;
+            assert_eq!(terms[i].to_canonical(), *value);
+        }
+    }
+    assert!(terms.iter().zip(seen).all(|(v, has)| has == (*v != Fr::ZERO)));
+    terms[100..200].fill(Fr::from(101u64));
+    assert!(plan.apply(&terms).is_none());
+}
