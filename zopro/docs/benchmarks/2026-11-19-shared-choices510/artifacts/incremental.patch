+use super::{groups482, groups_g1_trial, preparation::Reservation, solver::Plan};
+const NONE: u32 = u32::MAX;
+pub(super) struct Maps {
+    pub a: Vec<u32>,
+    pub k: Vec<u32>,
+    _held: Reservation,
+}
+impl Maps {
+    pub fn bind(plan: &Plan, b: &groups482::Groups, a: &groups_g1_trial::Groups, k: &groups_g1_trial::Groups) -> Option<Self> {
+        let held = Reservation::analysis(a.len().checked_add(k.len())?.checked_mul(4)?.checked_add(128))?;
+        let _tmp = Reservation::analysis(plan.b_indices.len().checked_mul(4))?;
+        let mut owner = vec![NONE; plan.b_indices.len()];
+        for group in 0..b.len() {
+            for &index in b.members(group) {
+                *owner.get_mut(index as usize)? = u32::try_from(group).ok()?;
+            }
+        }
+        let bind = |linear: &groups_g1_trial::Groups, is_a: bool| {
+            let wire = |i: u32| if is_a { plan.a_indices.get(i as usize).copied() }
+                else { i.checked_add(u32::try_from(plan.n_public).ok()?) };
+            (0..linear.len()).map(|g| {
+                let rows = linear.members(g);
+                let Some(first) = wire(rows[0]) else {return NONE;};
+                let Ok(index) = plan.b_indices.binary_search(&first) else {return NONE;};
+                let shared = owner[index];
+                if shared == NONE {return NONE;}
+                let other = b.members(shared as usize);
+                if other.len() == rows.len() && rows.iter().zip(other).all(|(&l,&r)|wire(l) == Some(plan.b_indices[r as usize])) { shared } else { NONE }
+            }).collect::<Vec<_>>()
+        };
+        let result = Self { a: bind(a,true), k: bind(k,false), _held: held };
+        if std::env::var_os("ZOPRO_GROUP_PROBE").is_some() {
+            eprintln!("SHARED_MAP {} {} {} {}",result.a.iter().filter(|&&v|v!=NONE).count(),a.len(),result.k.iter().filter(|&&v|v!=NONE).count(),k.len());
+        }
+        Some(result)
+    }
+}
