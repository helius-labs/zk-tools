+
+/// Profile the ordinary grouped B2 stages or change only its final layout.
+pub(super) fn grouped_b2_layout(
+    bases: &[zopro_bn254::G2Affine],
+    groups: &ScalarGroups,
+    layout: &str,
+    class_ns: Option<u128>,
+) -> zopro_bn254::G2Projective {
+    use zopro_bn254::G2Config;
+
+    assert_eq!(bases.len(), groups.len, "validated MSM dimensions");
+    let clock = class_ns.map(|_| crate::time::Instant::now());
+    let grouped = crate::msm::group_affine(bases, &groups.order, &groups.starts, &groups.counts);
+    let group_ns = clock.map(|t| t.elapsed().as_nanos());
+    let requested = match layout {
+        "u11x3" => Some((false, 11, 3)),
+        "u12x1" => Some((false, 12, 1)),
+        "u12x2" => Some((false, 12, 2)),
+        "u13x1" => Some((false, 13, 1)),
+        "s12x2" => Some((true, 12, 2)),
+        "s13x2" => Some((true, 13, 2)),
+        "s13x3" => Some((true, 13, 3)),
+        _ => None,
+    };
+    #[cfg(all(zopro_resource_schedule,feature="ifma8",target_arch="x86_64",target_feature="avx512ifma",target_feature="avx512vl",target_feature="avx512dq",not(no_ifma)))]
+    let selected = requested.filter(|_| (1024..65536).contains(&grouped.len())).and_then(|geometry| {
+        let (signed, bits, parts) = geometry;
+        let bytes = workspace::grouped_b2_layout_bytes(grouped.len(), bits, parts, signed);
+        let reservation = crate::preparation::Reservation::analysis(bytes)?;
+        Some((geometry, reservation))
+    });
+    #[cfg(not(all(zopro_resource_schedule,feature="ifma8",target_arch="x86_64",target_feature="avx512ifma",target_feature="avx512vl",target_feature="avx512dq",not(no_ifma))))]
+    let selected: Option<((bool, usize, usize), ())> = None;
+    let _ = requested;
+    let geometry = selected.as_ref().map(|(shape, _)| *shape);
+    let begin = clock.map(|t| t.elapsed().as_nanos());
+    let sum = match geometry {
+        Some((true, bits, parts)) => merge_split_width::<G2Config>(&grouped, &groups.values, parts, bits),
+        Some((false, bits, parts)) => msm_unsigned_raw::<G2Config>(&grouped, &groups.values, bits, parts),
+        None => msm_raw::<G2Config>(&grouped, &groups.values),
+    };
+    if let (Some(start), Some(group), Some(class), Some(begin)) = (clock, group_ns, class_ns, begin) {
+        let (sign, bits, parts) = geometry.unwrap_or((false, 0, 0));
+        eprintln!(
+            "B2_STAGES {} {} {} {} {} {} {class} {group} {} {}",
+            bases.len(), grouped.len(), usize::from(sign), bits, parts, rayon::current_num_threads(),
+            start.elapsed().as_nanos() - begin, begin - group,
+        );
+    }
+    sum
 }
 
