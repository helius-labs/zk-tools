+    let words: Vec<_> = scalars.iter().map(Fr::to_canonical).collect();
+    let expected = G2Affine::GENERATOR * weights.iter().zip(&scalars).map(|(&a, &b)| a * b).fold(Fr::ZERO, |sum, term| sum + term);
