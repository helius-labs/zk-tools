+    for i in 0..2053 {
+        random = random.square() + Fr::from(i as u64 + 5);
+        weights.push(if i % 11 == 0 { Fr::ZERO } else { Fr::from(i as u64 + 1) });
+        scalars.push(if i % 3 == 0 { terms[i % terms.len()] } else { random });
+    }
