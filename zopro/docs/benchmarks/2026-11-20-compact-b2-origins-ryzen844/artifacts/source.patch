+    let mut starts = [0, 2, 2, 3, 6];
+    let mut order = [u32::MAX; 6];
+    scatter_classes(&classes, &mut starts, &mut order);
+    starts.copy_within(..4, 1);
+    starts[0] = 0;
+    assert_eq!(starts, [0, 2, 2, 3, 6]);
+    assert_eq!(order, [1, 3, 4, 0, 5, 6]);
