+
+fn scatter_classes(classes: &[u32], positions: &mut [usize], order: &mut [u32]) {
+    for (i, &class) in classes.iter().enumerate() {
+        if class != u32::MAX {
+            let position = &mut positions[class as usize];
+            order[*position] = i as u32;
+            *position += 1;
+        }
+    }
+}
