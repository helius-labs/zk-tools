+        State { positions: all, width: positions.len() as u8 }
+    };
+    let stride = 1 << INDEX_BITS;
+    let plan = B2Origins {
+        order: vec![7, stride + 7, stride * 2 + 7, stride * 3 + 7, u32::MAX],
+        states: vec![
+            make(&[0, 1, 2]), make(&[0, 1, 2]), make(&[0, 1, 3]), make(&[0, 1]),
+        ],
+        covered: 4,
+        compact: true,
+        _memory: Reservation::analysis(Some(4096)).unwrap(),
+    };
+    let words = [[1; 4], [2; 4], [3; 4], [4; 4], [5; 4]];
+    let mut aliases = plan.aliases(&words).unwrap();
+    assert_eq!(aliases.classes.len(), 8 * (7 * 3 + parameters(3).0) + 4 * (7 * 2 + parameters(2).0));
+    *aliases.slot(0).unwrap() = 37;
+    assert_eq!(aliases.slot(1), Some(&mut 37));
+    assert_eq!(aliases.slot(2), Some(&mut u32::MAX));
+    assert_eq!(aliases.slot(3), Some(&mut u32::MAX));
