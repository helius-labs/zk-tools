+// Both sparse lists use the same signed windows and independent scalar buffers.
+pub(crate) fn paired_corrections(
+    left: &[G2Affine], lw: &mut [[u64; 4]],
+    right: &[G2Affine], rw: &mut [[u64; 4]], bits: usize,
+) -> G2Projective {
+    assert_eq!(left.len(), lw.len());
+    assert_eq!(right.len(), rw.len());
+    assert!(bits == 8 || bits == 10);
+    rayon::join(
+        || lw.par_iter_mut().with_min_len(128).for_each(|v| *v = phi_split(*v)),
+        || rw.par_iter_mut().with_min_len(128).for_each(|v| *v = phi_split(*v)),
+    );
+    let windows = 127usize.div_ceil(bits);
+    let values: Vec<_> = (0..windows).into_par_iter().map(|window| {
+        let (mut a, b) = rayon::join(
+            || hb_window(left, lw, window, bits),
+            || hb_window(right, rw, window, bits),
+        );
+        merge_buckets(&mut a, &b);
+        crate::msm::weighted_affine(&a)
+    }).collect();
+    let mut result = G2Projective::IDENTITY;
+    for value in values.iter().rev() {
+        for _ in 0..bits { result = result.double(); }
+        result += value;
+    }
+    result
+}
