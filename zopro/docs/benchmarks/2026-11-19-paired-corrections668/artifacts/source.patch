+#[cfg(test)]
+#[test]
+fn paired_corrections_match_known_scalar_sum() {
+    let mut values = Vec::new();
+    let mut points = Vec::new();
+    let mut expected = Fr::ZERO;
+    for i in 0..617 {
+        let signed = if i % 3 == 0 { -Fr::from((i+1) as u64) } else { Fr::from((i+1) as u64).pow(&[41]) };
+        let (point, weight) = match i % 4 {
+            0 => (G2Affine::IDENTITY, Fr::ZERO),
+            1 => (-G2Affine::GENERATOR, -Fr::ONE),
+            _ => (G2Affine::GENERATOR, Fr::ONE),
+        };
+        expected += weight * signed;
+        values.push(signed.to_canonical()); points.push(point);
+    }
+    for bits in [8, 10] {
+        for boundary in [0, 271, 617] {
+            let mut words = values.clone();
+            let (a, b) = words.split_at_mut(boundary);
+            let result = paired_corrections(&points[..boundary], a, &points[boundary..], b, bits);
+            assert_eq!(result.to_affine(), (G2Affine::GENERATOR * expected).to_affine());
+        }
+    }
+}
