+use super::*;
+use std::mem::MaybeUninit;
+
+pub(super) fn transform(plan: &Plan, a: &[Fr], b: &[Fr], padded: bool) -> Vec<PackedPair> {
+    let len = plan.n / 4;
+    let q = len / 32;
+    let roots = &plan.inverse_roots;
+    let mut output = Vec::with_capacity(len);
+    let mut stripes = output.spare_capacity_mut()[..len].chunks_exact_mut(q);
+    let stripes = core::array::from_fn(|_| stripes.next().unwrap());
+    let grain = (q / (rayon::current_num_threads() * 2)).max(8);
+    columns(stripes, 0, q, a, b, roots, grain, padded);
+    // Every stripe was initialized by a completed task. PackedPair owns no heap data.
+    unsafe { output.set_len(len) };
+    let cutoff = leaf::cutoff(len, rayon::current_num_threads());
+    output.par_chunks_mut(q).for_each(|part| {
+        stored_transform_inner::<PackedPair, false>(part, roots, 5, cutoff);
+    });
+    output
+}
+
+fn columns(
+    mut stripes: [&mut [MaybeUninit<PackedPair>]; 32], first: usize, q: usize,
+    a: &[Fr], b: &[Fr], roots: &Twiddles, grain: usize, padded: bool,
+) {
+    let len = stripes[0].len();
+    if len > grain {
+        let mid = len / 2;
+        let right = core::array::from_fn(|i| {
+            let (left, right) = std::mem::take(&mut stripes[i]).split_at_mut(mid);
+            stripes[i] = left;
+            right
+        });
+        rayon::join(|| columns(stripes, first, q, a, b, roots, grain, padded),
+                    || columns(right, first + mid, q, a, b, roots, grain, padded));
+        return;
+    }
+    let zero = Pair::new(&[Fr::ZERO; 8]);
+    let limit = a.len().max(b.len());
+    for col in first..first + len {
+        let mut values = core::array::from_fn(|row| {
+            let begin = 4 * (row * q + col);
+            if begin >= limit { return zero; }
+            let lanes = core::array::from_fn(|i| {
+                let src = if i < 4 { a } else { b };
+                src.get(begin + i % 4).copied().unwrap_or(Fr::ZERO)
+            });
+            Pair::new(&lanes)
+        });
+        if padded {
+            for j in 0..16 {
+                if 4 * (j * q + col) >= limit { break; }
+                let root = if roots.columns.is_empty() { &roots.layers[0][j*q+col] }
+                           else { &roots.columns[0][31*col+j] };
+                let (lo, hi) = (values[j], values[j+16]);
+                if 4 * ((j+16)*q + col) < limit {
+                    values[j] = lo.add(&hi);
+                    values[j+16] = lo.sub(&hi).mul(&broadcast(root));
+                } else {
+                    values[j+16] = lo.mul(&broadcast(root));
+                }
+            }
+            if roots.columns.is_empty() {
+                column_kernel_from::<false, false, 1>(&mut values, roots, 0, q, col);
+            } else {
+                column_kernel_from::<true, false, 1>(&mut values, roots, 0, q, col);
+            }
+        } else if roots.columns.is_empty() {
+            column_kernel::<false, false>(&mut values, roots, 0, q, col);
+        } else {
+            column_kernel::<true, false>(&mut values, roots, 0, q, col);
+        }
+        for (stripe, value) in stripes.iter_mut().zip(values) {
+            stripe[col-first].write(PackedPair::store(value));
+        }
+    }
+}
