+mod tests {
+    use super::*;
+    #[test]
+    fn direct_inverse_matches_separate_pack() {
+        for n in [8192usize, 32768] {
+            let root = Fr::root_of_unity(n).unwrap().pow(&[3]);
+            let coset = Fr::from(5u64);
+            let mut plan = Plan::new(n, root, coset, denominator(n,coset).unwrap());
+            for cached in [false,true] {
+                if cached {plan.inverse_roots.prepare_columns();} else {plan.inverse_roots.columns.clear();}
+                for (na,nb) in [(0,0),(n/4-1,n/4+1),(n/2+3,n/2-5),(n,n)] {
+                    let make=|len,salt| (0..len).map(|i| {
+                        Fr::from(i as u64 + salt).pow(&[9])
+                    }).collect::<Vec<_>>();
+                    let (a,b)=(make(na,13),make(nb,29));
+                    let mut expected=(0..n/4).map(|i| PackedPair::store(Pair::new(
+                        &core::array::from_fn(|j| (if j<4 {&a} else {&b}).get(4*i+j%4).copied().unwrap_or(Fr::ZERO))
+                    ))).collect::<Vec<_>>();
+                    stored_transform::<PackedPair,false>(&mut expected,&plan.inverse_roots,0);
+                    for padded in [false,true] {
+                        let got=transform(&plan,&a,&b,padded);
+                        assert!(got.iter().zip(&expected).all(|(l,r)| l.load().get()==r.load().get()));
+                    }
+                }
+            }
+        }
+    }
