+impl Key {
+    fn run_general_preparation<T: Send>(&self, phase: &str, work: impl FnOnce() -> T + Send) -> T {
+        if let Some(pool) = self.frontend_pool.as_ref() {
+            let mode = std::env::var("ZOPRO_BENCH_GENERAL_FRONTEND").unwrap_or_default();
+            if (mode == phase || mode == "both")
+                && pool.current_num_threads() < rayon::current_num_threads()
+                && !self.has_gpu()
+                && self.lagrange.as_ref().is_some_and(|q| q.folded.is_some())
+            {
+                return pool.install(work);
+            }
+        }
+        work()
