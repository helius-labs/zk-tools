+pub(super) fn trial_top_growth(
+    n: usize, workers: usize, bits: usize, parts: usize, joint: bool,
+) -> Option<usize> {
+    let ordinary = hb_windows::<G2Config>(n, 12, 2)?;
+    let mut trial = hb_windows::<G2Config>(n, bits, parts)?;
+    if joint {
+        let top_bits = 126 - (127usize.div_ceil(bits) - 1) * bits;
+        let merged = top::<G2Config>(n.checked_mul(2)?, top_bits + 2)?;
+        trial.held = add(trial.held, add(merged.held, vector::<Affine<G2Config>>(4 << top_bits, false)?)?)?;
+        trial.leaf = trial.leaf.max(merged.leaf);
+    }
+    add(trial.held.saturating_sub(ordinary.held),
+        mul(trial.leaf.saturating_sub(ordinary.leaf), workers)?)
