+// Both signed components share the input scan and the indexed reduction.
+fn joint_top(bases: &[G2Affine], short: &[[u64; 4]], w: usize, bits: usize) -> Vec<G2Affine> {
+    let n = 1 << (126 - w * bits);
+    let index = |d: i16, plane: usize| {
+        d.unsigned_abs() as usize - 1 + (2 * plane + usize::from(d < 0)) * n
+    };
+    let bins = |words: &[u64; 4]| [hb_digit(words, true, w, bits), hb_digit(words, false, w, bits)];
+    let mut counts = vec![0usize; 4 * n];
+    for (base, words) in bases.iter().zip(short) {
+        if !base.is_identity() {
+            for (plane, d) in bins(words).into_iter().enumerate() {
+                if d != 0 {
+                    debug_assert!(d.unsigned_abs() as usize <= n);
+                    counts[index(d, plane)] += 1;
+                }
+            }
+        }
+    }
+    let mut starts = Vec::with_capacity(counts.len() + 1);
+    starts.push(0);
+    for count in counts {
+        starts.push(starts.last().unwrap() + count);
+    }
+    let mut positions = starts[..4 * n].to_vec();
+    let mut order = vec![0u32; *starts.last().unwrap()];
+    for (i, (base, words)) in bases.iter().zip(short).enumerate() {
+        if !base.is_identity() {
+            for (plane, d) in bins(words).into_iter().enumerate() {
+                if d != 0 {
+                    let bin = index(d, plane);
+                    order[positions[bin]] = i as u32;
+                    positions[bin] += 1;
+                }
+            }
+        }
+    }
+    drop(positions);
+    let mut sums = crate::msm::reduce_indexed_buckets(bases, &order, &starts);
+    let mut negative_low = sums.split_off(3 * n);
+    let mut low = sums.split_off(2 * n);
+    let mut negative_high = sums.split_off(n);
+    for point in negative_high.iter_mut().chain(&mut negative_low) {
+        point.y = -point.y;
+    }
+    merge_buckets(&mut sums, &negative_high);
+    merge_buckets(&mut low, &negative_low);
+    for point in &mut sums {
+        if !point.is_identity() {
+            point.x = point.x.mul_by_fp(&BETA);
+        }
+    }
+    merge_buckets(&mut sums, &low);
