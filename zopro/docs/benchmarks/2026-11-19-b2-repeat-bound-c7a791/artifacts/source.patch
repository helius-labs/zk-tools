+// Used by the fixed-request benchmark to isolate B2 preparation cost.
+use super::{ScalarGroups, msm_grouped, msm_raw};
+use crate::preparation::Reservation;
+use std::sync::OnceLock;
+use zopro_bn254::{Fr, G2Affine, G2Projective};
+
+#[derive(Clone, Copy)]
+enum Replay {
+    Classes,
+    Affine,
+}
+impl Replay {
+    fn name(self) -> &'static str {
+        match self {
+            Self::Classes => "classes",
+            Self::Affine => "affine",
+        }
+    }
+}
+struct Prepared {
+    base_address: usize,
+    scalar_words: Vec<Fr>,
+    groups: ScalarGroups,
+    points: Option<Vec<G2Affine>>,
+    _scratch: Reservation,
+}
+
+fn trace(mode: Replay, count: usize, event: &str) {
+    static TRACE: OnceLock<bool> = OnceLock::new();
+    if *TRACE.get_or_init(|| std::env::var_os("ZOPRO_TRIAL_B2_REPLAY_TRACE").is_some()) {
+        eprintln!("B2_REPLAY {} {count} {event}", mode.name());
+    }
+}
+
+pub(crate) fn measure(
+    bases: &[G2Affine],
+    witness: &[Fr],
+    build: impl FnOnce() -> Option<ScalarGroups>,
+) -> Option<G2Projective> {
+    static MODE: OnceLock<Option<Replay>> = OnceLock::new();
+    static DATA: OnceLock<Option<Prepared>> = OnceLock::new();
+    let mode = (*MODE.get_or_init(|| match std::env::var("ZOPRO_TRIAL_B2_REPLAY").as_deref() {
+        Ok("classes") => Some(Replay::Classes),
+        Ok("affine") => Some(Replay::Affine),
+        _ => None,
+    }))?;
+    let count = witness.len();
+    let address = bases.as_ptr() as usize;
+    let mut initialized = false;
+    let cached = DATA
+        .get_or_init(|| {
+            let groups = build()?;
+            if !(1_024..262_144).contains(&groups.values.len()) {
+                return None;
+            }
+            let bytes = std::mem::size_of_val(witness).checked_add(match mode {
+                Replay::Classes => 0,
+                Replay::Affine => groups
+                    .values
+                    .len()
+                    .checked_mul(std::mem::size_of::<G2Affine>())?,
+            })?;
+            let scratch = Reservation::analysis(Some(bytes))?;
+            let points = match mode {
+                Replay::Classes => None,
+                Replay::Affine => Some(crate::msm::group_affine(
+                    bases,
+                    &groups.order,
+                    &groups.starts,
+                    &groups.counts,
+                )),
+            };
+            initialized = true;
+            Some(Prepared {
+                base_address: address,
+                scalar_words: witness.to_vec(),
+                groups,
+                points,
+                _scratch: scratch,
+            })
+        })
+        .as_ref()?;
+    // The SDK runner holds one immutable mapped proving key for its lifetime.
+    // Compare full witness coefficients before every use of its cached groups.
+    if cached.base_address != address || cached.scalar_words != witness {
+        trace(mode, count, "miss");
+        return None;
+    }
+    trace(mode, count, if initialized { "prime" } else { "hit" });
+    Some(match &cached.points {
+        None => msm_grouped(bases, &cached.groups),
+        Some(points) => msm_raw(points, &cached.groups.values),
+    })
+}
