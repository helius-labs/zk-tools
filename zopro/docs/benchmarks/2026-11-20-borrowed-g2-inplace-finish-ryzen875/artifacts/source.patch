+    fn finish_in_place(&mut self) {
+        let mut product = Fq2::ONE;
+        let mut pending = 0usize;
+        for (point, &bucket) in self.projective.iter_mut().zip(&self.projective_buckets) {
+            let destination = &mut self.affine[bucket];
+            *point += *destination;
+            if point.is_identity() {
+                *destination = G2Affine::IDENTITY;
+            } else if point.z == Fq2::ONE {
+                *destination = G2Affine::new(point.x, point.y);
+                point.z = Fq2::ZERO;
+            } else {
+                // Each projective contribution has a unique affine destination.
+                // Once consumed by the addition, its X can hold the prefix.
+                destination.x = product;
+                product *= point.z;
+                pending += 1;
+            }
+        }
+
+        static TRACE: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+        if *TRACE.get_or_init(|| {
+            std::env::var_os("ZOPRO_TRIAL_G2_INPLACE_FINISH_TRACE").is_some_and(|v| v == "1")
+        }) {
+            eprintln!("G2_INPLACE_FINISH {} {}", self.projective.len(), pending);
+        }
+
+        if pending == 0 {
+            return;
+        }
+        let mut inverse = product.inverse().expect("a nonzero product");
+        for (point, &bucket) in self.projective.iter().zip(&self.projective_buckets).rev() {
+            if point.is_identity() {
+                continue;
+            }
+            let destination = &mut self.affine[bucket];
+            let inv_z = inverse * destination.x;
+            inverse *= point.z;
+            let inv_z_squared = inv_z.square();
+            *destination = G2Affine::new(
+                point.x * inv_z_squared,
+                point.y * inv_z_squared * inv_z,
+            );
+        }
+    }
