+#[derive(Clone, Copy)]
+pub(crate) struct LargeMode {
+    group_k: bool,
+    pub(crate) parts: usize,
+}
+
+pub(crate) fn large_mode() -> Option<LargeMode> {
+    static MODE: std::sync::OnceLock<Option<LargeMode>> = std::sync::OnceLock::new();
+    *MODE.get_or_init(|| match std::env::var("ZOPRO_TRIAL_LARGE_FUSED_KH").as_deref() {
+        Ok("raw") => Some(LargeMode { group_k: false, parts: 1 }),
+        Ok("group") => Some(LargeMode { group_k: true, parts: 1 }),
+        Ok("striped") => Some(LargeMode { group_k: true, parts: 2 }),
+        _ => None,
+    })
+}
+
+fn large_fused(
+    k: &[G1Affine], sk: &[[u64; 4]], h: &[G1Affine], sh: &[[u64; 4]], parts: usize,
+) -> G1Projective {
+    if parts == 1 {
+        return fused(k, sk, h, sh, 13);
+    }
+    let k_mid = k.len() / 2;
+    let h_mid = h.len() / 2;
+    let (low, high) = rayon::join(
+        || fused(&k[..k_mid], &sk[..k_mid], &h[..h_mid], &sh[..h_mid], 13),
+        || fused(&k[k_mid..], &sk[k_mid..], &h[h_mid..], &sh[h_mid..], 13),
+    );
+    low + high
+}
+
+pub(crate) fn large_with_mode(
+    k: &[G1Affine], sk: &mut [Fr], h: &[G1Affine], sh: &mut [Fr], mode: LargeMode,
+) -> G1Projective {
+    let (groups, sh) = rayon::join(
+        || mode.group_k.then(|| super::group_witness(sk)).flatten(),
+        || super::canonical(sh),
+    );
+    let trace = std::env::var_os("ZOPRO_TRIAL_LARGE_FUSED_KH_TRACE").is_some();
+    if let Some(groups) = groups {
+        let reduced = crate::msm::group_affine(k, &groups.order, &groups.starts, &groups.counts);
+        if trace {
+            eprintln!("LARGE_FUSED_KH {} {} {} {}", k.len(), h.len(), mode.parts, reduced.len());
+        }
+        large_fused(&reduced, &groups.values, h, sh, mode.parts)
+    } else {
+        if trace {
+            eprintln!("LARGE_FUSED_KH {} {} {} 0", k.len(), h.len(), mode.parts);
+        }
+        large_fused(k, super::canonical(sk), h, sh, mode.parts)
+    }
+}
