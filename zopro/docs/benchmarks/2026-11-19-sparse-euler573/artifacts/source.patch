+use rayon::prelude::*;
+
+pub(super) struct Masks {
+    pub(super) blocks: Vec<u64>,
+    _charge: crate::preparation::Reservation,
+}
+
+fn blocks(words: &[[u64;4]]) -> Vec<u64> {
+    words.par_chunks(64).with_min_len(64).map(|chunk| {
+        chunk.iter().enumerate().fold(0, |bits,(i,w)| bits | (u64::from(*w != [0;4])<<i))
+    }).collect()
+}
+
+pub(super) fn positions(blocks:&[u64],start:usize,len:usize)->impl Iterator<Item=usize> + '_ {
+    let end=start+len;
+    let first=start/64;
+    let last=end.div_ceil(64);
+    blocks[first..last].iter().enumerate().flat_map(move |(index,mask)|{
+        let base=(first+index)*64;
+        let lo=start.saturating_sub(base);
+        let hi=(end-base).min(64);
+        let top=if hi==64 { u64::MAX } else { (1u64<<hi)-1 };
+        let mut live=*mask & top & (u64::MAX<<lo);
+        std::iter::from_fn(move || {
+            if live==0 { return None; }
+            let offset=live.trailing_zeros() as usize;
+            live&=live-1;
+            Some(base+offset-start)
+        })
+    })
+}
+
+impl Masks {
+    pub(super) fn new(words:&[[u64;4]])->Option<Self>{
+        let setting=std::env::var("ZOPRO_TRIAL_H_OCCUPANCY").ok()?;
+        if setting!="1" && setting!="trace" {return None;}
+        let stride=words.len().div_ceil(1024).max(1);
+        let count=words.len().div_ceil(stride);
+        let zero=words.iter().step_by(stride).filter(|w| **w==[0;4]).count();
+        if zero*4<count {
+            if setting=="trace"{eprintln!("H_OCCUPANCY_SKIP {} {} {}",words.len(),zero,count);}
+            return None;
+        }
+        let bytes=words.len().div_ceil(64).checked_mul(8)?;
+        let charge=crate::preparation::Reservation::analysis(Some(bytes))?;
+        let blocks=blocks(words);
+        if setting=="trace"{
+            let live:usize=blocks.iter().map(|x| x.count_ones() as usize).sum();
+            eprintln!("H_OCCUPANCY {} {} {}",words.len(),live,bytes);
+        }
+        Some(Self{blocks,_charge:charge})
+    }
+
+}
