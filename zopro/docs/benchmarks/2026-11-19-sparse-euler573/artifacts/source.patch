+    #[test]
+    fn partial_half_ranges_cover_every_nonzero_scalar_once() {
+        use zopro_bn254::{Fr,G1Affine,G1Projective};
+        let n=193usize;
+        let mut base=G1Projective::IDENTITY;
+        let points:Vec<_>=(0..n).map(|i|{
+            base+=G1Affine::GENERATOR;
+            if i%13==0 {G1Projective::IDENTITY} else {base}
+        }).collect();
+        let points=G1Projective::batch_to_affine(&points);
+        let words:Vec<_>=(0..n).map(|i|{
+            if i%5==0 || i>127 { [0;4] } else {
+                let v=i as u64;
+                [v.wrapping_mul(0xa91728d135489771),v.rotate_left(53),
+                 v.wrapping_mul(0xdb940a011338a7c7),v.rotate_left(47) | (1<<60)]
+            }
+        }).collect();
+        let scalar=words.iter().enumerate().filter(|(i,_)|i%13!=0).fold(Fr::ZERO,|acc,(i,w)|
+            acc+Fr::from((i+1) as u64)*Fr::from_canonical(*w).unwrap());
+        let expected=(G1Affine::GENERATOR*scalar).to_affine();
+        let mask=blocks(&words);
+        assert_eq!(super::super::sum_occupied::<_,false>(&points,&words,Some(&mask)).to_affine(),expected);
+        assert_eq!(super::super::sum_occupied::<_,true>(&points,&words,Some(&mask)).to_affine(),expected);
+        assert_eq!(super::super::sum_occupied::<_,true>(&points,&words,None).to_affine(),expected);
+
+        for n in [0usize,1,2,61,63,64,65,127,129,997] {
+            for pattern in [0,1,3,7] {
+                let words:Vec<_>=(0..n).map(|i|{
+                    let mut w=[0;4];
+                    if pattern!=0 && i%pattern==0 {w[i%4]=1+(i as u64);}
+                    w
+                }).collect();
+                let masks=blocks(&words);
+                for start in [0,n/4,n/2,n.saturating_sub(1),n]{
+                    for end in [start,(start+n)/2,n]{
+                        let expected:Vec<_>=words[start..end].iter().enumerate().filter_map(|(i,w)|(*w!=[0;4]).then_some(i)).collect();
+                        assert_eq!(positions(&masks,start,end-start).collect::<Vec<_>>(),expected);
+                    }
+                }
+            }
+        }
+    }
