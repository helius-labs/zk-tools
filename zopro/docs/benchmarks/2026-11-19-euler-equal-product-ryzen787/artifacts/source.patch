+#[cfg(test)]
+#[test]
+fn equal_row_fusion_matches_ordinary_product_on_mixed_and_partial_rows() {
+    let n = 8192usize;
+    let root = Fr::root_of_unity(n).unwrap();
+    let coset = Fr::from(5u64);
+    let mut plan = Plan::new(n, root, coset, denominator(n, coset).unwrap());
+    plan.prepare_euler_basis();
+    for len in [n - 9, n] {
+        let mut actual: Vec<_> = (0..len)
+            .map(|i| if i / 8 % 3 == 2 { Fr::ZERO } else { Fr::from((i + 4) as u64).square() })
+            .collect();
+        let right: Vec<_> = actual.iter().take(len - 5).enumerate()
+            .map(|(i, &x)| if i / 8 % 3 == 1 { x + Fr::from((i + 1) as u64) } else { x })
+            .collect();
+        let mut expected = actual.clone();
+        emit_products_mode::<false>(&plan, &mut expected, &right, Vec::with_capacity(n / 4));
+        emit_products_mode::<true>(&plan, &mut actual, &right, Vec::with_capacity(n / 4));
+        assert_eq!(actual, expected);
+    }
+}
