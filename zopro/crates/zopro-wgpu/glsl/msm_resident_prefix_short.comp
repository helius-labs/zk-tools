#version 450
// One workgroup scans each signed Booth window. Every bucket gets the
// exclusive start of its scalars and its partial sums at three shard levels.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer Histogram { uint values[]; } histogram;
layout(std430, set = 0, binding = 1) buffer Offsets { uvec4 values[]; } offsets;
layout(std430, set = 0, binding = 2) buffer Cursors { uint values[]; } cursors;
layout(std430, set = 0, binding = 3) buffer Totals { uvec4 values[]; } totals;
layout(std140, set = 0, binding = 4) uniform Geometry {
  uint n;
  uint half_range;
  uint windows;
  uint stride;
  uint first_log;
} args;
layout(std430, set = 0, binding = 5) buffer ShardBuckets { uint values[]; } shard_buckets;

shared uvec4 partials[64];
shared uint maxima[64];

uvec4 lengths(uint count) {
  if (count == 0u) return uvec4(0u);
  const uvec3 shifts = uvec3(args.first_log) + uvec3(0u, 5u, 10u);
  return uvec4(count, (uvec3(count - 1u) >> shifts) + 1u);
}

void main() {
  const uint window = gl_WorkGroupID.x;
  const uint lane = gl_LocalInvocationID.x;
  const uint block = (args.half_range + 63u) / 64u;
  const uint first = lane * block;
  const uint end = min(first + block, args.half_range);
  const uint base = window * args.half_range;
  uvec4 length = uvec4(0u);
  uint maximum = 0u;
  for (uint bucket = first; bucket < end; ++bucket) {
    const uint count = histogram.values[base + bucket];
    length += lengths(count);
    maximum = max(maximum, count);
  }
  partials[lane] = length;
  maxima[lane] = maximum;
  barrier();
  for (uint step = 1u; step < 64u; step <<= 1u) {
    const uvec4 previous = lane >= step ? partials[lane - step] : uvec4(0u);
    const uint previous_maximum = lane >= step ? maxima[lane - step] : 0u;
    barrier();
    partials[lane] += previous;
    maxima[lane] = max(maxima[lane], previous_maximum);
    barrier();
  }
  uvec4 start = lane == 0u ? uvec4(0u) : partials[lane - 1u];
  if (lane == 63u)
    totals.values[window] = uvec4(maxima[lane], (start + length).yzw);
  start.x += window * args.n;
  for (uint bucket = first; bucket < end; ++bucket) {
    const uint index = base + bucket;
    offsets.values[index] = start;
    cursors.values[index] = start.x;
    const uvec4 count = lengths(histogram.values[index]);
    const uint first_shard = window * args.stride + start.y;
    for (uint shard = 0u; shard < count.y; ++shard)
      shard_buckets.values[first_shard + shard] = index;
    start += count;
  }
}
