#version 450
#extension GL_GOOGLE_include_directive : require
#include "field.glsl"

layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Values { fr values[]; } values;
layout(std430, set = 0, binding = 1) readonly buffer Roots { fr values[]; } roots;
layout(std140, set = 0, binding = 2) uniform Tile {
  uint n;
  uint first;
  uint levels;
  uint stride_log;
  uint cols_log;
  uint forward;
} args;

shared fr tile[128];

// A tile holds a row group and a small run of adjacent columns.
// The stride separates consecutive rows within the original vector.
uint tile_index(uint group, uint row, uint column) {
  const uint stripe_log = args.stride_log - args.cols_log;
  const uint block = group >> stripe_log;
  const uint stripe = group & ((1u << stripe_log) - 1u);
  return (block << (args.levels + args.stride_log))
      + (stripe << args.cols_log) + column + (row << args.stride_log);
}

void main() {
  const uint group = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
  const uint lane = gl_LocalInvocationID.x;
  const uint cols_mask = (1u << args.cols_log) - 1u;
  const uint entries = 1u << (args.levels + args.cols_log);
  for (uint index = lane; index < entries; index += 64u) {
    tile[index] = values.values[tile_index(group, index >> args.cols_log, index & cols_mask)];
  }
  barrier();

  const uint column = lane & cols_mask;
  const uint pair = lane >> args.cols_log;
  const bool dit = args.forward != 0u;
  for (uint step = 0; step < args.levels; ++step) {
    if (lane < entries / 2u) {
      const uint local_level = dit ? args.levels - 1u - step : step;
      const uint gap_log = args.levels - 1u - local_level;
      const uint row0 = ((pair >> gap_log) << (gap_log + 1u)) | (pair & ((1u << gap_log) - 1u));
      const uint row1 = row0 | (1u << gap_log);
      const uint left = (row0 << args.cols_log) | column;
      const uint right = (row1 << args.cols_log) | column;
      const uint level = args.first + local_level;
      const uint gap = args.n >> (level + 1u);
      const uint power = (tile_index(group, row0, column) & (gap - 1u)) << level;

      const fr u = tile[left];
      fr v = tile[right];
      if (dit && power != 0u)
        v = fr_mul(v, roots.values[power]);
      tile[left] = fr_add(u, v);
      fr difference = fr_sub(u, v);
      if (!dit && power != 0u)
        difference = fr_mul(difference, roots.values[power]);
      tile[right] = difference;
    }
    barrier();
  }

  for (uint index = lane; index < entries; index += 64u) {
    values.values[tile_index(group, index >> args.cols_log, index & cols_mask)] = tile[index];
  }
}
