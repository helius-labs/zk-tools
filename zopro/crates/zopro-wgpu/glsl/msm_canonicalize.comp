#version 450
#extension GL_GOOGLE_include_directive : require
#include "field.glsl"
#define SORT_UNIFORM 1
#include "digits.glsl"

layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Scalars { fr values[]; } scalars;

void main() {
  const uint i = sort.offset + gl_GlobalInvocationID.x;
  if (i < sort.n)
    scalars.values[i] = fr_to_canon(scalars.values[i]);
}
