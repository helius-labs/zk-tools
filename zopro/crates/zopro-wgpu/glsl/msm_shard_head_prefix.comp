#version 450
layout(local_size_x = 1) in;
layout(std430, set = 0, binding = 0) buffer Bands { uint values[]; } bands;
layout(std140, set = 0, binding = 1) uniform Geometry { uint shift; uint count; uint p2; uint p3; } args;

void main() {
  uint accounted = 0u;
  for (uint band = 0u; band < args.count; ++band) {
    const uint count = bands.values[band];
    bands.values[band] = accounted;
    accounted += count;
  }
}
