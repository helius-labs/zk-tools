#version 450
#extension GL_GOOGLE_include_directive : require
// quotient.wgsl's fr_scale: values[i] *= weights[i] (bound as roots).
#include "field.glsl"
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Values { fr values[]; } values;
layout(std430, set = 0, binding = 1) readonly buffer Roots { fr values[]; } roots;
layout(std140, set = 0, binding = 2) uniform Stage { uint n; uint level; uint gap_log; uint pad; } stage;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  if (i < stage.n)
    values.values[i] = fr_mul(values.values[i], roots.values[i]);
}
