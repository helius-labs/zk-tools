// Selected u16 arithmetic does not call it.
// Exact 32x32->64 multiply using four native16-bit products. Each product fits
// u32; middle < 3*2^16; the exact high word fits u32, even for MAX*MAX.
fn fr_wide_mul(a: u32, b: u32) -> vec2<u32> {
    let a0 = a & 0xffffu;
    let a1 = a >> 16u;
    let b0 = b & 0xffffu;
    let b1 = b >> 16u;
